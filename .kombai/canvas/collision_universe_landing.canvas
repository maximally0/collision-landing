    },
    "var_77f50d8a2204": {
      "type": "variant",
      "label": "Collision — Impact Atlas",
      "parentId": "var_d60cff287751",
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style type=\"text/tailwindcss\">\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Manrope:wght@300;400;600&family=Space+Mono:wght@400;700&display=swap');\n\n@theme {\n  --color-cobalt: #051243;\n  --color-paper: #FDFBF7;\n  --color-ember: #E63946;\n  --color-cyan: #48CAE4;\n  --color-butter: #F4C95D;\n  --color-navy: #030a24;\n  --font-serif: \"Playfair Display\", serif;\n  --font-mono: \"Space Mono\", monospace;\n  --font-sans: \"Manrope\", sans-serif;\n}\n\nbody {\n  margin: 0;\n  background-color: var(--color-navy);\n  color: var(--color-paper);\n  font-family: 'Manrope', sans-serif;\n  overflow-x: clip;\n}\n\n/* Section Visuals */\n.collision-seam-bg {\n  background: linear-gradient(135deg, var(--color-paper) 50%, var(--color-cobalt) 50.1%);\n}\n\n.impact-mark {\n  background: var(--color-ember);\n  box-shadow: 0 0 20px var(--color-ember);\n}\n\n.paper-surface { background-color: var(--color-paper); color: var(--color-navy); }\n.cobalt-surface { background-color: var(--color-cobalt); color: var(--color-paper); }\n.navy-surface { background-color: var(--color-navy); color: var(--color-paper); }\n\n.paper-card {\n  background-color: var(--color-paper);\n  color: var(--color-navy);\n  box-shadow: 8px 8px 0 rgba(0,0,0,0.1);\n  border: 1px solid rgba(0,0,0,0.05);\n}\n\n.terminal-box {\n  background: rgba(3, 10, 36, 0.95);\n  border: 1px solid rgba(72, 202, 228, 0.3);\n  backdrop-filter: blur(8px);\n}\n\n.diagonal-divider {\n  clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);\n}\n\n.diagonal-divider-reverse {\n  clip-path: polygon(0 15%, 100% 0, 100% 100%, 0 100%);\n}\n\n.noise-overlay {\n  position: absolute;\n  inset: 0;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n  opacity: 0.05;\n  pointer-events: none;\n}\n\n/* Animations (Static-simulated) */\n.impact-ring {\n  border: 1px solid var(--ember);\n  border-radius: 50%;\n  position: absolute;\n}\n</style>\n<!-- 1. HERO / THE COLLISION -->\n<section class=\"relative min-h-screen flex items-center overflow-hidden\" data-kid=\"1\" data-name=\"hero collision section\">\n    <div class=\"absolute inset-0 collision-seam-bg opacity-100\" data-kid=\"1-1\" data-name=\"collision seam background\">\n    </div>\n    <div class=\"noise-overlay\" data-kid=\"1-2\" data-name=\"noise overlay\">\n    </div>\n    <nav class=\"absolute top-0 left-0 w-full p-10 flex justify-between items-center z-50\" data-kid=\"1-3\" data-name=\"main navigation bar\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-3-1\" data-name=\"logo container\">\n            <div class=\"w-12 h-12 bg-navy rounded-xs rotate-45 flex items-center justify-center border border-white/20\" data-kid=\"1-3-1-1\" data-name=\"logo shape\">\n                <div class=\"w-4 h-4 bg-paper rounded-full shadow-[0_0_15px_rgba(255,255,255,0.5)]\" data-kid=\"1-3-1-1-1\" data-name=\"logo core circle\">\n                </div>\n            </div>\n            <span class=\"text-4xl font-serif font-bold text-navy tracking-tight italic\" data-kid=\"1-3-1-2\" data-name=\"brand name text\">\n                Collision\n            </span>\n        </div>\n        <div class=\"hidden md:flex gap-16 text-[10px] font-mono tracking-[0.4em] text-navy/60 uppercase font-bold\" data-kid=\"1-3-2\" data-name=\"navigation menu links\">\n            <a class=\"hover:text-ember transition-colors relative group\" data-kid=\"1-3-2-1\" data-name=\"manifesto link\" href=\"#manifesto\">\n                Manifesto\n                <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-ember group-hover:w-full transition-all\" data-kid=\"1-3-2-1-1\" data-name=\"manifesto underline\">\n                </span>\n            </a>\n            <a class=\"hover:text-ember transition-colors relative group\" data-kid=\"1-3-2-2\" data-name=\"runtime link\" href=\"#runtime\">\n                Runtime\n                <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-ember group-hover:w-full transition-all\" data-kid=\"1-3-2-2-1\" data-name=\"runtime underline\">\n                </span>\n            </a>\n            <a class=\"hover:text-ember transition-colors relative group\" data-kid=\"1-3-2-3\" data-name=\"operators link\" href=\"#operators\">\n                Operators\n                <span class=\"absolute -bottom-1 left-0 w-0 h-px bg-ember group-hover:w-full transition-all\" data-kid=\"1-3-2-3-1\" data-name=\"operators underline\">\n                </span>\n            </a>\n            <a class=\"px-8 py-3 bg-navy text-paper hover:bg-ember transition-colors tracking-widest font-black ring-1 ring-navy/10\" data-kid=\"1-3-2-4\" data-name=\"deploy console call-to-action button\" href=\"#console\">\n                Deploy Console\n            </a>\n        </div>\n        <div class=\"font-mono text-[10px] text-navy/40 uppercase font-black tracking-widest flex items-center gap-2\" data-kid=\"1-3-3\" data-name=\"connection status indicator\">\n            <span class=\"w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse\" data-kid=\"1-3-3-1\" data-name=\"connection pulse dot\">\n            </span>\n            200_OK\n        </div>\n    </nav>\n    <div class=\"container mx-auto px-12 relative z-10 flex flex-col md:flex-row items-center justify-between\" data-kid=\"1-4\" data-name=\"hero content container\">\n        <!-- Human Side -->\n        <div class=\"w-full md:w-[55%] pr-0 md:pr-12 pt-40 md:pt-0 relative\" data-kid=\"1-4-1\" data-name=\"human side content area\">\n            <!-- Hand-drawn Orbital Diagrams -->\n            <svg class=\"absolute -top-60 -left-40 w-[800px] h-[800px] text-navy/5 -z-10 pointer-events-none\" data-kid=\"1-4-1-1\" data-name=\"hand-drawn orbital diagrams\" viewbox=\"0 0 200 200\">\n                <circle cx=\"100\" cy=\"100\" fill=\"none\" r=\"95\" stroke=\"currentColor\" stroke-width=\"0.2\">\n                </circle>\n                <circle cx=\"100\" cy=\"100\" fill=\"none\" r=\"75\" stroke=\"currentColor\" stroke-dasharray=\"2 1\" stroke-width=\"0.3\">\n                </circle>\n                <path d=\"M10,100 Q100,0 190,100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.1\">\n                </path>\n                <path d=\"M100,10 L100,190\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.05\">\n                </path>\n            </svg>\n            <div class=\"inline-block px-4 py-1.5 bg-navy text-paper font-mono text-xs mb-10 uppercase tracking-[0.5em] font-black\" data-kid=\"1-4-1-2\" data-name=\"version badge\">\n                Impact Atlas // V1.0.4\n            </div>\n            <h1 class=\"text-8xl md:text-[9.5rem] font-serif text-navy leading-[0.8] mb-12 italic tracking-tighter\" data-kid=\"1-4-1-3\" data-name=\"hero headline text\">\n                AI operators\n                <br data-kid=\"1-4-1-3-1\" data-name=\"headline line break\"/>\n                for\n                <span class=\"font-bold not-italic\" data-kid=\"1-4-1-3-2\" data-name=\"bold headline highlight\">\n                    ambitious\n                </span>\n                people.\n            </h1>\n            <p class=\"text-2xl md:text-3xl text-navy/70 max-w-xl mb-14 leading-tight font-light italic\" data-kid=\"1-4-1-4\" data-name=\"hero description text\">\n                The autonomous workforce has arrived. Strategic intent meets machine velocity at the collision point.\n            </p>\n            <div class=\"flex flex-col sm:flex-row gap-8\" data-kid=\"1-4-1-5\" data-name=\"button group\">\n                <button class=\"px-12 py-6 bg-navy text-paper font-mono text-sm tracking-[0.2em] font-black hover:bg-ember transition-all duration-500 shadow-2xl shadow-navy/30\" data-kid=\"1-4-1-5-1\" data-name=\"init runtime button\">\n                    INIT_RUNTIME\n                </button>\n                <button class=\"px-12 py-6 border-2 border-navy text-navy font-mono text-sm tracking-[0.2em] font-black hover:bg-navy hover:text-paper transition-all duration-500\" data-kid=\"1-4-1-5-2\" data-name=\"read vision button\">\n                    READ_VISION\n                </button>\n            </div>\n            <!-- Task Pills -->\n            <div class=\"mt-24 flex flex-wrap gap-6 max-w-lg\" data-kid=\"1-4-1-6\" data-name=\"task pills container\">\n                <div class=\"px-6 py-3 paper-card rounded-none flex items-center gap-4 border-l-4 border-ember\" data-kid=\"1-4-1-6-1\" data-name=\"scaling brand pill\">\n                    <div class=\"w-2.5 h-2.5 rounded-full bg-ember animate-pulse\" data-kid=\"1-4-1-6-1-1\" data-name=\"scaling brand pulse\">\n                    </div>\n                    <span class=\"font-mono text-xs font-black uppercase tracking-widest\" data-kid=\"1-4-1-6-1-2\" data-name=\"scaling brand text\">\n                        Scaling Personal Brand\n                    </span>\n                </div>\n                <div class=\"px-6 py-3 paper-card rounded-none flex items-center gap-4 border-l-4 border-cyan\" data-kid=\"1-4-1-6-2\" data-name=\"market analysis pill\">\n                    <div class=\"w-2.5 h-2.5 rounded-full bg-cyan\" data-kid=\"1-4-1-6-2-1\" data-name=\"market analysis indicator\">\n                    </div>\n                    <span class=\"font-mono text-xs font-black uppercase tracking-widest\" data-kid=\"1-4-1-6-2-2\" data-name=\"market analysis text\">\n                        Market Analysis Active\n                    </span>\n                </div>\n            </div>\n        </div>\n        <!-- Software Side -->\n        <div class=\"w-full md:w-1/2 flex justify-center relative mt-20 md:mt-0\" data-kid=\"1-4-2\" data-name=\"software side content area\">\n            <div class=\"relative w-[500px] h-[500px] flex items-center justify-center\" data-kid=\"1-4-2-1\" data-name=\"spheres and terminal container\">\n                <!-- Human Sphere (Etched-style via CSS) -->\n                <div class=\"absolute w-72 h-72 rounded-full -left-8 -top-8 border border-paper/30 bg-radial-gradient from-paper to-butter/40 backdrop-blur-sm z-0\" data-kid=\"1-4-2-1-1\" data-name=\"human sphere element\">\n                </div>\n                <!-- Software Sphere -->\n                <div class=\"absolute w-80 h-80 rounded-full -right-4 -bottom-4 border-2 border-cyan/40 bg-radial-gradient from-cobalt to-black z-10 shadow-2xl\" data-kid=\"1-4-2-1-2\" data-name=\"software sphere element\">\n                    <div class=\"absolute inset-0 opacity-20 pointer-events-none\" data-kid=\"1-4-2-1-2-1\" data-name=\"software sphere texture\" style=\"background-image: radial-gradient(var(--cyan) 1px, transparent 1px); background-size: 20px 20px;\">\n                    </div>\n                </div>\n                <!-- Central Impact Mark (SVG) -->\n                <div class=\"relative z-20 w-72 h-72 flex items-center justify-center\" data-kid=\"1-4-2-1-3\" data-name=\"central impact mark container\">\n                    <svg class=\"w-full h-full text-ember drop-shadow-[0_0_30px_rgba(230,57,70,0.5)]\" data-kid=\"1-4-2-1-3-1\" data-name=\"impact mark icon\" viewbox=\"0 0 200 200\">\n                        <path d=\"M100 20 L115 85 L180 100 L115 115 L100 180 L85 115 L20 100 L85 85 Z\" fill=\"currentColor\" fill-opacity=\"0.9\">\n                        </path>\n                        <path d=\"M100 50 L108 92 L150 100 L108 108 L100 150 L92 108 L50 100 L92 92 Z\" fill=\"white\">\n                        </path>\n                        <circle cx=\"100\" cy=\"100\" fill=\"var(--color-paper)\" r=\"12\">\n                        </circle>\n                        <!-- Speed lines -->\n                        <g stroke=\"currentColor\" stroke-dasharray=\"2 1\" stroke-width=\"0.5\">\n                            <line x1=\"100\" x2=\"200\" y1=\"100\" y2=\"0\">\n                            </line>\n                            <line x1=\"100\" x2=\"0\" y1=\"100\" y2=\"200\">\n                            </line>\n                            <line x1=\"100\" x2=\"200\" y1=\"100\" y2=\"200\">\n                            </line>\n                            <line x1=\"100\" x2=\"0\" y1=\"100\" y2=\"0\">\n                            </line>\n                        </g>\n                    </svg>\n                    <!-- Cracks -->\n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[140%] h-[140%] opacity-30\" data-kid=\"1-4-2-1-3-2\" data-name=\"crack effect container\">\n                        <div class=\"absolute top-0 left-1/2 w-px h-full bg-paper/50 rotate-45\" data-kid=\"1-4-2-1-3-2-1\" data-name=\"crack line 1\">\n                        </div>\n                        <div class=\"absolute top-0 left-1/2 w-px h-full bg-paper/50 -rotate-45\" data-kid=\"1-4-2-1-3-2-2\" data-name=\"crack line 2\">\n                        </div>\n                    </div>\n                </div>\n                <!-- Terminal Fragment -->\n                <div class=\"absolute -right-16 top-10 terminal-box p-6 rounded-sm w-72 shadow-2xl z-30\" data-kid=\"1-4-2-1-4\" data-name=\"terminal box\">\n                    <div class=\"flex gap-2 mb-6\" data-kid=\"1-4-2-1-4-1\" data-name=\"terminal status lights\">\n                        <div class=\"w-2.5 h-2.5 rounded-full bg-ember\" data-kid=\"1-4-2-1-4-1-1\" data-name=\"terminal red light\">\n                        </div>\n                        <div class=\"w-2.5 h-2.5 rounded-full bg-butter\" data-kid=\"1-4-2-1-4-1-2\" data-name=\"terminal yellow light\">\n                        </div>\n                        <div class=\"w-2.5 h-2.5 rounded-full bg-cyan\" data-kid=\"1-4-2-1-4-1-3\" data-name=\"terminal cyan light\">\n                        </div>\n                    </div>\n                    <div class=\"font-mono text-[10px] text-cyan space-y-3 leading-relaxed\" data-kid=\"1-4-2-1-4-2\" data-name=\"terminal content\">\n                        <div class=\"flex justify-between\" data-kid=\"1-4-2-1-4-2-1\" data-name=\"init sequence row\">\n                            <span class=\"text-white/40 font-bold\" data-kid=\"1-4-2-1-4-2-1-1\" data-name=\"init sequence label\">\n                                INIT_SEQ:\n                            </span>\n                            <span data-kid=\"1-4-2-1-4-2-1-2\" data-name=\"init sequence value\">\n                                [COLLISION_V1]\n                            </span>\n                        </div>\n                        <div class=\"text-paper/80 font-bold\" data-kid=\"1-4-2-1-4-2-2\" data-name=\"log message\">\n                            > ATTACHING RUNTIME TO BRAIN...\n                        </div>\n                        <div class=\"p-2 bg-white/5 border border-white/10 text-[9px]\" data-kid=\"1-4-2-1-4-2-3\" data-name=\"goal display box\">\n                            GOAL: \"Scale personal brand across LinkedIn & Twitter by 300%\"\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-4-2-1-4-2-4\" data-name=\"state row\">\n                            <span class=\"text-ember font-bold\" data-kid=\"1-4-2-1-4-2-4-1\" data-name=\"state label\">\n                                STATE:\n                            </span>\n                            <span class=\"px-2 py-0.5 bg-butter text-navy font-black text-[8px] rounded-xs uppercase\" data-kid=\"1-4-2-1-4-2-4-2\" data-name=\"state value\">\n                                Executing\n                            </span>\n                        </div>\n                        <div class=\"pt-2 border-t border-white/10 opacity-30 font-bold uppercase tracking-widest text-[9px]\" data-kid=\"1-4-2-1-4-2-5\" data-name=\"logs message\">\n                            LOGS: 14.3ms_lat // 8_agents_act\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 2. THE SHIFT -->\n<section class=\"py-32 navy-surface relative overflow-hidden\" data-kid=\"2\" data-name=\"evolution section\">\n    <div class=\"absolute inset-0 noise-overlay opacity-10\" data-kid=\"2-1\" data-name=\"evolution noise overlay\">\n    </div>\n    <div class=\"container mx-auto px-12 relative\" data-kid=\"2-2\" data-name=\"evolution container\">\n        <div class=\"flex flex-col md:flex-row gap-0 border-y border-white/10\" data-kid=\"2-2-1\" data-name=\"side-by-side comparison\">\n            <!-- Left side -->\n            <div class=\"w-full md:w-1/2 py-24 pr-12 border-r border-white/10 relative\" data-kid=\"2-2-1-1\" data-name=\"status quo side\">\n                <div class=\"absolute -top-4 -left-4 w-8 h-8 impact-mark opacity-20 rotate-45\" data-kid=\"2-2-1-1-1\" data-name=\"impact mark decoration\">\n                </div>\n                <div class=\"font-mono text-[10px] text-ember uppercase tracking-[0.4em] mb-6 font-bold\" data-kid=\"2-2-1-1-2\" data-name=\"status quo label\">\n                    The Status Quo\n                </div>\n                <h2 class=\"text-5xl font-serif italic mb-8\" data-kid=\"2-2-1-1-3\" data-name=\"status quo title\">\n                    Software waits.\n                </h2>\n                <p class=\"text-paper/60 leading-relaxed font-mono text-sm max-w-md italic\" data-kid=\"2-2-1-1-4\" data-name=\"status quo description\">\n                    Tools sit idle until you push the button. You are the battery. You are the bottleneck. You are the operator of 50 dead apps.\n                </p>\n            </div>\n            <!-- Seam -->\n            <div class=\"hidden md:flex items-center justify-center w-0 relative\" data-kid=\"2-2-1-2\" data-name=\"seam container\">\n                <div class=\"absolute h-full w-px bg-ember/30\" data-kid=\"2-2-1-2-1\" data-name=\"seam line\">\n                </div>\n                <div class=\"w-12 h-12 impact-mark rounded-full z-10 flex items-center justify-center shadow-[0_0_30px_rgba(230,57,70,0.5)]\" data-kid=\"2-2-1-2-2\" data-name=\"seam impact mark\">\n                    <div class=\"w-6 h-6 border-2 border-paper/20 rounded-full animate-pulse\" data-kid=\"2-2-1-2-2-1\" data-name=\"seam pulse circle\">\n                    </div>\n                </div>\n            </div>\n            <!-- Right side -->\n            <div class=\"w-full md:w-1/2 py-24 pl-0 md:pl-24 relative overflow-hidden\" data-kid=\"2-2-1-3\" data-name=\"evolution side\">\n                <div class=\"absolute top-0 right-0 w-full h-full opacity-5 pointer-events-none\" data-kid=\"2-2-1-3-1\" data-name=\"evolution background pattern container\">\n                    <svg class=\"w-full h-full text-cyan\" data-kid=\"2-2-1-3-1-1\" data-name=\"evolution background pattern\" viewbox=\"0 0 200 200\">\n                        <path d=\"M0,100 L200,100 M100,0 L100,200\" stroke=\"currentColor\" stroke-width=\"0.5\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"font-mono text-[10px] text-cyan uppercase tracking-[0.4em] mb-6 font-bold\" data-kid=\"2-2-1-3-2\" data-name=\"evolution label\">\n                    The Evolution\n                </div>\n                <h2 class=\"text-5xl font-serif italic mb-8 text-cyan\" data-kid=\"2-2-1-3-3\" data-name=\"evolution title\">\n                    Operators work.\n                </h2>\n                <p class=\"text-paper/60 leading-relaxed font-mono text-sm max-w-md italic\" data-kid=\"2-2-1-3-4\" data-name=\"evolution description\">\n                    Collision doesn't wait. It acts on strategic intent. It navigates your browser, manages your email, and scales your output while you sleep.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 3. THE PROBLEM (Execution Trace) -->\n<section class=\"py-32 bg-paper text-navy relative\" data-kid=\"3\" data-name=\"problem section\">\n    <div class=\"container mx-auto px-12\" data-kid=\"3-1\" data-name=\"problem container\">\n        <div class=\"flex flex-col md:flex-row items-center gap-20\" data-kid=\"3-1-1\" data-name=\"problem content grid\">\n            <div class=\"w-full md:w-1/3\" data-kid=\"3-1-1-1\" data-name=\"problem title and description\">\n                <h2 class=\"text-6xl font-serif italic mb-6\" data-kid=\"3-1-1-1-1\" data-name=\"problem title\">\n                    The loop of death.\n                </h2>\n                <p class=\"text-navy/60 leading-relaxed text-lg\" data-kid=\"3-1-1-1-2\" data-name=\"problem description\">\n                    Ambitious people are trapped in the mechanics of their own success. You write, you post, you reply—then you do it all again.\n                </p>\n            </div>\n            <div class=\"w-full md:w-2/3 relative min-h-[500px]\" data-kid=\"3-1-1-2\" data-name=\"execution trace diagram area\">\n                <!-- Execution Trace Diagram -->\n                <div class=\"flex flex-col items-center\" data-kid=\"3-1-1-2-1\" data-name=\"execution trace diagram content\">\n                    <div class=\"px-12 py-5 border-2 border-navy text-navy font-mono font-bold text-sm tracking-[0.3em] relative z-10 bg-paper\" data-kid=\"3-1-1-2-1-1\" data-name=\"strategic input badge\">\n                        STRATEGIC_INPUT\n                    </div>\n                    <div class=\"w-px h-20 bg-gradient-to-b from-navy to-ember\" data-kid=\"3-1-1-2-1-2\" data-name=\"trace vertical line\">\n                    </div>\n                    <div class=\"w-4 h-4 impact-mark rounded-full mb-8\" data-kid=\"3-1-1-2-1-3\" data-name=\"trace impact mark\">\n                    </div>\n                    <div class=\"relative w-full flex justify-center\" data-kid=\"3-1-1-2-1-4\" data-name=\"splitting threads container\">\n                        <svg class=\"absolute top-0 w-full h-[300px] pointer-events-none opacity-20\" data-kid=\"3-1-1-2-1-4-1\" data-name=\"splitting thread paths\" viewbox=\"0 0 800 300\">\n                            <path d=\"M400,0 L400,50 C400,100 100,100 100,200\" fill=\"none\" stroke=\"var(--navy)\" stroke-width=\"1\">\n                            </path>\n                            <path d=\"M400,0 L400,50 C400,100 400,100 400,200\" fill=\"none\" stroke=\"var(--navy)\" stroke-width=\"1\">\n                            </path>\n                            <path d=\"M400,0 L400,50 C400,100 700,100 700,200\" fill=\"none\" stroke=\"var(--navy)\" stroke-width=\"1\">\n                            </path>\n                            <circle cx=\"100\" cy=\"200\" fill=\"var(--ember)\" r=\"3\">\n                            </circle>\n                            <circle cx=\"400\" cy=\"200\" fill=\"var(--ember)\" r=\"3\">\n                            </circle>\n                            <circle cx=\"700\" cy=\"200\" fill=\"var(--ember)\" r=\"3\">\n                            </circle>\n                        </svg>\n                        <!-- Splitting threads -->\n                        <div class=\"flex justify-between w-full max-w-5xl px-4 relative z-10\" data-kid=\"3-1-1-2-1-4-2\" data-name=\"thread cards container\">\n                            <div class=\"flex flex-col items-center pt-40\" data-kid=\"3-1-1-2-1-4-2-1\" data-name=\"thread A content\">\n                                <div class=\"font-mono text-[9px] text-navy/40 mb-3 font-bold\" data-kid=\"3-1-1-2-1-4-2-1-1\" data-name=\"thread A label\">\n                                    THREAD_A // CONTENT\n                                </div>\n                                <div class=\"px-6 py-3 bg-navy text-paper text-[10px] font-bold tracking-widest mb-4\" data-kid=\"3-1-1-2-1-4-2-1-2\" data-name=\"thread A task 1\">\n                                    WRITE_POST\n                                </div>\n                                <div class=\"px-6 py-3 bg-navy text-paper text-[10px] font-bold tracking-widest mb-4\" data-kid=\"3-1-1-2-1-4-2-1-3\" data-name=\"thread A task 2\">\n                                    DISTRIBUTE\n                                </div>\n                                <div class=\"text-ember font-black text-[10px] mt-2 italic animate-pulse tracking-tighter\" data-kid=\"3-1-1-2-1-4-2-1-4\" data-name=\"thread A loop status\">\n                                    EXECUTION_LOOP_ACTIVE\n                                </div>\n                            </div>\n                            <div class=\"flex flex-col items-center pt-40\" data-kid=\"3-1-1-2-1-4-2-2\" data-name=\"thread B content\">\n                                <div class=\"font-mono text-[9px] text-navy/40 mb-3 font-bold\" data-kid=\"3-1-1-2-1-4-2-2-1\" data-name=\"thread B label\">\n                                    THREAD_B // ENGAGE\n                                </div>\n                                <div class=\"px-6 py-3 bg-navy text-paper text-[10px] font-bold tracking-widest mb-4\" data-kid=\"3-1-1-2-1-4-2-2-2\" data-name=\"thread B task 1\">\n                                    REPLY_INTENT\n                                </div>\n                                <div class=\"px-6 py-3 bg-navy text-paper text-[10px] font-bold tracking-widest mb-4\" data-kid=\"3-1-1-2-1-4-2-2-3\" data-name=\"thread B task 2\">\n                                    DM_TRIAGE\n                                </div>\n                                <div class=\"text-ember font-black text-[10px] mt-2 italic animate-pulse tracking-tighter\" data-kid=\"3-1-1-2-1-4-2-2-4\" data-name=\"thread B loop status\">\n                                    EXECUTION_LOOP_ACTIVE\n                                </div>\n                            </div>\n                            <div class=\"flex flex-col items-center pt-40\" data-kid=\"3-1-1-2-1-4-2-3\" data-name=\"thread C content\">\n                                <div class=\"font-mono text-[9px] text-navy/40 mb-3 font-bold\" data-kid=\"3-1-1-2-1-4-2-3-1\" data-name=\"thread C label\">\n                                    THREAD_C // SCHED\n                                </div>\n                                <div class=\"px-6 py-3 bg-navy text-paper text-[10px] font-bold tracking-widest mb-4\" data-kid=\"3-1-1-2-1-4-2-3-2\" data-name=\"thread C task 1\">\n                                    EMAIL_SYNC\n                                </div>\n                                <div class=\"px-6 py-3 bg-navy text-paper text-[10px] font-bold tracking-widest mb-4\" data-kid=\"3-1-1-2-1-4-2-3-3\" data-name=\"thread C task 2\">\n                                    CAL_OPTIMIZE\n                                </div>\n                                <div class=\"text-ember font-black text-[10px] mt-2 italic animate-pulse tracking-tighter\" data-kid=\"3-1-1-2-1-4-2-3-4\" data-name=\"thread C loop status\">\n                                    EXECUTION_LOOP_ACTIVE\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Impact Seam Crossing -->\n                <div class=\"absolute top-[45%] left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-ember to-transparent opacity-40\" data-kid=\"3-1-1-2-2\" data-name=\"impact seam crossing\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 4. THE RUNTIME (Hub & Spoke) -->\n<section class=\"py-40 cobalt-surface relative overflow-hidden\" data-kid=\"4\" data-name=\"runtime architecture section\" id=\"runtime\">\n    <div class=\"container mx-auto px-12\" data-kid=\"4-1\" data-name=\"runtime container\">\n        <div class=\"text-center mb-32\" data-kid=\"4-1-1\" data-name=\"runtime header\">\n            <div class=\"inline-block px-3 py-1 bg-cyan text-navy font-mono text-[10px] mb-6 uppercase tracking-[0.3em] font-bold\" data-kid=\"4-1-1-1\" data-name=\"runtime badge\">\n                Collision Core Architecture\n            </div>\n            <h2 class=\"text-7xl font-serif italic mb-6\" data-kid=\"4-1-1-2\" data-name=\"runtime title\">\n                One runtime,\n                <br data-kid=\"4-1-1-2-1\" data-name=\"title line break\"/>\n                total connectivity.\n            </h2>\n        </div>\n        <div class=\"relative flex flex-col items-center max-w-4xl mx-auto\" data-kid=\"4-1-2\" data-name=\"architecture diagram\">\n            <!-- Grid Spacing -->\n            <div class=\"flex gap-32 mb-20\" data-kid=\"4-1-2-1\" data-name=\"spoke grid\">\n                <div class=\"w-32 h-32 border border-white/10 flex flex-col items-center justify-center bg-white/5 relative group\" data-kid=\"4-1-2-1-1\" data-name=\"linkedin spoke\">\n                    <div class=\"font-mono text-[9px] text-cyan mb-2 group-hover:text-ember transition-colors\" data-kid=\"4-1-2-1-1-1\" data-name=\"linkedin label\">\n                        LINKEDIN\n                    </div>\n                    <div class=\"w-10 h-10 opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"4-1-2-1-1-2\" data-name=\"linkedin icon container\">\n                        <i class=\"ti ti-brand-linkedin text-3xl\" data-kid=\"4-1-2-1-1-2-1\" data-name=\"linkedin icon\">\n                        </i>\n                    </div>\n                    <div class=\"absolute -bottom-10 w-px h-10 bg-white/10\" data-kid=\"4-1-2-1-1-3\" data-name=\"spoke line\">\n                    </div>\n                </div>\n                <div class=\"w-32 h-32 border border-white/10 flex flex-col items-center justify-center bg-white/5 relative group\" data-kid=\"4-1-2-1-2\" data-name=\"email spoke\">\n                    <div class=\"font-mono text-[9px] text-cyan mb-2 group-hover:text-ember transition-colors\" data-kid=\"4-1-2-1-2-1\" data-name=\"email label\">\n                        EMAIL\n                    </div>\n                    <div class=\"w-10 h-10 opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"4-1-2-1-2-2\" data-name=\"email icon container\">\n                        <i class=\"ti ti-mail text-3xl\" data-kid=\"4-1-2-1-2-2-1\" data-name=\"email icon\">\n                        </i>\n                    </div>\n                    <div class=\"absolute -bottom-10 w-px h-10 bg-white/10\" data-kid=\"4-1-2-1-2-3\" data-name=\"spoke line\">\n                    </div>\n                </div>\n                <div class=\"w-32 h-32 border border-white/10 flex flex-col items-center justify-center bg-white/5 relative group\" data-kid=\"4-1-2-1-3\" data-name=\"browser spoke\">\n                    <div class=\"font-mono text-[9px] text-cyan mb-2 group-hover:text-ember transition-colors\" data-kid=\"4-1-2-1-3-1\" data-name=\"browser label\">\n                        BROWSER\n                    </div>\n                    <div class=\"w-10 h-10 opacity-40 group-hover:opacity-100 transition-opacity\" data-kid=\"4-1-2-1-3-2\" data-name=\"browser icon container\">\n                        <i class=\"ti ti-browser text-3xl\" data-kid=\"4-1-2-1-3-2-1\" data-name=\"browser icon\">\n                        </i>\n                    </div>\n                    <div class=\"absolute -bottom-10 w-px h-10 bg-white/10\" data-kid=\"4-1-2-1-3-3\" data-name=\"spoke line\">\n                    </div>\n                </div>\n            </div>\n            <!-- Central Hub -->\n            <div class=\"relative w-80 h-80 flex items-center justify-center\" data-kid=\"4-1-2-2\" data-name=\"central hub\">\n                <!-- Connecting lines -->\n                <div class=\"absolute w-[200%] h-px bg-gradient-to-r from-transparent via-cyan/30 to-transparent\" data-kid=\"4-1-2-2-1\" data-name=\"horizontal connector line\">\n                </div>\n                <div class=\"absolute h-[200%] w-px bg-gradient-to-b from-transparent via-cyan/30 to-transparent\" data-kid=\"4-1-2-2-2\" data-name=\"vertical connector line\">\n                </div>\n                <div class=\"w-64 h-64 rounded-full border-4 border-ember flex flex-col items-center justify-center p-8 text-center bg-navy shadow-[0_0_80px_rgba(230,57,70,0.3)] z-10 relative overflow-hidden\" data-kid=\"4-1-2-2-3\" data-name=\"hub container\">\n                    <div class=\"absolute inset-0 opacity-10\" data-kid=\"4-1-2-2-3-1\" data-name=\"hub pattern\" style=\"background-image: repeating-linear-gradient(45deg, var(--ember), var(--ember) 1px, transparent 1px, transparent 10px);\">\n                    </div>\n                    <h3 class=\"font-serif text-4xl italic mb-2 relative\" data-kid=\"4-1-2-2-3-2\" data-name=\"hub title\">\n                        Runtime\n                    </h3>\n                    <div class=\"font-mono text-[10px] text-ember font-bold tracking-widest relative\" data-kid=\"4-1-2-2-3-3\" data-name=\"hub label\">\n                        COLLISION_CORE\n                    </div>\n                    <div class=\"mt-8 flex gap-2 relative\" data-kid=\"4-1-2-2-3-4\" data-name=\"hub status dots\">\n                        <div class=\"w-1.5 h-1.5 bg-ember rounded-full\" data-kid=\"4-1-2-2-3-4-1\" data-name=\"status dot 1\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 bg-ember rounded-full opacity-60\" data-kid=\"4-1-2-2-3-4-2\" data-name=\"status dot 2\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 bg-ember rounded-full opacity-30\" data-kid=\"4-1-2-2-3-4-3\" data-name=\"status dot 3\">\n                        </div>\n                    </div>\n                </div>\n                <!-- Impact Ring Overlay -->\n                <div class=\"absolute inset-0 border border-ember/20 rounded-full scale-125 animate-pulse\" data-kid=\"4-1-2-2-4\" data-name=\"impact ring\">\n                </div>\n            </div>\n            <!-- Bottom Spoke -->\n            <div class=\"mt-20\" data-kid=\"4-1-2-3\" data-name=\"bottom spoke\">\n                <div class=\"w-40 h-40 border-2 border-paper flex flex-col items-center justify-center bg-paper text-navy relative group shadow-2xl\" data-kid=\"4-1-2-3-1\" data-name=\"user spoke box\">\n                    <div class=\"absolute -top-10 w-px h-10 bg-white/10\" data-kid=\"4-1-2-3-1-1\" data-name=\"spoke line\">\n                    </div>\n                    <div class=\"font-mono text-[10px] font-black tracking-widest mb-2\" data-kid=\"4-1-2-3-1-2\" data-name=\"user spoke label\">\n                        YOU\n                    </div>\n                    <div class=\"text-3xl\" data-kid=\"4-1-2-3-1-3\" data-name=\"user spoke icon container\">\n                        <i class=\"ti ti-user-bolt\" data-kid=\"4-1-2-3-1-3-1\" data-name=\"user spoke icon\">\n                        </i>\n                    </div>\n                    <div class=\"mt-4 font-mono text-[9px] opacity-40 font-bold uppercase tracking-tighter\" data-kid=\"4-1-2-3-1-4\" data-name=\"user spoke status\">\n                        Strategic Intent\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 5. PHILOSOPHY -->\n<section class=\"py-40 paper-surface relative\" data-kid=\"5\" data-name=\"philosophy section\">\n    <div class=\"container mx-auto px-12\" data-kid=\"5-1\" data-name=\"philosophy container\">\n        <div class=\"max-w-5xl mx-auto border-l-4 border-navy pl-16 py-12\" data-kid=\"5-1-1\" data-name=\"philosophy inner container\">\n            <div class=\"font-mono text-xs uppercase tracking-[0.5em] mb-12 font-bold text-navy/40\" data-kid=\"5-1-1-1\" data-name=\"manifesto label\">\n                Our Manifesto // 001\n            </div>\n            <h2 class=\"text-6xl md:text-9xl font-serif italic leading-[0.9] text-navy mb-20\" data-kid=\"5-1-1-2\" data-name=\"philosophy title\">\n                We don’t build assistants.\n                <br data-kid=\"5-1-1-2-1\" data-name=\"title line break\"/>\n                <span class=\"font-bold\" data-kid=\"5-1-1-2-2\" data-name=\"title highlight\">\n                    We build operators.\n                </span>\n            </h2>\n            <div class=\"flex flex-col md:flex-row gap-20 items-end\" data-kid=\"5-1-1-3\" data-name=\"philosophy details\">\n                <div class=\"w-full md:w-1/2\" data-kid=\"5-1-1-3-1\" data-name=\"philosophy quote container\">\n                    <p class=\"text-2xl text-navy/70 leading-relaxed font-light italic\" data-kid=\"5-1-1-3-1-1\" data-name=\"philosophy quote\">\n                        \"Assistants answer questions. Operators execute tasks. The future of work is not a chatbot; it is a workforce that lives in your infrastructure and understands your ambition.\"\n                    </p>\n                </div>\n                <div class=\"w-full md:w-1/2 flex flex-col gap-6\" data-kid=\"5-1-1-3-2\" data-name=\"feature list\">\n                    <div class=\"flex items-center gap-6\" data-kid=\"5-1-1-3-2-1\" data-name=\"feature 1\">\n                        <div class=\"w-16 h-px bg-ember\" data-kid=\"5-1-1-3-2-1-1\" data-name=\"feature 1 dash\">\n                        </div>\n                        <span class=\"font-mono text-xs font-bold uppercase tracking-widest\" data-kid=\"5-1-1-3-2-1-2\" data-name=\"feature 1 label\">\n                            Autonomous Workflow\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"5-1-1-3-2-2\" data-name=\"feature 2\">\n                        <div class=\"w-16 h-px bg-navy/20\" data-kid=\"5-1-1-3-2-2-1\" data-name=\"feature 2 dash\">\n                        </div>\n                        <span class=\"font-mono text-xs font-bold uppercase tracking-widest\" data-kid=\"5-1-1-3-2-2-2\" data-name=\"feature 2 label\">\n                            Context Awareness\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-6\" data-kid=\"5-1-1-3-2-3\" data-name=\"feature 3\">\n                        <div class=\"w-16 h-px bg-navy/20\" data-kid=\"5-1-1-3-2-3-1\" data-name=\"feature 3 dash\">\n                        </div>\n                        <span class=\"font-mono text-xs font-bold uppercase tracking-widest\" data-kid=\"5-1-1-3-2-3-2\" data-name=\"feature 3 label\">\n                            Continuous Execution\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 6. RUNTIME ARCHITECTURE -->\n<section class=\"py-40 navy-surface relative overflow-hidden\" data-kid=\"6\" data-name=\"architecture section\">\n    <div class=\"container mx-auto px-12\" data-kid=\"6-1\" data-name=\"architecture container\">\n        <div class=\"flex flex-col md:flex-row gap-32\" data-kid=\"6-1-1\" data-name=\"architecture split\">\n            <div class=\"w-full md:w-1/2\" data-kid=\"6-1-1-1\" data-name=\"architecture title area\">\n                <div class=\"sticky top-40\" data-kid=\"6-1-1-1-1\" data-name=\"sticky content\">\n                    <h2 class=\"text-6xl font-serif italic mb-8\" data-kid=\"6-1-1-1-1-1\" data-name=\"architecture title\">\n                        The Execution\n                        <br data-kid=\"6-1-1-1-1-1-1\" data-name=\"title line break\"/>\n                        Ladder\n                    </h2>\n                    <p class=\"text-paper/60 text-lg max-w-md mb-12\" data-kid=\"6-1-1-1-1-2\" data-name=\"architecture description\">\n                        How a single strategic spark becomes a global operational shift. The Collision Runtime is built for persistence and precision.\n                    </p>\n                    <div class=\"p-8 bg-white/5 border border-white/10 rounded-sm\" data-kid=\"6-1-1-1-1-3\" data-name=\"diagnostics box\">\n                        <div class=\"font-mono text-[10px] text-cyan mb-4\" data-kid=\"6-1-1-1-1-3-1\" data-name=\"diagnostics label\">\n                            LIVE_DIAGNOSTICS\n                        </div>\n                        <div class=\"space-y-2\" data-kid=\"6-1-1-1-1-3-2\" data-name=\"progress bars container\">\n                            <div class=\"h-1 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"6-1-1-1-1-3-2-1\" data-name=\"progress bar 1 container\">\n                                <div class=\"h-full bg-ember w-3/4\" data-kid=\"6-1-1-1-1-3-2-1-1\" data-name=\"progress bar 1 fill\">\n                                </div>\n                            </div>\n                            <div class=\"h-1 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"6-1-1-1-1-3-2-2\" data-name=\"progress bar 2 container\">\n                                <div class=\"h-full bg-cyan w-1/2\" data-kid=\"6-1-1-1-1-3-2-2-1\" data-name=\"progress bar 2 fill\">\n                                </div>\n                            </div>\n                            <div class=\"h-1 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"6-1-1-1-1-3-2-3\" data-name=\"progress bar 3 container\">\n                                <div class=\"h-full bg-butter w-9/10\" data-kid=\"6-1-1-1-1-3-2-3-1\" data-name=\"progress bar 3 fill\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-full md:w-1/2 space-y-12\" data-kid=\"6-1-1-2\" data-name=\"steps container\">\n                <!-- Step 1 -->\n                <div class=\"flex gap-8 group\" data-kid=\"6-1-1-2-1\" data-name=\"step 1\">\n                    <div class=\"flex flex-col items-center\" data-kid=\"6-1-1-2-1-1\" data-name=\"step 1 counter\">\n                        <div class=\"w-12 h-12 rounded-full border-2 border-ember flex items-center justify-center font-mono font-bold text-ember\" data-kid=\"6-1-1-2-1-1-1\" data-name=\"step 1 number\">\n                            01\n                        </div>\n                        <div class=\"w-px h-full bg-white/10 my-4\" data-kid=\"6-1-1-2-1-1-2\" data-name=\"step 1 line\">\n                        </div>\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"6-1-1-2-1-2\" data-name=\"step 1 text\">\n                        <h3 class=\"text-2xl font-serif italic mb-4 group-hover:text-ember transition-colors\" data-kid=\"6-1-1-2-1-2-1\" data-name=\"step 1 title\">\n                            Long-term Memory\n                        </h3>\n                        <p class=\"text-paper/50 text-sm leading-relaxed max-w-sm\" data-kid=\"6-1-1-2-1-2-2\" data-name=\"step 1 description\">\n                            Collision remembers every preference, every goal, and every previous execution to ensure perfect alignment.\n                        </p>\n                    </div>\n                </div>\n                <!-- Step 2 -->\n                <div class=\"flex gap-8 group\" data-kid=\"6-1-1-2-2\" data-name=\"step 2\">\n                    <div class=\"flex flex-col items-center\" data-kid=\"6-1-1-2-2-1\" data-name=\"step 2 counter\">\n                        <div class=\"w-12 h-12 rounded-full border-2 border-white/20 flex items-center justify-center font-mono font-bold text-white/20 group-hover:border-cyan group-hover:text-cyan transition-all\" data-kid=\"6-1-1-2-2-1-1\" data-name=\"step 2 number\">\n                            02\n                        </div>\n                        <div class=\"w-px h-full bg-white/10 my-4\" data-kid=\"6-1-1-2-2-1-2\" data-name=\"step 2 line\">\n                        </div>\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"6-1-1-2-2-2\" data-name=\"step 2 text\">\n                        <h3 class=\"text-2xl font-serif italic mb-4 group-hover:text-cyan transition-colors\" data-kid=\"6-1-1-2-2-2-1\" data-name=\"step 2 title\">\n                            Dynamic Planning\n                        </h3>\n                        <p class=\"text-paper/50 text-sm leading-relaxed max-w-sm\" data-kid=\"6-1-1-2-2-2-2\" data-name=\"step 2 description\">\n                            Break down massive goals into atomic operations that can be executed in parallel.\n                        </p>\n                    </div>\n                </div>\n                <!-- Step 3 -->\n                <div class=\"flex gap-8 group\" data-kid=\"6-1-1-2-3\" data-name=\"step 3\">\n                    <div class=\"flex flex-col items-center\" data-kid=\"6-1-1-2-3-1\" data-name=\"step 3 counter\">\n                        <div class=\"w-12 h-12 rounded-full border-2 border-white/20 flex items-center justify-center font-mono font-bold text-white/20 group-hover:border-butter group-hover:text-butter transition-all\" data-kid=\"6-1-1-2-3-1-1\" data-name=\"step 3 number\">\n                            03\n                        </div>\n                        <div class=\"w-px h-full bg-white/10 my-4\" data-kid=\"6-1-1-2-3-1-2\" data-name=\"step 3 line\">\n                        </div>\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"6-1-1-2-3-2\" data-name=\"step 3 text\">\n                        <h3 class=\"text-2xl font-serif italic mb-4 group-hover:text-butter transition-colors\" data-kid=\"6-1-1-2-3-2-1\" data-name=\"step 3 title\">\n                            Browser & API Control\n                        </h3>\n                        <p class=\"text-paper/50 text-sm leading-relaxed max-w-sm\" data-kid=\"6-1-1-2-3-2-2\" data-name=\"step 3 description\">\n                            Direct navigation of any software interface just like a human, but at machine speed.\n                        </p>\n                    </div>\n                </div>\n                <!-- Step 4 -->\n                <div class=\"flex gap-8 group\" data-kid=\"6-1-1-2-4\" data-name=\"step 4\">\n                    <div class=\"flex flex-col items-center\" data-kid=\"6-1-1-2-4-1\" data-name=\"step 4 counter\">\n                        <div class=\"w-12 h-12 rounded-full border-2 border-white/20 flex items-center justify-center font-mono font-bold text-white/20 group-hover:border-paper group-hover:text-paper transition-all\" data-kid=\"6-1-1-2-4-1-1\" data-name=\"step 4 number\">\n                            04\n                        </div>\n                    </div>\n                    <div class=\"pt-2\" data-kid=\"6-1-1-2-4-2\" data-name=\"step 4 text\">\n                        <h3 class=\"text-2xl font-serif italic mb-4 group-hover:text-paper transition-colors\" data-kid=\"6-1-1-2-4-2-1\" data-name=\"step 4 title\">\n                            Continuous Learning\n                        </h3>\n                        <p class=\"text-paper/50 text-sm leading-relaxed max-w-sm\" data-kid=\"6-1-1-2-4-2-2\" data-name=\"step 4 description\">\n                            Every interaction makes the operator smarter. Self-correction is built into the runtime.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 7. TODAY’S OPERATOR (Passport Card) -->\n<section class=\"py-40 paper-surface relative overflow-hidden\" data-kid=\"7\" data-name=\"case study section\" id=\"operators\">\n    <div class=\"noise-overlay opacity-5\" data-kid=\"7-1\" data-name=\"case study noise\">\n    </div>\n    <div class=\"container mx-auto px-12\" data-kid=\"7-2\" data-name=\"case study container\">\n        <div class=\"flex flex-col md:flex-row items-center gap-24\" data-kid=\"7-2-1\" data-name=\"case study content\">\n            <div class=\"w-full md:w-1/2\" data-kid=\"7-2-1-1\" data-name=\"case study intro\">\n                <div class=\"font-mono text-xs uppercase tracking-[0.4em] mb-6 font-bold text-ember\" data-kid=\"7-2-1-1-1\" data-name=\"case study label\">\n                    Case Study // OP_001\n                </div>\n                <h2 class=\"text-6xl font-serif italic mb-8\" data-kid=\"7-2-1-1-2\" data-name=\"case study title\">\n                    Personal Brand\n                    <br data-kid=\"7-2-1-1-2-1\" data-name=\"title line break\"/>\n                    Orchestrator.\n                </h2>\n                <p class=\"text-xl text-navy/70 leading-relaxed mb-10 italic\" data-kid=\"7-2-1-1-3\" data-name=\"case study description\">\n                    Meet the first generation of Collision operators. This specific instance is trained to scale executive presence across LinkedIn, X, and Substack while maintaining a hyper-authentic voice.\n                </p>\n                <div class=\"flex gap-4\" data-kid=\"7-2-1-1-4\" data-name=\"case study stats\">\n                    <div class=\"px-4 py-2 bg-navy text-paper font-mono text-[10px] uppercase font-bold tracking-widest\" data-kid=\"7-2-1-1-4-1\" data-name=\"stat 1\">\n                        87% ROI\n                    </div>\n                    <div class=\"px-4 py-2 border border-navy/20 font-mono text-[10px] uppercase font-bold tracking-widest\" data-kid=\"7-2-1-1-4-2\" data-name=\"stat 2\">\n                        24/7 Uptime\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-full md:w-1/2 flex justify-center\" data-kid=\"7-2-1-2\" data-name=\"passport container\">\n                <!-- Passport Card -->\n                <div class=\"w-[450px] bg-paper border border-navy/10 p-10 shadow-2xl relative overflow-hidden rotate-2\" data-kid=\"7-2-1-2-1\" data-name=\"passport card\">\n                    <div class=\"absolute inset-0 opacity-[0.02]\" data-kid=\"7-2-1-2-1-1\" data-name=\"passport texture\" style=\"background-image: radial-gradient(var(--navy) 1px, transparent 1px); background-size: 10px 10px;\">\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"7-2-1-2-1-2\" data-name=\"passport content\">\n                        <div class=\"flex justify-between items-start mb-12\" data-kid=\"7-2-1-2-1-2-1\" data-name=\"passport header\">\n                            <div data-kid=\"7-2-1-2-1-2-1-1\" data-name=\"passport id label\">\n                                <div class=\"font-mono text-[9px] uppercase tracking-tighter opacity-40 mb-1\" data-kid=\"7-2-1-2-1-2-1-1-1\" data-name=\"passport id sublabel\">\n                                    Impact Atlas Identification\n                                </div>\n                                <h3 class=\"font-serif text-4xl italic\" data-kid=\"7-2-1-2-1-2-1-1-2\" data-name=\"passport name\">\n                                    Operator 001\n                                </h3>\n                                <div class=\"mt-2 inline-block px-3 py-1 bg-ember text-paper font-mono text-[10px] font-bold uppercase tracking-widest\" data-kid=\"7-2-1-2-1-2-1-1-3\" data-name=\"passport tag\">\n                                    Personal Brand\n                                </div>\n                            </div>\n                            <div class=\"w-20 h-20 bg-navy/5 border border-navy/10 flex items-center justify-center grayscale\" data-kid=\"7-2-1-2-1-2-1-2\" data-name=\"passport avatar\">\n                                <svg class=\"w-12 h-12 text-navy/20\" data-kid=\"7-2-1-2-1-2-1-2-1\" data-name=\"avatar icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" viewbox=\"0 0 24 24\">\n                                    <circle cx=\"12\" cy=\"12\" r=\"10\">\n                                    </circle>\n                                    <path d=\"M12 2a15 15 0 0 0 0 20M2 12h20\">\n                                    </path>\n                                </svg>\n                            </div>\n                        </div>\n                        <div class=\"space-y-8\" data-kid=\"7-2-1-2-1-2-2\" data-name=\"passport body\">\n                            <div data-kid=\"7-2-1-2-1-2-2-1\" data-name=\"objective section\">\n                                <div class=\"font-mono text-[9px] uppercase tracking-tighter opacity-40 mb-2\" data-kid=\"7-2-1-2-1-2-2-1-1\" data-name=\"objective label\">\n                                    Primary Objective\n                                </div>\n                                <p class=\"text-sm font-medium leading-relaxed italic\" data-kid=\"7-2-1-2-1-2-2-1-2\" data-name=\"objective text\">\n                                    Establish thought leadership in the AI vertical by executing cross-platform content cycles and stakeholder engagement.\n                                </p>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-8\" data-kid=\"7-2-1-2-1-2-2-2\" data-name=\"stats grid\">\n                                <div data-kid=\"7-2-1-2-1-2-2-2-1\" data-name=\"status section\">\n                                    <div class=\"font-mono text-[9px] uppercase tracking-tighter opacity-40 mb-2\" data-kid=\"7-2-1-2-1-2-2-2-1-1\" data-name=\"status label\">\n                                        Status\n                                    </div>\n                                    <div class=\"flex items-center gap-2\" data-kid=\"7-2-1-2-1-2-2-2-1-2\" data-name=\"status content\">\n                                        <div class=\"w-2 h-2 rounded-full bg-cyan animate-pulse\" data-kid=\"7-2-1-2-1-2-2-2-1-2-1\" data-name=\"status pulse\">\n                                        </div>\n                                        <span class=\"text-xs font-mono font-bold uppercase tracking-widest\" data-kid=\"7-2-1-2-1-2-2-2-1-2-2\" data-name=\"status label text\">\n                                            Active Execution\n                                        </span>\n                                    </div>\n                                </div>\n                                <div data-kid=\"7-2-1-2-1-2-2-2-2\" data-name=\"budget section\">\n                                    <div class=\"font-mono text-[9px] uppercase tracking-tighter opacity-40 mb-2\" data-kid=\"7-2-1-2-1-2-2-2-2-1\" data-name=\"budget label\">\n                                        Budget Allocation\n                                    </div>\n                                    <div class=\"text-xs font-mono font-bold uppercase tracking-widest text-ember\" data-kid=\"7-2-1-2-1-2-2-2-2-2\" data-name=\"budget text\">\n                                        $4,250 / $5,000\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"pt-8 border-t border-navy/10 flex justify-between items-center\" data-kid=\"7-2-1-2-1-2-2-3\" data-name=\"passport footer\">\n                                <div class=\"flex -space-x-3\" data-kid=\"7-2-1-2-1-2-2-3-1\" data-name=\"team avatars\">\n                                    <div class=\"w-10 h-10 rounded-full border-2 border-paper bg-butter\" data-kid=\"7-2-1-2-1-2-2-3-1-1\" data-name=\"avatar 1\">\n                                    </div>\n                                    <div class=\"w-10 h-10 rounded-full border-2 border-paper bg-cyan\" data-kid=\"7-2-1-2-1-2-2-3-1-2\" data-name=\"avatar 2\">\n                                    </div>\n                                    <div class=\"w-10 h-10 rounded-full border-2 border-paper bg-ember\" data-kid=\"7-2-1-2-1-2-2-3-1-3\" data-name=\"avatar 3\">\n                                    </div>\n                                </div>\n                                <div class=\"font-mono text-[8px] uppercase font-bold text-navy/30 tracking-[0.2em]\" data-kid=\"7-2-1-2-1-2-2-3-2\" data-n