s=\"absolute -right-10 -bottom-10 w-64 h-64 border border-navy/5 rounded-full pointer-events-none\" data-kid=\"8-1-2-1-1\" data-name=\"executive operator bg\">\n                </div>\n                <div class=\"font-mono text-xs text-ember uppercase tracking-[0.5em] font-black mb-10\" data-kid=\"8-1-2-1-2\" data-name=\"executive operator label\">\n                    CORE_DEPLOYMENT // ID: EXEC_01\n                </div>\n                <div class=\"flex flex-col md:flex-row gap-20\" data-kid=\"8-1-2-1-3\" data-name=\"executive operator content\">\n                    <div class=\"md:w-1/2\" data-kid=\"8-1-2-1-3-1\" data-name=\"executive operator details\">\n                        <h3 class=\"text-5xl font-serif italic mb-8\" data-kid=\"8-1-2-1-3-1-1\" data-name=\"executive operator title\">\n                            Executive Ops\n                        </h3>\n                        <p class=\"text-xl text-navy/60 leading-relaxed italic mb-12\" data-kid=\"8-1-2-1-3-1-2\" data-name=\"executive operator description\">\n                            Complex calendar orchestration, multi-stakeholder triage, and cross-platform communication management.\n                        </p>\n                        <div class=\"flex gap-4\" data-kid=\"8-1-2-1-3-1-3\" data-name=\"executive operator stats\">\n                            <span class=\"px-4 py-2 bg-navy text-paper font-mono text-xs font-black uppercase tracking-widest\" data-kid=\"8-1-2-1-3-1-3-1\" data-name=\"executive status\">\n                                Active\n                            </span>\n                            <span class=\"px-4 py-2 border border-navy/10 font-mono text-xs font-black uppercase tracking-widest\" data-kid=\"8-1-2-1-3-1-3-2\" data-name=\"executive uptime\">\n                                Uptime: 100%\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"md:w-1/2 flex flex-col justify-end items-end space-y-4\" data-kid=\"8-1-2-1-3-2\" data-name=\"executive meta info\">\n                        <div class=\"w-full h-px bg-navy/10\" data-kid=\"8-1-2-1-3-2-1\" data-name=\"meta divider 1\">\n                        </div>\n                        <div class=\"font-mono text-[10px] text-navy/30 uppercase\" data-kid=\"8-1-2-1-3-2-2\" data-name=\"telemetry label\">\n                            Telemetry: 8 active channels\n                        </div>\n                        <div class=\"w-full h-px bg-navy/10\" data-kid=\"8-1-2-1-3-2-3\" data-name=\"meta divider 2\">\n                        </div>\n                        <div class=\"font-mono text-[10px] text-navy/30 uppercase\" data-kid=\"8-1-2-1-3-2-4\" data-name=\"integrations label\">\n                            Integrations: Google, Slack, Notion\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Ticket 2 (Active) -->\n            <div class=\"bg-paper text-navy p-8 border-l-8 border-cyan relative group cursor-pointer hover:-translate-y-2 transition-transform duration-300\" data-kid=\"8-1-2-2\" data-name=\"sales operator card\">\n                <div class=\"absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-cobalt rounded-full\" data-kid=\"8-1-2-2-1\" data-name=\"sales operator circle\">\n                </div>\n                <div class=\"font-mono text-[10px] opacity-40 uppercase tracking-[0.3em] font-bold mb-4\" data-kid=\"8-1-2-2-2\" data-name=\"sales operator id\">\n                    ID: SALES_01\n                </div>\n                <h3 class=\"text-3xl font-serif italic mb-6\" data-kid=\"8-1-2-2-3\" data-name=\"sales operator title\">\n                    Sales Ops\n                </h3>\n                <p class=\"text-sm text-navy/60 leading-relaxed mb-8 italic\" data-kid=\"8-1-2-2-4\" data-name=\"sales operator description\">\n                    Outbound orchestration, lead enrichment, and CRM automation.\n                </p>\n                <div class=\"flex justify-between items-end\" data-kid=\"8-1-2-2-5\" data-name=\"sales operator status\">\n                    <div class=\"px-3 py-1 bg-cyan text-navy font-mono text-[9px] font-bold uppercase tracking-widest\" data-kid=\"8-1-2-2-5-1\" data-name=\"sales status badge\">\n                        Deployed\n                    </div>\n                    <div class=\"font-mono text-[9px] opacity-20\" data-kid=\"8-1-2-2-5-2\" data-name=\"sales id label\">\n                        #OP-042-B\n                    </div>\n                </div>\n            </div>\n            <!-- Ticket 3 (Muted) -->\n            <div class=\"bg-paper/80 text-navy p-8 border-l-8 border-butter relative group opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all cursor-pointer hover:-translate-y-2\" data-kid=\"8-1-2-3\" data-name=\"research operator card\">\n                <div class=\"absolute -right-4 top-1/2 -translate-y-1/2 w-8 h-8 bg-cobalt rounded-full\" data-kid=\"8-1-2-3-1\" data-name=\"research operator circle\">\n                </div>\n                <div class=\"font-mono text-[10px] opacity-40 uppercase tracking-[0.3em] font-bold mb-4\" data-kid=\"8-1-2-3-2\" data-name=\"research operator id\">\n                    ID: RESR_01\n                </div>\n                <h3 class=\"text-3xl font-serif italic mb-6\" data-kid=\"8-1-2-3-3\" data-name=\"research operator title\">\n                    Research\n                </h3>\n                <p class=\"text-sm text-navy/60 leading-relaxed mb-8 italic\" data-kid=\"8-1-2-3-4\" data-name=\"research operator description\">\n                    Deep competitive analysis, market reporting, and trend tracking.\n                </p>\n                <div class=\"flex justify-between items-end\" data-kid=\"8-1-2-3-5\" data-name=\"research operator status\">\n                    <div class=\"px-3 py-1 bg-navy/10 text-navy/40 font-mono text-[9px] font-bold uppercase tracking-widest\" data-kid=\"8-1-2-3-5-1\" data-name=\"research status badge\">\n                        Training\n                    </div>\n                    <div class=\"font-mono text-[9px] opacity-20\" data-kid=\"8-1-2-3-5-2\" data-name=\"research id label\">\n                        #OP-089-C\n                    </div>\n                </div>\n            </div>\n            <!-- More cards would go here for a full 6-card grid -->\n        </div>\n    </div>\n</section>\n<!-- 9. DEPLOYMENT (Rich CLI Execution Log) -->\n<section class=\"py-40 navy-surface border-y border-white/5 relative overflow-hidden\" data-kid=\"9\" data-name=\"deployment section\">\n    <div class=\"container mx-auto px-12\" data-kid=\"9-1\" data-name=\"deployment container\">\n        <div class=\"flex flex-col md:flex-row gap-32\" data-kid=\"9-1-1\" data-name=\"deployment content\">\n            <div class=\"w-full md:w-1/3\" data-kid=\"9-1-1-1\" data-name=\"deployment title area\">\n                <h2 class=\"text-6xl font-serif italic mb-8 leading-tight\" data-kid=\"9-1-1-1-1\" data-name=\"deployment title\">\n                    Deployment\n                    <br data-kid=\"9-1-1-1-1-1\" data-name=\"title line break\"/>\n                    Protocol.\n                </h2>\n                <p class=\"text-paper/50 text-lg italic leading-relaxed mb-12\" data-kid=\"9-1-1-1-2\" data-name=\"deployment description\">\n                    The transition from human bottleneck to machine workforce happens in four distinct calibration phases.\n                </p>\n                <div class=\"p-8 bg-white/5 border border-white/10\" data-kid=\"9-1-1-1-3\" data-name=\"system ready box\">\n                    <div class=\"font-mono text-xs text-ember uppercase tracking-[0.4em] mb-4 font-black\" data-kid=\"9-1-1-1-3-1\" data-name=\"system ready label\">\n                        System Ready\n                    </div>\n                    <div class=\"font-mono text-[10px] text-white/30 space-y-2\" data-kid=\"9-1-1-1-3-2\" data-name=\"terminal logs\">\n                        <div data-kid=\"9-1-1-1-3-2-1\" data-name=\"log 1\">\n                            > node init_atlas.js\n                        </div>\n                        <div data-kid=\"9-1-1-1-3-2-2\" data-name=\"log 2\">\n                            > checking dependencies... OK\n                        </div>\n                        <div data-kid=\"9-1-1-1-3-2-3\" data-name=\"log 3\">\n                            > establishing secure tunnel... OK\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-full md:w-2/3 bg-black/40 border border-white/10 p-12 font-mono relative\" data-kid=\"9-1-1-2\" data-name=\"calibration content\">\n                <div class=\"absolute top-0 right-0 p-6 opacity-10 pointer-events-none\" data-kid=\"9-1-1-2-1\" data-name=\"calibration decoration\">\n                    <svg class=\"w-32 h-32 text-cyan\" data-kid=\"9-1-1-2-1-1\" data-name=\"decoration icon\" viewbox=\"0 0 100 100\">\n                        <path d=\"M10,10 L90,90 M90,10 L10,90\" stroke=\"currentColor\" stroke-width=\"0.5\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"space-y-16 relative\" data-kid=\"9-1-1-2-2\" data-name=\"calibration steps container\">\n                    <div class=\"absolute left-6 top-4 bottom-4 w-px bg-white/10\" data-kid=\"9-1-1-2-2-1\" data-name=\"step line\">\n                    </div>\n                    <div class=\"flex gap-12 group\" data-kid=\"9-1-1-2-2-2\" data-name=\"calibration step 1\">\n                        <div class=\"w-12 h-12 bg-ember flex items-center justify-center shrink-0 z-10 shadow-[0_0_20px_rgba(230,57,70,0.3)]\" data-kid=\"9-1-1-2-2-2-1\" data-name=\"step 1 icon\">\n                            <span class=\"text-navy font-black\" data-kid=\"9-1-1-2-2-2-1-1\" data-name=\"step 1 number\">\n                                01\n                            </span>\n                        </div>\n                        <div data-kid=\"9-1-1-2-2-2-2\" data-name=\"step 1 content\">\n                            <div class=\"text-cyan text-xs font-bold tracking-widest mb-2\" data-kid=\"9-1-1-2-2-2-2-1\" data-name=\"step 1 label\">\n                                > PHASE_DISCOVERY\n                            </div>\n                            <h4 class=\"text-2xl font-serif text-paper italic mb-3\" data-kid=\"9-1-1-2-2-2-2-2\" data-name=\"step 1 title\">\n                                Strategic Alignment Call\n                            </h4>\n                            <p class=\"text-white/40 text-sm leading-relaxed max-w-lg\" data-kid=\"9-1-1-2-2-2-2-3\" data-name=\"step 1 description\">\n                                We map your unique operational surface, identifying high-leverage bottlenecks suitable for automation.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-12 group\" data-kid=\"9-1-1-2-2-3\" data-name=\"calibration step 2\">\n                        <div class=\"w-12 h-12 border border-white/20 bg-navy flex items-center justify-center shrink-0 z-10 group-hover:border-cyan transition-colors\" data-kid=\"9-1-1-2-2-3-1\" data-name=\"step 2 icon\">\n                            <span class=\"text-white/20 group-hover:text-cyan font-black\" data-kid=\"9-1-1-2-2-3-1-1\" data-name=\"step 2 number\">\n                                02\n                            </span>\n                        </div>\n                        <div data-kid=\"9-1-1-2-2-3-2\" data-name=\"step 2 content\">\n                            <div class=\"text-cyan text-xs font-bold tracking-widest mb-2\" data-kid=\"9-1-1-2-2-3-2-1\" data-name=\"step 2 label\">\n                                > PHASE_MAPPING\n                            </div>\n                            <h4 class=\"text-2xl font-serif text-paper italic mb-3\" data-kid=\"9-1-1-2-2-3-2-2\" data-name=\"step 2 title\">\n                                Context & Workflow Injection\n                            </h4>\n                            <p class=\"text-white/40 text-sm leading-relaxed max-w-lg\" data-kid=\"9-1-1-2-2-3-2-3\" data-name=\"step 2 description\">\n                                Collision ingest your existing processes, playbooks, and strategic goals to build a custom context graph.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-12 group\" data-kid=\"9-1-1-2-2-4\" data-name=\"calibration step 3\">\n                        <div class=\"w-12 h-12 border border-white/20 bg-navy flex items-center justify-center shrink-0 z-10 group-hover:border-butter transition-colors\" data-kid=\"9-1-1-2-2-4-1\" data-name=\"step 3 icon\">\n                            <span class=\"text-white/20 group-hover:text-butter font-black\" data-kid=\"9-1-1-2-2-4-1-1\" data-name=\"step 3 number\">\n                                03\n                            </span>\n                        </div>\n                        <div data-kid=\"9-1-1-2-2-4-2\" data-name=\"step 3 content\">\n                            <div class=\"text-cyan text-xs font-bold tracking-widest mb-2\" data-kid=\"9-1-1-2-2-4-2-1\" data-name=\"step 3 label\">\n                                > PHASE_CALIBRATION\n                            </div>\n                            <h4 class=\"text-2xl font-serif text-paper italic mb-3\" data-kid=\"9-1-1-2-2-4-2-2\" data-name=\"step 3 title\">\n                                Runtime Deployment & Training\n                            </h4>\n                            <p class=\"text-white/40 text-sm leading-relaxed max-w-lg\" data-kid=\"9-1-1-2-2-4-2-3\" data-name=\"step 3 description\">\n                                Initialization of the operator instances within your environment. Final alignment and safety check cycles.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center justify-center pt-8\" data-kid=\"9-1-1-2-2-5\" data-name=\"final init button container\">\n                        <button class=\"px-16 py-5 bg-white text-navy font-black tracking-[0.3em] text-sm hover:bg-ember hover:text-white transition-all duration-500 shadow-2xl\" data-kid=\"9-1-1-2-2-5-1\" data-name=\"final init button\">\n                            INIT_FINAL_SEQUENCE\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 10. DESIGN PARTNERS -->\n<section class=\"py-40 bg-black/40 text-paper border-y border-white/10\" data-kid=\"10\" data-name=\"collaboration section\">\n    <div class=\"container mx-auto px-12\" data-kid=\"10-1\" data-name=\"collaboration container\">\n        <div class=\"flex flex-col md:flex-row items-center gap-24\" data-kid=\"10-1-1\" data-name=\"collaboration inner\">\n            <div class=\"w-full md:w-1/2\" data-kid=\"10-1-1-1\" data-name=\"collaboration title area\">\n                <h2 class=\"text-5xl font-serif italic mb-8\" data-kid=\"10-1-1-1-1\" data-name=\"collaboration title\">\n                    Direct collaboration.\n                    <br data-kid=\"10-1-1-1-1-1\" data-name=\"title line break\"/>\n                    Absolute precision.\n                </h2>\n                <div class=\"space-y-8\" data-kid=\"10-1-1-1-2\" data-name=\"collaboration benefits\">\n                    <div class=\"flex items-start gap-6 group\" data-kid=\"10-1-1-1-2-1\" data-name=\"benefit 1\">\n                        <div class=\"w-10 h-10 border border-ember flex items-center justify-center font-mono text-ember font-bold shrink-0\" data-kid=\"10-1-1-1-2-1-1\" data-name=\"benefit 1 number\">\n                            1\n                        </div>\n                        <div data-kid=\"10-1-1-1-2-1-2\" data-name=\"benefit 1 text\">\n                            <h4 class=\"font-serif text-xl italic mb-2\" data-kid=\"10-1-1-1-2-1-2-1\" data-name=\"benefit 1 title\">\n                                Direct Slack Access\n                            </h4>\n                            <p class=\"text-white/40 text-sm\" data-kid=\"10-1-1-1-2-1-2-2\" data-name=\"benefit 1 description\">\n                                We are embedded in your team. Zero friction communication.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start gap-6 group\" data-kid=\"10-1-1-1-2-2\" data-name=\"benefit 2\">\n                        <div class=\"w-10 h-10 border border-cyan flex items-center justify-center font-mono text-cyan font-bold shrink-0\" data-kid=\"10-1-1-1-2-2-1\" data-name=\"benefit 2 number\">\n                            2\n                        </div>\n                        <div data-kid=\"10-1-1-1-2-2-2\" data-name=\"benefit 2 text\">\n                            <h4 class=\"font-serif text-xl italic mb-2\" data-kid=\"10-1-1-1-2-2-2-1\" data-name=\"benefit 2 title\">\n                                Weekly Iterations\n                            </h4>\n                            <p class=\"text-white/40 text-sm\" data-kid=\"10-1-1-1-2-2-2-2\" data-name=\"benefit 2 description\">\n                                Rapid feedback cycles to ensure the operator evolves with you.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start gap-6 group\" data-kid=\"10-1-1-1-2-3\" data-name=\"benefit 3\">\n                        <div class=\"w-10 h-10 border border-butter flex items-center justify-center font-mono text-butter font-bold shrink-0\" data-kid=\"10-1-1-1-2-3-1\" data-name=\"benefit 3 number\">\n                            3\n                        </div>\n                        <div data-kid=\"10-1-1-1-2-3-2\" data-name=\"benefit 3 text\">\n                            <h4 class=\"font-serif text-xl italic mb-2\" data-kid=\"10-1-1-1-2-3-2-1\" data-name=\"benefit 3 title\">\n                                Human Approval\n                            </h4>\n                            <p class=\"text-white/40 text-sm\" data-kid=\"10-1-1-1-2-3-2-2\" data-name=\"benefit 3 description\">\n                                You retain strategic control. Collision executes the mechanics.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-full md:w-1/2\" data-kid=\"10-1-1-2\" data-name=\"partner portal\">\n                <div class=\"p-12 border-2 border-white/5 bg-white/[0.02] backdrop-blur-3xl relative\" data-kid=\"10-1-1-2-1\" data-name=\"portal box\">\n                    <div class=\"absolute top-0 right-0 p-4 font-mono text-[9px] text-white/20\" data-kid=\"10-1-1-2-1-1\" data-name=\"portal label\">\n                        PARTNER_PORTAL_V1\n                    </div>\n                    <h3 class=\"font-serif text-3xl italic mb-6\" data-kid=\"10-1-1-2-1-2\" data-name=\"portal title\">\n                        Shape the roadmap.\n                    </h3>\n                    <p class=\"text-white/60 mb-10 italic leading-relaxed\" data-kid=\"10-1-1-2-1-3\" data-name=\"portal description\">\n                        Collision is currently in a closed design partner phase. We work with a select few visionary founders and executives to build the autonomous future.\n                    </p>\n                    <button class=\"w-full py-4 border border-white/20 text-paper font-mono text-xs tracking-widest hover:bg-white hover:text-black transition-all\" data-kid=\"10-1-1-2-1-4\" data-name=\"partner program button\">\n                        JOIN_PARTNER_PROGRAM\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 11. MANIFESTO -->\n<section class=\"py-60 cobalt-surface relative overflow-hidden\" data-kid=\"11\" data-name=\"manifesto section\" id=\"manifesto\">\n    <div class=\"absolute inset-0 noise-overlay\" data-kid=\"11-1\" data-name=\"manifesto noise\">\n    </div>\n    <div class=\"container mx-auto px-12 relative text-center\" data-kid=\"11-2\" data-name=\"manifesto container\">\n        <!-- Big quiet impact ring in background -->\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-white/[0.03] rounded-full\" data-kid=\"11-2-1\" data-name=\"background ring 1\">\n        </div>\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-white/[0.05] rounded-full\" data-kid=\"11-2-2\" data-name=\"background ring 2\">\n        </div>\n        <div class=\"relative z-10 max-w-5xl mx-auto py-20\" data-kid=\"11-2-3\" data-name=\"manifesto content\">\n            <div class=\"absolute -top-40 left-1/2 -translate-x-1/2 text-[15rem] font-serif font-black italic opacity-[0.03] select-none whitespace-nowrap\" data-kid=\"11-2-3-1\" data-name=\"manifesto watermark\">\n                THE_MANIFESTO\n            </div>\n            <h2 class=\"text-7xl md:text-9xl font-serif italic mb-24 leading-[0.9] tracking-tighter\" data-kid=\"11-2-3-2\" data-name=\"manifesto title\">\n                The internet changed.\n                <br data-kid=\"11-2-3-2-1\" data-name=\"title line 1\"/>\n                Software didn't.\n                <br data-kid=\"11-2-3-2-2\" data-name=\"title line 2\"/>\n                <span class=\"text-ember font-bold not-italic\" data-kid=\"11-2-3-2-3\" data-name=\"title highlight\">\n                    Until now.\n                </span>\n            </h2>\n            <p class=\"text-3xl text-paper/60 leading-relaxed font-light mb-24 italic max-w-4xl mx-auto\" data-kid=\"11-2-3-3\" data-name=\"manifesto quote\">\n                \"The next generation won’t click buttons. It won’t toggle settings. It will act. Collision is building the core infrastructure for an autonomous era.\"\n            </p>\n            <div class=\"flex flex-wrap justify-center gap-12 opacity-30 font-mono text-[10px] tracking-widest uppercase font-bold\" data-kid=\"11-2-3-4\" data-name=\"philosophy tags\">\n                <span data-kid=\"11-2-3-4-1\" data-name=\"tag 1\">\n                    Strategic Intent\n                </span>\n                <span data-kid=\"11-2-3-4-2\" data-name=\"tag 2\">\n                    Autonomous Action\n                </span>\n                <span data-kid=\"11-2-3-4-3\" data-name=\"tag 3\">\n                    Persistent Runtime\n                </span>\n                <span data-kid=\"11-2-3-4-4\" data-name=\"tag 4\">\n                    Impact Atlas\n                </span>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- 12. FINAL CTA -->\n<section class=\"py-40 navy-surface border-t border-white/10 relative overflow-hidden\" data-kid=\"12\" data-name=\"final cta section\" id=\"console\">\n    <div class=\"container mx-auto px-12\" data-kid=\"12-1\" data-name=\"cta container\">\n        <div class=\"max-w-6xl mx-auto terminal-box p-1 md:p-12 relative\" data-kid=\"12-1-1\" data-name=\"cta terminal box\">\n            <div class=\"absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-cyan to-transparent\" data-kid=\"12-1-1-1\" data-name=\"cta top bar\">\n            </div>\n            <div class=\"flex flex-col md:flex-row gap-20 items-center\" data-kid=\"12-1-1-2\" data-name=\"cta layout\">\n                <div class=\"w-full md:w-1/2\" data-kid=\"12-1-1-2-1\" data-name=\"cta content\">\n                    <div class=\"font-mono text-xs text-cyan mb-6 tracking-widest font-bold\" data-kid=\"12-1-1-2-1-1\" data-name=\"cta label\">\n                        > READY_FOR_DEPLOYMENT?\n                    </div>\n                    <h2 class=\"text-6xl font-serif italic mb-8\" data-kid=\"12-1-1-2-1-2\" data-name=\"cta title\">\n                        Initialize your first operator.\n                    </h2>\n                    <p class=\"text-paper/60 text-lg italic leading-relaxed mb-10\" data-kid=\"12-1-1-2-1-3\" data-name=\"cta description\">\n                        The collision has begun. Join the vanguard of autonomous operations and reclaim your strategic focus.\n                    </p>\n                    <div class=\"flex flex-col gap-4\" data-kid=\"12-1-1-2-1-4\" data-name=\"cta button group\">\n                        <button class=\"px-10 py-6 bg-butter text-navy font-mono text-lg font-black tracking-widest hover:bg-ember hover:text-paper transition-all shadow-[0_0_60px_rgba(244,201,93,0.3)]\" data-kid=\"12-1-1-2-1-4-1\" data-name=\"cta button\">\n                            > INIT_COLLISION_RUNTIME_\n                        </button>\n                        <div class=\"font-mono text-[10px] text-white/20 mt-2\" data-kid=\"12-1-1-2-1-4-2\" data-name=\"cta message\">\n                            Awaiting connection... handshake: 0x44F...\n                        </div>\n                    </div>\n                </div>\n                <div class=\"w-full md:w-1/2 relative\" data-kid=\"12-1-1-2-2\" data-name=\"cta visual\">\n                    <!-- Rich command console visual -->\n                    <div class=\"bg-black p-8 border border-white/10 rounded-sm font-mono text-xs space-y-4 shadow-2xl\" data-kid=\"12-1-1-2-2-1\" data-name=\"command console\">\n                        <div class=\"flex justify-between border-b border-white/10 pb-4 mb-4\" data-kid=\"12-1-1-2-2-1-1\" data-name=\"console header\">\n                            <span class=\"text-butter font-bold\" data-kid=\"12-1-1-2-2-1-1-1\" data-name=\"console title\">\n                                COLLISION_CONSOLE\n                            </span>\n                            <span class=\"text-white/20\" data-kid=\"12-1-1-2-2-1-1-2\" data-name=\"console version\">\n                                v1.0.4\n                            </span>\n                        </div>\n                        <div class=\"text-cyan\" data-kid=\"12-1-1-2-2-1-2\" data-name=\"console log 1\">\n                            > scan_workflow --full\n                        </div>\n                        <div class=\"text-white/40 italic\" data-kid=\"12-1-1-2-2-1-3\" data-name=\"console log 2\">\n                            // Found 48 distinct operational friction points\n                        </div>\n                        <div class=\"text-paper\" data-kid=\"12-1-1-2-2-1-4\" data-name=\"console log 3\">\n                            > deploy --operator_type=executive --goal=\"q3_scale\"\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"12-1-1-2-2-1-5\" data-name=\"console status bar\">\n                            <span class=\"text-ember\" data-kid=\"12-1-1-2-2-1-5-1\" data-name=\"status label\">\n                                PROVISIONING:\n                            </span>\n                            <div class=\"h-2 flex-grow bg-white/10 rounded-full overflow-hidden\" data-kid=\"12-1-1-2-2-1-5-2\" data-name=\"progress container\">\n                                <div class=\"h-full bg-cyan w-4/5\" data-kid=\"12-1-1-2-2-1-5-2-1\" data-name=\"progress bar\">\n                                </div>\n                            </div>\n                            <span data-kid=\"12-1-1-2-2-1-5-3\" data-name=\"progress text\">\n                                80%\n                            </span>\n                        </div>\n                        <div class=\"text-butter animate-pulse font-black tracking-widest\" data-kid=\"12-1-1-2-2-1-6\" data-name=\"status imminent\">\n                            > STATUS: COLLISION_IMMINENT\n                        </div>\n                        <div class=\"pt-4 border-t border-white/10 text-white/20 text-xs font-bold tracking-widest\" data-kid=\"12-1-1-2-2-1-7\" data-name=\"console metrics\">\n                            CPU: 0.4% // MEM: 1.2GB // ACTIVE: 1\n                        </div>\n                    </div>\n                    <!-- Floating impact marks around the console -->\n                    <div class=\"absolute -top-10 -right-10 w-20 h-20 impact-mark opacity-20 rotate-12 blur-sm\" data-kid=\"12-1-1-2-2-2\" data-name=\"floating mark 1\">\n                    </div>\n                    <div class=\"absolute -bottom-8 -left-8 w-16 h-16 border border-cyan/30 rounded-full animate-ping\" data-kid=\"12-1-1-2-2-3\" data-name=\"floating mark 2\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <!-- Footer-ish credits -->\n    <div class=\"container mx-auto px-12 mt-40 pb-20 flex flex-col md:flex-row justify-between items-center gap-10 opacity-50\" data-kid=\"12-2\" data-name=\"footer\">\n        <div class=\"flex items-center gap-3\" data-kid=\"12-2-1\" data-name=\"footer logo\">\n            <div class=\"w-8 h-8 bg-ember rounded-xs rotate-45 flex items-center justify-center\" data-kid=\"12-2-1-1\" data-name=\"logo shape\">\n                <div class=\"w-2.5 h-2.5 bg-paper rounded-full\" data-kid=\"12-2-1-1-1\" data-name=\"logo core\">\n                </div>\n            </div>\n            <span class=\"font-serif italic font-bold text-2xl\" data-kid=\"12-2-1-2\" data-name=\"footer brand name\">\n                Collision\n            </span>\n        </div>\n        <div class=\"font-mono text-xs tracking-[0.3em] uppercase font-black text-center text-white/30\" data-kid=\"12-2-2\" data-name=\"copyright text\">\n            © 2026 COLLISION_INFRASTRUCTURE // ROOT_SYSTEM_ACTIVE\n        </div>\n        <div class=\"flex gap-8 font-mono text-[10px] uppercase font-bold tracking-widest\" data-kid=\"12-2-3\" data-name=\"footer links\">\n            <a class=\"hover:text-ember transition-colors\" data-kid=\"12-2-3-1\" data-name=\"twitter link\" href=\"#\">\n                Twitter\n            </a>\n            <a class=\"hover:text-cyan transition-colors\" data-kid=\"12-2-3-2\" data-name=\"docs link\" href=\"#\">\n                Docs\n            </a>\n            <a class=\"hover:text-butter transition-colors\" data-kid=\"12-2-3-3\" data-name=\"privacy link\" href=\"#\">\n                Privacy\n            </a>\n        </div>\n    </div>\n</section>\n<!-- Global Icon Support -->\n<link data-kid=\"13\" data-name=\"icon support\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n",
