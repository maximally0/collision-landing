    },
    "var_bbaa27065eb3": {
      "type": "variant",
      "label": "Collision — Deep Sea Command",
      "parentId": "var_d60cff287751",
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"bg-[#020814] text-[#EAE2B7] font-['Space_Grotesk'] selection:bg-butter selection:text-navy overflow-x-clip min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&family=Manrope:wght@300;400;500;600;700&display=swap');\n        \n        :root {\n            --color-navy: #020814;\n            --color-paper: #EAE2B7;\n            --color-butter: #FFD166;\n            --color-cobalt: #118AB2;\n            --color-coral: #EF8354;\n        }\n\n        .font-mono { font-family: 'Space Mono', monospace; }\n        .font-sans { font-family: 'Space Grotesk', sans-serif; }\n        .font-manrope { font-family: 'Manrope', sans-serif; }\n        .text-butter { color: var(--color-butter); }\n        .bg-butter { background-color: var(--color-butter); }\n        .text-cobalt { color: var(--color-cobalt); }\n        .bg-cobalt { background-color: var(--color-cobalt); }\n        .border-cobalt { border-color: var(--color-cobalt); }\n        .text-coral { color: var(--color-coral); }\n        .bg-paper { background-color: var(--color-paper); }\n        .text-navy { color: var(--color-navy); }\n\n        .topo-bg {\n            background-image: \n                radial-gradient(var(--color-cobalt) 0.8px, transparent 0.8px),\n                repeating-linear-gradient(45deg, rgba(17, 138, 178, 0.05) 0px, rgba(17, 138, 178, 0.05) 1px, transparent 1px, transparent 10px);\n            background-size: 40px 40px, 20px 20px;\n        }\n\n        .sonar-grid {\n            background-image: \n                linear-gradient(rgba(17, 138, 178, 0.1) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(17, 138, 178, 0.1) 1px, transparent 1px);\n            background-size: 50px 50px;\n        }\n\n        .scanline {\n            width: 100%;\n            height: 2px;\n            background: linear-gradient(to right, transparent, var(--color-butter), transparent);\n            position: absolute;\n            z-index: 50;\n            pointer-events: none;\n            opacity: 0.1;\n        }\n\n        .sonar-pulse {\n            animation: sonar-pulse 4s cubic-bezier(0, 0.2, 0.8, 1) infinite;\n        }\n\n        @keyframes sonar-pulse {\n            0% { transform: scale(0.5); opacity: 1; }\n            100% { transform: scale(2.5); opacity: 0; }\n        }\n\n        .knot-shadow {\n            box-shadow: 0 0 60px -10px var(--color-butter);\n        }\n\n        .glass {\n            background: rgba(10, 18, 36, 0.7);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(17, 138, 178, 0.2);\n        }\n\n        /* 90-degree lines for org chart */\n        .connector-h { height: 1px; background-color: var(--color-cobalt); }\n        .connector-v { width: 1px; background-color: var(--color-cobalt); }\n\n        ::-webkit-scrollbar { width: 6px; }\n        ::-webkit-scrollbar-track { background: var(--color-navy); }\n        ::-webkit-scrollbar-thumb { background: var(--color-cobalt); border-radius: 10px; }\n    </style>\n    <!-- SECTION 1: HERO / THE DEPTHS OF ORCHESTRATION -->\n    <header class=\"relative min-h-[120vh] flex flex-col items-center justify-start pt-24 overflow-hidden font-manrope\" data-kid=\"1-1\" data-name=\"hero section container\">\n        <!-- Background Layer -->\n        <div class=\"absolute inset-0 z-0 topo-bg opacity-30\" data-kid=\"1-1-1\" data-name=\"topographic background layer\">\n        </div>\n        <div class=\"absolute inset-0 z-0 overflow-hidden pointer-events-none\" data-kid=\"1-1-2\" data-name=\"hero visual svg container\">\n            <svg class=\"w-full h-full opacity-15\" data-kid=\"1-1-2-1\" data-name=\"abstract line chart svg\" fill=\"none\" viewbox=\"0 0 1440 1000\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M720 0V300\" stroke=\"var(--color-cobalt)\" stroke-dasharray=\"8 8\" stroke-width=\"2\">\n                </path>\n                <path d=\"M720 300L200 600M720 300L1240 600M720 300L720 700\" stroke=\"var(--color-cobalt)\" stroke-width=\"1.5\">\n                </path>\n                <circle cx=\"720\" cy=\"300\" r=\"150\" stroke=\"var(--color-butter)\" stroke-opacity=\"0.1\">\n                </circle>\n                <circle cx=\"720\" cy=\"300\" r=\"250\" stroke=\"var(--color-cobalt)\" stroke-opacity=\"0.05\">\n                </circle>\n            </svg>\n        </div>\n        <!-- Status Rail (Top) -->\n        <div class=\"relative z-20 w-full px-8 flex justify-between items-center mb-24 font-mono text-[9px] uppercase tracking-[0.3em] border-y border-white/5 py-3 glass\" data-kid=\"1-1-3\" data-name=\"system status rail\">\n            <div class=\"flex items-center gap-12\" data-kid=\"1-1-3-1\" data-name=\"left side status group\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-1\" data-name=\"active status indicator group\">\n                    <span class=\"w-1.5 h-1.5 rounded-full bg-butter animate-pulse\" data-kid=\"1-1-3-1-1-1\" data-name=\"pulsing active dot icon\">\n                    </span>\n                    <span class=\"text-butter font-bold\" data-kid=\"1-1-3-1-1-2\" data-name=\"system status text\">\n                        SYST: RUNTIME_ACTIVE\n                    </span>\n                </div>\n                <div class=\"text-[#EAE2B7]/40 flex gap-4\" data-kid=\"1-1-3-1-2\" data-name=\"telemetry data group\">\n                    <span data-kid=\"1-1-3-1-2-1\" data-name=\"depth telemetry text\">\n                        DPT: 4.2KM\n                    </span>\n                    <span data-kid=\"1-1-3-1-2-2\" data-name=\"latency telemetry text\">\n                        LAT: 12MS\n                    </span>\n                    <span data-kid=\"1-1-3-1-2-3\" data-name=\"engine name text\">\n                        ENG: NEURAL_ORCH\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-12\" data-kid=\"1-1-3-2\" data-name=\"right side status group\">\n                <div class=\"text-[#EAE2B7]/30 text-right hidden lg:flex gap-6\" data-kid=\"1-1-3-2-1\" data-name=\"load monitoring text group\">\n                    <span data-kid=\"1-1-3-2-1-1\" data-name=\"cpu load text\">\n                        CPU_LOAD: 14%\n                    </span>\n                    <span data-kid=\"1-1-3-2-1-2\" data-name=\"thread load text\">\n                        THRD: 4,096_PKT\n                    </span>\n                </div>\n                <div class=\"bg-butter text-navy px-4 py-0.5 font-bold tracking-tighter\" data-kid=\"1-1-3-2-2\" data-name=\"stable version label\">\n                    V.0.8.4_STABLE\n                </div>\n            </div>\n        </div>\n        <div class=\"relative z-20 text-center px-8 font-sans\" data-kid=\"1-1-4\" data-name=\"hero central content area\">\n            <h2 class=\"font-mono text-butter uppercase tracking-[0.5em] text-[10px] mb-10 opacity-70\" data-kid=\"1-1-4-1\" data-name=\"hero sub-headline text\">\n                Deep Sea Command — Orchestration Runtime\n            </h2>\n            <h1 class=\"text-7xl md:text-9xl font-bold tracking-[-0.04em] leading-[0.85] mb-14 max-w-6xl mx-auto\" data-kid=\"1-1-4-2\" data-name=\"hero main headline\">\n                AI operators for\n                <br data-kid=\"1-1-4-2-1\" data-name=\"headline line break\"/>\n                <span class=\"text-[#EAE2B7]/90 italic\" data-kid=\"1-1-4-2-2\" data-name=\"emphasized headline text\">\n                    ambitious people.\n                </span>\n            </h1>\n            <!-- Command Palette -->\n            <div class=\"w-full max-w-4xl mx-auto glass p-2 rounded-2xl shadow-[0_40px_100px_-20px_rgba(17,138,178,0.3)] mb-14\" data-kid=\"1-1-4-3\" data-name=\"command palette container\">\n                <div class=\"bg-[#0A1224] flex flex-col md:flex-row items-center gap-6 p-10 rounded-xl text-left border border-white/5\" data-kid=\"1-1-4-3-1\" data-name=\"interactive command input area\">\n                    <div class=\"flex-1 w-full flex items-center\" data-kid=\"1-1-4-3-1-1\" data-name=\"command prompt icon group\">\n                        <span class=\"font-mono text-butter text-2xl mr-6 opacity-50\" data-kid=\"1-1-4-3-1-1-1\" data-name=\"prompt icon text\">\n                            >\n                        </span>\n                        <span class=\"text-3xl font-medium text-[#EAE2B7] tracking-tight\" data-kid=\"1-1-4-3-1-1-2\" data-name=\"prompt placeholder text\">\n                            Build a presence people remember.\n                        </span>\n                        <span class=\"w-2 h-8 bg-butter inline-block animate-pulse ml-3 align-middle\" data-kid=\"1-1-4-3-1-1-3\" data-name=\"pulsing cursor indicator\">\n                        </span>\n                    </div>\n                    <button class=\"w-full md:w-auto bg-butter text-navy font-black px-12 py-5 rounded-lg uppercase text-sm tracking-[0.2em] hover:bg-white hover:scale-105 transition-all cursor-pointer shadow-lg active:scale-95\" data-kid=\"1-1-4-3-1-2\" data-name=\"primary execution button\">\n                        EXECUTE_CORE\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap justify-center gap-6 font-mono text-[10px] uppercase\" data-kid=\"1-1-4-4\" data-name=\"hero navigation links container\">\n                <a class=\"flex items-center gap-3 border border-butter/30 px-8 py-4 hover:bg-butter/5 transition-all group\" data-kid=\"1-1-4-4-1\" data-name=\"deploy operator action link\" href=\"#deploy\">\n                    <i class=\"ti ti-ship text-butter text-lg group-hover:scale-110 transition-transform\" data-kid=\"1-1-4-4-1-1\" data-name=\"ship icon\">\n                    </i>\n                