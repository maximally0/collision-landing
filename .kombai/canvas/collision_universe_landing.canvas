iv>\n            </div>\n            <!-- Branching Threads -->\n            <div class=\"mt-[-20px] w-full max-w-6xl h-64 relative overflow-hidden\" data-kid=\"1-1-5-3\" data-name=\"branching threads animation container\">\n                <svg class=\"w-full h-full\" data-kid=\"1-1-5-3-1\" data-name=\"thread lines svg\" fill=\"none\" viewbox=\"0 0 1200 400\">\n                    <path d=\"M600 0C600 100 200 150 0 300\" stroke=\"var(--color-cobalt)\" stroke-dasharray=\"4 4\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M600 0C600 100 400 150 250 350\" stroke=\"var(--color-cobalt)\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M600 0V380\" stroke=\"var(--color-butter)\" stroke-width=\"3\">\n                    </path>\n                    <path d=\"M600 0C600 100 800 150 950 350\" stroke=\"var(--color-cobalt)\" stroke-width=\"2\">\n                    </path>\n                    <path d=\"M600 0C600 100 1000 150 1200 300\" stroke=\"var(--color-cobalt)\" stroke-dasharray=\"4 4\" stroke-width=\"2\">\n                    </path>\n                </svg>\n            </div>\n        </div>\n    </header>\n    <!-- SECTION 2: THE SHIFT -->\n    <section class=\"py-48 bg-[#050A18] relative overflow-hidden\" data-kid=\"1-2\" data-name=\"paradigm shift section\">\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20 pointer-events-none\" data-kid=\"1-2-1\" data-name=\"sonar pulse animation container\">\n            <div class=\"w-[600px] h-[600px] border border-cobalt rounded-full sonar-pulse absolute inset-0\" data-kid=\"1-2-1-1\" data-name=\"first sonar ring\">\n            </div>\n            <div class=\"w-[600px] h-[600px] border border-cobalt rounded-full sonar-pulse absolute inset-0 [animation-delay:1s]\" data-kid=\"1-2-1-2\" data-name=\"second sonar ring\">\n            </div>\n            <div class=\"w-[600px] h-[600px] border border-cobalt rounded-full sonar-pulse absolute inset-0 [animation-delay:2s]\" data-kid=\"1-2-1-3\" data-name=\"third sonar ring\">\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto px-8 relative z-10 grid md:grid-cols-2 gap-32 items-center\" data-kid=\"1-2-2\" data-name=\"content grid container\">\n            <div class=\"space-y-12\" data-kid=\"1-2-2-1\" data-name=\"status comparison cards container\">\n                <div class=\"bg-white/5 border border-white/10 p-12 rounded-lg opacity-50 backdrop-blur-sm\" data-kid=\"1-2-2-1-1\" data-name=\"static software card\">\n                    <h3 class=\"text-3xl font-bold text-[#EAE2B7]/40 mb-4 tracking-tighter italic\" data-kid=\"1-2-2-1-1-1\" data-name=\"static card title\">\n                        Software waits.\n                    </h3>\n                    <p class=\"font-mono text-sm text-[#EAE2B7]/30 uppercase tracking-widest\" data-kid=\"1-2-2-1-1-2\" data-name=\"static card description\">\n                        Awaiting human input. Static. Latent.\n                    </p>\n                </div>\n                <div class=\"bg-butter border-l-[12px] border-cobalt p-12 rounded-lg shadow-2xl scale-110 md:-mr-12 relative\" data-kid=\"1-2-2-1-2\" data-name=\"autonomous operator card\">\n                    <div class=\"absolute -top-4 -right-4 bg-cobalt text-white font-mono text-[10px] px-3 py-1\" data-kid=\"1-2-2-1-2-1\" data-name=\"active state badge\">\n                        ACTIVE_STATE\n                    </div>\n                    <h3 class=\"text-4xl font-black text-navy mb-4 tracking-tighter uppercase\" data-kid=\"1-2-2-1-2-2\" data-name=\"operator card title\">\n                        Operators work.\n                    </h3>\n                    <p class=\"font-mono text-sm text-navy/70 uppercase tracking-widest leading-relaxed\" data-kid=\"1-2-2-1-2-3\" data-name=\"operator card description\">\n                        Continuous execution. Goal-oriented. Autonomous.\n                    </p>\n                </div>\n            </div>\n            <div class=\"text-right\" data-kid=\"1-2-2-2\" data-name=\"paradigm description area\">\n                <div class=\"inline-block p-4 border border-cobalt/20 mb-8\" data-kid=\"1-2-2-2-1\" data-name=\"icon container\">\n                    <img alt=\"sonar\" class=\"w-16 h-16 opacity-50 brightness-0 invert\" data-kid=\"1-2-2-2-1-1\" data-name=\"sonar sweep icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/radar-sweep.svg\" style=\"color: #118AB2;\"/>\n                </div>\n                <h2 class=\"text-6xl font-bold tracking-tighter mb-8 leading-none\" data-kid=\"1-2-2-2-2\" data-name=\"paradigm shift heading\">\n                    The paradigm\n                    <br data-kid=\"1-2-2-2-2-1\" data-name=\"paradigm shift heading break\"/>\n                    has shifted.\n                </h2>\n                <p class=\"text-xl text-[#EAE2B7]/60 max-w-md ml-auto\" data-kid=\"1-2-2-2-3\" data-name=\"paradigm shift description\">\n                    Collision isn't just another tool. It's the engine that powers your digital workforce while you sleep.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 3: THE PROBLEM -->\n    <section class=\"py-56 bg-[#020814] border-y border-white/5 relative sonar-grid\" data-kid=\"1-3\" data-name=\"structural waste section\">\n        <div class=\"max-w-7xl mx-auto px-8 relative z-10\" data-kid=\"1-3-1\" data-name=\"diagnostic content container\">\n            <div class=\"mb-24 flex flex-col lg:flex-row justify-between items-end gap-12\" data-kid=\"1-3-1-1\" data-name=\"header grid container\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"diagnostic heading group\">\n                    <h3 class=\"font-mono text-butter uppercase tracking-[0.4em] text-[10px] mb-6 opacity-60\" data-kid=\"1-3-1-1-1-1\" data-name=\"diagnostic subtitle\">\n                        Diagnostic // Structural Waste\n                    </h3>\n                    <h2 class=\"text-6xl font-bold tracking-tighter max-w-2xl leading-none\" data-kid=\"1-3-1-1-1-2\" data-name=\"diagnostic main headline\">\n                        The human cost of manual repetition.\n                    </h2>\n                </div>\n                <div class=\"flex gap-6 font-mono text-right w-full lg:w-auto\" data-kid=\"1-3-1-1-2\" data-name=\"cost leakage metrics container\">\n                    <div class=\"flex-1 p-8 border border-coral/20 bg-coral/[0.03] backdrop-blur-sm\" data-kid=\"1-3-1-1-2-1\" data-name=\"wage leakage card\">\n                        <span class=\"block text-coral text-5xl font-black tracking-tighter\" data-kid=\"1-3-1-1-2-1-1\" data-name=\"wage leakage value\">\n                            $14,200\n                        </span>\n                        <span class=\"text-[10px] text-coral/40 uppercase tracking-widest font-bold\" data-kid=\"1-3-1-1-2-1-2\" data-name=\"wage leakage label\">\n                            Monthly Wage Leakage\n                        </span>\n                    </div>\n                    <div class=\"flex-1 p-8 border border-butter/20 bg-butter/[0.03] backdrop-blur-sm\" data-kid=\"1-3-1-1-2-2\" data-name=\"time lost card\">\n                        <span class=\"block text-butter text-5xl font-black tracking-tighter\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"time lost value\">\n                            128H\n                        </span>\n                        <span class=\"text-[10px] text-butter/40 uppercase tracking-widest font-bold\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"time lost label\">\n                            Monthly Time Lost\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- Failing Chain Grid -->\n            <div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-3-1-2\" data-name=\"failing chain grid container\">\n                <!-- Chain Item -->\n                <div class=\"w-40 p-6 border border-coral/40 bg-coral/10 relative group h-32 flex flex-col justify-between shadow-[0_0_20px_rgba(239,131,84,0.1)]\" data-kid=\"1-3-1-2-1\" data-name=\"node 01 card\">\n                    <span class=\"font-mono text-[9px] text-coral uppercase font-bold\" data-kid=\"1-3-1-2-1-1\" data-name=\"node 01 label\">\n                        NODE_01\n                    </span>\n                    <h4 class=\"font-black text-xl uppercase italic\" data-kid=\"1-3-1-2-1-2\" data-name=\"node 01 title\">\n                        YOU\n                    </h4>\n                    <div class=\"absolute top-2 right-2\" data-kid=\"1-3-1-2-1-3\" data-name=\"node 01 status container\">\n                        <div class=\"w-2 h-2 rounded-full bg-coral animate-ping\" data-kid=\"1-3-1-2-1-3-1\" data-name=\"node 01 ping indicator\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"opacity-20 flex items-center h-32\" data-kid=\"1-3-1-2-2\" data-name=\"chain separator one\">\n                    <svg class=\"text-coral\" data-kid=\"1-3-1-2-2-1\" data-name=\"arrow icon one\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"w-40 p-6 border border-white/10 bg-white/[0.02] h-32 flex flex-col justify-between\" data-kid=\"1-3-1-2-3\" data-name=\"node 02 card\">\n                    <span class=\"font-mono text-[9px] text-white/20 uppercase font-bold\" data-kid=\"1-3-1-2-3-1\" data-name=\"node 02 label\">\n                        NODE_02\n                    </span>\n                    <h4 class=\"font-bold text-xl uppercase\" data-kid=\"1-3-1-2-3-2\" data-name=\"node 02 title\">\n                        WRITE\n                    </h4>\n                </div>\n                <div class=\"opacity-20 flex items-center h-32\" data-kid=\"1-3-1-2-4\" data-name=\"chain separator two\">\n                    <svg data-kid=\"1-3-1-2-4-1\" data-name=\"arrow icon two\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"w-40 p-6 border border-white/10 bg-white/[0.02] h-32 flex flex-col justify-between\" data-kid=\"1-3-1-2-5\" data-name=\"node 03 card\">\n                    <span class=\"font-mono text-[9px] text-white/20 uppercase font-bold\" data-kid=\"1-3-1-2-5-1\" data-name=\"node 03 label\">\n                        NODE_03\n                    </span>\n                    <h4 class=\"font-bold text-xl uppercase\" data-kid=\"1-3-1-2-5-2\" data-name=\"node 03 title\">\n                        POST\n                    </h4>\n                </div>\n                <div class=\"opacity-20 flex items-center h-32\" data-kid=\"1-3-1-2-6\" data-name=\"chain separator three\">\n                    <svg data-kid=\"1-3-1-2-6-1\" data-name=\"arrow icon three\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"w-40 p-6 border border-white/10 bg-white/[0.02] h-32 flex flex-col justify-between\" data-kid=\"1-3-1-2-7\" data-name=\"node 04 card\">\n                    <span class=\"font-mono text-[9px] text-white/20 uppercase font-bold\" data-kid=\"1-3-1-2-7-1\" data-name=\"node 04 label\">\n                        NODE_04\n                    </span>\n                    <h4 class=\"font-bold text-xl uppercase\" data-kid=\"1-3-1-2-7-2\" data-name=\"node 04 title\">\n                        REPLY\n                    </h4>\n                </div>\n                <div class=\"opacity-20 flex items-center h-32\" data-kid=\"1-3-1-2-8\" data-name=\"chain separator four\">\n                    <svg data-kid=\"1-3-1-2-8-1\" data-name=\"arrow icon four\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"w-40 p-6 border border-white/10 bg-white/[0.02] h-32 flex flex-col justify-between\" data-kid=\"1-3-1-2-9\" data-name=\"node 05 card\">\n                    <span class=\"font-mono text-[9px] text-white/20 uppercase font-bold\" data-kid=\"1-3-1-2-9-1\" data-name=\"node 05 label\">\n                        NODE_05\n                    </span>\n                    <h4 class=\"font-bold text-xl uppercase\" data-kid=\"1-3-1-2-9-2\" data-name=\"node 05 title\">\n                        EMAIL\n                    </h4>\n                </div>\n                <div class=\"opacity-20 flex items-center h-32\" data-kid=\"1-3-1-2-10\" data-name=\"chain separator five\">\n                    <svg data-kid=\"1-3-1-2-10-1\" data-name=\"arrow icon five\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"24\">\n                        <path d=\"M5 12h14M12 5l7 7-7 7\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"w-40 p-6 border border-coral/30 border-dashed bg-coral/5 text-coral h-32 flex flex-col justify-between\" data-kid=\"1-3-1-2-11\" data-name=\"failure loop node\">\n                    <span class=\"font-mono text-[9px] uppercase font-bold\" data-kid=\"1-3-1-2-11-1\" data-name=\"failure node label\">\n                        LOOP\n                    </span>\n                    <h4 class=\"font-black text-xl italic uppercase\" data-kid=\"1-3-1-2-11-2\" data-name=\"failure node title\">\n                        FAIL_REP\n                    </h4>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 4: THE RUNTIME / ORG CHART -->\n    <section class=\"py-48 bg-[#020814] relative overflow-hidden\" data-kid=\"1-4\" data-name=\"runtime topology section\">\n        <div class=\"max-w-7xl mx-auto px-8 relative z-10\" data-kid=\"1-4-1\" data-name=\"topology container\">\n            <div class=\"mb-32\" data-kid=\"1-4-1-1\" data-name=\"topology heading group\">\n                <h3 class=\"font-mono text-butter uppercase tracking-[0.4em] text-xs mb-4\" data-kid=\"1-4-1-1-1\" data-name=\"topology subtitle\">\n                    Runtime Topology\n                </h3>\n                <h2 class=\"text-6xl font-bold tracking-tighter leading-none\" data-kid=\"1-4-1-1-2\" data-name=\"topology headline\">\n                    Your Goal, Multiplied.\n                </h2>\n            </div>\n            <div class=\"relative flex items-center\" data-kid=\"1-4-1-2\" data-name=\"topology chart container\">\n                <!-- Root Node -->\n                <div class=\"w-80 shrink-0 z-20\" data-kid=\"1-4-1-2-1\" data-name=\"root node container\">\n                    <div class=\"bg-paper text-navy p-10 border-r-[12px] border-butter shadow-2xl relative group\" data-kid=\"1-4-1-2-1-1\" data-name=\"root node card\">\n                        <!-- Connecting line from center right -->\n                        <div class=\"absolute right-[-124px] top-1/2 w-[124px] h-[2px] bg-cobalt shadow-[0_0_15px_rgba(17,138,178,0.6)] z-10\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"connection line\">\n                        </div>\n                        <span class=\"font-mono text-[10px] uppercase tracking-widest opacity-60 block mb-3 font-bold\" data-kid=\"1-4-1-2-1-1-2\" data-name=\"root node subtitle\">\n                            Primary Control Core\n                        </span>\n                        <h4 class=\"text-4xl font-black uppercase leading-[0.85] mb-8\" data-kid=\"1-4-1-2-1-1-3\" data-name=\"root node title\">\n                            Collision\n                            <br data-kid=\"1-4-1-2-1-1-3-1\" data-name=\"root title break\"/>\n                            Runtime\n                        </h4>\n                        <div class=\"flex items-center gap-2 font-mono text-[10px] bg-navy/5 p-2 border border-navy/10\" data-kid=\"1-4-1-2-1-1-4\" data-name=\"root status bar\">\n                            <span class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" data-kid=\"1-4-1-2-1-1-4-1\" data-name=\"root status indicator\">\n                            </span>\n                            <span class=\"font-bold\" data-kid=\"1-4-1-2-1-1-4-2\" data-name=\"root status text\">\n                                STATUS: UPLINK_LOCKED\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <!-- Tree Structure Container -->\n                <div class=\"flex-1 relative pl-24 h-[800px]\" data-kid=\"1-4-1-2-2\" data-name=\"tree branch container\">\n                    <!-- Vertical Trunk -->\n                    <div class=\"absolute left-[0px] top-[15%] bottom-[15%] w-[2px] bg-cobalt/40 shadow-[0_0_10px_rgba(17,138,178,0.2)]\" data-kid=\"1-4-1-2-2-1\" data-name=\"vertical trunk line\">\n                    </div>\n                    <div class=\"flex flex-col justify-between h-full py-4\" data-kid=\"1-4-1-2-2-2\" data-name=\"branch columns container\">\n                        <!-- Branch 1: LinkedIn -->\n                        <div class=\"relative flex items-center\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"linkedin branch\">\n                            <div class=\"absolute left-[-100px] w-[100px] h-[2px] bg-cobalt/40\" data-kid=\"1-4-1-2-2-2-1-1\" data-name=\"linkedin connector\">\n                            </div>\n                            <div class=\"w-96 glass p-8 border-l-8 border-butter shadow-xl hover:translate-x-3 transition-transform relative\" data-kid=\"1-4-1-2-2-2-1-2\" data-name=\"linkedin card\">\n                                <div class=\"absolute -top-3 -right-3 w-6 h-6 bg-butter flex items-center justify-center text-navy font-mono text-[8px] font-black\" data-kid=\"1-4-1-2-2-2-1-2-1\" data-name=\"linkedin id badge\">\n                                    01\n                                </div>\n                                <div class=\"flex justify-between items-start mb-6\" data-kid=\"1-4-1-2-2-2-1-2-2\" data-name=\"linkedin header\">\n                                    <span class=\"font-mono text-[10px] text-butter font-bold uppercase tracking-widest\" data-kid=\"1-4-1-2-2-2-1-2-2-1\" data-name=\"linkedin sub-core label\">\n                                        SUB_CORE: NETWORK_GEN\n                                    </span>\n                                    <span class=\"bg-butter text-navy font-mono text-[9px] font-black px-2 py-0.5\" data-kid=\"1-4-1-2-2-2-1-2-2-2\" data-name=\"linkedin status badge\">\n                                        ACTIVE\n                                    </span>\n                                </div>\n                                <h5 class=\"text-2xl font-black mb-2 uppercase tracking-tight\" data-kid=\"1-4-1-2-2-2-1-2-3\" data-name=\"linkedin title\">\n                                    LinkedIn Operator\n                                </h5>\n                                <p class=\"text-white/50 text-xs font-mono uppercase tracking-tighter\" data-kid=\"1-4-1-2-2-2-1-2-4\" data-name=\"linkedin command text\">\n                                    EXEC: [Thought_Leadership_Stream]\n                                </p>\n                            </div>\n                        </div>\n                        <!-- Branch 2: Email -->\n                        <div class=\"relative flex items-center opacity-60\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"email branch\">\n                            <div class=\"absolute left-[-100px] w-[100px] h-[2px] bg-cobalt/30\" data-kid=\"1-4-1-2-2-2-2-1\" data-name=\"email connector\">\n                            </div>\n                            <div class=\"w-96 glass p-8 border-l-8 border-white/20\" data-kid=\"1-4-1-2-2-2-2-2\" data-name=\"email card\">\n                                <div class=\"flex justify-between items-start mb-6\" data-kid=\"1-4-1-2-2-2-2-2-1\" data-name=\"email header\">\n                                    <span class=\"font-mono text-[10px] text-white/30 uppercase tracking-widest\" data-kid=\"1-4-1-2-2-2-2-2-1-1\" data-name=\"email sub-core label\">\n                                        SUB_CORE: OUTREACH\n                                    </span>\n                                    <span class=\"bg-white/10 text-white/50 font-mono text-[9px] font-black px-2 py-0.5\" data-kid=\"1-4-1-2-2-2-2-2-1-2\" data-name=\"email status badge\">\n                                        LATENT\n                                    </span>\n                                </div>\n                                <h5 class=\"text-2xl font-black mb-2 uppercase tracking-tight text-white/40\" data-kid=\"1-4-1-2-2-2-2-2-2\" data-name=\"email card title\">\n                                    Email Engine\n                                </h5>\n                                <p class=\"text-white/30 text-xs font-mono\" data-kid=\"1-4-1-2-2-2-2-2-3\" data-name=\"email card command text\">\n                                    WAITING_FOR_TRIGGER\n                                </p>\n                            </div>\n                        </div>\n                        <!-- Branch 3: Approval -->\n                        <div class=\"relative flex items-center\" data-kid=\"1-4-1-2-2-2-3\" data-name=\"approval branch\">\n                            <div class=\"absolute left-[-100px] w-[100px] h-[2px] bg-coral/50 shadow-[0_0_10px_rgba(239,131,84,0.3)]\" data-kid=\"1-4-1-2-2-2-3-1\" data-name=\"approval connector\">\n                            </div>\n                            <div class=\"w-96 bg-coral/[0.08] border-2 border-dashed border-coral/40 p-8 flex items-center gap-6 shadow-xl\" data-kid=\"1-4-1-2-2-2-3-2\" data-name=\"approval card\">\n                                <div class=\"shrink-0 w-14 h-14 rounded-full bg-coral/20 flex items-center justify-center animate-pulse\" data-kid=\"1-4-1-2-2-2-3-2-1\" data-name=\"approval icon container\">\n                                    <i class=\"ti ti-shield-lock text-coral text-2xl\" data-kid=\"1-4-1-2-2-2-3-2-1-1\" data-name=\"security lock icon\">\n                                    </i>\n                                </div>\n                                <div data-kid=\"1-4-1-2-2-2-3-2-2\" data-name=\"approval content\">\n                                    <h5 class=\"text-xl font-black uppercase text-coral leading-none mb-2\" data-kid=\"1-4-1-2-2-2-3-2-2-1\" data-name=\"approval card title\">\n                                        Security Gate\n                                    </h5>\n                                    <p class=\"text-coral/60 font-mono text-[11px] uppercase leading-tight font-bold\" data-kid=\"1-4-1-2-2-2-3-2-2-2\" data-name=\"approval instruction\">\n                                        MANUAL_APPROVAL_REQ:\n                                        <br data-kid=\"1-4-1-2-2-2-3-2-2-2-1\" data-name=\"approval line break\"/>\n                                        CALENDAR_SYNC_OAUTH\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <!-- Branch 4: YOU -->\n                        <div class=\"relative flex items-center mt-12 pt-12 border-t border-white/10\" data-kid=\"1-4-1-2-2-2-4\" data-name=\"admin branch\">\n                            <div class=\"absolute left-[-100px] w-[100px] h-[2px] bg-cobalt/20\" data-kid=\"1-4-1-2-2-2-4-1\" data-name=\"admin connector\">\n                            </div>\n                            <div class=\"w-96 bg-butter text-navy p-6 flex justify-between items-center shadow-2xl\" data-kid=\"1-4-1-2-2-2-4-2\" data-name=\"admin identity card\">\n                                <h5 class=\"font-black uppercase tracking-widest text-2xl\" data-kid=\"1-4-1-2-2-2-4-2-1\" data-name=\"admin identity title\">\n                                    YOU\n                                </h5>\n                                <div class=\"text-right\" data-kid=\"1-4-1-2-2-2-4-2-2\" data-name=\"admin identity meta\">\n                                    <span class=\"font-mono text-[9px] block font-black uppercase opacity-60 leading-none\" data-kid=\"1-4-1-2-2-2-4-2-2-1\" data-name=\"admin identity label\">\n                                        ROOT_ADMIN_TOKEN\n                                    </span>\n                                    <span class=\"font-mono text-[8px] block opacity-40 leading-none mt-1\" data-kid=\"1-4-1-2-2-2-4-2-2-2\" data-name=\"admin session id\">\n                                        SESSION_ID: 0x9f4a...\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 5: PHILOSOPHY -->\n    <section class=\"py-0 relative z-20 font-sans\" data-kid=\"1-5\" data-name=\"philosophy section\">\n        <div class=\"bg-paper text-navy py-56 px-8 border-y-8 border-butter\" data-kid=\"1-5-1\" data-name=\"intent statement container\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"1-5-1-1\" data-name=\"intent statement wrapper\">\n                <div class=\"mb-12\" data-kid=\"1-5-1-1-1\" data-name=\"intent heading content\">\n                    <h3 class=\"font-mono text-navy/40 uppercase tracking-[0.5em] text-[10px] mb-16 font-bold\" data-kid=\"1-5-1-1-1-1\" data-name=\"protocol subtitle\">\n                        Statement of Intent // Operational Protocol 001\n                    </h3>\n                    <p class=\"text-7xl md:text-[10rem] font-black tracking-tighter uppercase leading-none mb-24 text-navy\" data-kid=\"1-5-1-1-1-2\" data-name=\"intent main headline\">\n                        We don’t build assistants.\n                        <br data-kid=\"1-5-1-1-1-2-1\" data-name=\"intent line break\"/>\n                        <span class=\"text-cobalt italic\" data-kid=\"1-5-1-1-1-2-2\" data-name=\"intent emphasis text\">\n                            We build operators.\n                        </span>\n                    </p>\n                    <div class=\"flex flex-col lg:flex-row gap-24 items-start\" data-kid=\"1-5-1-1-1-3\" data-name=\"intent contrast layout\">\n                        <p class=\"text-4xl md:text-6xl font-bold tracking-tight text-navy/80 max-w-4xl leading-tight\" data-kid=\"1-5-1-1-1-3-1\" data-name=\"contrast description\">\n                            Assistants answer.\n                            <br data-kid=\"1-5-1-1-1-3-1-1\" data-name=\"contrast line break\"/>\n                            Operators execute.\n                        </p>\n                        <div class=\"w-full lg:w-[500px] bg-navy p-12 text-[#EAE2B7] font-mono text-[12px] space-y-8 shadow-[40px_40px_0px_rgba(17,138,178,0.2)] border-l-8 border-butter\" data-kid=\"1-5-1-1-1-3-2\" data-name=\"intent log output card\">\n                            <p class=\"text-butter font-black uppercase tracking-widest bg-white/5 px-3 py-1 inline-block\" data-kid=\"1-5-1-1-1-3-2-1\" data-name=\"log title badge\">\n                                // SYS_LOG: CONTRAST_DUMP\n                            </p>\n                            <div class=\"space-y-3 opacity-40\" data-kid=\"1-5-1-1-1-3-2-2\" data-name=\"log contrast body\">\n                                <p class=\"text-coral font-bold italic\" data-kid=\"1-5-1-1-1-3-2-2-1\" data-name=\"human log entry\">\n                                    HUMAN: \"Find leads and email them.\"\n                                </p>\n                                <p data-kid=\"1-5-1-1-1-3-2-2-2\" data-name=\"assistant log entry\">\n                                    ASSISTANT: \"I've found 5 leads. Would you like me to draft an email for your approval?\"\n                                </p>\n                            </div>\n                            <div class=\"space-y-3 border-t border-white/10 pt-6\" data-kid=\"1-5-1-1-1-3-2-3\" data-name=\"operator log block\">\n                                <p class=\"text-butter font-bold\" data-kid=\"1-5-1-1-1-3-2-3-1\" data-name=\"operator log entry\">\n                                    OPERATOR: \"I've analyzed your ideal customer profile, sourced 250 qualified leads, personalized every outreach with context from their latest 10-K, and initiated the primary sequence. 4 meetings are already tentatively held on your calendar.\"\n                                </p>\n                            </div>\n                            <p class=\"text-butter uppercase font-black tracking-widest border border-butter/30 p-3 inline-block leading-none\" data-kid=\"1-5-1-1-1-3-2-4\" data-name=\"log result badge\">\n                                RESULT: [AUTONOMY_MAXIMIZED]\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 6: RUNTIME ARCHITECTURE -->\n    <section class=\"py-48 bg-[#020814] relative topo-bg\" data-kid=\"1-6\" data-name=\"architecture section\">\n        <div class=\"max-w-4xl mx-auto px-8\" data-kid=\"1-6-1\" data-name=\"architecture container\">\n            <div class=\"text-center mb-24\" data-kid=\"1-6-1-1\" data-name=\"architecture heading group\">\n                <h3 class=\"font-mono text-butter uppercase tracking-[0.3em] text-xs mb-4\" data-kid=\"1-6-1-1-1\" data-name=\"architecture subtitle\">\n                    Deep Sea Descent\n                </h3>\n                <h2 class=\"text-5xl font-bold tracking-tighter\" data-kid=\"1-6-1-1-2\" data-name=\"architecture headline\">\n                    Stack Architecture\n                </h2>\n            </div>\n            <div class=\"space-y-4\" data-kid=\"1-6-1-2\" data-name=\"stack layers container\">\n                <!-- Layer -->\n                <div class=\"group relative bg-[#0A1224] border border-white/5 p-6 hover:border-cobalt transition-colors\" data-kid=\"1-6-1-2-1\" data-name=\"memory layer\">\n                    <div class=\"flex justify-between items-center\" data-kid=\"1-6-1-2-1-1\" data-name=\"memory layer header\">\n                        <div class=\"flex items-center gap-6\" data-kid=\"1-6-1-2-1-1-1\" data-name=\"memory header content\">\n                            <span class=\"font-mono text-cobalt text-sm\" data-kid=\"1-6-1-2-1-1-1-1\" data-name=\"memory layer number\">\n                                01\n                            </span>\n                            <h4 class=\"text-2xl font-bold uppercase tracking-tight\" data-kid=\"1-6-1-2-1-1-1-2\" data-name=\"memory layer title\">\n                                Memory\n                            </h4>\n                        </div>\n                        <div class=\"flex items-center gap-4 font-mono text-[9px] uppercase\" data-kid=\"1-6-1-2-1-1-2\" data-name=\"memory status group\">\n                            <span class=\"text-butter/50\" data-kid=\"1-6-1-2-1-1-2-1\" data-name=\"memory status text\">\n                                Status: Read/Write\n                            </span>\n                            <span class=\"bg-cobalt/20 text-cobalt px-2 py-0.5\" data-kid=\"1-6-1-2-1-1-2-2\" data-n