no text-[10px] font-black uppercase bg-navy/5 px-2 py-0.5\" data-kid=\"1-8-1-2-1-1-1\" data-name=\"operator id label\">\n                            UNIT_ID_001\n                        </span>\n                        <div class=\"w-12 h-12 bg-navy/5 flex items-center justify-center\" data-kid=\"1-8-1-2-1-1-2\" data-name=\"operator icon container\">\n                            <i class=\"ti ti-brand-linkedin text-3xl opacity-30\" data-kid=\"1-8-1-2-1-1-2-1\" data-name=\"operator icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <h5 class=\"font-black uppercase text-5xl mb-2 tracking-tighter leading-none\" data-kid=\"1-8-1-2-1-2\" data-name=\"operator title\">\n                        Personal\n                        <br data-kid=\"1-8-1-2-1-2-1\" data-name=\"operator title line break\"/>\n                        Brand Authority\n                    </h5>\n                    <div class=\"mt-12 flex justify-between items-center\" data-kid=\"1-8-1-2-1-3\" data-name=\"operator card footer\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-8-1-2-1-3-1\" data-name=\"operator activity status\">\n                            <span class=\"w-3 h-3 rounded-full bg-green-600 animate-pulse\" data-kid=\"1-8-1-2-1-3-1-1\" data-name=\"operator activity dot\">\n                            </span>\n                            <span class=\"font-mono text-[11px] font-black uppercase tracking-widest text-green-700\" data-kid=\"1-8-1-2-1-3-1-2\" data-name=\"operator activity text\">\n                                ACTIVE_DEPLOYMENT\n                            </span>\n                        </div>\n                        <span class=\"font-mono text-[10px] opacity-40 font-bold italic\" data-kid=\"1-8-1-2-1-3-2\" data-name=\"operator efficiency text\">\n                            EFFICIENCY: 98%\n                        </span>\n                    </div>\n                </div>\n                <!-- Placeholder Cards - Non Uniform Grid -->\n                <div class=\"bg-[#0A1224] border border-white/5 p-8 relative group hover:border-cobalt transition-all flex flex-col justify-between\" data-kid=\"1-8-1-2-2\" data-name=\"queued sales card\">\n                    <div data-kid=\"1-8-1-2-2-1\" data-name=\"queued sales header\">\n                        <span class=\"font-mono text-[9px] font-black uppercase text-white/20 mb-8 block\" data-kid=\"1-8-1-2-2-1-1\" data-name=\"queued sales label\">\n                            UNIT_ID_002\n                        </span>\n                        <h5 class=\"font-bold uppercase text-2xl mb-1 leading-none text-white/40 italic tracking-tighter\" data-kid=\"1-8-1-2-2-1-2\" data-name=\"queued sales title\">\n                            Sales\n                            <br data-kid=\"1-8-1-2-2-1-2-1\" data-name=\"queued sales title line break\"/>\n                            Operator\n                        </h5>\n                    </div>\n                    <div class=\"flex justify-between items-center opacity-30 group-hover:opacity-100 transition-opacity\" data-kid=\"1-8-1-2-2-2\" data-name=\"queued sales status\">\n                        <span class=\"font-mono text-[10px] uppercase font-bold tracking-widest\" data-kid=\"1-8-1-2-2-2-1\" data-name=\"queued label\">\n                            QUEUED\n                        </span>\n                        <i class=\"ti ti-lock-access text-xl\" data-kid=\"1-8-1-2-2-2-2\" data-name=\"locked icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"bg-[#0A1224] border border-white/5 p-8 relative group hover:border-cobalt transition-all flex flex-col justify-between\" data-kid=\"1-8-1-2-3\" data-name=\"queued support card\">\n                    <div data-kid=\"1-8-1-2-3-1\" data-name=\"queued support header\">\n                        <span class=\"font-mono text-[9px] font-black uppercase text-white/20 mb-8 block\" data-kid=\"1-8-1-2-3-1-1\" data-name=\"queued support label\">\n                            UNIT_ID_003\n                        </span>\n                        <h5 class=\"font-bold uppercase text-2xl mb-1 leading-none text-white/40 italic tracking-tighter\" data-kid=\"1-8-1-2-3-1-2\" data-name=\"queued support title\">\n                            Support\n                            <br data-kid=\"1-8-1-2-3-1-2-1\" data-name=\"queued support title line break\"/>\n                            Operator\n                        </h5>\n                    </div>\n                    <div class=\"flex justify-between items-center opacity-30\" data-kid=\"1-8-1-2-3-2\" data-name=\"queued support status\">\n                        <span class=\"font-mono text-[10px] uppercase font-bold tracking-widest\" data-kid=\"1-8-1-2-3-2-1\" data-name=\"queued label\">\n                            QUEUED\n                        </span>\n                        <i class=\"ti ti-lock-access text-xl\" data-kid=\"1-8-1-2-3-2-2\" data-name=\"locked icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"bg-cobalt text-white p-8 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-white hover:text-navy transition-all border-2 border-dashed border-white/20 group\" data-kid=\"1-8-1-2-4\" data-name=\"deploy new card\">\n                    <div class=\"w-16 h-16 rounded-full border-2 border-white/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform\" data-kid=\"1-8-1-2-4-1\" data-name=\"deploy new icon container\">\n                        <i class=\"ti ti-plus text-4xl\" data-kid=\"1-8-1-2-4-1-1\" data-name=\"plus icon\">\n                        </i>\n                    </div>\n                    <span class=\"font-mono text-[11px] font-black uppercase tracking-[0.2em]\" data-kid=\"1-8-1-2-4-2\" data-name=\"deploy new text\">\n                        Deploy_New_Node\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 9: DEPLOYMENT -->\n    <section class=\"py-48 bg-[#020814] relative border-t border-white/5\" data-kid=\"1-9\" data-name=\"deployment section\" id=\"deploy\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"1-9-1\" data-name=\"deployment container\">\n            <div class=\"flex flex-col md:flex-row justify-between items-start gap-16\" data-kid=\"1-9-1-1\" data-name=\"deployment grid\">\n                <div class=\"md:sticky md:top-32 w-full md:w-1/3\" data-kid=\"1-9-1-1-1\" data-name=\"deployment intro\">\n                    <h3 class=\"font-mono text-butter uppercase tracking-[0.3em] text-xs mb-8\" data-kid=\"1-9-1-1-1-1\" data-name=\"deployment subtitle\">\n                        Mission Protocol\n                    </h3>\n                    <h2 class=\"text-7xl font-bold tracking-tighter leading-none mb-8 uppercase\" data-kid=\"1-9-1-1-1-2\" data-name=\"deployment headline\">\n                        Deploy the Fleets.\n                    </h2>\n                    <p class=\"text-white/50 text-xl max-w-sm mb-12\" data-kid=\"1-9-1-1-1-3\" data-name=\"deployment description\">\n                        The transition from human manual labor to autonomous orchestration happens in four phases.\n                    </p>\n                    <button class=\"bg-butter text-navy font-bold px-10 py-5 rounded-md uppercase text-sm tracking-widest shadow-2xl hover:-translate-y-1 transition-transform\" data-kid=\"1-9-1-1-1-4\" data-name=\"initiation button\">\n                        INITIALIZE_MISSION\n                    </button>\n                </div>\n                <div class=\"flex-1 space-y-12\" data-kid=\"1-9-1-1-2\" data-name=\"deployment phases container\">\n                    <div class=\"flex gap-8 group\" data-kid=\"1-9-1-1-2-1\" data-name=\"phase 01\">\n                        <div class=\"flex flex-col items-center\" data-kid=\"1-9-1-1-2-1-1\" data-name=\"phase 01 number\">\n                            <div class=\"w-12 h-12 rounded-full border border-butter flex items-center justify-center font-mono text-butter text-xl group-hover:bg-butter group-hover:text-navy transition-all\" data-kid=\"1-9-1-1-2-1-1-1\" data-name=\"phase 01 circle\">\n                                01\n                            </div>\n                            <div class=\"w-px flex-1 bg-white/10 mt-4\" data-kid=\"1-9-1-1-2-1-1-2\" data-name=\"phase 01 line\">\n                            </div>\n                        </div>\n                        <div class=\"pb-24\" data-kid=\"1-9-1-1-2-1-2\" data-name=\"phase 01 body\">\n                            <h4 class=\"text-3xl font-bold uppercase tracking-tighter mb-4\" data-kid=\"1-9-1-1-2-1-2-1\" data-name=\"phase 01 title\">\n                                Book Call\n                            </h4>\n                            <p class=\"text-white/50 text-lg leading-relaxed\" data-kid=\"1-9-1-1-2-1-2-2\" data-name=\"phase 01 description\">\n                                Strategic alignment session to map your human objectives to autonomous workflows. We identify high-leverage bottlenecks.\n                            </p>\n                            <div class=\"mt-6 font-mono text-[10px] text-cobalt uppercase\" data-kid=\"1-9-1-1-2-1-2-3\" data-name=\"phase 01 meta\">\n                                Requirement: 30min Sync\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-9-1-1-2-2\" data-name=\"phase 02\">\n                        <div class=\"flex flex-col items-center\" data-kid=\"1-9-1-1-2-2-1\" data-name=\"phase 02 number\">\n                            <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center font-mono text-white/40 text-xl group-hover:border-butter transition-all\" data-kid=\"1-9-1-1-2-2-1-1\" data-name=\"phase 02 circle\">\n                                02\n                            </div>\n                            <div class=\"w-px flex-1 bg-white/10 mt-4\" data-kid=\"1-9-1-1-2-2-1-2\" data-name=\"phase 02 line\">\n                            </div>\n                        </div>\n                        <div class=\"pb-24\" data-kid=\"1-9-1-1-2-2-2\" data-name=\"phase 02 body\">\n                            <h4 class=\"text-3xl font-bold uppercase tracking-tighter mb-4 text-white/40 group-hover:text-white transition-colors\" data-kid=\"1-9-1-1-2-2-2-1\" data-name=\"phase 02 title\">\n                                Understand Workflow\n                            </h4>\n                            <p class=\"text-white/30 text-lg leading-relaxed group-hover:text-white/50 transition-colors\" data-kid=\"1-9-1-1-2-2-2-2\" data-name=\"phase 02 description\">\n                                We shadow your existing manual process, capturing decision-making logic, tone, and tool integration points.\n                            </p>\n                            <div class=\"mt-6 font-mono text-[10px] text-white/10 uppercase\" data-kid=\"1-9-1-1-2-2-2-3\" data-name=\"phase 02 meta\">\n                                Requirement: Workflow Audit\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-9-1-1-2-3\" data-name=\"phase 03\">\n                        <div class=\"flex flex-col items-center\" data-kid=\"1-9-1-1-2-3-1\" data-name=\"phase 03 number\">\n                            <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center font-mono text-white/40 text-xl\" data-kid=\"1-9-1-1-2-3-1-1\" data-name=\"phase 03 circle\">\n                                03\n                            </div>\n                            <div class=\"w-px flex-1 bg-white/10 mt-4\" data-kid=\"1-9-1-1-2-3-1-2\" data-name=\"phase 03 line\">\n                            </div>\n                        </div>\n                        <div class=\"pb-24\" data-kid=\"1-9-1-1-2-3-2\" data-name=\"phase 03 body\">\n                            <h4 class=\"text-3xl font-bold uppercase tracking-tighter mb-4 text-white/40\" data-kid=\"1-9-1-1-2-3-2-1\" data-name=\"phase 03 title\">\n                                Deploy Runtime\n                            </h4>\n                            <p class=\"text-white/30 text-lg leading-relaxed\" data-kid=\"1-9-1-1-2-3-2-2\" data-name=\"phase 03 description\">\n                                Activation of the Collision core within your infrastructure. Secure API connections and vector memory initialization.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-9-1-1-2-4\" data-name=\"phase 04\">\n                        <div class=\"flex flex-col items-center\" data-kid=\"1-9-1-1-2-4-1\" data-name=\"phase 04 number\">\n                            <div class=\"w-12 h-12 rounded-full border border-white/20 flex items-center justify-center font-mono text-white/40 text-xl\" data-kid=\"1-9-1-1-2-4-1-1\" data-name=\"phase 04 circle\">\n                                04\n                            </div>\n                        </div>\n                        <div class=\"pb-12\" data-kid=\"1-9-1-1-2-4-2\" data-name=\"phase 04 body\">\n                            <h4 class=\"text-3xl font-bold uppercase tracking-tighter mb-4 text-white/40\" data-kid=\"1-9-1-1-2-4-2-1\" data-name=\"phase 04 title\">\n                                Train Operator\n                            </h4>\n                            <p class=\"text-white/30 text-lg leading-relaxed\" data-kid=\"1-9-1-1-2-4-2-2\" data-name=\"phase 04 description\">\n                                The fine-tuning phase. The operator learns your style, refines its execution path, and starts handling low-stakes tasks.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-9-1-1-2-5\" data-name=\"phase live\">\n                        <div class=\"flex flex-col items-center\" data-kid=\"1-9-1-1-2-5-1\" data-name=\"phase live badge\">\n                            <div class=\"w-16 h-16 rounded-full bg-butter flex items-center justify-center font-black text-navy text-2xl shadow-[0_0_30px_rgba(255,209,102,0.4)]\" data-kid=\"1-9-1-1-2-5-1-1\" data-name=\"phase live circle\">\n                                GO\n                            </div>\n                        </div>\n                        <div data-kid=\"1-9-1-1-2-5-2\" data-name=\"phase live body\">\n                            <h4 class=\"text-4xl font-black uppercase tracking-tighter mb-4 text-butter\" data-kid=\"1-9-1-1-2-5-2-1\" data-name=\"phase live title\">\n                                Operator Goes Live\n                            </h4>\n                            <p class=\"text-white/70 text-xl leading-relaxed\" data-kid=\"1-9-1-1-2-5-2-2\" data-name=\"phase live description\">\n                                Continuous, autonomous execution. Your workforce is live. You focus on the objective, the operator handles the rest.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 10: DESIGN PARTNERS -->\n    <section class=\"py-56 bg-black relative overflow-hidden font-manrope\" data-kid=\"1-10\" data-name=\"partners section\">\n        <div class=\"max-w-7xl mx-auto px-8 relative z-10\" data-kid=\"1-10-1\" data-name=\"partners container\">\n            <div class=\"border border-white/10 p-20 relative glass\" data-kid=\"1-10-1-1\" data-name=\"partners glass box\">\n                <div class=\"absolute top-0 right-0 p-10 font-mono text-[11px] text-butter/70 text-right uppercase leading-tight font-black\" data-kid=\"1-10-1-1-1\" data-name=\"partner restricted meta\">\n                    SECURITY_STATUS: RESTRICTED\n                    <br data-kid=\"1-10-1-1-1-1\" data-name=\"partner meta line break\"/>\n                    AVAILABLE_SLOTS: 04_LEFT\n                </div>\n                <h3 class=\"font-mono text-butter uppercase tracking-[0.6em] text-[11px] mb-16 font-black border-l-4 border-butter pl-6\" data-kid=\"1-10-1-1-2\" data-name=\"partner protocol title\">\n                    Design Partners Protocol // Phase 01\n                </h3>\n                <h2 class=\"text-7xl font-bold tracking-tighter mb-24 max-w-4xl leading-[0.9] uppercase\" data-kid=\"1-10-1-1-3\" data-name=\"partner main headline\">\n                    Building for the first wave of autonomous organizations.\n                </h2>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-16 gap-x-12 border-t border-white/10 pt-20\" data-kid=\"1-10-1-1-4\" data-name=\"partner features grid\">\n                    <div class=\"flex gap-8 group\" data-kid=\"1-10-1-1-4-1\" data-name=\"partner feature 01\">\n                        <span class=\"font-mono text-cobalt text-3xl font-black opacity-30 group-hover:opacity-100 transition-opacity\" data-kid=\"1-10-1-1-4-1-1\" data-name=\"feature 01 id\">\n                            01\n                        </span>\n                        <div class=\"space-y-4\" data-kid=\"1-10-1-1-4-1-2\" data-name=\"feature 01 body\">\n                            <h5 class=\"font-black uppercase text-2xl tracking-tighter leading-none\" data-kid=\"1-10-1-1-4-1-2-1\" data-name=\"feature 01 title\">\n                                Objective First\n                            </h5>\n                            <p class=\"text-white/40 text-sm leading-relaxed uppercase tracking-tight\" data-kid=\"1-10-1-1-4-1-2-2\" data-name=\"feature 01 description\">\n                                We don't automate tasks. We orchestrate goals. The operator understands the \"Why\", not just the \"How\".\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-10-1-1-4-2\" data-name=\"partner feature 02\">\n                        <span class=\"font-mono text-cobalt text-3xl font-black opacity-30 group-hover:opacity-100 transition-opacity\" data-kid=\"1-10-1-1-4-2-1\" data-name=\"feature 02 id\">\n                            02\n                        </span>\n                        <div class=\"space-y-4\" data-kid=\"1-10-1-1-4-2-2\" data-name=\"feature 02 body\">\n                            <h5 class=\"font-black uppercase text-2xl tracking-tighter leading-none\" data-kid=\"1-10-1-1-4-2-2-1\" data-name=\"feature 02 title\">\n                                Deep Memory\n                            </h5>\n                            <p class=\"text-white/40 text-sm leading-relaxed uppercase tracking-tight\" data-kid=\"1-10-1-1-4-2-2-2\" data-name=\"feature 02 description\">\n                                Every interaction builds context. Permanent vector learning ensures the operator evolves with your company's DNA.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-10-1-1-4-3\" data-name=\"partner feature 03\">\n                        <span class=\"font-mono text-cobalt text-3xl font-black opacity-30 group-hover:opacity-100 transition-opacity\" data-kid=\"1-10-1-1-4-3-1\" data-name=\"feature 03 id\">\n                            03\n                        </span>\n                        <div class=\"space-y-4\" data-kid=\"1-10-1-1-4-3-2\" data-name=\"feature 03 body\">\n                            <h5 class=\"font-black uppercase text-2xl tracking-tighter leading-none\" data-kid=\"1-10-1-1-4-3-2-1\" data-name=\"feature 03 title\">\n                                Safety Core\n                            </h5>\n                            <p class=\"text-white/40 text-sm leading-relaxed uppercase tracking-tight\" data-kid=\"1-10-1-1-4-3-2-2\" data-name=\"feature 03 description\">\n                                Deterministic guardrails for autonomous actions. Multi-layer verification before any high-stakes outbound execution.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group\" data-kid=\"1-10-1-1-4-4\" data-name=\"partner feature 04\">\n                        <span class=\"font-mono text-cobalt text-3xl font-black opacity-30 group-hover:opacity-100 transition-opacity\" data-kid=\"1-10-1-1-4-4-1\" data-name=\"feature 04 id\">\n                            04\n                        </span>\n                        <div class=\"space-y-4\" data-kid=\"1-10-1-1-4-4-2\" data-name=\"feature 04 body\">\n                            <h5 class=\"font-black uppercase text-2xl tracking-tighter leading-none\" data-kid=\"1-10-1-1-4-4-2-1\" data-name=\"feature 04 title\">\n                                Human Gate\n                            </h5>\n                            <p class=\"text-white/40 text-sm leading-relaxed uppercase tracking-tight\" data-kid=\"1-10-1-1-4-4-2-2\" data-name=\"feature 04 description\">\n                                Granular permission system. Some branches are fully autonomous; others require your explicit digital signature to proceed.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex gap-8 group lg:col-span-2\" data-kid=\"1-10-1-1-4-5\" data-name=\"partner feature 05\">\n                        <span class=\"font-mono text-cobalt text-3xl font-black opacity-30 group-hover:opacity-100 transition-opacity\" data-kid=\"1-10-1-1-4-5-1\" data-name=\"feature 05 id\">\n                            05\n                        </span>\n                        <div class=\"space-y-4\" data-kid=\"1-10-1-1-4-5-2\" data-name=\"feature 05 body\">\n                            <h5 class=\"font-black uppercase text-2xl tracking-tighter leading-none\" data-kid=\"1-10-1-1-4-5-2-1\" data-name=\"feature 05 title\">\n                                Budget Limits\n                            </h5>\n                            <p class=\"text-white/40 text-sm leading-relaxed uppercase tracking-tight\" data-kid=\"1-10-1-1-4-5-2-2\" data-name=\"feature 05 description\">\n                                Financial guardrails built into the runtime. Set weekly spend caps for every operator and tool integration. Never over-burn.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 11: MANIFESTO -->\n    <section class=\"min-h-[120vh] bg-[#020814] flex flex-col items-center justify-center relative overflow-hidden px-8 text-center font-sans py-32\" data-kid=\"1-11\" data-name=\"manifesto section\" id=\"manifesto\">\n        <!-- Giant Sonar Ring Background -->\n        <div class=\"absolute inset-0 flex items-center justify-center opacity-10 pointer-events-none\" data-kid=\"1-11-1\" data-name=\"sonar background container\">\n            <div class=\"w-[1200px] h-[1200px] border-[1px] border-cobalt rounded-full flex items-center justify-center sonar-pulse\" data-kid=\"1-11-1-1\" data-name=\"sonar circles container\">\n                <div class=\"w-[1000px] h-[1000px] border-[1px] border-cobalt/50 rounded-full flex items-center justify-center\" data-kid=\"1-11-1-1-1\" data-name=\"sonar ring 01\">\n                    <div class=\"w-[800px] h-[800px] border-[2px] border-butter/30 rounded-full flex items-center justify-center\" data-kid=\"1-11-1-1-1-1\" data-name=\"sonar ring 02\">\n                        <div class=\"w-[600px] h-[600px] border-[1px] border-butter/20 rounded-full opacity-50 flex items-center justify-center\" data-kid=\"1-11-1-1-1-1-1\" data-name=\"sonar ring 03\">\n                            <div class=\"w-[400px] h-[400px] bg-butter/5 rounded-full\" data-kid=\"1-11-1-1-1-1-1-1\" data-name=\"sonar ring 04\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"absolute w-full h-px bg-cobalt/20\" data-kid=\"1-11-1-2\" data-name=\"sonar horizontal line\">\n            </div>\n            <div class=\"absolute h-full w-px bg-cobalt/20\" data-kid=\"1-11-1-3\" data-name=\"sonar vertical line\">\n            </div>\n            <div class=\"absolute top-[20%] left-[20%] font-mono text-[8px] text-butter/30 uppercase tracking-[0.5em]\" data-kid=\"1-11-1-4\" data-name=\"sonar meta top\">\n                Trk_Id: MNF_09\n            </div>\n            <div class=\"absolute bottom-[20%] right-[20%] font-mono text-[8px] text-cobalt/30 uppercase tracking-[0.5em]\" data-kid=\"1-11-1-5\" data-name=\"sonar meta bottom\">\n                Coord: 0.0, 0.0, 0.0\n            </div>\n        </div>\n        <div class=\"relative z-10 max-w-full px-4 space-y-32 pb-48\" data-kid=\"1-11-2\" data-name=\"manifesto content container\">\n            <h3 class=\"font-mono text-butter uppercase tracking-[1em] text-[11px] mb-8 font-black bg-white/5 py-3 px-10 inline-block shadow-2xl border border-white/10 backdrop-blur-md\" data-kid=\"1-11-2-1\" data-name=\"manifesto title badge\">\n                Manifesto // Core Beliefs\n            </h3>\n            <div class=\"space-y-8\" data-kid=\"1-11-2-2\" data-name=\"manifesto beliefs grid\">\n                <p class=\"text-7xl md:text-[11rem] font-black tracking-tight uppercase leading-[0.85]\" data-kid=\"1-11-2-2-1\" data-name=\"belief line 01\">\n                    The internet changed.\n                </p>\n                <p class=\"text-7xl md:text-[11rem] font-black tracking-tight uppercase leading-[0.85] text-[#EAE2B7]/20 italic\" data-kid=\"1-11-2-2-2\" data-name=\"belief line 02\">\n                    Software didn’t.\n                </p>\n                <p class=\"text-7xl md:text-[11rem] font-black tracking-tight uppercase leading-[0.85]\" data-kid=\"1-11-2-2-3\" data-name=\"belief line 03\">\n                    Until now.\n                </p>\n            </div>\n            <div class=\"py-32 border-y-4 border-cobalt/30 relative\" data-kid=\"1-11-2-3\" data-name=\"manifesto critical insight\">\n                <div class=\"absolute -top-6 left-1/2 -translate-x-1/2 bg-butter text-navy font-mono text-[12px] px-8 py-2 font-black tracking-[0.3em]\" data-kid=\"1-11-2-3-1\" data-name=\"insight badge\">\n                    CRITICAL_INSIGHT\n                </div>\n                <p class=\"text-7xl md:text-[11rem] font-black tracking-tight uppercase leading-[0.85] text-butter\" data-kid=\"1-11-2-3-2\" data-name=\"insight content\">\n                    The next generation\n                    <br data-kid=\"1-11-2-3-2-1\" data-name=\"insight line break 01\"/>\n                    won’t click.\n                    <br data-kid=\"1-11-2-3-2-2\" data-name=\"insight line break 02\"/>\n                    <span class=\"text-white italic underline decoration-cobalt underline-offset-20\" data-kid=\"1-11-2-3-2-3\" data-name=\"insight emphasis\">\n                        It will act.\n                    </span>\n                </p>\n            </div>\n            <div class=\"pt-20\" data-kid=\"1-11-2-4\" data-name=\"manifesto mission conclusion\">\n                <p class=\"text-8xl md:text-[15rem] font-black tracking-tight uppercase leading-[0.7] text-cobalt/30\" data-kid=\"1-11-2-4-1\" data-name=\"mission conclusion text\">\n                    Collision is building\n                    <br data-kid=\"1-11-2-4-1-1\" data-name=\"mission conclusion line break\"/>\n                    AI operators.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- SECTION 12: FINAL CTA / FOOTER -->\n    <footer class=\"bg-black py-48 border-t-2 border-cobalt/20 relative overflow-hidden\" data-kid=\"1-12\" data-name=\"footer bar\">\n        <!-- Decoration: Edge Coordinates -->\n        <div class=\"absolute top-0 left-0 p-4 font-mono text-[8px] text-white/10 uppercase tracking-widest\" data-kid=\"1-12-1\" data-name=\"footer corner coord 01\">\n            Border_Coord: 77.01.22\n        </div>\n        <div class=\"absolute top-0 right-0 p-4 font-mono text-[8px] text-white/10 uppercase tracking-widest\" data-kid=\"1-12-2\" data-name=\"footer corner coord 02\">\n            System_Exit_Node: 0x99\n        </div>\n        <div class=\"max-w-7xl mx-auto px-8 relative z-10\" data-kid=\"1-12-3\" data-name=\"footer content container\">\n            <div class=\"flex flex-col md:flex-row justify-between items-end gap-24\" data-kid=\"1-12-3-1\" data-name=\"footer layout container\">\n                <div class=\"space-y-12\" data-kid=\"1-12-3-1-1\" data-name=\"footer left column\">\n                    <h2 class=\"text-6xl font-black tracking-tighter uppercase leading-none max-w-xl\" data-kid=\"1-12-3-1-1-1\" data-name=\"footer call to action\">\n                        Ready to deploy your first operator?\n                    </h2>\n                    <div class=\"flex flex-col gap-6\" data-kid=\"1-12-3-1-1-2\" data-name=\"footer action container\">\n                        <button class=\"w-full md:w-auto bg-butter text-navy font-black px-12 py-6 rounded-none uppercase text-xl tracking-widest hover:bg-white transition-all shadow-[0_0_50px_rgba(255,209,102,0.2)]\" data-kid=\"1-12-3-1-1-2-1\" data-name=\"footer deploy button\">\n                            > DEPLOY_FIRST_OPERATOR\n                        </button>\n                        <div class=\"flex items-center gap-3 font-mono text-[10px] text-white/40 uppercase\" data-kid=\"1-12-3-1-1-2-2\" data-name=\"footer status\">\n                            <span class=\"w-2 h-2 rounded-full bg-butter animate-pulse\" data-kid=\"1-12-3-1-1-2-2-1\" data-name=\"footer status indicator\">\n                            </span>\n                            Currently onboarding a small number of design partners.\n                        </div>\n                    </div>\n                </div>\n                <div class=\"w-full md:w-1/3 space-y-8 text-right font-mono text-[10px] uppercase tracking-widest\" data-kid=\"1-12-3-1-2\" data-name=\"footer right column\">\n                    <div class=\"grid grid-cols-2 gap-8 border-t border-white/10 pt-8\" data-kid=\"1-12-3-1-2-1\" data-name=\"footer menu grid\">\n                        <div class=\"space-y-4\" data-kid=\"1-12-3-1-2-1-1\" data-name=\"footer nav column 01\">\n                            <h6 class=\"text-white font-bold\" data-kid=\"1-12-3-1-2-1-1-1\" data-name=\"footer nav title 01\">\n                                Navigation\n                            </h6>\n                            <ul class=\"space-y-2 text-white/30\" data-kid=\"1-12-3-1-2-1-1-2\" data-name=\"footer nav link list 01\">\n                                <li data-kid=\"1-12-3-1-2-1-1-2-1\" data-name=\"nav link 01\">\n                                    <a class=\"hover:text-butter transition-colors\" data-kid=\"1-12-3-1-2-1-1-2-1-1\" data-name=\"nav link 01 text\" href=\"#\">\n                                        Runtime\n                                    </a>\n                                </li>\n                                <li data-kid=\"1-12-3-1-2-1-1-2-2\" data-name=\"nav link 02\">\n                                    <a class=\"hover:text-butter transition-colors\" data-kid=\"1-12-3-1-2-1-1-2-2-1\" data-name=\"nav link 02 text\" href=\"#\">\n                                        Architecture\n                                    </a>\n                                </li>\n                                <li data-kid=\"1-12-3-1-2-1-1-2-3\" data-name=\"nav link 03\">\n                                    <a class=\"hover:text-butter transition-colors\" data-kid=\"1-12-3-1-2-1-1-2-3-1\" data-name=\"nav link 03 text\" href=\"#\">\n                                        Dossier\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-12-3-1-2-1-2\" data-name=\"footer nav column 02\">\n                            <h6 class=\"text-white font-bold\" data-kid=\"1-12-3-1-2-1-2-1\" data-name=\"footer nav title 02\">\n                                Access\n                            </h6>\n                            <ul class=\"space-y-2 text-white/30\" data-kid=\"1-12-3-1-2-1-2-2\" data-name=\"footer nav link list 02\">\n                                <li data-kid=\"1-12-3-1-2-1-2-2-1\" data-name=\"nav link 04\">\n                                    <a class=\"hover:text-butter transition-colors\" data-kid=\"1-12-3-1-2-1-2-2-1-1\" data-name=\"nav link 04 text\" href=\"#\">\n                                        Terminal\n                                    </a>\n                                </li>\n                                <li data-kid=\"1-12-3-1-2-1-2-2-2\" data-name=\"nav link 05\">\n                                    <a class=\"hover:text-butter transition-colors\" data-kid=\"1-12-3-1-2-1-2-2-2-1\" data-name=\"nav link 05 text\" href=\"#\">\n                                        Documentation\n                                    </a>\n                                </li>\n                                <li data-kid=\"1-12-3-1-2-1-2-2-3\" data-name=\"nav link 06\">\n                                    <a class=\"hover:text-butter transition-colors\" data-kid=\"1-12-3-1-2-1-2-2-3-1\" data-name=\"nav link 06 text\" href=\"#\">\n                                        Partners\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"mt-12 text-white/20\" data-kid=\"1-12-3-1-2-2\" data-name=\"footer copy info\">\n                        <p data-kid=\"1-12-3-1-2-2-1\" data-name=\"footer copyright\">\n                            © 2026 COLLISION RUNTIME SYSTEMS.\n                        </p>\n                        <p data-kid=\"1-12-3-1-2-2-2\" data-name=\"footer system unit\">\n                            DEEP_SEA_COMMAND_UNIT_4.0.2\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Radar Sweep Decoration -->\n        <div class=\"absolute bottom-0 left-0 w-64 h-64 opacity-5 pointer-events-none grayscale brightness-200\" data-kid=\"1-12-4\" data-name=\"footer radar sweep icon\">\n            <img alt=\"radar\" class=\"w-full h-full\" data-kid=\"1-12-4-1\" data-name=\"footer radar sweep image\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/radar-sweep.svg\"/>\n        </div>\n    </footer>\n</div>\n<link data-kid=\"2\" data-name=\"icon stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n",
