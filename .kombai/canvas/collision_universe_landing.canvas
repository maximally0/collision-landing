    "var_d60cff287751": {
      "type": "variant",
      "label": "Collision — Event Horizon",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 9801
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n\n  :root {\n    --collision-ivory: #eef0f4;\n    --collision-slate: #dfe3ea;\n    --collision-ink: #111317;\n    --collision-muted: #6f7784;\n    --collision-line: rgba(17, 19, 23, 0.16);\n    --collision-blue: #5875c6;\n    --collision-night: #0b0e14;\n    --collision-night-muted: #8b93a2;\n    --collision-white: #f4f5f7;\n    --collision-sans: 'Manrope', sans-serif;\n    --collision-mono: 'JetBrains Mono', monospace;\n  }\n\n  .collision-shell {\n    color: var(--collision-ink);\n    background: var(--collision-ivory);\n    font-family: var(--collision-sans);\n    overflow-x: clip;\n  }\n\n  .collision-shell a,\n  .collision-shell button {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .collision-mono {\n    font-family: var(--collision-mono);\n  }\n\n  .collision-rail {\n    position: fixed;\n    top: 50%;\n    left: 28px;\n    z-index: 30;\n    width: 1px;\n    height: 136px;\n    transform: translateY(-50%);\n    background: var(--collision-line);\n  }\n\n  .collision-rail::before,\n  .collision-rail::after {\n    position: absolute;\n    left: -2px;\n    width: 5px;\n    height: 5px;\n    content: '';\n    border-radius: 999px;\n    background: var(--collision-blue);\n  }\n\n  .collision-rail::before { top: 0; }\n  .collision-rail::after { bottom: 0; opacity: .35; }\n\n  .collision-orb {\n    width: 11px;\n    height: 11px;\n    border: 1px solid rgba(88, 117, 198, .5);\n    border-radius: 999px;\n    background: var(--collision-blue);\n    box-shadow: 0 0 0 7px rgba(88, 117, 198, .09);\n  }\n\n  .collision-eclipse {\n    position: relative;\n    width: min(39vw, 510px);\n    aspect-ratio: 1;\n  }\n\n  .collision-eclipse::after {\n    position: absolute;\n    inset: 22%;\n    content: '';\n    border: 1px solid rgba(88, 117, 198, .36);\n    border-radius: 999px;\n  }\n\n  .collision-section-rule {\n    border-top: 1px solid var(--collision-line);\n  }\n\n  .collision-node {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 76px;\n    height: 76px;\n    border: 1px solid var(--collision-line);\n    border-radius: 999px;\n    background: rgba(255, 255, 255, .28);\n    color: var(--collision-muted);\n    font-family: var(--collision-mono);\n    font-size: 10px;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n  }\n\n  .collision-node-active {\n    border-color: var(--collision-blue);\n    background: rgba(88, 117, 198, .08);\n    color: var(--collision-ink);\n  }\n\n  .collision-dark {\n    color: var(--collision-white);\n    background: var(--collision-night);\n  }\n\n  .collision-dark .collision-section-rule {\n    border-color: rgba(244, 245, 247, .16);\n  }\n\n  .collision-dark .collision-muted {\n    color: var(--collision-night-muted);\n  }\n\n  .collision-dark .collision-rail {\n    background: rgba(244, 245, 247, .18);\n  }\n\n  .collision-dark .collision-rail::after {\n    background: var(--collision-white);\n    opacity: .5;\n  }\n\n  @media (max-width: 760px) {\n    .collision-rail { left: 14px; }\n    .collision-eclipse { width: min(78vw, 420px); }\n  }\n</style>\n<div class=\"collision-shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <div aria-hidden=\"true\" class=\"collision-rail\" data-kid=\"1-1\" data-name=\"page progress rail\">\n    </div>\n    <section class=\"relative flex min-h-[100dvh] items-center overflow-hidden px-8 py-10 md:px-20 lg:px-28\" data-kid=\"1-2\" data-name=\"hero section\" id=\"hero\">\n        <div class=\"absolute left-8 right-8 top-8 flex items-center justify-between md:left-20 md:right-20 lg:left-28 lg:right-28\" data-kid=\"1-2-1\" data-name=\"hero navigation bar\">\n            <span class=\"collision-mono text-[10px] uppercase tracking-[0.42em] text-[#111317]/70\" data-kid=\"1-2-1-1\" data-name=\"wordmark text\">\n                Collision\n            </span>\n            <span class=\"collision-mono text-[9px] uppercase tracking-[0.3em] text-[#111317]/45\" data-kid=\"1-2-1-2\" data-name=\"runtime version indicator\">\n                Runtime / 001\n            </span>\n        </div>\n        <div class=\"mx-auto grid w-full max-w-[1220px] items-center gap-16 pt-12 lg:grid-cols-[1.05fr_.95fr] lg:gap-12\" data-kid=\"1-2-2\" data-name=\"hero layout grid\">\n            <div class=\"max-w-[760px]\" data-kid=\"1-2-2-1\" data-name=\"hero content container\">\n                <p class=\"collision-mono mb-9 text-[10px] uppercase tracking-[0.34em] text-[#111317]/45\" data-kid=\"1-2-2-1-1\" data-name=\"subheadline text\">\n                    A new kind of software\n                </p>\n                <h1 class=\"max-w-[850px] text-[clamp(3.8rem,8vw,8.6rem)] font-light leading-[.92] tracking-[-.075em] text-[#111317]\" data-kid=\"1-2-2-1-2\" data-name=\"hero headline\">\n                    AI operators for\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"headline line break\"/>\n                    <em class=\"font-light text-[#111317]/48\" data-kid=\"1-2-2-1-2-2\" data-name=\"italic emphasis text\">\n                        ambitious people.\n                    </em>\n                </h1>\n                <p class=\"mt-12 max-w-[500px] text-[17px] font-light leading-[1.7] text-[#111317]/62] md:text-[19px]\" data-kid=\"1-2-2-1-3\" data-name=\"hero description text\">\n                    Every ambitious person will eventually have AI operators working on their behalf. We're building them.\n                </p>\n                <div class=\"mt-12 flex flex-wrap items-center gap-x-9 gap-y-4\" data-kid=\"1-2-2-1-4\" data-name=\"hero call-to-action container\">\n                    <a class=\"collision-mono border-b border-[#111317]/70 pb-2 text-[10px] font-medium uppercase tracking-[0.28em] text-[#111317]\" data-kid=\"1-2-2-1-4-1\" data-name=\"deploy collision button\" href=\"#operator\">\n                        Deploy Collision\n                    </a>\n                    <a class=\"collision-mono border-b border-transparent pb-2 text-[10px] font-medium uppercase tracking-[0.28em] text-[#111317]/45\" data-kid=\"1-2-2-1-4-2\" data-name=\"read vision button\" href=\"#manifesto\">\n                        Read Vision\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative flex min-h-[360px] items-center justify-center lg:min-h-[500px]\" data-kid=\"1-2-2-2\" data-name=\"hero visualizer container\">\n                <div aria-label=\"A quiet eclipse diagram representing the Collision Runtime\" class=\"collision-eclipse\" data-kid=\"1-2-2-2-1\" data-name=\"eclipse diagram graphic\">\n                    <svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"1-2-2-2-1-1\" data-name=\"eclipse diagram svg\" fill=\"none\" viewbox=\"0 0 500 500\">\n                        <circle cx=\"250\" cy=\"250\" r=\"228\" stroke=\"#111317\" stroke-opacity=\".10\" stroke-width=\"1\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"250\" r=\"176\" stroke=\"#111317\" stroke-opacity=\".13\" stroke-width=\"1\">\n                        </circle>\n                        <ellipse cx=\"250\" cy=\"250\" rx=\"231\" ry=\"102\" stroke=\"#5875c6\" stroke-opacity=\".24\" stroke-width=\"1\">\n                        </ellipse>\n                        <ellipse cx=\"250\" cy=\"250\" rx=\"231\" ry=\"102\" stroke=\"#111317\" stroke-opacity=\".10\" stroke-width=\"1\" transform=\"rotate(60 250 250)\">\n                        </ellipse>\n                        <ellipse cx=\"250\" cy=\"250\" rx=\"231\" ry=\"102\" stroke=\"#111317\" stroke-opacity=\".10\" stroke-width=\"1\" transform=\"rotate(-60 250 250)\">\n                        </ellipse>\n                        <circle cx=\"250\" cy=\"250\" fill=\"#111317\" r=\"89\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"250\" r=\"100\" stroke=\"#5875c6\" stroke-opacity=\".34\" stroke-width=\"1\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"250\" fill=\"#5875c6\" r=\"5\">\n                        </circle>\n                        <circle cx=\"93\" cy=\"176\" fill=\"#111317\" fill-opacity=\".38\" r=\"3\">\n                        </circle>\n                        <circle cx=\"407\" cy=\"326\" fill=\"#111317\" fill-opacity=\".38\" r=\"3\">\n                        </circle>\n                        <path d=\"M73 250H427\" stroke=\"#111317\" stroke-dasharray=\"2 10\" stroke-opacity=\".08\" stroke-width=\"1\">\n                        </path>\n                        <path d=\"M250 73V427\" stroke=\"#111317\" stroke-dasharray=\"2 10\" stroke-opacity=\".08\" stroke-width=\"1\">\n                        </path>\n                    </svg>\n                    <div class=\"absolute left-[8%] top-[10%] collision-mono text-[8px] uppercase tracking-[0.22em] text-[#111317]/34\" data-kid=\"1-2-2-2-1-2\" data-name=\"diagram label text\">\n                        RA 12h 45m\n                    </div>\n                    <div class=\"absolute bottom-[11%] right-[6%] collision-mono text-[8px] uppercase tracking-[0.22em] text-[#111317]/34\" data-kid=\"1-2-2-2-1-3\" data-name=\"diagram label text\">\n                        Signal / 01\n                    </div>\n                    <div class=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2\" data-kid=\"1-2-2-2-1-4\" data-name=\"center orb container\">\n                        <div class=\"collision-orb\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"pulsing center orb\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"absolute bottom-8 left-8 flex items-center gap-3 md:left-20 lg:left-28\" data-kid=\"1-2-3\" data-name=\"runtime status container\">\n            <div class=\"collision-orb !h-2 !w-2 !border-0 !shadow-none\" data-kid=\"1-2-3-1\" data-name=\"connection dot\">\n            </div>\n            <span class=\"collision-mono text-[9px] uppercase tracking-[0.24em] text-[#111317]/45\" data-kid=\"1-2-3-2\" data-name=\"runtime status text\">\n                Runtime signal / online\n            </span>\n        </div>\n    </section>\n    <section class=\"collision-section-rule flex min-h-[78dvh] items-center px-8 py-28 md:px-20 lg:px-28\" data-kid=\"1-3\" data-name=\"shift section\" id=\"shift\">\n        <div class=\"mx-auto w-full max-w-[1220px]\" data-kid=\"1-3-1\" data-name=\"shift content container\">\n            <div class=\"mb-20 flex items-center gap-5\" data-kid=\"1-3-1-1\" data-name=\"shift title container\">\n                <span class=\"collision-mono text-[9px] uppercase tracking-[0.34em] text-[#111317]/45\" data-kid=\"1-3-1-1-1\" data-name=\"section index label\">\n                    01 / The shift\n                </span>\n                <div class=\"h-px flex-1 bg-[#111317]/12\" data-kid=\"1-3-1-1-2\" data-name=\"connector line\">\n                </div>\n            </div>\n            <div class=\"grid gap-12 md:grid-cols-2 md:gap-24\" data-kid=\"1-3-1-2\" data-name=\"title grid container\">\n                <div data-kid=\"1-3-1-2-1\" data-name=\"old model container\">\n                    <p class=\"collision-mono mb-8 text-[9px] uppercase tracking-[0.28em] text-[#111317]/35\" data-kid=\"1-3-1-2-1-1\" data-name=\"model label\">\n                        Old model\n                    </p>\n                    <h2 class=\"text-[clamp(3.3rem,6.8vw,7.2rem)] font-light leading-[.9] tracking-[-.07em] text-[#111317]/28\" data-kid=\"1-3-1-2-1-2\" data-name=\"old model headline\">\n                        Software\n                        <br data-kid=\"1-3-1-2-1-2-1\" data-name=\"headline line break\"/>\n                        waits.\n                    </h2>\n                </div>\n                <div class=\"md:pt-24\" data-kid=\"1-3-1-2-2\" data-name=\"new model container\">\n                    <p class=\"collision-mono mb-8 text-[9px] uppercase tracking-[0.28em] text-[#5875c6]\" data-kid=\"1-3-1-2-2-1\" data-name=\"model label\">\n                        New model\n                    </p>\n                    <h2 class=\"text-[clamp(3.3rem,6.8vw,7.2rem)] font-light leading-[.9] tracking-[-.07em] text-[#111317]\" data-kid=\"1-3-1-2-2-2\" data-name=\"new model headline\">\n                        Operators\n                        <br data-kid=\"1-3-1-2-2-2-1\" data-name=\"headline line break\"/>\n                        work.\n                    </h2>\n                </div>\n            </div>\n            <div class=\"mt-20 flex items-center gap-4\" data-kid=\"1-3-1-3\" data-name=\"shift description container\">\n                <div class=\"h-px w-16 bg-[#5875c6]\" data-kid=\"1-3-1-3-1\" data-name=\"decorative line\">\n                </div>\n                <p class=\"max-w-[520px] text-[17px] font-light leading-[1.7] text-[#111317]/58\" data-kid=\"1-3-1-3-2\" data-name=\"description text\">\n                    The next generation of software won't wait for instructions.\n                    <em class=\"text-[#111317]\" data-kid=\"1-3-1-3-2-1\" data-name=\"italic emphasis text\">\n                        It will execute.\n                    </em>\n                </p>\n            </div>\n        </div>\n    </section>\n    <section class=\"bg-[#dfe3ea] px-8 py-28 md:px-20 lg:px-28\" data-kid=\"1-4\" data-name=\"problem timeline section\" id=\"runtime\">\n        <div class=\"mx-auto grid w-full max-w-[1220px] gap-24 lg:grid-cols-[.8fr_1.2fr] lg:items-center\" data-kid=\"1-4-1\" data-name=\"problem timeline grid\">\n            <div data-kid=\"1-4-1-1\" data-name=\"problem explanation container\">\n                <div class=\"mb-16 flex items-center gap-5\" data-kid=\"1-4-1-1-1\" data-name=\"section index label\">\n                    <span class=\"collision-mono text-[9px] uppercase tracking-[0.34em] text-[#111317]/45\" data-kid=\"1-4-1-1-1-1\" data-name=\"index label text\">\n                        02 / The loop\n                    </span>\n                    <div class=\"h-px flex-1 bg-[#111317]/12\" data-kid=\"1-4-1-1-1-2\" data-name=\"connector line\">\n                    </div>\n                </div>\n                <h2 class=\"max-w-[460px] text-[clamp(2.8rem,5vw,5.7rem)] font-light leading-[.94] tracking-[-.07em]\" data-kid=\"1-4-1-1-2\" data-name=\"problem headline\">\n                    Operating instead of building.\n                </h2>\n                <p class=\"mt-9 max-w-[420px] text-[16px] font-light leading-[1.7] text-[#111317]/58\" data-kid=\"1-4-1-1-3\" data-name=\"problem description\">\n                    The work repeats across every platform. One task becomes eight tabs, eight decisions, and a day spent keeping the system moving.\n                </p>\n                <p class=\"mt-14 max-w-[300px] text-[19px] font-light italic leading-[1.45] text-[#111317]/72\" data-kid=\"1-4-1-1-4\" data-name=\"problem statement paragraph\">\n                    Ambitious people spend their time operating instead of building.\n                </p>\n            </div>\n            <div class=\"relative mx-auto w-full max-w-[600px] py-8\" data-kid=\"1-4-1-2\" data-name=\"timeline item container\">\n                <div class=\"absolute bottom-8 left-[38px] top-8 w-px bg-[#111317]/16\" data-kid=\"1-4-1-2-1\" data-name=\"dashed timeline track\">\n                </div>\n                <div class=\"space-y-8\" data-kid=\"1-4-1-2-2\" data-name=\"timeline list container\">\n                    <div class=\"relative flex items-center gap-7\" data-kid=\"1-4-1-2-2-1\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-3 w-3 rounded-full border border-[#111317]/50 bg-[#dfe3ea]\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[11px] uppercase tracking-[0.24em] text-[#111317]\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"timeline label text\">\n                            You\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-9\" data-kid=\"1-4-1-2-2-2\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-2 w-2 rounded-full bg-[#111317]/22\" data-kid=\"1-4-1-2-2-2-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[10px] uppercase tracking-[0.24em] text-[#111317]/52\" data-kid=\"1-4-1-2-2-2-2\" data-name=\"timeline label text\">\n                            Write\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-20\" data-kid=\"1-4-1-2-2-3\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-2 w-2 rounded-full bg-[#111317]/22\" data-kid=\"1-4-1-2-2-3-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[10px] uppercase tracking-[0.24em] text-[#111317]/52\" data-kid=\"1-4-1-2-2-3-2\" data-name=\"timeline label text\">\n                            Post\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-9\" data-kid=\"1-4-1-2-2-4\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-2 w-2 rounded-full bg-[#111317]/22\" data-kid=\"1-4-1-2-2-4-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[10px] uppercase tracking-[0.24em] text-[#111317]/52\" data-kid=\"1-4-1-2-2-4-2\" data-name=\"timeline label text\">\n                            Reply\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-20\" data-kid=\"1-4-1-2-2-5\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-2 w-2 rounded-full bg-[#111317]/22\" data-kid=\"1-4-1-2-2-5-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[10px] uppercase tracking-[0.24em] text-[#111317]/52\" data-kid=\"1-4-1-2-2-5-2\" data-name=\"timeline label text\">\n                            DM\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-9\" data-kid=\"1-4-1-2-2-6\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-2 w-2 rounded-full bg-[#111317]/22\" data-kid=\"1-4-1-2-2-6-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[10px] uppercase tracking-[0.24em] text-[#111317]/52\" data-kid=\"1-4-1-2-2-6-2\" data-name=\"timeline label text\">\n                            Email\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-20\" data-kid=\"1-4-1-2-2-7\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-2 w-2 rounded-full bg-[#111317]/22\" data-kid=\"1-4-1-2-2-7-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[10px] uppercase tracking-[0.24em] text-[#111317]/52\" data-kid=\"1-4-1-2-2-7-2\" data-name=\"timeline label text\">\n                            Meetings\n                        </span>\n                    </div>\n                    <div class=\"relative flex items-center gap-7 pl-9\" data-kid=\"1-4-1-2-2-8\" data-name=\"timeline item\">\n                        <div class=\"relative z-10 h-3 w-3 rounded-full border border-[#5875c6] bg-[#dfe3ea]\" data-kid=\"1-4-1-2-2-8-1\" data-name=\"timeline marker circle\">\n                        </div>\n                        <span class=\"collision-mono text-[11px] uppercase tracking-[0.24em] text-[#5875c6]\" data-kid=\"1-4-1-2-2-8-2\" data-name=\"timeline label text\">\n                            Repeat\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-auto mt-32 w-full max-w-[1220px] border-t border-[#111317]/14 pt-28\" data-kid=\"1-4-2\" data-name=\"runtime diagram section\" id=\"runtime-diagram\">\n            <div class=\"grid gap-16 lg:grid-cols-[.7fr_1.3fr] lg:items-center\" data-kid=\"1-4-2-1\" data-name=\"diagram grid container\">\n                <div data-kid=\"1-4-2-1-1\" data-name=\"diagram explanation container\">\n                    <span class=\"collision-mono text-[9px] uppercase tracking-[0.34em] text-[#5875c6]\" data-kid=\"1-4-2-1-1-1\" data-name=\"section index label\">\n                        03 / The runtime\n                    </span>\n                    <h2 class=\"mt-8 text-[clamp(2.8rem,5vw,5.7rem)] font-light leading-[.94] tracking-[-.07em]\" data-kid=\"1-4-2-1-1-2\" data-name=\"runtime headline\">\n                        One intelligence.\n                        <br data-kid=\"1-4-2-1-1-2-1\" data-name=\"headline line break\"/>\n                        Many surfaces.\n                    </h2>\n                    <p class=\"mt-9 max-w-[420px] text-[16px] font-light leading-[1.7] text-[#111317]/58\" data-kid=\"1-4-2-1-1-3\" data-name=\"runtime description text\">\n                        Collision sits between your goals and the platforms where they happen. No prompts. No waiting. Just a runtime that keeps moving.\n                    </p>\n                </div>\n                <div class=\"relative mx-auto flex aspect-square w-full max-w-[520px] items-center justify-center\" data-kid=\"1-4-2-1-2\" data-name=\"runtime 