      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  .signal-grid {\n    background-image: linear-gradient(rgba(255,255,255,.026) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px);\n    background-size: 72px 72px;\n    mask-image: linear-gradient(to bottom, rgba(0,0,0,.9), transparent 92%);\n  }\n  .signal-dots {\n    background-image: radial-gradient(circle, rgba(54,226,255,.48) 1px, transparent 1.4px);\n    background-size: 22px 22px;\n    mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);\n  }\n  .focus-brand:focus-visible { outline: 3px solid #36e2ff; outline-offset: 5px; }\n  .stage-card { box-shadow: 0 18px 55px rgba(0,0,0,.26), inset 0 1px 0 rgba(255,255,255,.055); }\n  .surface-shadow { box-shadow: 0 36px 100px rgba(0,0,0,.52), 0 0 90px rgba(37,99,255,.085); }\n  .active-line { background: linear-gradient(90deg, #36e2ff 0%, #2563ff 52%, rgba(54,226,255,.22) 100%); box-shadow: 0 0 18px rgba(54,226,255,.42); }\n</style>\n<main class=\"relative min-h-[900px] overflow-hidden bg-[#05060a] font-['Space_Grotesk'] text-white\" data-kid=\"1\" data-name=\"main landing page layout\">\n    <div class=\"pointer-events-none absolute inset-0 signal-grid opacity-70\" data-kid=\"1-1\" data-name=\"background signal grid pattern\">\n    </div>\n    <div class=\"pointer-events-none absolute inset-0 signal-dots opacity-25\" data-kid=\"1-2\" data-name=\"background signal dots pattern\">\n    </div>\n    <div class=\"pointer-events-none absolute -left-40 top-20 h-[540px] w-[540px] rounded-full bg-[#2563ff]/[0.055] blur-[110px]\" data-kid=\"1-3\" data-name=\"left glowing decorative blur\">\n    </div>\n    <div class=\"pointer-events-none absolute right-[-120px] top-[260px] h-[460px] w-[460px] rounded-full bg-[#36e2ff]/[0.045] blur-[120px]\" data-kid=\"1-4\" data-name=\"right glowing decorative blur\">\n    </div>\n    <div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-white/[0.07]\" data-kid=\"1-5\" data-name=\"top border separator line\">\n    </div>\n    <nav aria-label=\"Primary navigation\" class=\"relative z-20 mx-auto mt-6 flex h-[64px] w-[calc(100%-96px)] max-w-[1312px] items-center justify-between rounded-full border border-white/[0.14] bg-[#080a10]/90 px-3 pl-4 shadow-[0_18px_70px_rgba(0,0,0,.34)] backdrop-blur-xl\" data-kid=\"1-6\" data-name=\"main navigation bar\">\n        <a aria-label=\"Collision home\" class=\"focus-brand flex items-center gap-3 rounded-full\" data-kid=\"1-6-1\" data-name=\"home link\" href=\"#signal-room\">\n            <span class=\"relative grid h-9 w-9 place-items-center overflow-hidden rounded-full bg-[#2563ff] shadow-[0_0_26px_rgba(37,99,255,.42)]\" data-kid=\"1-6-1-1\" data-name=\"logo icon container\">\n                <span class=\"h-4 w-4 rounded-full bg-[#e9e5ff]\" data-kid=\"1-6-1-1-1\" data-name=\"large logo circle\">\n                </span>\n                <span class=\"absolute h-1.5 w-1.5 rounded-full bg-[#36e2ff] shadow-[0_0_12px_#36e2ff]\" data-kid=\"1-6-1-1-2\" data-name=\"small glowing logo circle\">\n                </span>\n            </span>\n            <span class=\"text-[15px] font-bold tracking-[-0.055em]\" data-kid=\"1-6-1-2\" data-name=\"brand name text\">\n                COLLISION\n            </span>\n        </a>\n        <div class=\"hidden items-center gap-3 font-['JetBrains_Mono'] text-[10px] font-medium uppercase tracking-[0.28em] text-white/45 md:flex\" data-kid=\"1-6-2\" data-name=\"live status indicator\">\n            <span class=\"h-2 w-2 rounded-full bg-[#c6ff5c] shadow-[0_0_14px_rgba(198,255,92,.85)]\" data-kid=\"1-6-2-1\" data-name=\"live pulse dot\">\n            </span>\n            LIVE / BATCH 01\n        </div>\n        <button class=\"focus-brand rounded-full bg-white px-5 py-3 text-xs font-bold text-[#05060a] transition-colors hover:bg-[#e9e5ff] focus-visible:bg-white\" data-kid=\"1-6-3\" data-name=\"primary get-early-access button\" type=\"button\">\n            Get Early Access\n        </button>\n    </nav>\n    <section class=\"relative z-10 mx-auto grid max-w-[1312px] grid-cols-[minmax(330px,.72fr)_minmax(0,1.28fr)] gap-16 px-12 pb-10 pt-[92px]\" data-kid=\"1-7\" data-name=\"hero section\" id=\"signal-room\">\n        <div class=\"flex min-h-[690px] flex-col justify-between\" data-kid=\"1-7-1\" data-name=\"hero content area\">\n            <div data-kid=\"1-7-1-1\" data-name=\"hero text content block\">\n                <div class=\"flex items-center gap-3 font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-[0.24em] text-[#36e2ff]\" data-kid=\"1-7-1-1-1\" data-name=\"software being label\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#36e2ff] shadow-[0_0_14px_rgba(54,226,255,.9)]\" data-kid=\"1-7-1-1-1-1\" data-name=\"software being label dot\">\n                    </span>\n                    SOFTWARE BEING / 01\n                </div>\n                <h1 class=\"mt-10 max-w-[520px] text-[clamp(4.7rem,6.25vw,6.9rem)] font-bold leading-[.86] tracking-[-.075em]\" data-kid=\"1-7-1-1-2\" data-name=\"hero headline text\">\n                    <span class=\"block text-white\" data-kid=\"1-7-1-1-2-1\" data-name=\"hero headline line one\">\n                        The first\n                    </span>\n                    <span class=\"block text-[#e9e5ff]\" data-kid=\"1-7-1-1-2-2\" data-name=\"hero headline line two\">\n                        software\n                    </span>\n                    <span class=\"block text-white\" data-kid=\"1-7-1-1-2-3\" data-name=\"hero headline line three\">\n                        being.\n                    </span>\n                </h1>\n                <p class=\"mt-9 max-w-[450px] text-[clamp(1.35rem,1.9vw,2rem)] font-normal leading-[1.08] tracking-[-.045em] text-white/75\" data-kid=\"1-7-1-1-3\" data-name=\"hero subheading text\">\n                    It thinks. It remembers. It works.\n                </p>\n                <p class=\"mt-6 max-w-[440px] text-[15px] leading-[1.55] text-white/50\" data-kid=\"1-7-1-1-4\" data-name=\"hero body text\">\n                    Give it access to your browser, email, calendar, LinkedIn, X, WhatsApp, and the rest of your stack.\n                </p>\n                <div class=\"mt-9 flex flex-wrap items-center gap-4\" data-kid=\"1-7-1-1-5\" data-name=\"hero action button container\">\n                    <button class=\"focus-brand inline-flex h-12 items-center gap-3 rounded-full bg-[#2563ff] px-5 text-sm font-bold text-white shadow-[0_16px_38px_rgba(37,99,255,.26)] transition-all hover:-translate-y-0.5 hover:bg-[#6b5cff] focus-visible:bg-[#2563ff]\" data-kid=\"1-7-1-1-5-1\" data-name=\"hero get early access button\" type=\"button\">\n                        Get Early Access\n                        <span class=\"text-lg leading-none\" data-kid=\"1-7-1-1-5-1-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </button>\n                    <button class=\"focus-brand inline-flex h-12 items-center gap-2 rounded-full border border-white/[0.13] bg-white/[0.025] px-4 text-sm font-medium text-white/65 transition-colors hover:border-white/30 hover:text-white focus-visible:text-white\" data-kid=\"1-7-1-1-5-2\" data-name=\"watch demo button\" type=\"button\">\n                        Watch Collision Work\n                        <span class=\"grid h-5 w-5 place-items-center rounded-full border border-[#36e2ff]/45 text-[9px] text-[#36e2ff]\" data-kid=\"1-7-1-1-5-2-1\" data-name=\"play icon\">\n                            ▶\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 font-['JetBrains_Mono'] text-[9px] font-medium uppercase tracking-[0.22em] text-white/28\" data-kid=\"1-7-1-2\" data-name=\"scroll hint container\">\n                <span class=\"h-5 w-px bg-[#36e2ff]/60\" data-kid=\"1-7-1-2-1\" data-name=\"scroll hint line\">\n                </span>\n                SCROLL TO WAKE IT UP\n                <span class=\"text-[#36e2ff]/70\" data-kid=\"1-7-1-2-2\" data-name=\"scroll hint arrow\">\n                    ↘\n                </span>\n            </div>\n        </div>\n        <div class=\"relative min-h-[690px] pt-2\" data-kid=\"1-7-2\" data-name=\"hero visual surface container\">\n            <div class=\"absolute -inset-6 rounded-[42px] bg-[#2563ff]/[0.035] blur-3xl\" data-kid=\"1-7-2-1\" data-name=\"surface blur background\">\n            </div>\n            <div class=\"surface-shadow relative h-full overflow-hidden rounded-[32px] border border-white/[0.14] bg-[#0b0e16]/95\" data-kid=\"1-7-2-2\" data-name=\"interactive work surface card\">\n                <div class=\"flex h-[70px] items-center justify-between border-b border-white/[0.10] px-7\" data-kid=\"1-7-2-2-1\" data-name=\"surface header\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-7-2-2-1-1\" data-name=\"header title group\">\n                        <span class=\"grid h-8 w-8 place-items-center rounded-lg border border-[#36e2ff]/25 bg-[#36e2ff]/[0.08] text-sm text-[#36e2ff]\" data-kid=\"1-7-2-2-1-1-1\" data-name=\"command icon\">\n                            ⌘\n                        </span>\n                        <div data-kid=\"1-7-2-2-1-1-2\" data-name=\"header text group\">\n                            <div class=\"font-['JetBrains_Mono'] text-[10px] font-bold uppercase tracking-[0.2em] text-[#36e2ff]\" data-kid=\"1-7-2-2-1-1-2-1\" data-name=\"live work surface label\">\n                                LIVE WORK SURFACE\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-white/34\" data-kid=\"1-7-2-2-1-1-2-2\" data-name=\"status subtext\">\n                                Collision is moving through your stack.\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-4 font-['JetBrains_Mono'] text-[9px] uppercase tracking-[0.16em] text-white/36\" data-kid=\"1-7-2-2-1-2\" data-name=\"task status indicator\">\n                        <span data-kid=\"1-7-2-2-1-2-1\" data-name=\"task number label\">\n                            TASK / 0042\n                        </span>\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#c6ff5c] shadow-[0_0_10px_rgba(198,255,92,.8)]\" data-kid=\"1-7-2-2-1-2-2\" data-name=\"active status dot\">\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative px-7 pb-8 pt-6\" data-kid=\"1-7-2-2-2\" data-name=\"work process content area\">\n                    <div class=\"grid grid-cols-4 gap-2 font-['JetBrains_Mono'] text-[9px] font-bold uppercase tracking-[0.16em]\" data-kid=\"1-7-2-2-2-1\" data-name=\"process step labels\">\n                        <div class=\"flex items-center gap-2 text-[#36e2ff]\" data-kid=\"1-7-2-2-2-1-1\" data-name=\"step one label\">\n                            <span class=\"grid h-5 w-5 place-items-center rounded-full border border-[#36e2ff] bg-[#36e2ff]/[0.12] text-[8px]\" data-kid=\"1-7-2-2-2-1-1-1\" data-name=\"step one number\">\n                                01\n                            </span>\n                            CONTEXT\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[#36e2ff]\" data-kid=\"1-7-2-2-2-1-2\" data-name=\"step two label\">\n                            <span class=\"grid h-5 w-5 place-items-center rounded-full border border-[#36e2ff] bg-[#36e2ff]/[0.12] text-[8px]\" data-kid=\"1-7-2-2-2-1-2-1\" data-name=\"step two number\">\n                                02\n                            </span>\n                            INTENT\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[#36e2ff]\" data-kid=\"1-7-2-2-2-1-3\" data-name=\"step three label\">\n                            <span class=\"grid h-5 w-5 place-items-center rounded-full border border-[#36e2ff] bg-[#36e2ff]/[0.12] text-[8px]\" data-kid=\"1-7-2-2-2-1-3-1\" data-name=\"step three number\">\n                                03\n                            </span>\n                            ACTION\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[#c6ff5c]\" data-kid=\"1-7-2-2-2-1-4\" data-name=\"step four label\">\n                            <span class=\"grid h-5 w-5 place-items-center rounded-full border border-[#c6ff5c] bg-[#c6ff5c]/[0.12] text-[8px]\" data-kid=\"1-7-2-2-2-1-4-1\" data-name=\"step four number\">\n                                04\n                            </span>\n                            RESULT\n                        </div>\n                    </div>\n                    <div class=\"mt-3 h-1 overflow-hidden rounded-full bg-white/[0.07]\" data-kid=\"1-7-2-2-2-2\" data-name=\"progress bar track\">\n                        <div class=\"active-line h-full w-[88%] rounded-full\" data-kid=\"1-7-2-2-2-2-1\" data-name=\"active progress bar\">\n                        </div>\n                    </div>\n                    <div class=\"relative mt-7 grid grid-cols-[1fr_30px_1fr_30px_1fr_30px_1.08fr] items-center gap-0\" data-kid=\"1-7-2-2-2-3\" data-name=\"process stages timeline grid\">\n                        <div class=\"space-y-3\" data-kid=\"1-7-2-2-2-3-1\" data-name=\"browser stage group\">\n                            <div class=\"stage-card rounded-2xl border border-white/[0.11] bg-[#121722] p-4\" data-kid=\"1-7-2-2-2-3-1-1\" data-name=\"browser card\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-7-2-2-2-3-1-1-1\" data-name=\"browser header\">\n                                    <span class=\"flex items-center gap-2 text-xs font-semibold\" data-kid=\"1-7-2-2-2-3-1-1-1-1\" data-name=\"browser icon group\">\n                                        <span class=\"grid h-7 w-7 place-items-center rounded-lg bg-[#e9e5ff]/[0.10] text-[#e9e5ff]\" data-kid=\"1-7-2-2-2-3-1-1-1-1-1\" data-name=\"browser icon\">\n                                            ◌\n                                        </span>\n                                        Browser\n                                    </span>\n                                    <span class=\"font-['JetBrains_Mono'] text-[8px] uppercase tracking-[0.12em] text-[#36e2ff]\" data-kid=\"1-7-2-2-2-3-1-1-1-2\" data-name=\"browser status\">\n                                        SYNCED\n                                    </span>\n                                </div>\n                                <div class=\"mt-3 h-1.5 w-[82%] rounded-full bg-white/[0.12]\" data-kid=\"1-7-2-2-2-3-1-1-2\" data-name=\"browser progress line 1\">\n                                </div>\n                                <div class=\"mt-2 h-1.5 w-[58%] rounded-full bg-white/[0.07]\" data-kid=\"1-7-2-2-2-3-1-1-3\" data-name=\"browser progress line 2\">\n                                </div>\n                            </div>\n                            <div class=\"stage-card rounded-2xl border border-white/[0.11] bg-[#121722] p-4\" data-kid=\"1-7-2-2-2-3-1-2\" data-name=\"gmail card\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-7-2-2-2-3-1-2-1\" data-name=\"gmail header\">\n                                    <span class=\"flex items-center gap-2 text-xs font-semibold\" data-kid=\"1-7-2-2-2-3-1-2-1-1\" data-name=\"gmail icon group\">\n                                        <span class=\"grid h-7 w-7 place-items-center rounded-lg bg-[#ff6a88]/[0.11] text-[#ff8da2]\" data-kid=\"1-7-2-2-2-3-1-2-1-1-1\" data-name=\"gmail icon\">\n                                            ✉\n                                        </span>\n                                        Gmail\n                                    </span>\n                                    <span class=\"font-['JetBrains_Mono'] text-[8px] uppercase tracking-[0.12em] text-[#36e2ff]\" data-kid=\"1-7-2-2-2-3-1-2-1-2\" data-name=\"gmail status\">\n                                        3 REPLIES\n                                    </span>\n                                </div>\n                                <div class=\"mt-3 h-1.5 w-[68%] rounded-full bg-white/[0.12]\" data-kid=\"1-7-2-2-2-3-1-2-2\" data-name=\"gmail progress line 1\">\n                                </div>\n                                <div class=\"mt-2 h-1.5 w-[46%] rounded-full bg-white/[0.07]\" data-kid=\"1-7-2-2-2-3-1-2-3\" data-name=\"gmail progress line 2\">\n                                </div>\n                            </div>\n                            <div class=\"stage-card rounded-2xl border border-white/[0.11] bg-[#121722] p-4\" data-kid=\"1-7-2-2-2-3-1-3\" data-name=\"linkedin card\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-7-2-2-2-3-1-3-1\" data-name=\"linkedin header\">\n                                    <span class=\"flex items-center gap-2 text-xs font-semibold\" data-kid=\"1-7-2-2-2-3-1-3-1-1\" data-name=\"linkedin icon group\">\n                                        <span class=\"grid h-7 w-7 place-items-center rounded-lg bg-[#36e2ff]/[0.10] text-[#36e2ff]\" data-kid=\"1-7-2-2-2-3-1-3-1-1-1\" data-name=\"linkedin icon\">\n                                            in\n                                        </span>\n                                        LinkedIn\n                                    </span>\n                                    <span class=\"font-['JetBrains_Mono'] text-[8px] uppercase tracking-[0.12em] text-[#36e2ff]\" data-kid=\"1-7-2-2-2-3-1-3-1-2\" data-name=\"linkedin 