         </span>\n                        <span class=\"text-[10px] font-mono opacity-60\" data-kid=\"1-8-1-1-5-1-2\" data-name=\"status text\">\n                            142 MEMORIES ACTIVE\n                        </span>\n                    </div>\n                    <!-- Node Graph Visualization -->\n                    <div class=\"grid grid-cols-12 gap-4 opacity-30\" data-kid=\"1-8-1-1-5-2\" data-name=\"node graph visualization\">\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[#36E2FF] shadow-[0_0_10px_#36E2FF] animate-pulse\" data-kid=\"1-8-1-1-5-2-1\" data-name=\"node one\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-2\" data-name=\"node two\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-3\" data-name=\"node three\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[#36E2FF] shadow-[0_0_10px_#36E2FF] animate-pulse\" data-kid=\"1-8-1-1-5-2-4\" data-name=\"node four\" style=\"animation-delay: 0.5s\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-5\" data-name=\"node five\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-6\" data-name=\"node six\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[#36E2FF] animate-pulse\" data-kid=\"1-8-1-1-5-2-7\" data-name=\"node seven\" style=\"animation-delay: 1.2s\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-8\" data-name=\"node eight\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-[#36E2FF] animate-pulse\" data-kid=\"1-8-1-1-5-2-9\" data-name=\"node nine\" style=\"animation-delay: 0.8s\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-10\" data-name=\"node ten\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-11\" data-name=\"node eleven\">\n                        </div>\n                        <div class=\"w-1.5 h-1.5 rounded-full bg-white opacity-20\" data-kid=\"1-8-1-1-5-2-12\" data-name=\"node twelve\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Hands Side -->\n            <div class=\"col-span-5 space-y-8\" data-kid=\"1-8-1-2\" data-name=\"hands section container\">\n                <div class=\"bg-white/2 rounded-[80px] p-16 border border-white/5 relative overflow-hidden flex flex-col justify-between h-full\" data-kid=\"1-8-1-2-1\" data-name=\"hands card\">\n                    <div data-kid=\"1-8-1-2-1-1\" data-name=\"card content\">\n                        <span class=\"text-[10px] font-mono text-[#C6FF5C] tracking-[0.4em] uppercase mb-8 block\" data-kid=\"1-8-1-2-1-1-1\" data-name=\"section label\">\n                            Execution / Hands\n                        </span>\n                        <h3 class=\"text-4xl font-geist font-thin tracking-tighter mb-8\" data-kid=\"1-8-1-2-1-1-2\" data-name=\"card headline\">\n                            It has hands.\n                        </h3>\n                        <div class=\"space-y-4 font-mono text-xs leading-relaxed\" data-kid=\"1-8-1-2-1-1-3\" data-name=\"execution log container\">\n                            <div class=\"flex items-center gap-4 opacity-60 py-3 border-b border-white/5\" data-kid=\"1-8-1-2-1-1-3-1\" data-name=\"log entry one\">\n                                <span class=\"text-[#C6FF5C] font-bold\" data-kid=\"1-8-1-2-1-1-3-1-1\" data-name=\"log timestamp one\">\n                                    [14:21]\n                                </span>\n                                SEARCHING CRM FOR PARTNERS...\n                            </div>\n                            <div class=\"flex items-center gap-4 py-3 border-b border-white/5\" data-kid=\"1-8-1-2-1-1-3-2\" data-name=\"log entry two\">\n                                <span class=\"text-[#C6FF5C] font-bold\" data-kid=\"1-8-1-2-1-1-3-2-1\" data-name=\"log timestamp two\">\n                                    [14:22]\n                                </span>\n                                CLICKING \"REPLY\" ON LINKEDIN...\n                            </div>\n                            <div class=\"flex items-center gap-4 py-3 border-b border-white/5 text-[#36E2FF]\" data-kid=\"1-8-1-2-1-1-3-3\" data-name=\"log entry three\">\n                                <span class=\"text-[#36E2FF] animate-pulse font-bold\" data-kid=\"1-8-1-2-1-1-3-3-1\" data-name=\"log indicator\">\n                                    >\n                                </span>\n                                TYPING RESPONSE TO SAM...\n                            </div>\n                            <div class=\"flex items-center gap-4 opacity-50 py-3 border-b border-white/5\" data-kid=\"1-8-1-2-1-1-3-4\" data-name=\"log entry four\">\n                                <span class=\"text-white font-bold\" data-kid=\"1-8-1-2-1-1-3-4-1\" data-name=\"log timestamp four\">\n                                    [14:23]\n                                </span>\n                                BOOKING CALENDAR EVENT...\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-12 flex items-center gap-6\" data-kid=\"1-8-1-2-1-2\" data-name=\"footer content\">\n                        <div class=\"w-12 h-12 glass-bubble rounded-full flex items-center justify-center text-xl text-[#C6FF5C]\" data-kid=\"1-8-1-2-1-2-1\" data-name=\"play icon wrapper\">\n                            <i class=\"ti ti-player-play\" data-kid=\"1-8-1-2-1-2-1-1\" data-name=\"play icon\">\n                            </i>\n                        </div>\n                        <p class=\"text-xs font-mono opacity-50 uppercase tracking-[0.2em]\" data-kid=\"1-8-1-2-1-2-2\" data-name=\"execution status text\">\n                            Executing 24/7\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- FINAL CTA: MEET COLLISION -->\n    <section class=\"min-h-screen py-40 px-20 flex flex-col items-center justify-center text-center bg-[#050508] relative overflow-hidden\" data-kid=\"1-9\" data-name=\"final section\" id=\"final\">\n        <!-- Background Glow -->\n        <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"1-9-1\" data-name=\"background effect container\">\n            <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[#2563FF] opacity-[0.05] blur-[150px] rounded-full\" data-kid=\"1-9-1-1\" data-name=\"background glow\">\n            </div>\n        </div>\n        <span class=\"text-[10px] font-mono opacity-40 uppercase tracking-[0.5em] mb-12 block reveal-up\" data-kid=\"1-9-2\" data-name=\"final section label\">\n            The First Software Being\n        </span>\n        <h2 class=\"text-[10vw] font-geist font-thin tracking-tighter leading-none mb-16 reveal-up\" data-kid=\"1-9-3\" data-name=\"final section headline\">\n            Meet Collision.\n        </h2>\n        <div class=\"max-w-2xl mx-auto space-y-12 reveal-up\" data-kid=\"1-9-4\" data-name=\"final section content\">\n            <p class=\"text-2xl font-light opacity-60 leading-relaxed\" data-kid=\"1-9-4-1\" data-name=\"final section description\">\n                Stop operating software. Start working with it. Collision is built to work alongside humans.\n                <br data-kid=\"1-9-4-1-1\" data-name=\"description line break\"/>\n                Persistent. Autonomous. Internet-native.\n            </p>\n            <div class=\"flex flex-col items-center gap-8 pt-12\" data-kid=\"1-9-4-2\" data-name=\"final action buttons container\">\n                <button class=\"px-16 py-8 bg-white text-black rounded-full text-xl font-bold tracking-wide hover:bg-[#36E2FF] hover:text-white transition-all duration-500 hover:shadow-[0_0_100px_rgba(54,226,255,0.5)]\" data-kid=\"1-9-4-2-1\" data-name=\"waitlist button\">\n                    Join the Waitlist\n                </button>\n                <div class=\"flex items-center gap-4 opacity-40 text-[11px] font-mono uppercase tracking-[0.4em]\" data-kid=\"1-9-4-2-2\" data-name=\"verification container\">\n                    <i class=\"ti ti-shield-check\" data-kid=\"1-9-4-2-2-1\" data-name=\"shield icon\">\n                    </i>\n                    Neural Handshake Verified\n                </div>\n            </div>\n        </div>\n        <!-- Telemetry Ticker Footer -->\n        <div class=\"absolute bottom-0 left-0 w-full h-16 bg-white/5 backdrop-blur-md border-t border-white/10 flex items-center overflow-hidden z-20\" data-kid=\"1-9-5\" data-name=\"ticker footer\">\n            <div class=\"ticker-wrap w-full px-8\" data-kid=\"1-9-5-1\" data-name=\"ticker wrapper\">\n                <div class=\"ticker-move text-[10px] font-mono opacity-50 uppercase tracking-[0.5em] flex gap-32\" data-dynamic=\"true\" data-kid=\"1-9-5-1-1\" data-name=\"ticker move container\" data-reason=\"content duplicated and text moved by infinite animation script\">\n                    <span data-kid=\"1-9-5-1-1-1\" data-name=\"ticker item one\">\n                        Collision OS v1.0.8 - ACTIVE\n                    </span>\n                    <span data-kid=\"1-9-5-1-1-2\" data-name=\"ticker item two\">\n                        Neural Link: ESTABLISHED\n                    </span>\n                    <span data-kid=\"1-9-5-1-1-3\" data-name=\"ticker item three\">\n                        142 Memories: SYNCED\n                    </span>\n                    <span data-kid=\"1-9-5-1-1-4\" data-name=\"ticker item four\">\n                        Autonomous Execution: ENABLED\n                    </span>\n                    <span data-kid=\"1-9-5-1-1-5\" data-name=\"ticker item five\">\n                        Safety Protocols: NOMINAL\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <style>\n        .animate-spin-slow { animation: spinSlow 40s linear infinite; }\n        @keyframes spinSlow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n    </style>\n    <script type=\"module\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n        // Smooth Scroll Init\n        const lenis = new Lenis({\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            orientation: 'vertical',\n            gestureOrientation: 'vertical',\n            smoothWheel: true,\n            wheelMultiplier: 1,\n            smoothTouch: false,\n            touchMultiplier: 2,\n            infinite: false,\n        })\n\n        function raf(time) {\n            lenis.raf(time)\n            requestAnimationFrame(raf)\n        }\n        requestAnimationFrame(raf)\n\n        // Cursor Aura Following\n        const cursor = document.getElementById('cursor-aura');\n        const orb = document.getElementById('orb-container');\n\n        window.addEventListener('mousemove', (e) => {\n            const { clientX, clientY } = e;\n            \n            // Cursor Aura\n            animate(cursor, {\n                x: clientX,\n                y: clientY\n            }, { duration: 0.1 });\n\n            // Subtle Orb Reactivity\n            if (orb) {\n                const moveX = (clientX - window.innerWidth / 2) * 0.02;\n                const moveY = (clientY - window.innerHeight / 2) * 0.02;\n                animate(orb, {\n                    x: moveX,\n                    y: moveY\n                }, { duration: 0.5, ease: \"easeOut\" });\n            }\n        });\n\n        // Improved Reveal Animations on Scroll using animate\n        const revealElements = document.querySelectorAll(\".reveal-up\");\n        revealElements.forEach(el => {\n            // Initial state set via JS to avoid flicker/blank areas if JS fails\n            el.style.opacity = \"0\";\n            el.style.transform = \"translateY(40px)\";\n            \n            inView(el, (info) => {\n                animate(el, { \n                    opacity: 1, \n                    y: 0 \n                }, { \n                    duration: 1, \n                    easing: [0.16, 1, 0.3, 1],\n                    delay: 0.1\n                });\n                return () => {\n                    animate(el, { opacity: 0, y: 40 }, { duration: 0.5 });\n                };\n            });\n        });\n\n        // Chapter Scroll Tints (Simplified mood transitions)\n        scroll(({ y }) => {\n            const progress = y.progress;\n            const journey = document.querySelector('.gradient-journey');\n            if (journey) {\n                journey.style.opacity = 0.15 + (progress * 0.2);\n            }\n        });\n\n        // Ticker cloning for seamless effect\n        const ticker = document.querySelector('.ticker-move');\n        if (ticker) {\n            ticker.innerHTML += ticker.innerHTML;\n        }\n\n        // Role Toggle Simulation\n        const rolePills = document.querySelectorAll('.role-pill');\n        rolePills.forEach(pill => {\n            pill.addEventListener('click', () => {\n                rolePills.forEach(p => p.classList.remove('active', 'opacity-50'));\n                pill.classList.add('active');\n                rolePills.forEach(p => {\n                    if (p !== pill) p.classList.add('opacity-50');\n                });\n            });\n        });\n    </script>\n</div>\n",
