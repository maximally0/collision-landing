    "var_870620db57b5": {
      "type": "variant",
      "label": "Collision — Kinetic Network",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root {\n  --color-electric-blue: #2563FF;\n  --color-neon-cyan: #36E2FF;\n  --color-violet: #6B5CFF;\n  --color-deep-indigo: #1A1B6B;\n  --color-lavender: #E9E5FF;\n  --color-coral: #FF6A88;\n  --color-orange: #FF9F43;\n  --color-pink: #FF59C7;\n  --color-lime: #C6FF5C;\n  --color-true-black: #000000;\n}\n\nbody {\n  font-family: 'Space Grotesk', sans-serif;\n  background-color: var(--color-true-black);\n  color: #fff;\n  margin: 0;\n  overflow-x: clip; /* Fix for sticky and scroll */\n}\n\n.font-mono { font-family: 'JetBrains Mono', monospace; }\n\n/* Custom Scrollbar */\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-track { background: #000; }\n::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }\n\n/* Glassmorphism */\n.glass {\n  background: rgba(255, 255, 255, 0.03);\n  backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 32px;\n}\n\n/* Floating Bubbles */\n.bubble {\n  position: absolute;\n  border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;\n  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.15), rgba(255,255,255,0));\n  border: 1px solid rgba(255,255,255,0.1);\n  backdrop-filter: blur(12px);\n  z-index: 5;\n  pointer-events: none;\n}\n\n@keyframes float {\n  0%, 100% { transform: translateY(0) rotate(0deg); }\n  50% { transform: translateY(-20px) rotate(5deg); }\n}\n\n@keyframes pulse {\n  0%, 100% { transform: scale(1); opacity: 0.8; }\n  50% { transform: scale(1.05); opacity: 1; }\n}\n\n@keyframes scanline {\n  0% { transform: translateY(-100%); }\n  100% { transform: translateY(100%); }\n}\n\n.animate-float { animation: float 6s ease-in-out infinite; }\n.animate-pulse-slow { animation: pulse 4s ease-in-out infinite; }\n\n.cursor-aura {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 400px;\n  height: 400px;\n  background: radial-gradient(circle, var(--color-electric-blue) 0%, transparent 70%);\n  opacity: 0.15;\n  filter: blur(80px);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 9999;\n  transform: translate(-50%, -50%);\n  mix-blend-mode: screen;\n}\n\n.role-ticker-item {\n  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n\n.role-ticker-item.active {\n  transform: scale(1.3);\n  color: white !important;\n  text-shadow: 0 0 20px rgba(255,255,255,0.4);\n}\n\n.liquid-gradient {\n  background: linear-gradient(135deg, var(--color-pink), var(--color-orange), var(--color-pink));\n  background-size: 200% 200%;\n  animation: liquidMove 10s ease infinite;\n}\n\n@keyframes liquidMove {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n\n.waterfall-mask {\n  mask-image: linear-gradient(to bottom, transparent 0%, black 25%, black 75%, transparent 100%);\n}\n</style>\n<!-- JS Libraries -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n  import Snap from \"https://esm.sh/lenis@1/snap\"\n  const lenis = new Lenis()\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n  gsap.registerPlugin(ScrollTrigger);\n</script>\n<link data-kid=\"1\" data-name=\"lenis scroll library stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<div class=\"cursor-aura\" data-dynamic=\"true\" data-kid=\"2\" data-name=\"mouse tracking cursor aura\" data-reason=\"style properties left and top updated every frame by script\" id=\"cursorAura\">\n</div>\n<main class=\"w-[1280px] mx-auto overflow-x-clip bg-black\" data-kid=\"3\" data-name=\"page content container\">\n    <!-- Navigation -->\n    <nav class=\"fixed top-8 left-1/2 -translate-x-1/2 w-[1200px] glass px-8 py-4 flex items-center justify-between z-[100]\" data-kid=\"3-1\" data-name=\"navigation bar\">\n        <div class=\"flex items-center gap-4\" data-kid=\"3-1-1\" data-name=\"brand logo area\">\n            <div class=\"w-10 h-10 bg-[var(--color-electric-blue)] rounded-full flex items-center justify-center\" data-kid=\"3-1-1-1\" data-name=\"brand icon container\">\n                <div class=\"w-5 h-5 bg-white rounded-full animate-pulse\" data-kid=\"3-1-1-1-1\" data-name=\"pulsing icon indicator\">\n                </div>\n            </div>\n            <span class=\"text-2xl font-bold tracking-tighter uppercase\" data-kid=\"3-1-1-2\" data-name=\"brand name text\">\n                Collision\n            </span>\n        </div>\n        <div class=\"flex items-center gap-10\" data-kid=\"3-1-2\" data-name=\"nav links and cta container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"3-1-2-1\" data-name=\"live status indicator container\">\n                <span class=\"w-2.5 h-2.5 rounded-full bg-[var(--color-lime)] animate-pulse\" data-kid=\"3-1-2-1-1\" data-name=\"pulsing status dot\">\n                </span>\n                <span class=\"font-mono text-sm uppercase tracking-widest text-white/50\" data-kid=\"3-1-2-1-2\" data-name=\"status label text\">\n                    Live Mode / Batch 01\n                </span>\n            </div>\n            <button class=\"px-8 py-2.5 bg-white text-black font-bold rounded-full hover:scale-105 transition-transform cursor-pointer\" data-kid=\"3-1-2-2\" data-name=\"early access cta button\">\n                Get Early Access\n            </button>\n        </div>\n    </nav>\n    <!-- Hero Section -->\n    <section class=\"relative min-h-screen pt-48 px-16 flex flex-col justify-start\" data-kid=\"3-2\" data-name=\"hero section\">\n        <div class=\"grid grid-cols-12 gap-8 items-center relative z-10\" data-kid=\"3-2-1\" data-name=\"hero content grid\">\n            <!-- Left Content -->\n            <div class=\"col-span-7 hero-text-container\" data-kid=\"3-2-1-1\" data-name=\"hero text content container\">\n                <h1 class=\"text-[140px] font-bold leading-[0.8] tracking-[-0.06em] mb-12\" data-kid=\"3-2-1-1-1\" data-name=\"hero title headline\">\n                    The first\n                    <br data-kid=\"3-2-1-1-1-1\" data-name=\"line break\"/>\n                    <span class=\"text-[var(--color-lavender)]\" data-kid=\"3-2-1-1-1-2\" data-name=\"hero title emphasized text\">\n                        software\n                    </span>\n                    <br data-kid=\"3-2-1-1-1-3\" data-name=\"line break\"/>\n                    being.\n                </h1>\n                <div class=\"space-y-4 mb-16 max-w-xl\" data-kid=\"3-2-1-1-2\" data-name=\"hero description block\">\n                    <p class=\"text-4xl font-light text-white/70 tracking-tight\" data-kid=\"3-2-1-1-2-1\" data-name=\"hero subheadline\">\n                        It thinks. It remembers. It works.\n                    </p>\n                    <p class=\"text-xl text-white/40 font-light leading-relaxed\" data-kid=\"3-2-1-1-2-2\" data-name=\"hero supporting text\">\n                        Give it access to your browser, email, calendar, LinkedIn, X, WhatsApp, and the rest of your stack.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-8\" data-kid=\"3-2-1-1-3\" data-name=\"hero cta group\">\n                    <button class=\"group px-10 py-5 bg-[var(--color-electric-blue)] text-white text-2xl font-bold rounded-full relative overflow-hidden flex items-center gap-3 cursor-pointer\" data-kid=\"3-2-1-1-3-1\" data-name=\"primary cta button\">\n                        <span data-kid=\"3-2-1-1-3-1-1\" data-name=\"primary cta button text\">\n                            Get Early Access\n                        </span>\n                        <i class=\"ti ti-arrow-right text-3xl group-hover:translate-x-1 transition-transform\" data-kid=\"3-2-1-1-3-1-2\" data-name=\"arrow icon\">\n                        </i>\n                    </button>\n                    <button class=\"flex items-center gap-3 text-xl font-medium text-white/60 hover:text-white transition-colors cursor-pointer\" data-kid=\"3-2-1-1-3-2\" data-name=\"secondary video play button\">\n                        Watch Collision Work\n                        <i class=\"ti ti-player-play-filled text-[var(--color-neon-cyan)]\" data-kid=\"3-2-1-1-3-2-1\" data-name=\"play icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <!-- Right Kinetic Cluster -->\n            <div class=\"col-span-5 relative h-[700px] flex items-center justify-center\" data-kid=\"3-2-1-2\" data-name=\"hero kinetic cluster container\">\n                <div class=\"relative w-full aspect-square\" data-kid=\"3-2-1-2-1\" data-name=\"kinetic imagery container\">\n                    <img alt=\"Kinetic Brain\" class=\"w-full h-full object-cover rounded-full mix-blend-lighten opacity-80 scale-125 hero-img\" data-kid=\"3-2-1-2-1-1\" data-name=\"hero kinetic brain image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/e7471c0d0fa34a7eaa458102de9bae87.jpg?auto=format&w=800&q=80&fit=crop\"/>\n                    <!-- Irregular Floating Bubbles -->\n                    <div class=\"bubble w-40 h-40 -top-12 -right-8 animate-float\" data-kid=\"3-2-1-2-1-2\" data-name=\"floating decorative bubble\" style=\"animation-delay: -1s;\">\n                    </div>\n                    <div class=\"bubble w-24 h-24 bottom-0 -left-16 animate-float\" data-kid=\"3-2-1-2-1-3\" data-name=\"floating decorative bubble\" style=\"animation-delay: -4s;\">\n                    </div>\n                    <div class=\"bubble w-56 h-56 -bottom-24 right-12 animate-float\" data-kid=\"3-2-1-2-1-4\" data-name=\"floating decorative bubble\" style=\"animation-delay: -2s;\">\n                    </div>\n                    <!-- Moving Laser Accents -->\n                    <div class=\"absolute top-1/2 -left-20 w-[140%] h-[1px] bg-gradient-to-r from-transparent via-[var(--color-neon-cyan)] to-transparent -rotate-15 blur-[2px] opacity-40\" data-kid=\"3-2-1-2-1-5\" data-name=\"laser accent line\">\n                    </div>\n                    <div class=\"absolute top-1/3 left-0 w-[140%] h-[1px] bg-gradient-to-r from-transparent via-[var(--color-pink)] to-transparent rotate-35 blur-[2px] opacity-40\" data-kid=\"3-2-1-2-1-6\" data-name=\"laser accent line\">\n                    </div>\n                </div>\n                <!-- Overlapping Activity Panel -->\n                <div class=\"absolute bottom-16 -left-12 w-[380px] bg-black/40 backdrop-blur-2xl p-10 border-l-4 border-[var(--color-neon-cyan)] shadow-[0_0_50px_rgba(0,0,0,0.5)] z-30 transform-gpu activity-card\" data-kid=\"3-2-1-2-2\" data-name=\"activity log panel\">\n                    <div class=\"flex items-center justify-between mb-8\" data-kid=\"3-2-1-2-2-1\" data-name=\"activity panel header\">\n                        <span class=\"font-mono text-[11px] uppercase tracking-[0.3em] text-[var(--color-lime)] flex items-center gap-2\" data-kid=\"3-2-1-2-2-1-1\" data-name=\"live execution label\">\n                            <span class=\"w-2 h-2 bg-[var(--color-lime)] rounded-full animate-pulse\" data-kid=\"3-2-1-2-2-1-1-1\" data-name=\"pulsing status dot\">\n                            </span>\n                            LIVE EXECUTION STREAM\n                        </span>\n                        <span class=\"font-mono text-[9px] text-white/20\" data-kid=\"3-2-1-2-2-1-2\" data-name=\"timestamp\">\n                            01.00.42\n                        </span>\n                    </div>\n                    <div class=\"space-y-4 font-mono text-sm\" data-kid=\"3-2-1-2-2-2\" data-name=\"activity list\">\n                        <div class=\"flex items-center gap-3 text-white/90\" data-kid=\"3-2-1-2-2-2-1\" data-name=\"activity log item\">\n                            <i class=\"ti ti-circle-check-filled text-[var(--color-lime)] text-lg\" data-kid=\"3-2-1-2-2-2-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                            <span data-kid=\"3-2-1-2-2-2-1-2\" data-name=\"activity text\">\n                                replied to 18 comments\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3 text-white/90\" data-kid=\"3-2-1-2-2-2-2\" data-name=\"activity log item\">\n                            <i class=\"ti ti-circle-check-filled text-[var(--color-lime)] text-lg\" data-kid=\"3-2-1-2-2-2-2-1\" data-name=\"checkmark icon\">\n                            </i>\n                            <span data-kid=\"3-2-1-2-2-2-2-2\" data-name=\"activity text\">\n                                wrote tomorrow's post\n                            </span>\n                        </div>\n                        <div class=\"flex items-center gap-3 text-white/90\" data-kid=\"3-2-1-2-2-2-3\" data-name=\"activity log item\">\n                            <i class=\"ti ti-circle-check-filled text-[var(--color-lime)] text-lg\" data-kid=\"3-2-1-2-2-2-3-1\" data-name=\"checkmark icon\">\n                            </i>\n                            <span data-kid=\"3-2-1-2-2-2-3-2\" data-name=\"activity text\">\n                                found 3 prospects\n                            </span>\n                        </div>\n                        <div class=\"pt-4 border-t border-white/10 text-[var(--color-neon-cyan)] font-bold italic animate-pulse\" data-kid=\"3-2-1-2-2-2-4\" data-name=\"live status message\">\n                            currently writing to Sam Altman...\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Kinetic Role Ticker -->\n    <section class=\"py-12 border-y border-white/10 bg-black/50 overflow-hidden\" data-kid=\"3-3\" data-name=\"role ticker section\">\n        <div class=\"flex items-center gap-6 whitespace-nowrap role-ticker-container\" data-kid=\"3-3-1\" data-name=\"role ticker container\">\n            <div class=\"text-white/20 text-5xl font-mono px-4\" data-kid=\"3-3-1-1\" data-name=\"ticker label\">\n                Today\n            </div>\n            <div class=\"text-[var(--color-pink)] text-4xl\" data-kid=\"3-3-1-2\" data-name=\"separator arrow\">\n                →\n            </div>\n            <div class=\"role-ticker-item active text-6xl font-bold px-8\" data-dynamic=\"true\" data-kid=\"3-3-1-3\" data-name=\"ticker item\" data-reason=\"class list toggled by script every 2 seconds\">\n                SDR\n            </div>\n            <div class=\"text-white/20 text-4xl\" data-kid=\"3-3-1-4\" data-name=\"separator arrow\">\n                →\n            </div>\n            <div class=\"role-ticker-item text-6xl font-bold text-white/20 px-8\" data-dynamic=\"true\" data-kid=\"3-3-1-5\" data-name=\"ticker item\" data-reason=\"class list toggled by script every 2 seconds\">\n                Recruiter\n            </div>\n            <div class=\"text-white/20 text-4xl\" data-kid=\"3-3-1-6\" data-name=\"separator arrow\">\n                →\n            </div>\n            <div class=\"role-ticker-item text-6xl font-bold text-white/20 px-8\" data-dynamic=\"true\" data-kid=\"3-3-1-7\" data-name=\"ticker item\" data-reason=\"class list toggled by script every 2 seconds\">\n                Researcher\n            </div>\n            <div class=\"text-white/20 text-4xl\" data-kid=\"3-3-1-8\" data-name=\"separator arrow\">\n                →\n            </div>\n            <div class=\"role-ticker-item text-6xl font-bold text-white/20 px-8\" data-dynamic=\"true\" data-kid=\"3-3-1-9\" data-name=\"ticker item\" data-reason=\"class list toggled by script every 2 seconds\">\n                Marketer\n            </div>\n            <div class=\"text-white/20 text-4xl\" data-kid=\"3-3-1-10\" data-name=\"separator arrow\">\n                →\n            </div>\n            <div class=\"role-ticker-item text-6xl font-bold text-white/20 px-8\" data-dynamic=\"true\" data-kid=\"3-3-1-11\" data-name=\"ticker item\" data-reason=\"class list toggled by script every 2 seconds\">\n                Founder Associate\n            </div>\n            <div class=\"text-white/20 text-4xl\" data-kid=\"3-3-1-12\" data-name=\"separator arrow\">\n                →\n            </div>\n            <div class=\"role-ticker-item text-6xl font-bold text-white/20 px-8\" data-dynamic=\"true\" data-kid=\"3-3-1-13\" data-name=\"ticker item\" data-reason=\"class list toggled by script every 2 seconds\">\n                Operator\n            </div>\n        </div>\n    </section>\n    <!-- Chapter: The Shift -->\n    <section class=\"relative py-48 px-16 overflow-hidden\" data-kid=\"3-4\" data-name=\"shift explanation section\">\n        <!-- Blue/White Dotted Field -->\n        <div class=\"absolute inset-0 z-0 opacity-20\" data-kid=\"3-4-1\" data-name=\"dotted field background\" style=\"background-image: radial-gradient(circle, var(--color-electric-blue) 1.5px, transparent 1.5px); background-size: 40px 40px;\">\n        </div>\n        <div class=\"relative z-10 max-w-6xl mx-auto\" data-kid=\"3-4-2\" data-name=\"content wrapper\">\n            <h2 class=\"text-[140px] font-bold tracking-[-0.05em] mb-24 leading-none text-center shift-title\" data-kid=\"3-4-2-1\" data-name=\"section headline\">\n                The Shift\n            </h2>\n            <div class=\"grid grid-cols-12 gap-12 items-end\" data-kid=\"3-4-2-2\" data-name=\"comparison grid\">\n                <div class=\"col-span-5 space-y-12 shift-card-left\" data-kid=\"3-4-2-2-1\" data-name=\"legacy systems column\">\n                    <div class=\"flex items-center gap-4 text-white/40 font-mono text-xs uppercase tracking-widest\" data-kid=\"3-4-2-2-1-1\" data-name=\"column header group\">\n                        <span class=\"w-12 h-[1px] bg-white/20\" data-kid=\"3-4-2-2-1-1-1\" data-name=\"divider line\">\n                        </span>\n                        LEGACY SYSTEMS\n                    </div>\n                    <p class=\"text-5xl leading-[0.95] tracking-tight font-light text-white/60\" data-kid=\"3-4-2-2-1-2\" data-name=\"legacy description text\">\n                        Software used to wait. It was static. You clicks buttons. Filled forms. Manually synced.\n                    </p>\n                </div>\n                <div class=\"col-span-2 flex justify-center pb-6\" data-kid=\"3-4-2-2-2\" data-name=\"separator column\">\n                    <div class=\"w-16 h-16 rounded-full border border-white/10 flex items-center justify-center\" data-kid=\"3-4-2-2-2-1\" data-name=\"arrow icon container\">\n                        <i class=\"ti ti-arrow-right text-3xl text-[var(--color-pink)]\" data-kid=\"3-4-2-2-2-1-1\" data-name=\"arrow icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"col-span-5 space-y-12 shift-card-right\" data-kid=\"3-4-2-2-3\" data-name=\"new system column\">\n                    <div class=\"flex items-center gap-4 text-[var(--color-pink)] font-mono text-xs uppercase tracking-widest\" data-kid=\"3-4-2-2-3-1\" data-name=\"column header group\">\n                        <span class=\"w-12 h-[1px] bg-[var(--color-pink)]/40\" data-kid=\"3-4-2-2-3-1-1\" data-name=\"divider line\">\n                        </span>\n                        COLLISION BEING\n                    </div>\n                    <p class=\"text-6xl leading-[0.9] tracking-tighter font-bold text-white\" data-kid=\"3-4-2-2-3-2\" data-name=\"new system description text\">\n                        It works instead. It remembers your stacks. It executes. It grows with you.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Chapter: Infinite Roles (Liquid Wash) -->\n    <section class=\"px-16 pb-48\" data-kid=\"3-5\" data-name=\"infinite roles section\">\n        <div class=\"liquid-gradient p-32 rounded-[100px] text-black relative overflow-hidden infinite-roles-container\" data-kid=\"3-5-1\" data-name=\"liquid gradient card\">\n            <!-- Decorator Spheres -->\n            <div class=\"absolute top-0 right-0 w-96 h-96 bg-white/20 rounded-full blur-[100px]\" data-kid=\"3-5-1-1\" data-name=\"decorator sphere\">\n            </div>\n            <div class=\"absolute bottom-0 left-0 w-64 h-64 bg-white/20 rounded-full blur-[80px]\" data-kid=\"3-5-1-2\" data-name=\"decorator sphere\">\n            </div>\n            <div class=\"relative z-10\" data-kid=\"3-5-1-3\" data-name=\"card content container\">\n                <h3 class=\"text-[110px] font-bold leading-[0.85] tracking-[-0.05em] mb-12\" data-kid=\"3-5-1-3-1\" data-name=\"section headline\">\n                    One Being.\n                    <br data-kid=\"3-5-1-3-1-1\" data-name=\"line break\"/>\n                    Infinite Roles.\n                </h3>\n                <p class=\"text-3xl font-medium max-w-2xl opacity-90 leading-tight\" data-kid=\"3-5-1-3-2\" data-name=\"section description text\">\n                    Instead of hiring another tool, you give Collision another responsibility. One intelligence, specialized for your unique workflows.\n                </p>\n                <div class=\"mt-20 flex flex-wrap gap-4\" data-kid=\"3-5-1-3-3\" data-name=\"roles tag container\">\n                    <span class=\"px-6 py-2 bg-black/10 rounded-full border border-black/20 text-xl font-bold\" data-kid=\"3-5-1-3-3-1\" data-name=\"role tag\">\n                        Today\n                    </span>\n                    <span class=\"px-6 py-2 bg-black/10 rounded-full border border-black/20 text-xl font-bold\" data-kid=\"3-5-1-3-3-2\" data-name=\"role tag\">\n                        Tomorrow\n                    </span>\n                    <span class=\"px-8 py-3 bg-[#0a0a0a] rounded-full text-white text-xl font-bold shadow-2xl ring-2 ring-white/10\" data-kid=\"3-5-1-3-3-3\" data-name=\"active role tag\">\n                        Analyst\n                    </span>\n                    <span class=\"px-6 py-2 bg-black/10 rounded-full border border-black/20 text-xl font-bold\" data-kid=\"3-5-1-3-3-4\" data-name=\"role tag\">\n                        Designer\n                    </span>\n                    <span class=\"px-6 py-2 bg-black/10 rounded-full border border-black/20 text-xl font-bold\" data-kid=\"3-5-1-3-3-5\" data-name=\"role tag\">\n                        Support\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Chapter: Connection -->\n    <section class=\"py-48 px-16 bg-[#0a0a1a] relative overflow-hidden connection-section\" data-kid=\"3-6\" data-name=\"connection section\">\n        <div class=\"grid grid-cols-12 gap-16 items-center\" data-kid=\"3-6-1\" data-name=\"content grid\">\n            <div class=\"col-span-6 space-y-12\" data-kid=\"3-6-1-1\" data-name=\"text column\">\n                <h2 class=\"text-8xl font-bold tracking-tighter leading-none text-[var(--color-lime)]\" data-kid=\"3-6-1-1-1\" data-name=\"section headline\">\n                    Connect\n                    <br data-kid=\"3-6-1-1-1-1\" data-name=\"line break\"/>\n                    everything.\n                </h2>\n                <p class=\"text-2xl text-white/60 max-w-md leading-relaxed\" data-kid=\"3-6-1-1-2\" data-name=\"section description text\">\n                    Browser, Gmail, Calendar, LinkedIn, X, WhatsApp, Slack, Notion. If you can use it, Collision can too.\n                </p>\n                <div class=\"grid grid-cols-2 gap-6 max-w-sm\" data-kid=\"3-6-1-1-3\" data-name=\"integrations grid\">\n                    <div class=\"bg-black/40 border border-white/5 px-8 py-4 flex items-center gap-3 text-xl hover:border-white/20 transition-all rotate-[-2deg]\" data-kid=\"3-6-1-1-3-1\" data-name=\"integration card\">\n                        <i class=\"ti ti-brand-linkedin text-[#0077B5]\" data-kid=\"3-6-1-1-3-1-1\" data-name=\"linkedin icon\">\n                        </i>\n                        LinkedIn\n                    </div>\n                    <div class=\"bg-black/40 border border-white/5 px-8 py-4 flex items-center gap-3 text-xl hover:border-white/20 transition-all rotate-[3deg]\" data-kid=\"3-6-1-1-3-2\" data-name=\"integration card\">\n                        <i class=\"ti ti-brand-x text-white\" data-kid=\"3-6-1-1-3-2-1\" data-name=\"x icon\">\n                        </i>\n                        X\n                    </div>\n                    <div class=\"bg-black/40 border border-white/5 px-8 py-4 flex items-center gap-3 text-xl hover:border-white/20 transition-all rotate-[1deg]\" data-kid=\"3-6-1-1-3-3\" data-name=\"integration card\">\n                        <i class=\"ti ti-brand-slack text-[#4A154B]\" data-kid=\"3-6-1-1-3-3-1\" data-name=\"slack icon\">\n                        </i>\n                        Slack\n                    </div>\n                    <div class=\"bg-black/40 border border-white/5 px-8 py-4 flex items-center gap-3 text-xl hover:border-white/20 transition-all rotate-[-3deg]\" data-kid=\"3-6-1-1-3-4\" data-name=\"integration card\">\n                        <i class=\"ti ti-mail text-[#EA4335]\" data-kid=\"3-6-1-1-3-4-1\" data-name=\"gmail icon\">\n                        </i>\n                        Gmail\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-span-6 relative\" data-kid=\"3-6-1-2\" data-name=\"image column\">\n                <div class=\"relative rounded-[60px] overflow-hidden border border-white/10 shadow-2xl connection-img-container\" data-kid=\"3-6-1-2-1\" data-name=\"connection imagery container\">\n                    <img alt=\"Neural Connections\" class=\"w-full h-full object-cover\" data-kid=\"3-6-1-2-1-1\" data-name=\"connection visualization image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/761269e56b5e4eb2a58a8f36d5b2c8be.jpg?auto=format&w=800&q=80&fit=crop\"/>\n                    <!-- Floating app spheres overlay -->\n                    <div class=\"bubble w-32 h-32 -top-10 -right-10 flex items-center justify-center scale-75 bg-white/5\" data-kid=\"3-6-1-2-1-2\" data-name=\"floating bubble\">\n                        <i class=\"ti ti-brand-whatsapp text-5xl text-[#25D366]\" data-kid=\"3-6-1-2-1-2-1\" data-name=\"whatsapp icon\">\n                        </i>\n                    </div>\n                    <div class=\"bubble w-28 h-28 -bottom-8 -left-8 flex items-center justify-center scale-90 bg-white/5\" data-kid=\"3-6-1-2-1-3\" data-name=\"floating bubble\">\n                        <i class=\"ti ti-calendar text-4xl text-[#4285F4]\" data-kid=\"3-6-1-2-1-3-1\" data-name=\"calendar icon\">\n                        </i>\n                    </div>\n                </div>\n                <!-- Neural Link Diagram Overlay -->\n                <svg class=\"absolute top-0 left-0 w-full h-full pointer-events-none opacity-40 z-20\" data-kid=\"3-6-1-2-2\" data-name=\"neural link diagram\">\n                    <circle cx=\"20%\" cy=\"30%\" fill=\"var(--color-lime)\" r=\"5\">\n                    </circle>\n                    <circle cx=\"80%\" cy=\"70%\" fill=\"var(--color-neon-cyan)\" r=\"5\">\n                    </circle>\n                    <line stroke=\"var(--color-lime)\" stroke-dasharray=\"10,5\" stroke-width=\"1\" x1=\"20%\" x2=\"80%\" y1=\"30%\" y2=\"70%\">\n                    </line>\n                </svg>\n            </div>\n        </div>\n    </section>\n    <!-- Chapter: Memory (Cyan/Lime Node Graph) -->\n    <section class=\"py-48 px-16 memory-section-trigger\" data-kid=\"3-7\" data-name=\"memory section\">\n        <div class=\"bg-gradient-to-br from-[var(--color-neon-cyan)] to-[var(--color-lime)] p-24 rounded-[80px] text-black memory-container\" data-kid=\"3-7-1\" data-name=\"memory container\">\n            <div class=\"grid grid-cols-12 gap-12 items-center\" data-kid=\"3-7-1-1\" data-name=\"memory content grid\">\n                <div class=\"col-span-6 space-y-8\" data-kid=\"3-7-1-1-1\" data-name=\"text column\">\n                    <h2 class=\"text-[100px] font-bold leading-[0.85] tracking-[-0.05em]\" data-kid=\"3-7-1-1-1-1\" data-name=\"section headline\">\n                        It remembers.\n                        <br data-kid=\"3-7-1-1-1-1-1\" data-name=\"line break\"/>\n                        Everything.\n                    </h2>\n                    <p class=\"text-3xl font-medium opacity-70 leading-tight max-w-lg\" data-kid=\"3-7-1-1-1-2\" data-name=\"section description text\">\n                        Every conversation. Every preference. Every customer. Every decision. The longer you work together, the better Collision becomes.\n                    </p>\n                </div>\n                <div class=\"col-span-6 relative h-[500px]\" data-kid=\"3-7-1-1-2\" data-name=\"visualization column\">\n                    <!-- Node Graph Visualization (SVG Animation) -->\n                    <svg class=\"w-full h-full stroke-black/30 fill-none scale-110\" data-kid=\"3-7-1-1-2-1\" data-name=\"node graph svg\" viewbox=\"0 0 400 300\">\n                        <path class=\"memory-path\" d=\"M50 50 L200 150 L350 80 L300 250 L100 200 Z M200 150 L100 200 M350 80 L200 150 M300 250 L200 150\" stroke-width=\"1.5\">\n                        </path>\n                        <circle cx=\"50\" cy=\"50\" fill=\"black\" r=\"6\">\n                        </circle>\n                        <circle cx=\"200\" cy=\"150\" fill=\"black\" r=\"10\">\n                        </circle>\n                        <circle cx=\"350\" cy=\"80\" fill=\"black\" r=\"6\">\n                        </circle>\n                        <circle cx=\"300\" cy=\"250\" fill=\"black\" r=\"8\">\n                        </circle>\n                        <circle cx=\"100\" cy=\"200\" fill=\"black\" r=\"6\">\n                        </circle>\n                        <circle cx=\"250\" cy=\"50\" fill=\"black/40\" r=\"4\">\n                        </circle>\n                        <circle cx=\"150\" cy=\"280\" fill=\"black/40\" r=\"4\">\n                        </circle>\n                    </svg>\n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 glass px-6 py-4 border-black/20 bg-white/10 text-black font-bold text-2xl rotate-[-5deg]\" data-kid=\"3-7-1-1-2-2\" data-name=\"label card\">\n                        Persistent Core\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Chapter: Hands (White/Blue Waterfall) -->\n    <section class=\"py-48 px-16 bg-white text-black overflow-hidden hands-section\" data-kid=\"3-8\" data-name=\"execution section\">\n        <div class=\"grid grid-cols-12 gap-24 items-center\" data-kid=\"3-8-1\" data-name=\"content grid\">\n            <div class=\"col-span-6 space-y-12\" data-kid=\"3-8-1-1\" data-name=\"text column\">\n                <h2 class=\"text-9xl font-bold tracking-tighter text-[var(--color-electric-blue)] leading-none\" data-kid=\"3-8-1-1-1\" data-name=\"section headline\">\n                    It has\n                    <br data-kid=\"3-8-1-1-1-1\" data-name=\"line break\"/>\n                    hands.\n                </h2>\n                <p class=\"text-3xl font-medium opacity-60 leading-tight\" data-kid=\"3-8-1-1-2\" data-name=\"section description text\">\n                    Collision doesn't stop at advice. It clicks. Types. Posts. Replies. Researches. Books meetings. Runs workflows.\n                </p>\n                <button class=\"px-12 py-5 bg-[var(--color-electric-blue)] text-white text-2xl font-bold rounded-full shadow-2xl hover:scale-105 transition-transform cursor-pointer\" data-kid=\"3-8-1-1-3\" data-name=\"cta button\">\n                    See the executions\n                </button>\n            </div>\n            <div class=\"col-span-6 bg-black rounded-[40px] p-12 h-[600px] relative overflow-hidden shadow-[0_0_100px_rgba(37,99,255,0.1)] waterfall-container\" data-kid=\"3-8-1-2\" data-name=\"waterfall log container\">\n                <div class=\"flex items-center justify-between mb-10 border-b border-white/10 pb-6\" data-kid=\"3-8-1-2-1\" data-name=\"log header\">\n                    <span class=\"font-mono text-[var(--color-neon-cyan)] text-xs font-bold uppercase tracking-widest\" data-kid=\"3-8-1-2-1-1\" data-name=\"log label\">\n                        Core / Process / Exec\n                    </span>\n                    <div class=\"flex gap-3\" data-kid=\"3-8-1-2-1-2\" data-name=\"status group\">\n                        <div class=\"w-3 h-3 bg-[var(--color-lime)]/20 border border-[var(--color-lime)]\" data-kid=\"3-8-1-2-1-2-1\" data-name=\"status light\">\n                        </div>\n                        <div class=\"w-3 h-3 bg-[var(--color-pink)]/20 border border-[var(--color-pink)]\" data-kid=\"3-8-1-2-1-2-2\" data-name=\"status light\">\n                        </div>\n                        <div class=\"w-3 h-3 bg-[var(--color-neon-cyan)]/20 border border-[var(--color-neon-cyan)]\" data-kid=\"3-8-1-2-1-2-3\" data-name=\"status light\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-4 font-mono text-sm waterfall-mask h-[420px] overflow-hidden relative\" data-kid=\"3-8-1-2-2\" data-name=\"log scrolling window\">\n                    <div class=\"waterfall-scroll flex flex-col gap-3\" data-dynamic=\"true\" data-kid=\"3-8-1-2-2-1\" data-name=\"log items list\" data-reason=\"position y translated by gs-animation\">\n                        <div class=\"text-[var(--color-lime)]\" data-kid=\"3-8-1-2-2-1-1\" data-name=\"log item\">\n                            [ACTION] Navigating to LinkedIn Sales Navigator...\n                        </div>\n                        <div class=\"text-[var(--color-neon-cyan)]\" data-kid=\"3-8-1-2-2-1-2\" data-name=\"log item\">\n                            [SEARCH] Query: \"VP of Engineering at AI Startups\"\n                        </div>\n                        <div class=\"text-white/40\" data-kid=\"3-8-1-2-2-1-3\" data-name=\"log item\">\n                            [LOG] 42 matches found. Initializing scoring engine...\n                        </div>\n                        <div class=\"text-[var(--color-pink)]\" data-kid=\"3-8-1-2-2-1-4\" data-name=\"log item\">\n                            [TASK] Summarizing profile for Sarah Chen (Chief Architect)...\n                        </div>\n                        <div class=\"text-[var(--color-lime)]\" data-kid=\"3-8-1-2-2-1-5\" data-name=\"log item\">\n                            [ACTION] Drafted personalized message via InMail. Reference: \"Interstellar paper\".\n                        </div>\n                        <div class=\"text-[var(--color-orange)]\" data-kid=\"3-8-1-2-2-1-6\" data-name=\"log item\">\n                            [WAIT] Checking calendar for available slots...\n                        </div>\n                        <div class=\"text-[var(--color-lime)]\" data-kid=\"3-8-1-2-2-1-7\" data-name=\"log item\">\n                            [ACTION] Booked introductory call on Tuesday 2PM.\n                        </div>\n                        <div class=\"text-white/60\" data-kid=\"3-8-1-2-2-1-8\" data-name=\"log item\">\n                            [SUCCESS] Email confirmation sent to both parties.\n                        </div>\n                        <div class=\"text-white/20\" data-kid=\"3-8-1-2-2-1-9\" data-name=\"log item\">\n                            --- NEXT TASK / BATCH_02 ---\n                        </div>\n                        <div class=\"text-[var(--color-lime)]\" data-kid=\"3-8-1-2-2-1-10\" data-name=\"log item\">\n                            [ACTION] Opening Stripe Dashboard...\n                        </div>\n                        <div class=\"text-[var(--color-neon-cyan)]\" data-kid=\"3-8-1-2-2-1-11\" data-name=\"log item\">\n                            [QUERY] \"Revenue trends for last 30 days\"\n                        </div>\n                        <div class=\"text-white/40\" data-kid=\"3-8-1-2-2-1-12\" data-name=\"log item\">\n                            [LOG] Anomalous growth detected in APAC region (+18.4%).\n                        </div>\n                        <div class=\"text-[var(--color-pink)]\" data-kid=\"3-8-1-2-2-1-13\" data-name=\"log item\">\n                            [TASK] Creating Slack report for #growth-ops\n                        </div>\n                        <!-- Repeat for seamless loop effect if needed -->\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Final Chapter: Meet Collision (Black/Pink) -->\n    <section class=\"py-64 px-16 text-center relative overflow-hidden\" data-kid=\"3-9\" data-name=\"waitlist section\">\n        <!-- Pulsing Neural Orb in background -->\n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-[var(--color-pink)]/5 rounded-full blur-[120px] animate-pulse-slow\" data-kid=\"3-9-1\" data-name=\"pulsing neural orb\">\n        </div>\n        <div class=\"relative z-10 max-w-4xl mx-auto\" data-kid=\"3-9-2\" data-name=\"waitlist content container\">\n            <h2 class=\"text-[160px] font-bold tracking-[-0.06em] leading-none mb-16 waitlist-title\" data-kid=\"3-9-2-1\" data-name=\"section headline\">\n                Meet\n                <br data-kid=\"3-9-2-1-1\" data-name=\"line break\"/>\n                Collision.\n            </h2>\n            <p class=\"text-3xl text-white/50 mb-20 leading-relaxed font-light\" data-kid=\"3-9-2-2\" data-name=\"section description text\">\n                Collision isn't pretending to be human. It's something new. A software being built to work alongside you.\n                <span class=\"text-white\" data-kid=\"3-9-2-2-1\" data-name=\"emphasized text span\">\n                    Persistent. Autonomous. Internet-native.\n                </span>\n            </p>\n            <div class=\"flex flex-col items-center gap-12\" data-kid=\"3-9-2-3\" data-name=\"cta group\">\n                <button class=\"px-20 py-10 bg-white text-black text-4xl font-bold rounded-full hover:scale-105 transition-transform shadow-[0_0_80px_rgba(255,89,199,0.3)] cursor-pointer border-4 border-[var(--color-pink)]\" data-kid=\"3-9-2-3-1\" data-name=\"waitlist join cta button\">\n                    Join the Waitlist\n                </button>\n                <div class=\"flex items-center gap-8 font-mono text-sm tracking-[0.3em] uppercase text-white/30\" data-kid=\"3-9-2-3-2\" data-name=\"meta info group\">\n                    <span data-kid=\"3-9-2-3-2-1\" data-name=\"arrival date text\">\n                        EST. Arrival 2026\n                    </span>\n                    <span class=\"w-2 h-2 bg-white/20 rounded-full\" data-kid=\"3-9-2-3-2-2\" data-name=\"separator dot\">\n                    </span>\n                    <span data-kid=\"3-9-2-3-2-3\" data-name=\"batch info text\">\n                        Limited Batch 01\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"py-16 px-16 border-t border-white/5 flex items-center justify-between text-white/40 font-mono text-xs uppercase tracking-widest\" data-kid=\"3-10\" data-name=\"footer bar\">\n        <div data-kid=\"3-10-1\" data-name=\"copyright text\">\n            © 2026 Collision Labs Inc.\n        </div>\n        <div class=\"flex gap-12\" data-kid=\"3-10-2\" data-name=\"footer link group\">\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-10-2-1\" data-name=\"manifesto link\" href=\"#\">\n                Manifesto\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-10-2-2\" data-name=\"docs link\" href=\"#\">\n                Documentation\n            </a>\n            <a class=\"hover:text-white transition-colors\" data-kid=\"3-10-2-3\" data-name=\"security link\" href=\"#\">\n                Security\n            </a>\n        </div>\n        <div data-kid=\"3-10-3\" data-name=\"footer product info\">\n            Software Being / 001\n        </div>\n    </footer>\n</main>\n<script>\n    // GSAP Animations\n  window.addEventListener('load', () => {\n    // Hero Entrance\n    const tl = gsap.timeline();\n    tl.from('.hero-text-container h1', { opacity: 0, y: 100, duration: 1.2, ease: 'power4.out' })\n      .from('.hero-text-container p', { opacity: 0, y: 20, duration: 0.8, stagger: 0.2 }, '-=0.8')\n      .from('.hero-text-container button', { opacity: 0, scale: 0.8, duration: 0.8, stagger: 0.2, ease: 'back.out(1.7)' }, '-=0.6')\n      .from('.hero-img', { opacity: 0, scale: 0.5, duration: 1.5, ease: 'power2.out' }, '-=1.2')\n      .from('.activity-card', { opacity: 0, x: 50, duration: 1, ease: 'power2.out' }, '-=0.5');\n\n    // Scroll Trigger for Sections\n    gsap.from('.shift-title', {\n      scrollTrigger: { trigger: '.shift-title', start: 'top 80%' },\n      opacity: 0, y: 100, duration: 1.2, ease: 'power3.out'\n    });\n    \n    gsap.from('.shift-card-left', {\n      scrollTrigger: { trigger: '.shift-card-left', start: 'top 80%' },\n      opacity: 0, x: -100, rotate: -10, duration: 1.2\n    });\n    \n    gsap.from('.shift-card-right', {\n      scrollTrigger: { trigger: '.shift-card-right', start: 'top 80%' },\n      opacity: 0, x: 100, rotate: 10, duration: 1.2\n    });\n\n    gsap.from('.infinite-roles-container', {\n      scrollTrigger: { trigger: '.infinite-roles-container', start: 'top 70%' },\n      scale: 0.9, opacity: 0, duration: 1.5, ease: 'expo.out'\n    });\n\n    gsap.from('.connection-img-container', {\n      scrollTrigger: { trigger: '.connection-img-container', start: 'top 70%' },\n      opacity: 0, scale: 0.8, duration: 1.5, ease: 'power3.out'\n    });\n\n    gsap.from('.memory-container', {\n      scrollTrigger: { trigger: '.memory-section-trigger', start: 'top 70%' },\n      opacity: 0, scale: 0.95, y: 100, duration: 1.5, ease: 'expo.out'\n    });\n\n    gsap.from('.memory-path', {\n      scrollTrigger: { trigger: '.memory-section-trigger', start: 'top 70%' },\n      strokeDasharray: 1000,\n      strokeDashoffset: 1000,\n      duration: 4,\n      ease: 'power1.inOut'\n    });\n\n    // Role Ticker Inflating Logic\n    const tickerItems = document.querySelectorAll('.role-ticker-item');\n    setInterval(() => {\n      const activeIdx = Math.floor(Math.random() * tickerItems.length);\n      tickerItems.forEach(item => item.classList.remove('active'));\n      tickerItems[activeIdx].classList.add('active');\n    }, 2000);\n\n    // Waterfall Animation\n    gsap.to('.waterfall-scroll', {\n      y: '-50%',\n      duration: 15,\n      ease: 'linear',\n      repeat: -1\n    });\n\n    // Cursor Aura Tracking\n    const aura = document.getElementById('cursorAura');\n    let mouseX = 0, mouseY = 0;\n    let auraX = 0, auraY = 0;\n\n    window.addEventListener('mousemove', (e) => {\n      mouseX = e.clientX;\n      mouseY = e.clientY;\n    });\n\n    function updateAura() {\n      auraX += (mouseX - auraX) * 0.1;\n      auraY += (mouseY - auraY) * 0.1;\n      aura.style.left = `${auraX}px`;\n      aura.style.top = `${auraY}px`;\n      requestAnimationFrame(updateAura);\n    }\n    updateAura();\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-03T11:53:44.693492+00:00",
      "modified": "2026-08-03T11:53:44.693492+00:00",
      "id": "var_870620db57b5",
      "viewportScrollY": 0
    },
    "var_ba6164ee95d3": {
      "type": "variant",
      "label": "Collision — Luminous Organism",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"bg-[#050508] text-[#E9E5FF] font-sans selection:bg-[#2563FF]/30 selection:text-white overflow-x-clip\" data-kid=\"1\" data-name=\"page root container\" id=\"root\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Geist:wght@100;300;400;500;600;700&family=JetBrains+Mono:wght@300;400&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n        @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n        :root {\n            --color-blue: #2563FF;\n            --color-cyan: #36E2FF;\n            --color-violet: #6B5CFF;\n            --color-indigo: #1A1B6B;\n            --color-lavender: #E9E5FF;\n            --color-coral: #FF6A88;\n            --color-orange: #FF9F43;\n            --color-pink: #FF59C7;\n            --color-lime: #C6FF5C;\n        }\n\n        .font-geist { font-family: 'Geist', sans-serif; }\n        .font-mono { font-family: 'JetBrains Mono', monospace; }\n\n        /* Custom Scrollbar */\n        ::-webkit-scrollbar { width: 4px; }\n        ::-webkit-scrollbar-track { background: transparent; }\n        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n\n        /* Dynamic Background Gradient Journey */\n        .gradient-journey {\n            background: linear-gradient(-45deg, #020205, #0a0a1a, #1A1B6B, #2563FF, #6B5CFF, #FF59C7, #FF9F43, #36E2FF, #020205);\n            background-size: 400% 400%;\n            animation: gradientJourney 40s ease infinite;\n            opacity: 0.12;\n            filter: blur(120px);\n        }\n\n        @keyframes gradientJourney {\n            0% { background-position: 0% 50%; }\n            50% { background-position: 100% 50%; }\n            100% { background-position: 0% 50%; }\n        }\n\n        /* Glass Bubbles */\n        .glass-bubble {\n            background: rgba(255, 255, 255, 0.02);\n            backdrop-filter: blur(40px);\n            border: 1px solid rgba(255, 255, 255, 0.06);\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);\n            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;\n        }\n\n        .glass-bubble:hover {\n            border-color: rgba(255, 255, 255, 0.15);\n            transform: translateY(-8px) scale(1.01);\n        }\n\n        /* Orb Breathing & Pulsing */\n        .orb-pulse {\n            animation: orbPulse 8s ease-in-out infinite;\n        }\n\n        @keyframes orbPulse {\n            0%, 100% { transform: scale(1); filter: brightness(1); }\n            50% { transform: scale(1.08); filter: brightness(1.2) drop-shadow(0 0 80px rgba(37, 99, 255, 0.4)); }\n        }\n\n        /* Orbital Rings */\n        .orbit-ring {\n            position: absolute;\n            border: 1px solid rgba(255, 255, 255, 0.05);\n            border-radius: 50%;\n            pointer-events: none;\n        }\n\n        /* Cursor Aura */\n        .cursor-aura {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 400px;\n            height: 400px;\n            background: radial-gradient(circle, rgba(37, 99, 255, 0.1) 0%, transparent 70%);\n            pointer-events: none;\n            z-index: 9999;\n            transform: translate(-50%, -50%);\n            transition: opacity 0.3s ease;\n        }\n\n        /* Telemetry Ticker */\n        .ticker-wrap {\n            overflow: hidden;\n            white-space: nowrap;\n        }\n        .ticker-move {\n            display: inline-block;\n            animation: ticker 60s linear infinite;\n        }\n        @keyframes ticker {\n            0% { transform: translateX(0); }\n            100% { transform: translateX(-50%); }\n        }\n\n        /* Floating elements movement */\n        .float-slow { animation: floatSlow 6s ease-in-out infinite; }\n        @keyframes floatSlow {\n            0%, 100% { transform: translateY(0px); }\n            50% { transform: translateY(-20px); }\n        }\n\n        /* Scroll Progress Reveal - Handled via Motion JS for reliability */\n        .reveal-up {\n            will-change: transform, opacity;\n        }\n\n        /* Role Pill Active */\n        .role-pill.active {\n            background: white;\n            color: black;\n            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);\n        }\n    </style>\n    <!-- Cursor Aura (JS Updated) -->\n    <div class=\"cursor-aura\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"cursor aura effect\" data-reason=\"position updated continuously by mousemove event listener\" id=\"cursor-aura\">\n    </div>\n    <!-- Minimal Top Bar -->\n    <nav class=\"fixed top-0 left-0 w-full z-50 px-12 py-8 flex justify-between items-center mix-blend-difference\" data-kid=\"1-2\" data-name=\"main navigation bar\">\n        <div class=\"flex items-center gap-12\" data-kid=\"1-2-1\" data-name=\"brand and label container\">\n            <span class=\"font-geist text-2xl font-bold tracking-tighter\" data-kid=\"1-2-1-1\" data-name=\"brand name\">\n                Collision\n            </span>\n            <div class=\"flex items-center gap-2 opacity-50 font-mono text-[10px] tracking-[0.2em]\" data-kid=\"1-2-1-2\" data-name=\"software identifier tag\">\n                <span class=\"w-1 h-1 rounded-full bg-white\" data-kid=\"1-2-1-2-1\" data-name=\"status dot\">\n                </span>\n                SOFTWARE BEING / 01\n            </div>\n        </div>\n        <div class=\"flex items-center gap-8\" data-kid=\"1-2-2\" data-name=\"navigation links and cta container\">\n            <a class=\"text-xs font-mono opacity-50 hover:opacity-100 transition-opacity uppercase tracking-widest\" data-kid=\"1-2-2-1\" data-name=\"chapters link\" href=\"#\">\n                Chapters\n            </a>\n            <a class=\"text-xs font-mono opacity-50 hover:opacity-100 transition-opacity uppercase tracking-widest\" data-kid=\"1-2-2-2\" data-name=\"intelligence link\" href=\"#\">\n                Intelligence\n            </a>\n            <button class=\"px-6 py-2.5 glass-bubble rounded-full text-xs font-semibold uppercase tracking-widest hover:bg-white hover:text-black transition-all\" data-kid=\"1-2-2-3\" data-name=\"early access button\">\n                Early Access\n            </button>\n        </div>\n    </nav>\n    <!-- Global Background Journey Overlay -->\n    <div class=\"fixed inset-0 pointer-events-none z-0\" data-kid=\"1-3\" data-name=\"background layer\">\n        <div class=\"gradient-journey absolute inset-0\" data-kid=\"1-3-1\" data-name=\"dynamic gradient journey\">\n        </div>\n    </div>\n    <!-- HERO VIEWPORT -->\n    <section class=\"relative h-screen flex flex-col items-center justify-center pt-20 px-20 overflow-hidden\" data-kid=\"1-4\" data-name=\"hero section\" id=\"hero\">\n        <!-- Giant \"Collision\" Text background - Moved deeper -->\n        <div class=\"absolute -top-[10%] -left-[5%] z-0 pointer-events-none w-full select-none\" data-kid=\"1-4-1\" data-name=\"giant text background container\">\n            <h1 class=\"font-geist text-[30vw] font-black leading-[0.7] tracking-[-0.08em] text-white opacity-[0.01] uppercase\" data-kid=\"1-4-1-1\" data-name=\"giant background heading\">\n                Collision\n            </h1>\n        </div>\n        <!-- Headline & Copy - Varied Layout -->\n        <div class=\"absolute top-[25%] left-24 z-20 max-w-3xl\" data-kid=\"1-4-2\" data-name=\"hero content container\">\n            <h2 class=\"font-geist text-9xl font-thin tracking-tighter leading-[0.85] mb-12 text-[#E9E5FF] reveal-up\" data-kid=\"1-4-2-1\" data-name=\"hero headline\">\n                The first\n                <br data-kid=\"1-4-2-1-1\" data-name=\"headline line break\"/>\n                <span class=\"font-light text-[#36E2FF]\" data-kid=\"1-4-2-1-2\" data-name=\"software being span\">\n                    software being.\n                </span>\n            </h2>\n            <div class=\"flex gap-12 font-mono text-xs uppercase tracking-[0.4em] text-white/40 mb-16\" data-kid=\"1-4-2-2\" data-name=\"hero capability tags container\">\n                <span class=\"reveal-up\" data-kid=\"1-4-2-2-1\" data-name=\"capability tag one\">\n                    It thinks.\n                </span>\n                <span class=\"reveal-up\" data-kid=\"1-4-2-2-2\" data-name=\"capability tag two\">\n                    It remembers.\n                </span>\n                <span class=\"reveal-up\" data-kid=\"1-4-2-2-3\" data-name=\"capability tag three\">\n                    It works.\n                </span>\n            </div>\n            <p class=\"mt-4 text-2xl font-light opacity-40 max-w-lg leading-relaxed reveal-up\" data-kid=\"1-4-2-3\" data-name=\"hero description text\">\n                Give it access to your browser, email, calendar, LinkedIn, X, WhatsApp, and the rest of your stack.\n            </p>\n            <div class=\"mt-12 flex items-center gap-8\" data-kid=\"1-4-2-4\" data-name=\"hero action buttons container\">\n                <button class=\"px-10 py-5 bg-[#2563FF] text-white rounded-full text-sm font-bold tracking-wide shadow-[0_0_60px_rgba(37,99,255,0.4)] hover:scale-105 transition-transform duration-300\" data-kid=\"1-4-2-4-1\" data-name=\"get early access button\">\n                    Get Early Access\n                </button>\n                <button class=\"group flex items-center gap-3 text-sm font-medium tracking-wide opacity-80 hover:opacity-100 transition-opacity\" data-kid=\"1-4-2-4-2\" data-name=\"watch demo button\">\n                    Watch Collision Work\n                    <i class=\"ti ti-arrow-right text-lg group-hover:translate-x-1 transition-transform\" data-kid=\"1-4-2-4-2-1\" data-name=\"arrow icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <!-- Central Orb Organism -->\n        <div class=\"relative w-[800px] h-[800px] flex items-center justify-center transition-transform duration-700 ease-out z-10\" data-dynamic=\"true\" data-kid=\"1-4-3\" data-name=\"orb container\" data-reason=\"position updated by mousemove event listener\" id=\"orb-container\">\n            <!-- Layers of Rings -->\n            <div class=\"orbit-ring w-[100%] h-[100%] opacity-20 rotate-45 border-white/5\" data-kid=\"1-4-3-1\" data-name=\"outer orbit ring\">\n            </div>\n            <div class=\"orbit-ring w-[80%] h-[80%] opacity-30 -rotate-12 border-white/10\" data-kid=\"1-4-3-2\" data-name=\"middle orbit ring\">\n            </div>\n            <div class=\"orbit-ring w-[60%] h-[60%] opacity-50 rotate-90 border-[#36E2FF]/10\" data-kid=\"1-4-3-3\" data-name=\"inner orbit ring\">\n            </div>\n            <!-- Particle Field (Simplified for CSS) -->\n            <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"1-4-3-4\" data-name=\"particle field container\">\n                <div class=\"absolute top-1/4 left-1/4 w-1 h-1 bg-white rounded-full animate-ping opacity-20\" data-kid=\"1-4-3-4-1\" data-name=\"ping particle\">\n                </div>\n                <div class=\"absolute bottom-1/3 right-1/4 w-1.5 h-1.5 bg-[#FF59C7] rounded-full animate-pulse opacity-30\" data-kid=\"1-4-3-4-2\" data-name=\"pulse particle\">\n                </div>\n                <div class=\"absolute top-1/2 left-2/3 w-0.5 h-0.5 bg-[#36E2FF] rounded-full animate-bounce opacity-40\" data-kid=\"1-4-3-4-3\" data-name=\"bounce particle\">\n                </div>\n            </div>\n            <!-- The Core Video Orb -->\n            <div class=\"relative w-96 h-96 rounded-full overflow-hidden orb-pulse shadow-[0_0_120px_rgba(54,226,255,0.3)] z-20\" data-kid=\"1-4-3-5\" data-name=\"video orb container\">\n                <video autoplay=\"\" class=\"w-full h-full object-cover scale-105\" data-kid=\"1-4-3-5-1\" data-name=\"core video player\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://kombai-assets.b-cdn.net/generated_assets/e60e2319a73d47f28994ff00ef63dd60.jpg\" preload=\"metadata\" src=\"https://kombai-assets.b-cdn.net/generated_assets/134183b3-7657-46b7-aa44-253d94a33dc8/3c40d34058c54190a30a17aa9f5d7ac5.mp4\">\n                </video>\n                <!-- Inner Glow Overlay -->\n                <div class=\"absolute inset-0 bg-gradient-to-tr from-[#2563FF]/20 to-transparent mix-blend-overlay\" data-kid=\"1-4-3-5-2\" data-name=\"inner glow overlay\">\n                </div>\n            </div>\n            <!-- Floating Translucent Transcript Bubble -->\n            <div class=\"absolute -bottom-10 -right-20 w-[380px] glass-bubble rounded-[80px] p-10 float-slow z-30 border-white/10\" data-kid=\"1-4-3-6\" data-name=\"floating transcript bubble\">\n                <div class=\"flex items-center gap-3 mb-8\" data-kid=\"1-4-3-6-1\" data-name=\"bubble header\">\n                    <div class=\"w-2 h-2 rounded-full bg-[#36E2FF] animate-pulse shadow-[0_0_10px_#36E2FF]\" data-kid=\"1-4-3-6-1-1\" data-name=\"live status dot\">\n                    </div>\n                    <span class=\"text-[10px] font-mono opacity-50 uppercase tracking-[0.3em]\" data-kid=\"1-4-3-6-1-2\" data-name=\"bubble label\">\n                        Collision Intelligence\n                    </span>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"1-4-3-6-2\" data-name=\"transcript body\">\n                    <p class=\"text-base font-light leading-relaxed text-[#E9E5FF] italic\" data-kid=\"1-4-3-6-2-1\" data-name=\"transcript text\">\n                        \"Good afternoon. I've already reviewed today's calendar. 3 emails need replies. 2 meetings need preparation. One customer hasn't been followed up. What should I take ownership of?\"\n                    </p>\n                    <div class=\"pt-8 space-y-4 border-t border-white/5\" data-kid=\"1-4-3-6-2-2\" data-name=\"stats container\">\n                        <div class=\"flex justify-between items-center text-[10px] font-mono\" data-kid=\"1-4-3-6-2-2-1\" data-name=\"calendar stat\">\n                            <span class=\"opacity-40\" data-kid=\"1-4-3-6-2-2-1-1\" data-name=\"calendar label\">\n                                CALENDAR\n                            </span>\n                            <span class=\"text-[#36E2FF] tracking-widest\" data-kid=\"1-4-3-6-2-2-1-2\" data-name=\"calendar value\">\n                                REVIEWED\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between items-center text-[10px] font-mono\" data-kid=\"1-4-3-6-2-2-2\" data-name=\"email stat\">\n                            <span class=\"opacity-40\" data-kid=\"1-4-3-6-2-2-2-1\" data-name=\"email label\">\n                                EMAIL REPLIES\n                            </span>\n                            <span class=\"text-[#6B5CFF] tracking-widest\" data-kid=\"1-4-3-6-2-2-2-2\" data-name=\"email value\">\n                                3 PENDING\n                            </span>\n                        </div>\n                        <div class=\"flex justify-between items-center text-[10px] font-mono\" data-kid=\"1-4-3-6-2-2-3\" data-name=\"prep meetings stat\">\n                            <span class=\"opacity-40\" data-kid=\"1-4-3-6-2-2-3-1\" data-name=\"prep meetings label\">\n                                PREP MEETINGS\n                            </span>\n                            <span class=\"text-[#FF9F43] tracking-widest\" data-kid=\"1-4-3-6-2-2-3-2\" data-name=\"prep meetings value\">\n                                2 ACTIVE\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Scroll Hint -->\n        <div class=\"absolute bottom-12 flex flex-col items-center gap-2 opacity-30 animate-bounce\" data-kid=\"1-4-4\" data-name=\"scroll hint container\">\n            <span class=\"text-[9px] font-mono tracking-[0.3em] uppercase\" data-kid=\"1-4-4-1\" data-name=\"scroll hint text\">\n                Begin Story\n            </span>\n            <i class=\"ti ti-chevron-down\" data-kid=\"1-4-4-2\" data-name=\"scroll hint icon\">\n            </i>\n        </div>\n    </section>\n    <!-- CHAPTER 02: THE SHIFT -->\n    <section class=\"min-h-screen py-40 px-20 flex items-center bg-[#08080A] relative overflow-hidden\" data-kid=\"1-5\" data-name=\"chapter two section\" id=\"shift\">\n        <div class=\"absolute inset-0 opacity-20 pointer-events-none\" data-kid=\"1-5-1\" data-name=\"section background container\">\n            <img class=\"w-full h-full object-cover grayscale brightness-50\" data-kid=\"1-5-1-1\" data-name=\"background image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/e60e2319a73d47f28994ff00ef63dd60.jpg?auto=format&w=1920&q=80&fit=crop\"/>\n        </div>\n        <div class=\"max-w-6xl mx-auto grid grid-cols-2 gap-24 items-center relative z-10\" data-kid=\"1-5-2\" data-name=\"content grid\">\n            <div class=\"space-y-12\" data-kid=\"1-5-2-1\" data-name=\"text column\">\n                <span class=\"text-[10px] font-mono text-[#2563FF] tracking-[0.5em] uppercase block\" data-kid=\"1-5-2-1-1\" data-name=\"chapter label\">\n                    Chapter 02 // The Shift\n                </span>\n                <h2 class=\"text-[10rem] font-geist font-thin tracking-tighter leading-[0.75] reveal-up\" data-kid=\"1-5-2-1-2\" data-name=\"section headline\">\n                    Software\n                    <br data-kid=\"1-5-2-1-2-1\" data-name=\"headline line break one\"/>\n                    used to\n                    <br data-kid=\"1-5-2-1-2-2\" data-name=\"headline line break two\"/>\n                    <span class=\"line-through opacity-20\" data-kid=\"1-5-2-1-2-3\" data-name=\"strikethrough text\">\n                        wait.\n                    </span>\n                </h2>\n                <div class=\"space-y-6 text-xl font-light opacity-50 max-w-md\" data-kid=\"1-5-2-1-3\" data-name=\"description text container\">\n                    <p data-kid=\"1-5-2-1-3-1\" data-name=\"description line one\">\n                        Clicked buttons. Filled forms. Copied text. Moved between tabs.\n                    </p>\n                    <p data-kid=\"1-5-2-1-3-2\" data-name=\"description line two\">\n                        Software used to wait for your permission.\n                    </p>\n                </div>\n            </div>\n            <div class=\"relative\" data-kid=\"1-5-2-2\" data-name=\"visual column\">\n                <div class=\"glass-bubble rounded-[100px] p-20 border-white/10 relative overflow-hidden shadow-[0_40px_100px_rgba(0,0,0,0.8)]\" data-kid=\"1-5-2-2-1\" data-name=\"glass card\">\n                    <div class=\"absolute inset-0 bg-gradient-to-br from-[#2563FF]/10 to-transparent\" data-kid=\"1-5-2-2-1-1\" data-name=\"glass card gradient\">\n                    </div>\n                    <h3 class=\"text-7xl font-geist font-thin tracking-tighter mb-8 leading-tight reveal-up\" data-kid=\"1-5-2-2-1-2\" data-name=\"card headline\">\n                        Collision\n                        <br data-kid=\"1-5-2-2-1-2-1\" data-name=\"card headline break\"/>\n                        <span class=\"text-[#36E2FF] font-light\" data-kid=\"1-5-2-2-1-2-2\" data-name=\"card headline focus\">\n                            works instead.\n                        </span>\n                    </h3>\n                    <p class=\"text-xl font-light opacity-60 leading-relaxed mb-12\" data-kid=\"1-5-2-2-1-3\" data-name=\"card description\">\n                        Tell Collision what you want done.\n                        <br data-kid=\"1-5-2-2-1-3-1\" data-name=\"description break\"/>\n                        Stop telling software what to do.\n                    </p>\n 