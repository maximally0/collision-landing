        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen overflow-hidden bg-[#fbfaf6] text-[#15213a] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'DM Sans',sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap');\n    .collision-serif{font-family:'Lora',serif}\n    .blue-rule{height:1px;background:rgba(21,33,58,.18)}\n    .quiet-float{animation:quiet-float 8s ease-in-out infinite}\n    .sun-haze{animation:sun-haze 12s ease-in-out infinite}\n    @keyframes quiet-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}\n    @keyframes sun-haze{0%,100%{opacity:.42;transform:scale(1)}50%{opacity:.7;transform:scale(1.08)}}\n    @media (prefers-reduced-motion:reduce){.quiet-float,.sun-haze{animation:none}}\n    </style>\n    <nav aria-label=\"Primary navigation\" class=\"absolute inset-x-0 top-0 z-30\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <div class=\"mx-auto flex max-w-[1120px] items-center justify-between px-7 py-6 lg:px-0\" data-kid=\"1-1-1\" data-name=\"navigation container\">\n            <a aria-label=\"Collision home\" class=\"flex items-center gap-3 text-white\" data-kid=\"1-1-1-1\" data-name=\"brand identity logo link\" href=\"#top\">\n                <img alt=\"Collision helmet mark\" class=\"h-8 w-8 rounded-full object-cover ring-1 ring-white/40\" data-kid=\"1-1-1-1-1\" data-name=\"brand helmet icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend-new/public/collision-helmet.png\"/>\n                <span class=\"text-[17px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    collision.\n                </span>\n            </a>\n            <div class=\"hidden items-center gap-8 text-[11px] font-medium tracking-[0.08em] text-white/80 md:flex\" data-kid=\"1-1-1-2\" data-name=\"nav link group\">\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link approach\" href=\"#approach\">\n                    Approach\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link what we own\" href=\"#ownership\">\n                    What we own\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link behind the scenes\" href=\"#behind\">\n                    Behind the scenes\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-4\" data-name=\"navigation link proof\" href=\"#proof\">\n                    Proof\n                </a>\n            </div>\n            <a class=\"rounded-full bg-[#1f5eff] px-5 py-2.5 text-[12px] font-semibold text-white ring-1 ring-white/40 hover:bg-[#1745c2]\" data-kid=\"1-1-1-3\" data-name=\"hire collision cta button\" href=\"#contact\">\n                Hire Collision\n            </a>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative isolate flex min-h-[760px] items-center overflow-hidden bg-[#77d8ef]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <video autoplay=\"\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/14017302/pexels-photo-14017302.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/14017302/14017302-sd_960_540_30fps.mp4\">\n            </video>\n            <div class=\"absolute inset-0 bg-[#57cce9]/45 mix-blend-color\" data-kid=\"1-2-1-2\" data-name=\"hero overlay color 1\">\n            </div>\n            <div class=\"absolute inset-0 bg-[#12335a]/38\" data-kid=\"1-2-1-3\" data-name=\"hero overlay color 2\">\n            </div>\n            <div class=\"absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-[#0c2749]/75 via-[#144b6c]/24 to-transparent\" data-kid=\"1-2-1-4\" data-name=\"hero bottom gradient fade\">\n            </div>\n            <div class=\"sun-haze absolute right-[14%] top-[17%] h-48 w-48 rounded-full bg-[#ffe16a]/35 blur-3xl\" data-kid=\"1-2-1-5\" data-name=\"hero decorative sun haze\">\n            </div>\n            <div class=\"relative z-10 mx-auto flex w-full max-w-[980px] flex-col items-center px-7 pb-12 pt-32 text-center text-white lg:px-0\" data-kid=\"1-2-1-6\" data-name=\"hero text content container\">\n                <p class=\"mb-6 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/75\" data-kid=\"1-2-1-6-1\" data-name=\"hero subheadline\">\n                    The AI you hire to run growth\n                </p>\n                <h1 class=\"collision-serif max-w-[900px] text-[48px] font-medium leading-[1.02] tracking-[-0.06em] sm:text-[70px] lg:text-[82px]\" data-kid=\"1-2-1-6-2\" data-name=\"hero main headline\" id=\"hero-title\">\n                    One intelligence for your whole\n                    <em class=\"font-normal text-[#ffe16a]\" data-kid=\"1-2-1-6-2-1\" data-name=\"hero headline emphasis text\">\n                        growth function.\n                    </em>\n                </h1>\n                <p class=\"mt-7 max-w-[760px] text-[16px] leading-7 text-white/88 sm:text-[18px]\" data-kid=\"1-2-1-6-3\" data-name=\"hero description text\">\n                    Collision understands your business and executes across LinkedIn, X, SEO, AI search, newsletters, Gmail, outbound, and store growth — while it coordinates the rest of the work behind the scenes.\n                </p>\n                <div class=\"quiet-float mt-10 w-full max-w-[780px] rounded-[18px] bg-[#fbfaf6] p-2.5 text-left text-[#15213a] ring-1 ring-white/55\" data-kid=\"1-2-1-6-4\" data-name=\"hero interactive prompt input box\">\n                    <div class=\"flex flex-col gap-2 sm:flex-row sm:items-center\" data-kid=\"1-2-1-6-4-1\" data-name=\"hero prompt input layout\">\n                        <div class=\"flex-1 px-4 py-4 text-[15px] text-[#69798a]\" data-kid=\"1-2-1-6-4-1-1\" data-name=\"hero prompt placeholder text\">\n                            What should we grow today?\n                        </div>\n                        <button class=\"rounded-[12px] bg-[#1f5eff] px-6 py-4 text-[13px] font-semibold text-white hover:bg-[#1745c2]\" data-kid=\"1-2-1-6-4-1-2\" data-name=\"hero run growth button\">\n                            Run growth\n                        </button>\n                    </div>\n                    <div class=\"flex flex-wrap gap-2 border-t border-[#15213a]/10 px-3 pb-2 pt-3\" data-kid=\"1-2-1-6-4-2\" data-name=\"hero quick action tag group\">\n                        <span class=\"rounded-full bg-[#e9f8fb] px-3.5 py-2 text-[11px] text-[#52667d]\" data-kid=\"1-2-1-6-4-2-1\" data-name=\"hero action tag launch\">\n                            Launch our product\n                        </span>\n                        <span class=\"rounded-full bg-[#e9f8fb] px-3.5 py-2 text-[11px] text-[#52667d]\" data-kid=\"1-2-1-6-4-2-2\" data-name=\"hero action tag linkedin\">\n                            Grow our LinkedIn\n                        </span>\n                        <span class=\"rounded-full bg-[#e9f8fb] px-3.5 py-2 text-[11px] text-[#52667d]\" data-kid=\"1-2-1-6-4-2-3\" data-name=\"hero action tag newsletter\">\n                            Write this week's newsletter\n                        </span>\n                        <span class=\"rounded-full bg-[#e9f8fb] px-3.5 py-2 text-[11px] text-[#52667d]\" data-kid=\"1-2-1-6-4-2-4\" data-name=\"hero action tag chatgpt\">\n                            Optimize us for ChatGPT\n                        </span>\n                        <span class=\"rounded-full bg-[#fff2cf] px-3.5 py-2 text-[11px] text-[#52667d]\" data-kid=\"1-2-1-6-4-2-5\" data-name=\"hero action tag signups\">\n                            Why are signups down?\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-[10px] font-medium uppercase tracking-[0.15em] text-white/70\" data-kid=\"1-2-1-6-5\" data-name=\"hero benefit indicator bar\">\n                    <span data-kid=\"1-2-1-6-5-1\" data-name=\"hero benefit text 1\">\n                        One conversation\n                    </span>\n                    <span class=\"text-white/35\" data-kid=\"1-2-1-6-5-2\" data-name=\"hero benefit separator 1\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-1-6-5-3\" data-name=\"hero benefit text 2\">\n                        One memory\n                    </span>\n                    <span class=\"text-white/35\" data-kid=\"1-2-1-6-5-4\" data-name=\"hero benefit separator 2\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-1-6-5-5\" data-name=\"hero benefit text 3\">\n                        One source of truth\n                    </span>\n                    <span class=\"ml-2 rounded-full bg-[#00e5c0]/90 px-3 py-1 text-[#12335a]\" data-kid=\"1-2-1-6-5-6\" data-name=\"hero approval badge\">\n                        approval-based\n                    </span>\n                </div>\n                <p class=\"mt-4 text-[11px] tracking-[0.08em] text-white/60\" data-kid=\"1-2-1-6-6\" data-name=\"hero non-chatbot text\">\n                    Not a chatbot. Not an agency. Not another dashboard.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"ownership-title\" class=\"bg-[#fbfaf6] px-7 py-24 lg:px-0 lg:py-28\" data-kid=\"1-2-2\" data-name=\"ownership features section\" id=\"ownership\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-2-1\" data-name=\"ownership features wrapper\">\n                <div class=\"grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end\" data-kid=\"1-2-2-1-1\" data-name=\"ownership features intro layout\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"ownership intro headline group\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"ownership overline\">\n                            The whole function\n                        </p>\n                        <h2 class=\"collision-serif mt-5 max-w-[570px] text-[45px] font-medium leading-[1.04] tracking-[-0.055em] text-[#15213a] sm:text-[64px]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"ownership main title\" id=\"ownership-title\">\n                            If it contributes to growth, Collision can own it.\n                        </h2>\n                    </div>\n                    <div class=\"border-l-2 border-[#1f5eff] pl-7 lg:mb-1\" data-kid=\"1-2-2-1-1-2\" data-name=\"ownership features description group\">\n                        <p class=\"text-[18px] leading-7 text-[#405570]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"ownership description\">\n                            Most AI products solve one problem. Collision owns one outcome:\n                            <span class=\"font-semibold text-[#1f5eff]\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"ownership description emphasis\">\n                                growth.\n                            </span>\n                        </p>\n                        <p class=\"mt-4 max-w-[510px] text-[14px] leading-6 text-[#6b7c8e]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"ownership detailed description\">\n                            Not another SEO tool. Not another writing tool. Not another analytics dashboard or marketing automation platform. One intelligence sees the full picture and makes decisions across every surface.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-16 border-y border-[#15213a]/15\" data-kid=\"1-2-2-1-2\" data-name=\"features list wrapper\">\n                    <div class=\"grid gap-5 border-b border-[#15213a]/12 py-7 lg:grid-cols-[160px_1fr_260px] lg:items-center\" data-kid=\"1-2-2-1-2-1\" data-name=\"feature item reach\">\n                        <div class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#1f5eff]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"feature item reach label\">\n                            Reach\n                        </div>\n                        <div class=\"collision-serif text-[25px] leading-[1.2] text-[#15213a]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"feature item reach platforms\">\n                            LinkedIn\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"feature item reach separator 1\">\n                                /\n                            </span>\n                            X\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"feature item reach separator 2\">\n                                /\n                            </span>\n                            SEO\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-1-2-3\" data-name=\"feature item reach separator 3\">\n                                /\n                            </span>\n                            AI Search\n                            <span class=\"text-[16px] text-[#667991]\" data-kid=\"1-2-2-1-2-1-2-4\" data-name=\"feature item reach subtext\">\n                                (ChatGPT, Perplexity, Google AI Overviews, Gemini)\n                            </span>\n                        </div>\n                        <p class=\"text-[13px] leading-5 text-[#6b7c8e]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"feature item reach summary\">\n                            Build demand where people are already looking.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-5 border-b border-[#15213a]/12 py-7 lg:grid-cols-[160px_1fr_260px] lg:items-center\" data-kid=\"1-2-2-1-2-2\" data-name=\"feature item content\">\n                        <div class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#ff7b63]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"feature item content label\">\n                            Content\n                        </div>\n                        <div class=\"collision-serif text-[25px] leading-[1.2] text-[#15213a]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"feature item content list\">\n                            Blogs\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"feature item content separator 1\">\n                                /\n                            </span>\n                            Newsletters\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"feature item content separator 2\">\n                                /\n                            </span>\n                            Landing Pages\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-2-2-3\" data-name=\"feature item content separator 3\">\n                                /\n                            </span>\n                            Website Copy\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-2-2-4\" data-name=\"feature item content separator 4\">\n                                /\n                            </span>\n                            Product Launches\n                        </div>\n                        <p class=\"text-[13px] leading-5 text-[#6b7c8e]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"feature item content summary\">\n                            Turn your point of view into a system people remember.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-5 border-b border-[#15213a]/12 py-7 lg:grid-cols-[160px_1fr_260px] lg:items-center\" data-kid=\"1-2-2-1-2-3\" data-name=\"feature item revenue\">\n                        <div class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#00a98e]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"feature item revenue label\">\n                            Revenue\n                        </div>\n                        <div class=\"collision-serif text-[25px] leading-[1.2] text-[#15213a]\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"feature item revenue list\">\n                            Gmail\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"feature item revenue separator 1\">\n                                /\n                            </span>\n                            Email Campaigns\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-3-2-2\" data-name=\"feature item revenue separator 2\">\n                                /\n                            </span>\n                            Outbound\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-3-2-3\" data-name=\"feature item revenue separator 3\">\n                                /\n                            </span>\n                            Storefront + Store Growth\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-3-2-4\" data-name=\"feature item revenue separator 4\">\n                                /\n                            </span>\n                            Community Distribution\n                        </div>\n                        <p class=\"text-[13px] leading-5 text-[#6b7c8e]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"feature item revenue summary\">\n                            Create the motion that turns attention into conversations.\n                        </p>\n                    </div>\n                    <div class=\"grid gap-5 py-7 lg:grid-cols-[160px_1fr_260px] lg:items-center\" data-kid=\"1-2-2-1-2-4\" data-name=\"feature item intelligence\">\n                        <div class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#c49722]\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"feature item intelligence label\">\n                            Intelligence\n                        </div>\n                        <div class=\"collision-serif text-[25px] leading-[1.2] text-[#15213a]\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"feature item intelligence list\">\n                            Competitor Research\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-4-2-1\" data-name=\"feature item intelligence separator 1\">\n                                /\n                            </span>\n                            Positioning\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-4-2-2\" data-name=\"feature item intelligence separator 2\">\n                                /\n                            </span>\n                            Messaging\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-4-2-3\" data-name=\"feature item intelligence separator 3\">\n                                /\n                            </span>\n                            Analytics\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-4-2-4\" data-name=\"feature item intelligence separator 4\">\n                                /\n                            </span>\n                            Growth Strategy\n                            <span class=\"text-[#a4b6c7]\" data-kid=\"1-2-2-1-2-4-2-5\" data-name=\"feature item intelligence separator 5\">\n                                /\n                            </span>\n                            Growth Experiments\n                        </div>\n                        <p class=\"text-[13px] leading-5 text-[#6b7c8e]\" data-kid=\"1-2-2-1-2-4-3\" data-name=\"feature item intelligence summary\">\n                            Learn what works, then make the next decision better.\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-7 text-right text-[13px] italic text-[#667991]\" data-kid=\"1-2-2-1-3\" data-name=\"features section concluding note\">\n                    You ask for the outcome. Collision figures out the work.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"approach-title\" class=\"bg-[#eaf9fb] px-7 py-28 lg:px-0 lg:py-36\" data-kid=\"1-2-3\" data-name=\"experience section\" id=\"approach\">\n            <div class=\"mx-auto grid max-w-[1120px] gap-16 lg:grid-cols-[1.1fr_.9fr] lg:items-center lg:gap-28\" data-kid=\"1-2-3-1\" data-name=\"experience grid wrapper\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"experience intro content\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-3-1-1-1\" data-name=\"experience overline\">\n                        The experience\n                    </p>\n                    <h2 class=\"collision-serif mt-6 max-w-[700px] text-[45px] font-medium leading-[1.06] tracking-[-0.055em] text-[#15213a] sm:text-[62px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"experience headline\" id=\"approach-title\">\n                        Working with Collision should feel like working with the best Head of Growth you've ever met.\n                    </h2>\n                    <p class=\"mt-8 max-w-[590px] text-[17px] leading-8 text-[#52667d]\" data-kid=\"1-2-3-1-1-3\" data-name=\"experience text\">\n                        You never think about prompts, workflows, or which AI model to use. You simply talk to Collision, and the work moves forward with context.\n                    </p>\n                </div>\n                <div class=\"space-y-6\" data-kid=\"1-2-3-1-2\" data-name=\"experience dialogue mock\">\n                    <div class=\"ml-0 max-w-[390px] border border-[#15213a]/15 bg-white p-6\" data-kid=\"1-2-3-1-2-1\" data-name=\"experience dialogue user\">\n                        <p class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#7f91a4]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"experience dialogue user label\">\n                            You\n                        </p>\n                        <p class=\"collision-serif text-[27px] leading-[1.15] text-[#15213a]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"experience dialogue user text\">\n                            “Launch our product.”\n                        </p>\n                    </div>\n                    <div class=\"ml-auto max-w-[430px] border border-[#1f5eff]/35 bg-[#1f5eff] p-6 text-white\" data-kid=\"1-2-3-1-2-2\" data-name=\"experience dialogue collision\">\n                        <p class=\"mb-3 text-right text-[10px] font-semibold uppercase tracking-[0.16em] text-white/65\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"experience dialogue collision label\">\n                            Collision\n                        </p>\n                        <p class=\"collision-serif text-[27px] leading-[1.15]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"experience dialogue collision text\">\n                            “Understood. I’ll research, plan, write, distribute, and learn.”\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"behind-title\" class=\"bg-[#123c78] px-7 py-24 text-white lg:px-0 lg:py-32\" data-kid=\"1-2-4\" data-name=\"behind scenes section\" id=\"behind\">\n            <div class=\"mx-auto grid max-w-[1120px] gap-16 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-28\" data-kid=\"1-2-4-1\" data-name=\"behind scenes grid\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"behind scenes intro group\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#9beef2]\" data-kid=\"1-2-4-1-1-1\" data-name=\"behind scenes overline\">\n                        Behind the scenes\n                    </p>\n                    <h2 class=\"collision-serif mt-6 max-w-[470px] text-[45px] font-medium leading-[1.06] tracking-[-0.055em] sm:text-[61px]\" data-kid=\"1-2-4-1-1-2\" data-name=\"behind scenes headline\" id=\"behind-title\">\n                        One conversation. A network of specialists.\n                    </h2>\n                    <p class=\"mt-7 max-w-[390px] text-[16px] leading-7 text-white/70\" data-kid=\"1-2-4-1-1-3\" data-name=\"behind scenes description\">\n                        Collision appears as a single AI. Behind that conversation, specialized systems handle the work. You only know Collision.\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap gap-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#15213a]\" data-kid=\"1-2-4-1-1-4\" data-name=\"behind scenes badge group\">\n                        <span class=\"rounded-full bg-[#00e5c0] px-3 py-2\" data-kid=\"1-2-4-1-1-4-1\" data-name=\"behind scenes badge approval\">\n                            approval-based\n                        </span>\n                        <span class=\"rounded-full bg-[#ffe16a] px-3 py-2\" data-kid=\"1-2-4-1-1-4-2\" data-name=\"behind scenes badge memory\">\n                            private memory\n                        </span>\n                        <span class=\"rounded-full bg-[#ff9b87] px-3 py-2\" data-kid=\"1-2-4-1-1-4-3\" data-name=\"behind scenes badge source\">\n                            one source of truth\n                        </span>\n                    </div>\n                </div>\n                <div class=\"border-y border-white/20\" data-kid=\"1-2-4-1-2\" data-name=\"behind scenes specializations\">\n                    <div class=\"flex items-center justify-between border-b border-white/20 py-5 text-[11px] uppercase tracking-[0.15em] text-[#b9d3ec]\" data-kid=\"1-2-4-1-2-1\" data-name=\"specialization header\">\n                        <span data-kid=\"1-2-4-1-2-1-1\" data-name=\"specialization header title\">\n                            Collision / operating layer\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-1-2\" data-name=\"specialization header status\">\n                            always on\n                        </span>\n                    </div>\n                    <div class=\"grid gap-0 sm:grid-cols-2\" data-kid=\"1-2-4-1-2-2\" data-name=\"specialization grid\">\n                        <div class=\"border-b border-white/15 py-6 sm:border-r sm:pr-8\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"specialization research\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"specialization research title\">\n                                Research\n                            </p>\n                            <p class=\"mt-2 text-[12px] text-white/55\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"specialization research description\">\n                                market, customer, competitor signals\n                            </p>\n                        </div>\n                        <div class=\"border-b border-white/15 py-6 sm:pl-8\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"specialization planning\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"specialization planning title\">\n                                Planning\n                            </p>\n                            <p class=\"mt-2 text-[12px] text-white/55\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"specialization planning description\">\n                                priorities, sequencing, experiments\n                            </p>\n                        </div>\n                        <div class=\"border-b border-white/15 py-6 sm:border-r sm:pr-8\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"specialization writing\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"specialization writing title\">\n                                Writing\n                            </p>\n                            <p class=\"mt-2 text-[12px] text-white/55\" data-kid=\"1-2-4-1-2-2-3-2\" data-name=\"specialization writing description\">\n                                posts, pages, emails, campaigns\n                            </p>\n                        </div>\n                        <div class=\"border-b border-white/15 py-6 sm:pl-8\" data-kid=\"1-2-4-1-2-2-4\" data-name=\"specialization optimization\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-4-1\" data-name=\"specialization optimization title\">\n                                Optimization\n                            </p>\n                            <p class=\"mt-2 text-[12px] text-white/55\" data-kid=\"1-2-4-1-2-2-4-2\" data-name=\"specialization optimization description\">\n                                SEO, AI search, conversion signals\n                            </p>\n                        </div>\n                        <div class=\"py-6 sm:border-r sm:pr-8\" data-kid=\"1-2-4-1-2-2-5\" data-name=\"specialization analysis\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-5-1\" data-name=\"specialization analysis title\">\n                                Analysis\n                            </p>\n                            <p class=\"mt-2 text-[12px] text-white/55\" data-kid=\"1-2-4-1-2-2-5-2\" data-name=\"specialization analysis description\">\n                                what moved, what matters next\n                            </p>\n                        </div>\n                        <div class=\"py-6 sm:pl-8\" data-kid=\"1-2-4-1-2-2-6\" data-name=\"specialization execution\">\n                            <p class=\"text-[17px] text-[#ffe16a]\" data-kid=\"1-2-4-1-2-2-6-1\" data-name=\"specialization execution title\">\n                                Execution\n                            </p>\n                            <p class=\"mt-2 text-[12px] text-white/55\" data-kid=\"1-2-4-1-2-2-6-2\" data-name=\"specialization execution description\">\n                                distribution across every channel\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"journey-title\" class=\"bg-[#fbfaf6] px-7 py-28 lg:px-0 lg:py-36\" data-kid=\"1-2-5\" data-name=\"journey section\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-5-1\" data-name=\"journey content container\">\n                <div class=\"max-w-[650px]\" data-kid=\"1-2-5-1-1\" data-name=\"journey intro group\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-5-1-1-1\" data-name=\"journey overline\">\n                        Objective → work → outcome\n                    </p>\n                    <h2 class=\"collision-serif mt-6 text-[46px] font-medium leading-[1.04] tracking-[-0.055em] text-[#15213a] sm:text-[63px]\" data-kid=\"1-2-5-1-1-2\" data-name=\"journey headline\" id=\"journey-title\">\n                        Growth moves as one system.\n                    </h2>\n                </div>\n                <div class=\"mt-16 grid gap-0 border-y border-[#15213a]/15 lg:grid-cols-3\" data-kid=\"1-2-5-1-2\" data-name=\"journey steps grid\">\n                    <div class=\"border-b border-[#15213a]/15 py-8 lg:border-b-0 lg:border-r lg:pr-10\" data-kid=\"1-2-5-1-2-1\" data-name=\"journey step objective\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#ff7b63]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"journey step objective label\">\n                            Objective\n                        </p>\n                        <p class=\"collision-serif mt-5 text-[30px] leading-[1.1]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"journey step objective text\">\n                            Get more qualified demand.\n                        </p>\n                        <p class=\"mt-5 text-[14px] leading-6 text-[#69798a]\" data-kid=\"1-2-5-1-2-1-3\" data-name=\"journey step objective desc\">\n                            A destination stated in plain English.\n                        </p>\n                    </div>\n                    <div class=\"border-b border-[#15213a]/15 py-8 lg:border-b-0 lg:border-r lg:px-10\" data-kid=\"1-2-5-1-2-2\" data-name=\"journey step work\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#1f5eff]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"journey step work label\">\n                            Work\n                        </p>\n                        <p class=\"collision-serif mt-5 text-[27px] leading-[1.15]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"journey step work text\">\n                            LinkedIn, SEO, AI search, newsletter, Gmail, outbound.\n                        </p>\n                        <p class=\"mt-5 text-[14px] leading-6 text-[#69798a]\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"journey step work desc\">\n                            The right sequence, coordinated behind the scenes.\n                        </p>\n                    </div>\n                    <div class=\"py-8 lg:pl-10\" data-kid=\"1-2-5-1-2-3\" data-name=\"journey step outcome\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#00a98e]\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"journey step outcome label\">\n                            Outcome\n                        </p>\n                        <p class=\"collision-serif mt-5 text-[30px] leading-[1.1]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"journey step outcome text\">\n                            More of the right people finding and choosing you.\n                        </p>\n                        <p class=\"mt-5 text-[14px] leading-6 text-[#69798a]\" data-kid=\"1-2-5-1-2-3-3\" data-name=\"journey step outcome desc\">\n                            Momentum you can actually feel.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"proof-title\" class=\"border-t border-[#15213a]/12 bg-[#eaf9fb] px-7 py-20 lg:px-0 lg:py-24\" data-kid=\"1-2-6\" data-name=\"proof section\" id=\"proof\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-6-1\" data-name=\"proof metrics container\">\n                <div class=\"grid gap-10 lg:grid-cols-4 lg:gap-0\" data-kid=\"1-2-6-1-1\" data-name=\"proof metrics grid\">\n                    <div class=\"lg:border-r lg:border-[#15213a]/15 lg:pr-8\" data-kid=\"1-2-6-1-1-1\" data-name=\"metric impressions group\">\n                        <p class=\"collision-serif text-[42px] leading-none text-[#15213a]\" data-kid=\"1-2-6-1-1-1-1\" data-name=\"metric impressions value\">\n                            300M\n                            <span class=\"text-[#ff7b63]\" data-kid=\"1-2-6-1-1-1-1-1\" data-name=\"metric impressions plus\">\n                                +\n                            </span>\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#69798a]\" data-kid=\"1-2-6-1-1-1-2\" data-name=\"metric impressions label\">\n                            impressions\n                        </p>\n                    </div>\n                    <div class=\"lg:border-r lg:border-[#15213a]/15 lg:px-8\" data-kid=\"1-2-6-1-1-2\" data-name=\"metric conversations group\">\n                        <p class=\"collision-serif text-[42px] leading-none text-[#15213a]\" data-kid=\"1-2-6-1-1-2-1\" data-name=\"metric conversations value\">\n                            14K\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#69798a]\" data-kid=\"1-2-6-1-1-2-2\" data-name=\"metric conversations label\">\n                            inbound conversations\n                        </p>\n                    </div>\n                    <div class=\"lg:border-r lg:border-[#15213a]/15 lg:px-8\" data-kid=\"1-2-6-1-1-3\" data-name=\"metric traffic group\">\n                        <p class=\"collision-serif text-[42px] leading-none text-[#15213a]\" data-kid=\"1-2-6-1-1-3-1\" data-name=\"metric traffic value\">\n                            2.4x\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#69798a]\" data-kid=\"1-2-6-1-1-3-2\" data-name=\"metric traffic label\">\n                            qualified traffic\n                        </p>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-5 lg:pl-8\" data-kid=\"1-2-6-1-1-4\" data-name=\"metric discovery group\">\n                        <div data-kid=\"1-2-6-1-1-4-1\" data-name=\"metric discovery value group\">\n                            <p class=\"collision-serif text-[42px] leading-none text-[#15213a]\" data-kid=\"1-2-6-1-1-4-1-1\" data-name=\"metric discovery value\">\n                                +38%\n                            </p>\n                            <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#69798a]\" data-kid=\"1-2-6-1-1-4-1-2\" data-name=\"metric discovery label\">\n                                AI search discovery\n                            </p>\n                        </div>\n                        <svg aria-hidden=\"true\" class=\"h-16 w-28\" data-kid=\"1-2-6-1-1-4-2\" data-name=\"metric discovery chart icon\" fill=\"none\" viewbox=\"0 0 112 64\">\n                            <path d=\"M2 55 C18 52 22 44 34 47 C46 50 48 35 60 39 C70 43 74 27 84 30 C95 33 100 17 110 8\" stroke=\"#1f5eff\" stroke-width=\"2\">\n                            </path>\n                            <circle cx=\"110\" cy=\"8\" fill=\"#ff7b63\" r=\"3.5\">\n                            </circle>\n                        </svg>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"relative overflow-hidden bg-[#fbfaf6] px-7 py-28 text-center lg:px-0 lg:py-36\" data-kid=\"1-2-7\" data-name=\"call to action section\" id=\"contact\">\n            <div class=\"sun-haze absolute left-1/2 top-8 h-28 w-28 -translate-x-1/2 rounded-full bg-[#ffe16a]/70 blur-xl\" data-kid=\"1-2-7-1\" data-name=\"cta decorative sun haze\">\n            </div>\n            <div class=\"relative mx-auto max-w-[820px]\" data-kid=\"1-2-7-2\" data-name=\"cta content container\">\n                <div class=\"mx-auto mb-7 h-8 w-52 border-b border-[#1f5eff]/35\" data-kid=\"1-2-7-2-1\" data-name=\"cta decorative rule\">\n                </div>\n                <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-7-2-2\" data-name=\"cta overline\">\n                    A calmer way to grow\n                </p>\n                <h2 class=\"collision-serif mt-6 text-[47px] font-medium leading-[1.04] tracking-[-0.055em] text-[#15213a] sm:text-[70px]\" data-kid=\"1-2-7-2-3\" data-name=\"cta headline\" id=\"cta-title\">\n                    Hire the intelligence behind your growth.\n                </h2>\n                <a class=\"mt-10 inline-flex rounded-full bg-[#1f5eff] px-7 py-4 text-[13px] font-semibold text-white hover:bg-[#1745c2]\" data-kid=\"1-2-7-2-4\" data-name=\"cta button\" href=\"#top\">\n                    Talk to Collision\n                </a>\n                <p class=\"mt-6 text-[11px] uppercase tracking-[0.14em] text-[#7a8b9b]\" data-kid=\"1-2-7-2-5\" data-name=\"cta concluding text\">\n                    One conversation. One memory. One personality. One source of truth.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#15213a]/15 bg-white px-7 py-8 lg:px-0\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1120px] flex-col justify-between gap-5 text-[11px] text-[#718397] sm:flex-row sm:items-center\" data-kid=\"1-3-1\" data-name=\"footer wrapper\">\n            <a class=\"collision-serif text-[23px] tracking-[-0.05em] text-[#15213a]\" data-kid=\"1-3-1-1\" data-name=\"footer logo link\" href=\"#top\">\n                collision.\n            </a>\n            <nav class=\"flex flex-wrap gap-x-7 gap-y-3\" data-kid=\"1-3-1-2\" data-name=\"footer links\">\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-1\" data-name=\"footer link what we own\" href=\"#ownership\">\n                    What we own\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-2\" data-name=\"footer link behind the scenes\" href=\"#behind\">\n                    Behind the scenes\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-3\" data-name=\"footer link contact\" href=\"mailto:hi@usecollision.com\">\n                    Contact\n                </a>\n            </nav>\n            <span data-kid=\"1-3-1-3\" data-name=\"footer copyright notice\">\n                © 2026 Collision Labs\n            </span>\n        </div>\n    </footer>\n</div>\n",
