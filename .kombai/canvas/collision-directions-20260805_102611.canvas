    "var_4bcffaccf632": {
      "type": "variant",
      "label": "Collision — Quiet Growth, Blue Sky / Growth Function",
      "parentId": "var_c7e0867311fe",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen overflow-hidden bg-[#f8faf7] text-[#14231d] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'DM Sans',sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap');\n    .collision-serif{font-family:'Lora',serif}\n    .hero-haze{animation:hero-haze 12s ease-in-out infinite}\n    .console-drift{animation:console-drift 8s ease-in-out infinite}\n    .line-rise{stroke-dasharray:900;stroke-dashoffset:900;animation:line-rise 2.8s ease-out .4s forwards}\n    @keyframes hero-haze{0%,100%{transform:translate3d(0,0,0) scale(1);opacity:.5}50%{transform:translate3d(16px,-10px,0) scale(1.08);opacity:.82}}\n    @keyframes console-drift{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}\n    @keyframes line-rise{to{stroke-dashoffset:0}}\n    @media (prefers-reduced-motion:reduce){.hero-haze,.console-drift,.line-rise{animation:none!important}.line-rise{stroke-dashoffset:0}}\n    </style>\n    <nav aria-label=\"Primary navigation\" class=\"absolute inset-x-0 top-0 z-30\" data-kid=\"1-1\" data-name=\"primary navigation bar\">\n        <div class=\"mx-auto flex max-w-[1120px] items-center justify-between px-7 py-6 lg:px-0\" data-kid=\"1-1-1\" data-name=\"navigation content wrapper\">\n            <a aria-label=\"Collision home\" class=\"flex items-center gap-3 text-white\" data-kid=\"1-1-1-1\" data-name=\"home link\" href=\"#top\">\n                <img alt=\"Collision helmet logo\" class=\"h-8 w-8 rounded-full object-cover ring-1 ring-white/40\" data-kid=\"1-1-1-1-1\" data-name=\"collision logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend-new/public/collision-helmet.png\"/>\n                <span class=\"text-[17px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1-2\" data-name=\"collision brand name text\">\n                    collision.\n                </span>\n            </a>\n            <div class=\"hidden items-center gap-8 text-[11px] font-medium tracking-[0.04em] text-white/80 md:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation link container\">\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-1\" data-name=\"approach section link\" href=\"#approach\">\n                    Approach\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"what we own section link\" href=\"#ownership\">\n                    What we own\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"behind the scenes section link\" href=\"#behind\">\n                    Behind the scenes\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-4\" data-name=\"proof section link\" href=\"#proof\">\n                    Proof\n                </a>\n            </div>\n            <a class=\"rounded-full bg-[#1f5eff] px-5 py-2.5 text-[12px] font-semibold text-white ring-1 ring-white/40 hover:bg-[#123fc2]\" data-kid=\"1-1-1-3\" data-name=\"hire collision call-to-action button\" href=\"#contact\">\n                Hire Collision\n            </a>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main page content\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative isolate flex min-h-[760px] items-center overflow-hidden bg-[#7ddff0]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <video aria-label=\"Peaceful meadow sunrise landscape video\" autoplay=\"\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1\" data-name=\"hero video background\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/14017302/pexels-photo-14017302.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/14017302/14017302-sd_960_540_30fps.mp4\">\n            </video>\n            <div class=\"absolute inset-0 bg-[#1f5eff]/30 mix-blend-multiply\" data-kid=\"1-2-1-2\" data-name=\"hero color overlay\">\n            </div>\n            <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(31,94,255,.32),rgba(125,223,240,.06)_40%,rgba(15,54,52,.72))]\" data-kid=\"1-2-1-3\" data-name=\"hero gradient mask\">\n            </div>\n            <div class=\"hero-haze absolute -right-12 top-28 h-72 w-72 rounded-full bg-[#ffe16a]/50 blur-3xl\" data-kid=\"1-2-1-4\" data-name=\"floating glowing haze element\">\n            </div>\n            <div class=\"absolute bottom-0 left-0 right-0 h-52 bg-gradient-to-t from-[#102f35]/70 to-transparent\" data-kid=\"1-2-1-5\" data-name=\"bottom gradient fade\">\n            </div>\n            <div class=\"relative z-10 mx-auto flex w-full max-w-[940px] flex-col items-center px-7 pb-10 pt-32 text-center text-white lg:px-0\" data-kid=\"1-2-1-6\" data-name=\"hero content container\">\n                <p class=\"mb-6 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80\" data-kid=\"1-2-1-6-1\" data-name=\"hero category label\">\n                    THE AI YOU HIRE TO RUN GROWTH\n                </p>\n                <h1 class=\"collision-serif max-w-[870px] text-[48px] font-medium leading-[1.03] tracking-[-0.06em] sm:text-[70px] lg:text-[84px]\" data-kid=\"1-2-1-6-2\" data-name=\"hero main headline\" id=\"hero-title\">\n                    One intelligence for your whole\n                    <em class=\"font-normal text-[#ffe16a]\" data-kid=\"1-2-1-6-2-1\" data-name=\"hero emphasized headline word\">\n                        growth function.\n                    </em>\n                </h1>\n                <p class=\"mt-7 max-w-[720px] text-[16px] leading-7 text-white/90 sm:text-[18px]\" data-kid=\"1-2-1-6-3\" data-name=\"hero description text\">\n                    Collision understands your business and executes across LinkedIn, X, SEO, AI search, newsletters, Gmail, outbound, and store growth — while it coordinates the rest of the work behind the scenes.\n                </p>\n                <div class=\"console-drift mt-10 w-full max-w-[790px] rounded-[22px] bg-[#fbfaf5] p-2.5 text-left text-[#14231d] shadow-[0_16px_55px_rgba(12,37,40,.24)] ring-1 ring-white/70\" data-kid=\"1-2-1-6-4\" data-name=\"interactive input console container\">\n                    <div class=\"flex flex-col gap-2 sm:flex-row sm:items-center\" data-kid=\"1-2-1-6-4-1\" data-name=\"console input row\">\n                        <div class=\"flex-1 px-4 py-4 text-[15px] text-[#14231d]/50\" data-kid=\"1-2-1-6-4-1-1\" data-name=\"console placeholder text\">\n                            What should we grow today?\n                        </div>\n                        <button class=\"rounded-[13px] bg-[#1f5eff] px-6 py-4 text-[13px] font-semibold text-white hover:bg-[#123fc2]\" data-kid=\"1-2-1-6-4-1-2\" data-name=\"console action button\">\n                            Run growth\n                        </button>\n                    </div>\n                    <div class=\"flex flex-wrap gap-2 border-t border-[#14231d]/10 px-3 pb-2 pt-3 text-[11px] text-[#14231d]/65\" data-kid=\"1-2-1-6-4-2\" data-name=\"console suggestion tags container\">\n                        <span class=\"rounded-full bg-[#e9f7f7] px-3 py-2\" data-kid=\"1-2-1-6-4-2-1\" data-name=\"suggestion tag launch\">\n                            Launch our product\n                        </span>\n                        <span class=\"rounded-full bg-[#e9f7f7] px-3 py-2\" data-kid=\"1-2-1-6-4-2-2\" data-name=\"suggestion tag linkedin\">\n                            Grow our LinkedIn\n                        </span>\n                        <span class=\"rounded-full bg-[#e9f7f7] px-3 py-2\" data-kid=\"1-2-1-6-4-2-3\" data-name=\"suggestion tag newsletter\">\n                            Write this week's newsletter\n                        </span>\n                        <span class=\"rounded-full bg-[#e9f7f7] px-3 py-2\" data-kid=\"1-2-1-6-4-2-4\" data-name=\"suggestion tag chatgpt\">\n                            Optimize us for ChatGPT\n                        </span>\n                        <span class=\"rounded-full bg-[#fff1ed] px-3 py-2\" data-kid=\"1-2-1-6-4-2-5\" data-name=\"suggestion tag signups\">\n                            Why are signups down?\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-[10px] font-medium uppercase tracking-[0.12em] text-white/75\" data-kid=\"1-2-1-6-5\" data-name=\"hero status tags container\">\n                    <span data-kid=\"1-2-1-6-5-1\" data-name=\"hero status tag one\">\n                        One conversation\n                    </span>\n                    <span class=\"text-[#ffe16a]\" data-kid=\"1-2-1-6-5-2\" data-name=\"hero status separator one\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-1-6-5-3\" data-name=\"hero status tag two\">\n                        One memory\n                    </span>\n                    <span class=\"text-[#ffe16a]\" data-kid=\"1-2-1-6-5-4\" data-name=\"hero status separator two\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-1-6-5-5\" data-name=\"hero status tag three\">\n                        One source of truth\n                    </span>\n                    <span class=\"ml-2 rounded-full border border-white/35 px-3 py-1 text-[#b7f4dc]\" data-kid=\"1-2-1-6-5-6\" data-name=\"hero status tag approval-based\">\n                        approval-based\n                    </span>\n                </div>\n                <p class=\"mt-5 text-[11px] tracking-[0.08em] text-white/70\" data-kid=\"1-2-1-6-6\" data-name=\"hero sub-description text\">\n                    Not a chatbot. Not an agency. Not another dashboard.\n                </p>\n            </div>\n        </section>\n        <section aria-label=\"Growth channels\" class=\"border-b border-[#14231d]/10 bg-[#f8faf7]\" data-kid=\"1-2-2\" data-name=\"growth channels section\">\n            <div class=\"mx-auto flex max-w-[1120px] flex-wrap items-center justify-center gap-x-7 gap-y-3 px-7 py-5 text-[11px] font-medium uppercase tracking-[0.12em] text-[#14231d]/65 lg:justify-between lg:px-0\" data-kid=\"1-2-2-1\" data-name=\"growth channels list\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-1\" data-name=\"linkedin channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#1f5eff]\" data-kid=\"1-2-2-1-1-1\" data-name=\"linkedin channel dot\">\n                    </i>\n                    LinkedIn\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-2\" data-name=\"x channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#ff7b63]\" data-kid=\"1-2-2-1-2-1\" data-name=\"x channel dot\">\n                    </i>\n                    X\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-3\" data-name=\"seo channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#00bfa6]\" data-kid=\"1-2-2-1-3-1\" data-name=\"seo channel dot\">\n                    </i>\n                    SEO\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-4\" data-name=\"ai search channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#ffe16a]\" data-kid=\"1-2-2-1-4-1\" data-name=\"ai search channel dot\">\n                    </i>\n                    AI Search\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-5\" data-name=\"newsletter channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#1f5eff]\" data-kid=\"1-2-2-1-5-1\" data-name=\"newsletter channel dot\">\n                    </i>\n                    Newsletter\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-6\" data-name=\"gmail channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#ff7b63]\" data-kid=\"1-2-2-1-6-1\" data-name=\"gmail channel dot\">\n                    </i>\n                    Gmail + outbound\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-7\" data-name=\"store growth channel item\">\n                    <i class=\"h-1.5 w-1.5 rounded-full bg-[#00bfa6]\" data-kid=\"1-2-2-1-7-1\" data-name=\"store growth channel dot\">\n                    </i>\n                    Store growth\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"ownership-title\" class=\"bg-[#f8faf7] px-7 py-24 lg:px-0 lg:py-32\" data-kid=\"1-2-3\" data-name=\"ownership section\" id=\"ownership\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-3-1\" data-name=\"ownership content container\">\n                <div class=\"grid gap-10 border-b border-[#14231d]/15 pb-12 lg:grid-cols-[.95fr_1.05fr] lg:gap-24\" data-kid=\"1-2-3-1-1\" data-name=\"ownership header container\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"ownership sub-headline container\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"ownership category label\">\n                            The full picture\n                        </p>\n                        <h2 class=\"collision-serif mt-6 max-w-[580px] text-[45px] font-medium leading-[1.06] tracking-[-0.055em] text-[#14231d] sm:text-[62px]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"ownership headline\" id=\"ownership-title\">\n                            If it contributes to growth,\n                            <em class=\"text-[#1f5eff]\" data-kid=\"1-2-3-1-1-1-2-1\" data-name=\"ownership headline emphasized\">\n                                Collision can own it.\n                            </em>\n                        </h2>\n                    </div>\n                    <div class=\"flex flex-col justify-end gap-6 border-l border-[#14231d]/15 pl-7 lg:pl-12\" data-kid=\"1-2-3-1-1-2\" data-name=\"ownership description column\">\n                        <p class=\"max-w-[470px] text-[18px] leading-8 text-[#14231d]/70\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"ownership description\">\n                            Collision owns the entire growth function — not just one channel. You ask for the outcome. Collision figures out the work.\n                        </p>\n                        <p class=\"max-w-[470px] text-[13px] leading-6 text-[#14231d]/50\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"ownership supplemental details\">\n                            It isn't another SEO tool, writing tool, analytics dashboard, or marketing automation platform. It is one intelligence that sees the entire picture and makes decisions across every surface.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-12 divide-y divide-[#14231d]/15 border-y border-[#14231d]/15\" data-kid=\"1-2-3-1-2\" data-name=\"ownership grid container\">\n                    <div class=\"grid gap-5 py-7 lg:grid-cols-[180px_1fr] lg:items-start\" data-kid=\"1-2-3-1-2-1\" data-name=\"reach category block\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"reach indicator container\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#1f5eff]\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"reach color dot\">\n                            </span>\n                            <span class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#1f5eff]\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"reach category label\">\n                                REACH\n                            </span>\n                        </div>\n                        <div data-kid=\"1-2-3-1-2-1-2\" data-name=\"reach details\">\n                            <p class=\"text-[22px] font-medium tracking-[-0.03em] text-[#14231d]\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"reach title\">\n                                LinkedIn / X / SEO / AI Search\n                            </p>\n                            <p class=\"mt-2 text-[13px] leading-6 text-[#14231d]/55\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"reach description\">\n                                ChatGPT, Perplexity, Google AI Overviews, Gemini — the places your next customer is already looking.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid gap-5 py-7 lg:grid-cols-[180px_1fr] lg:items-start\" data-kid=\"1-2-3-1-2-2\" data-name=\"content category block\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"content indicator container\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#ffe16a]\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"content color dot\">\n                            </span>\n                            <span class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#a27600]\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"content category label\">\n                                CONTENT\n                            </span>\n                        </div>\n                        <div data-kid=\"1-2-3-1-2-2-2\" data-name=\"content details\">\n                            <p class=\"text-[22px] font-medium tracking-[-0.03em] text-[#14231d]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"content title\">\n                                Blogs / Newsletters / Landing Pages / Website Copy / Product Launches\n                            </p>\n                            <p class=\"mt-2 text-[13px] leading-6 text-[#14231d]/55\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"content description\">\n                                The point of view, words, and launch moments that make the company worth remembering.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid gap-5 py-7 lg:grid-cols-[180px_1fr] lg:items-start\" data-kid=\"1-2-3-1-2-3\" data-name=\"revenue category block\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"revenue indicator container\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#ff7b63]\" data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"revenue color dot\">\n                            </span>\n                            <span class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#d15b47]\" data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"revenue category label\">\n                                REVENUE\n                            </span>\n                        </div>\n                        <div data-kid=\"1-2-3-1-2-3-2\" data-name=\"revenue details\">\n                            <p class=\"text-[22px] font-medium tracking-[-0.03em] text-[#14231d]\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"revenue title\">\n                                Gmail / Email Campaigns / Outbound / Storefront + Store Growth / Community Distribution\n                            </p>\n                            <p class=\"mt-2 text-[13px] leading-6 text-[#14231d]/55\" data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"revenue description\">\n                                The follow-through that turns attention into conversations, customers, and repeatable motion.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"grid gap-5 py-7 lg:grid-cols-[180px_1fr] lg:items-start\" data-kid=\"1-2-3-1-2-4\" data-name=\"intelligence category block\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"intelligence indicator container\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#00bfa6]\" data-kid=\"1-2-3-1-2-4-1-1\" data-name=\"intelligence color dot\">\n                            </span>\n                            <span class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#008f7b]\" data-kid=\"1-2-3-1-2-4-1-2\" data-name=\"intelligence category label\">\n                                INTELLIGENCE\n                            </span>\n                        </div>\n                        <div data-kid=\"1-2-3-1-2-4-2\" data-name=\"intelligence details\">\n                            <p class=\"text-[22px] font-medium tracking-[-0.03em] text-[#14231d]\" data-kid=\"1-2-3-1-2-4-2-1\" data-name=\"intelligence title\">\n                                Competitor Research / Positioning / Messaging / Analytics / Growth Strategy / Growth Experiments\n                            </p>\n                            <p class=\"mt-2 text-[13px] leading-6 text-[#14231d]/55\" data-kid=\"1-2-3-1-2-4-2-2\" data-name=\"intelligence description\">\n                                The decisions underneath the work — learning what is changing and where the next advantage is.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-8 text-center collision-serif text-[24px] italic text-[#1f5eff]\" data-kid=\"1-2-3-1-3\" data-name=\"ownership concluding quote\">\n                    Most AI products solve one problem. Collision owns one outcome: growth.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"approach-title\" class=\"bg-[#edf9fa] px-7 py-24 lg:px-0 lg:py-32\" data-kid=\"1-2-4\" data-name=\"approach section\" id=\"approach\">\n            <div class=\"mx-auto grid max-w-[1120px] items-center gap-16 lg:grid-cols-[1.1fr_.9fr] lg:gap-28\" data-kid=\"1-2-4-1\" data-name=\"approach content container\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"approach header container\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-4-1-1-1\" data-name=\"approach category label\">\n                        The experience\n                    </p>\n                    <h2 class=\"collision-serif mt-6 max-w-[650px] text-[44px] font-medium leading-[1.08] tracking-[-0.055em] text-[#14231d] sm:text-[60px]\" data-kid=\"1-2-4-1-1-2\" data-name=\"approach headline\" id=\"approach-title\">\n                        Working with Collision should feel like working with the\n                        <em class=\"text-[#ff7b63]\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"approach headline emphasized\">\n                            best Head of Growth you've ever met.\n                        </em>\n                    </h2>\n                    <p class=\"mt-8 max-w-[590px] text-[18px] leading-8 text-[#14231d]/65\" data-kid=\"1-2-4-1-1-3\" data-name=\"approach description\">\n                        You never think about prompts, workflows, or which AI model to use. You simply talk to Collision — and it understands the request, coordinates the work, and comes back with results.\n                    </p>\n                </div>\n                <div class=\"space-y-5\" data-kid=\"1-2-4-1-2\" data-name=\"approach visual chat example\">\n                    <div class=\"ml-0 max-w-[420px] rounded-[18px] bg-white px-6 py-5 ring-1 ring-[#14231d]/10\" data-kid=\"1-2-4-1-2-1\" data-name=\"approach user chat bubble\">\n                        <p class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#14231d]/45\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"approach user label\">\n                            You\n                        </p>\n                        <p class=\"collision-serif text-[27px] leading-[1.15] tracking-[-0.04em]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"approach user text\">\n                            “Launch our product.”\n                        </p>\n                    </div>\n                    <div class=\"ml-auto max-w-[460px] rounded-[18px] bg-[#1f5eff] px-6 py-5 text-white\" data-kid=\"1-2-4-1-2-2\" data-name=\"approach collision chat bubble\">\n                        <p class=\"mb-3 text-right text-[10px] font-semibold uppercase tracking-[0.18em] text-white/60\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"approach collision label\">\n                            Collision\n                        </p>\n                        <p class=\"collision-serif text-[27px] leading-[1.15] tracking-[-0.04em]\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"approach collision text\">\n                            “Understood. I'll research, plan, write, distribute, and learn.”\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"behind-title\" class=\"bg-[#172a66] px-7 py-24 text-white lg:px-0 lg:py-32\" data-kid=\"1-2-5\" data-name=\"behind the scenes section\" id=\"behind\">\n            <div class=\"mx-auto grid max-w-[1120px] gap-16 lg:grid-cols-[.82fr_1.18fr] lg:gap-28\" data-kid=\"1-2-5-1\" data-name=\"behind the scenes container\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"behind the scenes left column\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#b9f4e1]\" data-kid=\"1-2-5-1-1-1\" data-name=\"behind the scenes category label\">\n                        Behind the scenes\n                    </p>\n                    <h2 class=\"collision-serif mt-6 max-w-[480px] text-[45px] font-medium leading-[1.07] tracking-[-0.055em] sm:text-[60px]\" data-kid=\"1-2-5-1-1-2\" data-name=\"behind the scenes headline\" id=\"behind-title\">\n                        Behind one conversation is a\n                        <em class=\"text-[#ffe16a]\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"behind the scenes headline emphasized\">\n                            network of specialists.\n                        </em>\n                    </h2>\n                    <p class=\"mt-7 max-w-[380px] text-[16px] leading-7 text-white/70\" data-kid=\"1-2-5-1-1-3\" data-name=\"behind the scenes description\">\n                        Research, planning, writing, optimization, analysis, and execution are coordinated behind the scenes. You only know Collision.\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap gap-2 text-[10px] font-semibold uppercase tracking-[0.13em] text-[#b9f4e1]\" data-kid=\"1-2-5-1-1-4\" data-name=\"behind the scenes feature tags\">\n                        <span class=\"rounded-full border border-[#b9f4e1]/35 px-3 py-2\" data-kid=\"1-2-5-1-1-4-1\" data-name=\"feature tag approval\">\n                            approval-based\n                        </span>\n                        <span class=\"rounded-full border border-[#b9f4e1]/35 px-3 py-2\" data-kid=\"1-2-5-1-1-4-2\" data-name=\"feature tag memory\">\n                            private memory\n                        </span>\n                        <span class=\"rounded-full border border-[#b9f4e1]/35 px-3 py-2\" data-kid=\"1-2-5-1-1-4-3\" data-name=\"feature tag source\">\n                            one source of truth\n                        </span>\n                    </div>\n                </div>\n                <div class=\"border-y border-white/20 py-5\" data-kid=\"1-2-5-1-2\" data-name=\"behind the scenes visual list\">\n                    <div class=\"flex items-center justify-between border-b border-white/15 pb-5 text-[11px] uppercase tracking-[0.14em] text-white/55\" data-kid=\"1-2-5-1-2-1\" data-name=\"visual list header\">\n                        <span data-kid=\"1-2-5-1-2-1-1\" data-name=\"list header title\">\n                            REQUEST / Growth, handled\n                        </span>\n                        <span class=\"text-[#ffe16a]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"list header status\">\n                            LIVE\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-x-8\" data-kid=\"1-2-5-1-2-2\" data-name=\"behind the scenes items container\">\n                        <div class=\"flex items-start gap-4 border-b border-white/15 py-6\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"research list item\">\n                            <span class=\"text-[#b9f4e1]\" data-kid=\"1-2-5-1-2-2-1-1\" data-name=\"research item icon\">\n                                ✓\n                            </span>\n                            <div data-kid=\"1-2-5-1-2-2-1-2\" data-name=\"research item details\">\n                                <p class=\"text-[16px]\" data-kid=\"1-2-5-1-2-2-1-2-1\" data-name=\"research item title\">\n                                    Research\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-white/50\" data-kid=\"1-2-5-1-2-2-1-2-2\" data-name=\"research item description\">\n                                    market, audience, alternatives\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-start gap-4 border-b border-white/15 py-6\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"planning list item\">\n                            <span class=\"text-[#b9f4e1]\" data-kid=\"1-2-5-1-2-2-2-1\" data-name=\"planning item icon\">\n                                ✓\n                            </span>\n                            <div data-kid=\"1-2-5-1-2-2-2-2\" data-name=\"planning item details\">\n                                <p class=\"text-[16px]\" data-kid=\"1-2-5-1-2-2-2-2-1\" data-name=\"planning item title\">\n                                    Planning\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-white/50\" data-kid=\"1-2-5-1-2-2-2-2-2\" data-name=\"planning item description\">\n                                    strategy, sequencing, priorities\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-start gap-4 border-b border-white/15 py-6\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"writing list item\">\n                            <span class=\"text-[#b9f4e1]\" data-kid=\"1-2-5-1-2-2-3-1\" data-name=\"writing item icon\">\n                                ✓\n                            </span>\n                            <div data-kid=\"1-2-5-1-2-2-3-2\" data-name=\"writing item details\">\n                                <p class=\"text-[16px]\" data-kid=\"1-2-5-1-2-2-3-2-1\" data-name=\"writing item title\">\n                                    Writing\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-white/50\" data-kid=\"1-2-5-1-2-2-3-2-2\" data-name=\"writing item description\">\n                                    posts, pages, emails, launches\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-start gap-4 border-b border-white/15 py-6\" data-kid=\"1-2-5-1-2-2-4\" data-name=\"optimization list item\">\n                            <span class=\"text-[#b9f4e1]\" data-kid=\"1-2-5-1-2-2-4-1\" data-name=\"optimization item icon\">\n                                ✓\n                            </span>\n                            <div data-kid=\"1-2-5-1-2-2-4-2\" data-name=\"optimization item details\">\n                                <p class=\"text-[16px]\" data-kid=\"1-2-5-1-2-2-4-2-1\" data-name=\"optimization item title\">\n                                    Optimization\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-white/50\" data-kid=\"1-2-5-1-2-2-4-2-2\" data-name=\"optimization item description\">\n                                    SEO, AI search, conversion\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-6\" data-kid=\"1-2-5-1-2-2-5\" data-name=\"analysis list item\">\n                            <span class=\"text-[#ffe16a]\" data-kid=\"1-2-5-1-2-2-5-1\" data-name=\"analysis item icon\">\n                                ↗\n                            </span>\n                            <div data-kid=\"1-2-5-1-2-2-5-2\" data-name=\"analysis item details\">\n                                <p class=\"text-[#ffe16a]\" data-kid=\"1-2-5-1-2-2-5-2-1\" data-name=\"analysis item title\">\n                                    Analysis\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-white/50\" data-kid=\"1-2-5-1-2-2-5-2-2\" data-name=\"analysis item description\">\n                                    signals, attribution, learning\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-6\" data-kid=\"1-2-5-1-2-2-6\" data-name=\"execution list item\">\n                            <span class=\"text-[#ff9b8a]\" data-kid=\"1-2-5-1-2-2-6-1\" data-name=\"execution item icon\">\n                                ↗\n                            </span>\n                            <div data-kid=\"1-2-5-1-2-2-6-2\" data-name=\"execution item details\">\n                                <p class=\"text-[#ff9b8a]\" data-kid=\"1-2-5-1-2-2-6-2-1\" data-name=\"execution item title\">\n                                    Execution\n                                </p>\n                                <p class=\"mt-1 text-[12px] text-white/50\" data-kid=\"1-2-5-1-2-2-6-2-2\" data-name=\"execution item description\">\n                                    distribution, outreach, follow-through\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"journey-title\" class=\"bg-[#f8faf7] px-7 py-24 lg:px-0 lg:py-32\" data-kid=\"1-2-6\" data-name=\"journey section\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-6-1\" data-name=\"journey content container\">\n                <div class=\"flex flex-col justify-between gap-6 sm:flex-row sm:items-end\" data-kid=\"1-2-6-1-1\" data-name=\"journey header container\">\n                    <div data-kid=\"1-2-6-1-1-1\" data-name=\"journey header left\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-6-1-1-1-1\" data-name=\"journey category label\">\n                            From objective to outcome\n                        </p>\n                        <h2 class=\"collision-serif mt-5 text-[45px] font-medium leading-[1.06] tracking-[-0.055em] sm:text-[60px]\" data-kid=\"1-2-6-1-1-1-2\" data-name=\"journey headline\" id=\"journey-title\">\n                            The work moves.\n                            <em class=\"text-[#1f5eff]\" data-kid=\"1-2-6-1-1-1-2-1\" data-name=\"journey headline emphasized\">\n                                You don't have to.\n                            </em>\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[290px] text-[14px] leading-6 text-[#14231d]/55\" data-kid=\"1-2-6-1-1-2\" data-name=\"journey supplemental description\">\n                        A clear destination becomes coordinated action across the full growth function.\n                    </p>\n                </div>\n                <div class=\"mt-14 grid gap-4 lg:grid-cols-[1fr_auto_1.2fr_auto_1fr] lg:items-stretch\" data-kid=\"1-2-6-1-2\" data-name=\"journey step container\">\n                    <div class=\"border-t-4 border-[#ff7b63] bg-[#fff5f1] p-7\" data-kid=\"1-2-6-1-2-1\" data-name=\"journey objective block\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#d15b47]\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"journey objective label\">\n                            Objective\n                        </p>\n                        <p class=\"collision-serif mt-5 text-[29px] leading-[1.1] tracking-[-0.04em]\" data-kid=\"1-2-6-1-2-1-2\" data-name=\"journey objective text\">\n                            Get more qualified demand.\n                        </p>\n                    </div>\n                    <div class=\"hidden items-center text-3xl text-[#1f5eff] lg:flex\" data-kid=\"1-2-6-1-2-2\" data-name=\"journey transition arrow one\">\n                        →\n                    </div>\n                    <div class=\"border-t-4 border-[#1f5eff] bg-[#eef4ff] p-7\" data-kid=\"1-2-6-1-2-3\" data-name=\"journey work block\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#1f5eff]\" data-kid=\"1-2-6-1-2-3-1\" data-name=\"journey work label\">\n                            Work\n                        </p>\n                        <p class=\"collision-serif mt-5 text-[26px] leading-[1.12] tracking-[-0.04em]\" data-kid=\"1-2-6-1-2-3-2\" data-name=\"journey work text\">\n                            LinkedIn, SEO, AI search, newsletter, Gmail, outbound.\n                        </p>\n                    </div>\n                    <div class=\"hidden items-center text-3xl text-[#1f5eff] lg:flex\" data-kid=\"1-2-6-1-2-4\" data-name=\"journey transition arrow two\">\n                        →\n                    </div>\n                    <div class=\"border-t-4 border-[#00bfa6] bg-[#eafaf5] p-7\" data-kid=\"1-2-6-1-2-5\" data-name=\"journey outcome block\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#008f7b]\" data-kid=\"1-2-6-1-2-5-1\" data-name=\"journey outcome label\">\n                            Outcome\n                        </p>\n                        <p class=\"collision-serif mt-5 text-[29px] leading-[1.1] tracking-[-0.04em]\" data-kid=\"1-2-6-1-2-5-2\" data-name=\"journey outcome text\">\n                            More of the right people finding and choosing you.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"proof-title\" class=\"border-t border-[#14231d]/15 bg-[#edf9fa] px-7 py-10 lg:px-0\" data-kid=\"1-2-7\" data-name=\"proof section\" id=\"proof\">\n            <div class=\"mx-auto max-w-[1120px] border-y border-[#14231d]/15 py-10\" data-kid=\"1-2-7-1\" data-name=\"proof content container\">\n                <h2 class=\"sr-only\" data-kid=\"1-2-7-1-1\" data-name=\"proof section hidden title\" id=\"proof-title\">\n                    Growth proof\n                </h2>\n                <div class=\"grid gap-9 lg:grid-cols-[1fr_1fr_1fr_1.2fr] lg:gap-0\" data-kid=\"1-2-7-1-2\" data-name=\"proof stats grid\">\n                    <div class=\"lg:border-r lg:border-[#14231d]/15 lg:pr-8\" data-kid=\"1-2-7-1-2-1\" data-name=\"stat impressions\">\n                        <p class=\"collision-serif text-[39px] leading-none tracking-[-0.05em]\" data-kid=\"1-2-7-1-2-1-1\" data-name=\"stat impressions value\">\n                            300M+\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#14231d]/55\" data-kid=\"1-2-7-1-2-1-2\" data-name=\"stat impressions label\">\n                            impressions\n                        </p>\n                    </div>\n                    <div class=\"lg:border-r lg:border-[#14231d]/15 lg:px-8\" data-kid=\"1-2-7-1-2-2\" data-name=\"stat conversations\">\n                        <p class=\"collision-serif text-[39px] leading-none tracking-[-0.05em]\" data-kid=\"1-2-7-1-2-2-1\" data-name=\"stat conversations value\">\n                            14K\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#14231d]/55\" data-kid=\"1-2-7-1-2-2-2\" data-name=\"stat conversations label\">\n                            inbound conversations\n                        </p>\n                    </div>\n                    <div class=\"lg:border-r lg:border-[#14231d]/15 lg:px-8\" data-kid=\"1-2-7-1-2-3\" data-name=\"stat traffic\">\n                        <p class=\"collision-serif text-[39px] leading-none tracking-[-0.05em]\" data-kid=\"1-2-7-1-2-3-1\" data-name=\"stat traffic value\">\n                            2.4x\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#14231d]/55\" data-kid=\"1-2-7-1-2-3-2\" data-name=\"stat traffic label\">\n                            qualified traffic\n                        </p>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-5 lg:pl-8\" data-kid=\"1-2-7-1-2-4\" data-name=\"stat discovery\">\n                        <div data-kid=\"1-2-7-1-2-4-1\" data-name=\"stat discovery info\">\n                            <p class=\"collision-serif text-[39px] leading-none tracking-[-0.05em]\" data-kid=\"1-2-7-1-2-4-1-1\" data-name=\"stat discovery value\">\n                                +38%\n                            </p>\n                            <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#14231d]/55\" data-kid=\"1-2-7-1-2-4-1-2\" data-name=\"stat discovery label\">\n                                AI search discovery\n                            </p>\n                        </div>\n                        <svg aria-hidden=\"true\" class=\"h-16 w-32\" data-kid=\"1-2-7-1-2-4-2\" data-name=\"proof chart svg\" fill=\"none\" viewbox=\"0 0 128 64\">\n                            <path class=\"line-rise\" d=\"M2 56 C20 54 18 43 34 45 C49 47 50 36 64 38 C78 40 80 25 92 29 C105 33 111 17 126 8\" stroke=\"#1f5eff\" stroke-width=\"2\">\n                            </path>\n                            <circle cx=\"126\" cy=\"8\" fill=\"#ff7b63\" r=\"3.5\">\n                            </circle>\n                        </svg>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"bg-[#f8faf7] px-7 py-28 text-center lg:px-0 lg:py-36\" data-kid=\"1-2-8\" data-name=\"cta section\" id=\"contact\">\n            <div class=\"mx-auto max-w-[840px]\" data-kid=\"1-2-8-1\" data-name=\"cta content container\">\n                <div class=\"relative mx-auto mb-8 h-14 w-48 overflow-hidden border-b border-[#1f5eff]/35\" data-kid=\"1-2-8-1-1\" data-name=\"cta graphical element\">\n                    <span class=\"absolute bottom-[-29px] left-1/2 h-24 w-24 -translate-x-1/2 rounded-full bg-[#ffe16a]\" data-kid=\"1-2-8-1-1-1\" data-name=\"cta graphical circle\">\n                    </span>\n                    <span class=\"absolute bottom-1 left-1/2 h-1.5 w-20 -translate-x-1/2 bg-[#1f5eff]/50\" data-kid=\"1-2-8-1-1-2\" data-name=\"cta graphical line\">\n                    </span>\n                </div>\n                <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-8-1-2\" data-name=\"cta sub-headline\">\n                    A calmer way to grow\n                </p>\n                <h2 class=\"collision-serif mt-6 text-[48px] font-medium leading-[1.05] tracking-[-0.055em] sm:text-[70px]\" data-kid=\"1-2-8-1-3\" data-name=\"cta main headline\" id=\"cta-title\">\n                    Hire the intelligence behind your\n                    <em class=\"text-[#1f5eff]\" data-kid=\"1-2-8-1-3-1\" data-name=\"cta main headline emphasized\">\n                        growth.\n                    </em>\n                </h2>\n                <a class=\"mt-10 inline-flex rounded-full bg-[#1f5eff] px-7 py-4 text-[13px] font-semibold text-white hover:bg-[#123fc2]\" data-kid=\"1-2-8-1-4\" data-name=\"cta button\" href=\"#top\">\n                    Talk to Collision\n                </a>\n                <p class=\"mt-7 text-[11px] uppercase tracking-[0.12em] text-[#14231d]/50\" data-kid=\"1-2-8-1-5\" data-name=\"cta disclaimer text\">\n                    One conversation. One memory. One personality. One source of truth.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#14231d]/15 bg-white px-7 py-8 lg:px-0\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1120px] flex-col justify-between gap-5 text-[11px] text-[#14231d]/55 sm:flex-row sm:items-center\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n            <a class=\"collision-serif text-[24px] tracking-[-0.05em] text-[#14231d]\" data-kid=\"1-3-1-1\" data-name=\"footer logo link\" href=\"#top\">\n                collision.\n            </a>\n            <nav class=\"flex flex-wrap gap-x-7 gap-y-2\" data-kid=\"1-3-1-2\" data-name=\"footer links container\">\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-1\" data-name=\"footer approach link\" href=\"#approach\">\n                    Approach\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-2\" data-name=\"footer ownership link\" href=\"#ownership\">\n                    What we own\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-3\" data-name=\"footer behind the scenes link\" href=\"#behind\">\n                    Behind the scenes\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-4\" data-name=\"footer contact link\" href=\"mailto:hi@usecollision.com\">\n                    Contact\n                </a>\n            </nav>\n            <span data-kid=\"1-3-1-3\" data-name=\"footer copyright notice\">\n                © 2026 Collision Labs\n            </span>\n        </div>\n    </footer>\n</div>\n",
