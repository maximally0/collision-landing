    "var_8b26110ac0a6": {
      "type": "variant",
      "label": "Collision — Quiet Growth, Blue Sky / Growth Function",
      "parentId": "var_c7e0867311fe",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-[#f8f8f2] text-[#111111] antialiased\" data-kid=\"1\" data-name=\"main page container\" style=\"font-family:'DM Sans',sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap');\n    .collision-serif{font-family:'Lora',serif}\n    .hero-console{animation:console-float 8s ease-in-out infinite}\n    .sun-haze{animation:haze-drift 12s ease-in-out infinite}\n    @keyframes console-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}\n    @keyframes haze-drift{0%,100%{transform:translate3d(0,0,0) scale(1);opacity:.54}50%{transform:translate3d(15px,-9px,0) scale(1.08);opacity:.76}}\n    @media (prefers-reduced-motion:reduce){.hero-console,.sun-haze{animation:none}}\n    </style>\n    <nav aria-label=\"Primary navigation\" class=\"absolute inset-x-0 top-0 z-30\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <div class=\"mx-auto flex max-w-[1120px] items-center justify-between px-7 py-6 lg:px-0\" data-kid=\"1-1-1\" data-name=\"nav container\">\n            <a aria-label=\"Collision home\" class=\"flex items-center gap-3 text-white\" data-kid=\"1-1-1-1\" data-name=\"home link\" href=\"#top\">\n                <img alt=\"Collision helmet mark\" class=\"h-8 w-8 rounded-full object-cover ring-1 ring-white/45\" data-kid=\"1-1-1-1-1\" data-name=\"collision helmet logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend-new/public/collision-helmet.png\"/>\n                <span class=\"text-[17px] font-semibold tracking-[-0.05em]\" data-kid=\"1-1-1-1-2\" data-name=\"collision brand text\">\n                    collision.\n                </span>\n            </a>\n            <div class=\"hidden items-center gap-8 text-[11px] font-medium tracking-[0.05em] text-white/80 md:flex\" data-kid=\"1-1-1-2\" data-name=\"navigation menu links\">\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-1\" data-name=\"approach section link\" href=\"#approach\">\n                    Approach\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-2\" data-name=\"ownership section link\" href=\"#ownership\">\n                    What we own\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"behind the scenes section link\" href=\"#behind\">\n                    Behind the scenes\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-1-1-2-4\" data-name=\"proof section link\" href=\"#proof\">\n                    Proof\n                </a>\n            </div>\n            <a class=\"rounded-full bg-[#1f5eff] px-5 py-2.5 text-[12px] font-semibold text-white ring-1 ring-white/40 hover:bg-[#1749cf]\" data-kid=\"1-1-1-3\" data-name=\"hire collision call-to-action button\" href=\"#contact\">\n                Hire Collision\n            </a>\n        </div>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative isolate flex min-h-[750px] items-center overflow-hidden bg-[#75dceb]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <video aria-label=\"Peaceful meadow landscape at sunrise\" autoplay=\"\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/14017302/pexels-photo-14017302.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/14017302/14017302-sd_960_540_30fps.mp4\">\n            </video>\n            <div aria-hidden=\"true\" class=\"absolute inset-0 bg-[#57d5eb]/32\" data-kid=\"1-2-1-2\" data-name=\"hero overlay layer 1\">\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(7,45,72,.22),rgba(16,55,63,.25)_45%,rgba(7,25,31,.72))]\" data-kid=\"1-2-1-3\" data-name=\"hero overlay layer 2\">\n            </div>\n            <div aria-hidden=\"true\" class=\"sun-haze absolute -right-8 top-24 h-64 w-64 rounded-full bg-[#ffe16a]/30 blur-3xl\" data-kid=\"1-2-1-4\" data-name=\"animated decorative sun haze\">\n            </div>\n            <div class=\"relative z-10 mx-auto flex w-full max-w-[950px] flex-col items-center px-7 pb-10 pt-32 text-center text-white lg:px-0\" data-kid=\"1-2-1-5\" data-name=\"hero content container\">\n                <p class=\"mb-6 text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80\" data-kid=\"1-2-1-5-1\" data-name=\"hero eyebrow text\">\n                    The AI you hire to run growth\n                </p>\n                <h1 class=\"collision-serif max-w-[900px] text-[48px] font-medium leading-[1.04] tracking-[-0.065em] sm:text-[70px] lg:text-[82px]\" data-kid=\"1-2-1-5-2\" data-name=\"hero title\" id=\"hero-title\">\n                    One intelligence for your\n                    <em class=\"font-normal text-[#ffe16a]\" data-kid=\"1-2-1-5-2-1\" data-name=\"hero title highlight text\">\n                        whole growth function.\n                    </em>\n                </h1>\n                <p class=\"mt-7 max-w-[770px] text-[16px] leading-7 text-white/90 sm:text-[18px]\" data-kid=\"1-2-1-5-3\" data-name=\"hero description text\">\n                    Collision understands your business and executes across LinkedIn, X, SEO, AI search, newsletters, Gmail, outbound, and store growth — while it coordinates the rest of the work behind the scenes.\n                </p>\n                <div class=\"hero-console mt-10 w-full max-w-[790px] rounded-[20px] bg-[#fbfaf6] p-2.5 text-left text-[#111111] ring-1 ring-white/65 shadow-[0_20px_55px_rgba(5,25,35,.18)]\" data-kid=\"1-2-1-5-4\" data-name=\"hero console input container\">\n                    <div class=\"flex flex-col gap-2 sm:flex-row sm:items-center\" data-kid=\"1-2-1-5-4-1\" data-name=\"console inner layout\">\n                        <div class=\"flex-1 px-4 py-4 text-[15px] text-[#111111]/45\" data-kid=\"1-2-1-5-4-1-1\" data-name=\"console prompt text\">\n                            What should we grow today?\n                        </div>\n                        <button class=\"rounded-[13px] bg-[#1f5eff] px-6 py-4 text-[13px] font-semibold text-white hover:bg-[#1749cf]\" data-kid=\"1-2-1-5-4-1-2\" data-name=\"run growth action button\">\n                            Run growth\n                        </button>\n                    </div>\n                    <div class=\"flex flex-wrap gap-2 border-t border-[#111111]/10 px-3 pb-2 pt-3\" data-kid=\"1-2-1-5-4-2\" data-name=\"console suggestion chips container\">\n                        <span class=\"rounded-full bg-[#e8f7f7] px-3.5 py-2 text-[11px] text-[#315e67]\" data-kid=\"1-2-1-5-4-2-1\" data-name=\"suggestion chip 1\">\n                            Launch our product\n                        </span>\n                        <span class=\"rounded-full bg-[#e8f7f7] px-3.5 py-2 text-[11px] text-[#315e67]\" data-kid=\"1-2-1-5-4-2-2\" data-name=\"suggestion chip 2\">\n                            Grow our LinkedIn\n                        </span>\n                        <span class=\"rounded-full bg-[#e8f7f7] px-3.5 py-2 text-[11px] text-[#315e67]\" data-kid=\"1-2-1-5-4-2-3\" data-name=\"suggestion chip 3\">\n                            Write this week's newsletter\n                        </span>\n                        <span class=\"rounded-full bg-[#e8f7f7] px-3.5 py-2 text-[11px] text-[#315e67]\" data-kid=\"1-2-1-5-4-2-4\" data-name=\"suggestion chip 4\">\n                            Optimize us for ChatGPT\n                        </span>\n                        <span class=\"rounded-full bg-[#e8f7f7] px-3.5 py-2 text-[11px] text-[#315e67]\" data-kid=\"1-2-1-5-4-2-5\" data-name=\"suggestion chip 5\">\n                            Why are signups down?\n                        </span>\n                    </div>\n                </div>\n                <div class=\"mt-5 flex flex-wrap items-center justify-center gap-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/75\" data-kid=\"1-2-1-5-5\" data-name=\"hero footer tags container\">\n                    <span data-kid=\"1-2-1-5-5-1\" data-name=\"tag 1 text\">\n                        One conversation\n                    </span>\n                    <span class=\"h-1 w-1 rounded-full bg-white/55\" data-kid=\"1-2-1-5-5-2\" data-name=\"tag separator 1\">\n                    </span>\n                    <span data-kid=\"1-2-1-5-5-3\" data-name=\"tag 2 text\">\n                        One memory\n                    </span>\n                    <span class=\"h-1 w-1 rounded-full bg-white/55\" data-kid=\"1-2-1-5-5-4\" data-name=\"tag separator 2\">\n                    </span>\n                    <span data-kid=\"1-2-1-5-5-5\" data-name=\"tag 3 text\">\n                        One source of truth\n                    </span>\n                    <span class=\"ml-2 rounded-full bg-[#00e5c0]/90 px-3 py-1.5 text-[#123c3d]\" data-kid=\"1-2-1-5-5-6\" data-name=\"approval-based badge\">\n                        approval-based\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"ownership-title\" class=\"border-b border-[#111111]/10 bg-[#f8f8f2] px-7 py-24 lg:px-0 lg:py-32\" data-kid=\"1-2-2\" data-name=\"ownership section\" id=\"ownership\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-2-1\" data-name=\"ownership content wrapper\">\n                <div class=\"grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:gap-24\" data-kid=\"1-2-2-1-1\" data-name=\"ownership grid container\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"ownership introductory text\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"ownership eyebrow text\">\n                            The full function\n                        </p>\n                        <h2 class=\"collision-serif mt-6 max-w-[500px] text-[46px] font-medium leading-[1.04] tracking-[-0.06em] text-[#18324a] sm:text-[64px]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"ownership section title\" id=\"ownership-title\">\n                            If it contributes to growth,\n                            <em class=\"text-[#1f5eff]\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"ownership title highlight\">\n                                Collision can own it.\n                            </em>\n                        </h2>\n                        <p class=\"mt-8 max-w-[390px] text-[16px] leading-7 text-[#53616a]\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"ownership description text\">\n                            Most AI products solve one problem. Collision owns one outcome: growth. It is not another SEO tool, writing tool, analytics dashboard, or marketing automation platform.\n                        </p>\n                        <p class=\"mt-8 border-l-2 border-[#ff7b63] pl-5 text-[15px] italic leading-6 text-[#18324a]\" data-kid=\"1-2-2-1-1-1-4\" data-name=\"ownership quote text\">\n                            You ask for the outcome. Collision figures out the work.\n                        </p>\n                    </div>\n                    <div class=\"divide-y divide-[#18324a]/15 border-y border-[#18324a]/15\" data-kid=\"1-2-2-1-1-2\" data-name=\"ownership features list\">\n                        <div class=\"grid gap-4 py-7 sm:grid-cols-[145px_1fr] sm:gap-8\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"reach feature\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"reach icon\">\n                                <span class=\"mt-1 h-2.5 w-2.5 rounded-full bg-[#1f5eff]\" data-kid=\"1-2-2-1-1-2-1-1-1\">\n                                </span>\n                                <p class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#1f5eff]\" data-kid=\"1-2-2-1-1-2-1-1-2\">\n                                    Reach\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"reach title\">\n                                <p class=\"text-[17px] font-medium text-[#18324a]\" data-kid=\"1-2-2-1-1-2-1-2-1\" data-name=\"reach subtitle\">\n                                    LinkedIn · X · SEO · AI Search\n                                </p>\n                                <p class=\"mt-2 text-[13px] leading-6 text-[#68757a]\" data-kid=\"1-2-2-1-1-2-1-2-2\" data-name=\"reach description\">\n                                    Including ChatGPT, Perplexity, Google AI Overviews, and Gemini — so the right people can discover you everywhere they look.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"grid gap-4 py-7 sm:grid-cols-[145px_1fr] sm:gap-8\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"content feature\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"content icon\">\n                                <span class=\"mt-1 h-2.5 w-2.5 rounded-full bg-[#ff7b63]\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"content icon bullet\">\n                                </span>\n                                <p class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#d76754]\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"content feature eyebrow\">\n                                    Content\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"content title\">\n                                <p class=\"text-[17px] font-medium text-[#18324a]\" data-kid=\"1-2-2-1-1-2-2-2-1\" data-name=\"content subtitle\">\n                                    Blogs · Newsletters · Landing Pages · Website Copy · Product Launches\n                                </p>\n                                <p class=\"mt-2 text-[13px] leading-6 text-[#68757a]\" data-kid=\"1-2-2-1-1-2-2-2-2\" data-name=\"content description\">\n                                    From the point of view to the words and distribution, Collision keeps your story coherent as it moves.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"grid gap-4 py-7 sm:grid-cols-[145px_1fr] sm:gap-8\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"revenue feature\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"revenue icon\">\n                                <span class=\"mt-1 h-2.5 w-2.5 rounded-full bg-[#00bfa7]\" data-kid=\"1-2-2-1-1-2-3-1-1\" data-name=\"revenue icon bullet\">\n                                </span>\n                                <p class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#008f7f]\" data-kid=\"1-2-2-1-1-2-3-1-2\" data-name=\"revenue feature eyebrow\">\n                                    Revenue\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-2-1-1-2-3-2\" data-name=\"revenue title\">\n                                <p class=\"text-[17px] font-medium text-[#18324a]\" data-kid=\"1-2-2-1-1-2-3-2-1\" data-name=\"revenue subtitle\">\n                                    Gmail · Email Campaigns · Outbound · Storefront / Store Growth · Community Distribution\n                                </p>\n                                <p class=\"mt-2 text-[13px] leading-6 text-[#68757a]\" data-kid=\"1-2-2-1-1-2-3-2-2\" data-name=\"revenue description\">\n                                    Turn attention into conversations, customers, repeat buyers, and a community that keeps moving.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"grid gap-4 py-7 sm:grid-cols-[145px_1fr] sm:gap-8\" data-kid=\"1-2-2-1-1-2-4\" data-name=\"intelligence feature\">\n                            <div class=\"flex items-start gap-3\" data-kid=\"1-2-2-1-1-2-4-1\" data-name=\"intelligence icon\">\n                                <span class=\"mt-1 h-2.5 w-2.5 rounded-full bg-[#e4b94f]\" data-kid=\"1-2-2-1-1-2-4-1-1\" data-name=\"intelligence icon bullet\">\n                                </span>\n                                <p class=\"text-[12px] font-semibold uppercase tracking-[0.18em] text-[#b3871c]\" data-kid=\"1-2-2-1-1-2-4-1-2\" data-name=\"intelligence feature eyebrow\">\n                                    Intelligence\n                                </p>\n                            </div>\n                            <div data-kid=\"1-2-2-1-1-2-4-2\" data-name=\"intelligence title\">\n                                <p class=\"text-[17px] font-medium text-[#18324a]\" data-kid=\"1-2-2-1-1-2-4-2-1\" data-name=\"intelligence subtitle\">\n                                    Competitor Research · Positioning · Messaging · Analytics · Growth Strategy · Growth Experiments\n                                </p>\n                                <p class=\"mt-2 text-[13px] leading-6 text-[#68757a]\" data-kid=\"1-2-2-1-1-2-4-2-2\" data-name=\"intelligence description\">\n                                    The judgment layer behind the work: what to notice, what to say, what to try, and what to learn next.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-12 flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-[#18324a]/10 pt-6 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#68757a]\" data-kid=\"1-2-2-1-2\" data-name=\"ownership footer text container\">\n                    <span class=\"text-[#1f5eff]\" data-kid=\"1-2-2-1-2-1\" data-name=\"footer point 1\">\n                        One intelligence.\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-2\" data-name=\"footer point 2\">\n                        Your whole growth function.\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-3\" data-name=\"footer point 3\">\n                        Not a stack of specialists.\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"approach-title\" class=\"bg-[#f8f8f2] px-7 py-28 lg:px-0 lg:py-36\" data-kid=\"1-2-3\" data-name=\"approach section\" id=\"approach\">\n            <div class=\"mx-auto grid max-w-[1120px] items-center gap-16 lg:grid-cols-[1.05fr_.95fr] lg:gap-28\" data-kid=\"1-2-3-1\" data-name=\"approach grid container\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"approach text container\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#738187]\" data-kid=\"1-2-3-1-1-1\" data-name=\"approach eyebrow text\">\n                        The experience\n                    </p>\n                    <h2 class=\"collision-serif mt-6 max-w-[680px] text-[44px] font-medium leading-[1.08] tracking-[-0.06em] text-[#18324a] sm:text-[61px]\" data-kid=\"1-2-3-1-1-2\" data-name=\"approach title\" id=\"approach-title\">\n                        Working with Collision should feel like working with the\n                        <em class=\"text-[#1f5eff]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"approach title highlight\">\n                            best Head of Growth\n                        </em>\n                        you've ever met.\n                    </h2>\n                    <p class=\"mt-8 max-w-[600px] text-[17px] leading-8 text-[#5b6a70]\" data-kid=\"1-2-3-1-1-3\" data-name=\"approach description text\">\n                        You never think about prompts, workflows, or which AI model to use. You say what matters. Collision understands the request, decides what needs to happen, coordinates the work, and comes back with results.\n                    </p>\n                </div>\n                <div class=\"space-y-5 border-l border-[#18324a]/15 pl-8 lg:pl-12\" data-kid=\"1-2-3-1-2\" data-name=\"approach example dialogue container\">\n                    <div class=\"max-w-[390px] border border-[#18324a]/15 bg-white/60 p-6\" data-kid=\"1-2-3-1-2-1\" data-name=\"user prompt box\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#879196]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"user label\">\n                            You\n                        </p>\n                        <p class=\"collision-serif mt-4 text-[27px] leading-[1.2] tracking-[-0.04em] text-[#18324a]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"user prompt text\">\n                            “Launch our product.”\n                        </p>\n                    </div>\n                    <div class=\"ml-8 max-w-[430px] border border-[#1f5eff]/25 bg-[#e9f8fb] p-6 sm:ml-16\" data-kid=\"1-2-3-1-2-2\" data-name=\"collision response box\">\n                        <p class=\"text-right text-[10px] font-semibold uppercase tracking-[0.16em] text-[#1f5eff]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"collision label\">\n                            Collision\n                        </p>\n                        <p class=\"collision-serif mt-4 text-[27px] leading-[1.2] tracking-[-0.04em] text-[#18324a]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"collision response text\">\n                            “Understood. I’ll research, plan, write, distribute, and learn.”\n                        </p>\n                    </div>\n                    <p class=\"pt-3 text-[12px] leading-6 text-[#738187]\" data-kid=\"1-2-3-1-2-3\" data-name=\"approach note text\">\n                        One conversation, with specialized work happening quietly behind it.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"behind-title\" class=\"bg-[#2054e8] px-7 py-24 text-white lg:px-0 lg:py-32\" data-kid=\"1-2-4\" data-name=\"behind the scenes section\" id=\"behind\">\n            <div class=\"mx-auto grid max-w-[1120px] items-start gap-16 lg:grid-cols-[.78fr_1.22fr] lg:gap-28\" data-kid=\"1-2-4-1\" data-name=\"behind the scenes grid\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"behind the scenes intro text\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#ffe16a]\" data-kid=\"1-2-4-1-1-1\" data-name=\"behind the scenes eyebrow\">\n                        Behind the scenes\n                    </p>\n                    <h2 class=\"collision-serif mt-7 max-w-[440px] text-[46px] font-medium leading-[1.06] tracking-[-0.06em] sm:text-[62px]\" data-kid=\"1-2-4-1-1-2\" data-name=\"behind the scenes title\" id=\"behind-title\">\n                        Behind one conversation is a\n                        <em class=\"text-[#ffe16a]\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"behind the scenes title highlight\">\n                            network of specialists.\n                        </em>\n                    </h2>\n                    <p class=\"mt-7 max-w-[380px] text-[16px] leading-7 text-white/78\" data-kid=\"1-2-4-1-1-3\" data-name=\"behind the scenes description\">\n                        Collision appears as a single AI. Behind that single conversation, research, planning, writing, optimization, analysis, and execution work together.\n                    </p>\n                    <p class=\"mt-8 border-l-2 border-[#00e5c0] pl-5 text-[15px] leading-6 text-white\" data-kid=\"1-2-4-1-1-4\" data-name=\"behind the scenes highlight quote\">\n                        You only know Collision.\n                    </p>\n                </div>\n                <div class=\"border-y border-white/25\" data-kid=\"1-2-4-1-2\" data-name=\"specialist functions container\">\n                    <div class=\"flex items-center justify-between border-b border-white/20 py-5 text-[11px] uppercase tracking-[0.16em] text-white/65\" data-kid=\"1-2-4-1-2-1\" data-name=\"runtime header\">\n                        <span data-kid=\"1-2-4-1-2-1-1\" data-name=\"runtime status text\">\n                            Collision runtime / active\n                        </span>\n                        <span class=\"text-[#ffe16a]\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"runtime mode badge\">\n                            approval-based\n                        </span>\n                    </div>\n                    <div class=\"grid gap-x-10 sm:grid-cols-2\" data-kid=\"1-2-4-1-2-2\" data-name=\"specialist functions grid\">\n                        <div class=\"border-b border-white/15 py-6\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"research function\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"research title\">\n                                Research\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-white/58\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"research detail\">\n                                Market, audience, alternatives\n                            </p>\n                        </div>\n                        <div class=\"border-b border-white/15 py-6\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"planning function\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"planning title\">\n                                Planning\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-white/58\" data-kid=\"1-2-4-1-2-2-2-2\" data-name=\"planning detail\">\n                                Priorities, sequencing, experiments\n                            </p>\n                        </div>\n                        <div class=\"border-b border-white/15 py-6\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"writing function\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"writing title\">\n                                Writing\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-white/58\" data-kid=\"1-2-4-1-2-2-3-2\" data-name=\"writing detail\">\n                                Posts, emails, pages, launches\n                            </p>\n                        </div>\n                        <div class=\"border-b border-white/15 py-6\" data-kid=\"1-2-4-1-2-2-4\" data-name=\"optimization function\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-4-1\" data-name=\"optimization title\">\n                                Optimization\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-white/58\" data-kid=\"1-2-4-1-2-2-4-2\" data-name=\"optimization detail\">\n                                Search, conversion, distribution\n                            </p>\n                        </div>\n                        <div class=\"py-6\" data-kid=\"1-2-4-1-2-2-5\" data-name=\"analysis function\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-5-1\" data-name=\"analysis title\">\n                                Analysis\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-white/58\" data-kid=\"1-2-4-1-2-2-5-2\" data-name=\"analysis detail\">\n                                Signals, performance, learning\n                            </p>\n                        </div>\n                        <div class=\"py-6\" data-kid=\"1-2-4-1-2-2-6\" data-name=\"execution function\">\n                            <p class=\"text-[17px]\" data-kid=\"1-2-4-1-2-2-6-1\" data-name=\"execution title\">\n                                Execution\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-white/58\" data-kid=\"1-2-4-1-2-2-6-2\" data-name=\"execution detail\">\n                                Publishing, outreach, follow-through\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-wrap gap-3 border-t border-white/20 py-5 text-[10px] font-semibold uppercase tracking-[0.14em] text-white/65\" data-kid=\"1-2-4-1-2-3\" data-name=\"functions list footer\">\n                        <span data-kid=\"1-2-4-1-2-3-1\" data-name=\"footer tag 1\">\n                            Private memory\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-3-2\" data-name=\"tag separator\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-3-3\" data-name=\"footer tag 2\">\n                            One personality\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-3-4\" data-name=\"tag separator\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-4-1-2-3-5\" data-name=\"footer tag 3\">\n                            One source of truth\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"journey-title\" class=\"bg-[#f8f8f2] px-7 py-28 lg:px-0 lg:py-36\" data-kid=\"1-2-5\" data-name=\"journey section\">\n            <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-5-1\" data-name=\"journey content container\">\n                <div class=\"flex flex-col justify-between gap-7 lg:flex-row lg:items-end\" data-kid=\"1-2-5-1-1\" data-name=\"journey header container\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"journey eyebrow title\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"journey eyebrow text\">\n                            Objective → work → outcome\n                        </p>\n                        <h2 class=\"collision-serif mt-6 text-[46px] font-medium leading-[1.05] tracking-[-0.06em] text-[#18324a] sm:text-[62px]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"journey section title\" id=\"journey-title\">\n                            Give it the destination.\n                            <em class=\"text-[#ff7b63]\" data-kid=\"1-2-5-1-1-1-2-1\" data-name=\"journey title highlight\">\n                                Keep the day.\n                            </em>\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[300px] text-[15px] leading-6 text-[#68757a]\" data-kid=\"1-2-5-1-1-2\" data-name=\"journey description text\">\n                        The surface request stays simple. The growth function underneath does not.\n                    </p>\n                </div>\n                <div class=\"mt-16 grid gap-5 lg:grid-cols-[1fr_auto_1.15fr_auto_1fr] lg:items-stretch\" data-kid=\"1-2-5-1-2\" data-name=\"journey steps container\">\n                    <div class=\"border-t-4 border-[#ff7b63] bg-white p-7\" data-kid=\"1-2-5-1-2-1\" data-name=\"objective step card\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#d76754]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"objective label\">\n                            Objective\n                        </p>\n                        <p class=\"collision-serif mt-7 text-[30px] leading-[1.12] tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"objective text\">\n                            Get more qualified demand.\n                        </p>\n                    </div>\n                    <div class=\"hidden items-center justify-center text-3xl text-[#1f5eff] lg:flex\" data-kid=\"1-2-5-1-2-2\" data-name=\"arrow icon 1\">\n                        →\n                    </div>\n                    <div class=\"border-t-4 border-[#1f5eff] bg-[#e6f7fb] p-7\" data-kid=\"1-2-5-1-2-3\" data-name=\"work step card\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#1f5eff]\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"work label\">\n                            Work\n                        </p>\n                        <p class=\"mt-7 text-[18px] leading-7 text-[#18324a]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"work headline text\">\n                            LinkedIn · SEO · AI search · newsletter · Gmail · outbound\n                        </p>\n                        <p class=\"mt-4 text-[12px] leading-5 text-[#68757a]\" data-kid=\"1-2-5-1-2-3-3\" data-name=\"work description text\">\n                            Research, positioning, writing, distribution, and learning coordinated as one plan.\n                        </p>\n                    </div>\n                    <div class=\"hidden items-center justify-center text-3xl text-[#1f5eff] lg:flex\" data-kid=\"1-2-5-1-2-4\" data-name=\"arrow icon 2\">\n                        →\n                    </div>\n                    <div class=\"border-t-4 border-[#00bfa7] bg-[#ddfaf3] p-7\" data-kid=\"1-2-5-1-2-5\" data-name=\"outcome step card\">\n                        <p class=\"text-[10px] font-semibold uppercase tracking-[0.16em] text-[#008f7f]\" data-kid=\"1-2-5-1-2-5-1\" data-name=\"outcome label\">\n                            Outcome\n                        </p>\n                        <p class=\"collision-serif mt-7 text-[30px] leading-[1.12] tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-2-5-1-2-5-2\" data-name=\"outcome text\">\n                            More of the right people finding and choosing you.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"proof-title\" class=\"border-t border-[#18324a]/10 bg-[#f8f8f2] px-7 pb-28 lg:px-0 lg:pb-36\" data-kid=\"1-2-6\" data-name=\"proof section\" id=\"proof\">\n            <div class=\"mx-auto max-w-[1120px] border-y border-[#18324a]/15 py-10\" data-kid=\"1-2-6-1\" data-name=\"proof section container\">\n                <h2 class=\"sr-only\" data-kid=\"1-2-6-1-1\" data-name=\"proof section sr-only title\" id=\"proof-title\">\n                    Growth proof\n                </h2>\n                <div class=\"grid gap-9 lg:grid-cols-4 lg:gap-0\" data-kid=\"1-2-6-1-2\" data-name=\"proof stats grid\">\n                    <div class=\"lg:border-r lg:border-[#18324a]/15 lg:pr-8\" data-kid=\"1-2-6-1-2-1\" data-name=\"stat card 1\">\n                        <p class=\"collision-serif text-[40px] leading-none tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"stat 1 value\">\n                            300M+\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#738187]\" data-kid=\"1-2-6-1-2-1-2\" data-name=\"stat 1 label\">\n                            impressions\n                        </p>\n                    </div>\n                    <div class=\"lg:border-r lg:border-[#18324a]/15 lg:px-8\" data-kid=\"1-2-6-1-2-2\" data-name=\"stat card 2\">\n                        <p class=\"collision-serif text-[40px] leading-none tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-2-6-1-2-2-1\" data-name=\"stat 2 value\">\n                            14K\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#738187]\" data-kid=\"1-2-6-1-2-2-2\" data-name=\"stat 2 label\">\n                            inbound conversations\n                        </p>\n                    </div>\n                    <div class=\"lg:border-r lg:border-[#18324a]/15 lg:px-8\" data-kid=\"1-2-6-1-2-3\" data-name=\"stat card 3\">\n                        <p class=\"collision-serif text-[40px] leading-none tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-2-6-1-2-3-1\" data-name=\"stat 3 value\">\n                            2.4x\n                        </p>\n                        <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#738187]\" data-kid=\"1-2-6-1-2-3-2\" data-name=\"stat 3 label\">\n                            qualified traffic\n                        </p>\n                    </div>\n                    <div class=\"flex items-center justify-between gap-5 lg:pl-8\" data-kid=\"1-2-6-1-2-4\" data-name=\"stat card 4\">\n                        <div data-kid=\"1-2-6-1-2-4-1\" data-name=\"stat card 4 text container\">\n                            <p class=\"collision-serif text-[40px] leading-none tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-2-6-1-2-4-1-1\" data-name=\"stat 4 value\">\n                                +38%\n                            </p>\n                            <p class=\"mt-3 text-[11px] uppercase tracking-[0.14em] text-[#738187]\" data-kid=\"1-2-6-1-2-4-1-2\" data-name=\"stat 4 label\">\n                                AI search discovery\n                            </p>\n                        </div>\n                        <svg aria-hidden=\"true\" class=\"h-16 w-28 shrink-0\" data-kid=\"1-2-6-1-2-4-2\" data-name=\"growth trend chart icon\" fill=\"none\" viewbox=\"0 0 112 64\">\n                            <path d=\"M2 55C17 53 24 47 34 48C44 49 48 39 58 41C68 43 72 29 82 31C92 33 98 18 110 7\" stroke=\"#1f5eff\" stroke-width=\"2\">\n                            </path>\n                            <circle cx=\"110\" cy=\"7\" fill=\"#ff7b63\" r=\"3.5\">\n                            </circle>\n                        </svg>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"contact-title\" class=\"bg-[#f8f8f2] px-7 py-24 lg:px-0 lg:py-32\" data-kid=\"1-2-7\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"mx-auto flex max-w-[1120px] flex-col items-center text-center\" data-kid=\"1-2-7-1\" data-name=\"contact section container\">\n                <div class=\"relative mb-8 h-12 w-48 overflow-hidden border-b border-[#18324a]/30\" data-kid=\"1-2-7-1-1\" data-name=\"decorative element\">\n                    <span class=\"absolute bottom-[-30px] left-1/2 h-24 w-24 -translate-x-1/2 rounded-full bg-[#ffe16a]\" data-kid=\"1-2-7-1-1-1\" data-name=\"decorative circle\">\n                    </span>\n                    <span class=\"absolute bottom-1 left-1/2 h-1.5 w-20 -translate-x-1/2 rounded-full bg-[#1f5eff]/55\" data-kid=\"1-2-7-1-1-2\" data-name=\"decorative bar\">\n                    </span>\n                </div>\n                <p class=\"text-[11px] font-semibold uppercase tracking-[0.22em] text-[#1f5eff]\" data-kid=\"1-2-7-1-2\" data-name=\"contact eyebrow text\">\n                    Ready when you are\n                </p>\n                <h2 class=\"collision-serif mt-6 max-w-[760px] text-[48px] font-medium leading-[1.04] tracking-[-0.06em] text-[#18324a] sm:text-[70px]\" data-kid=\"1-2-7-1-3\" data-name=\"contact title\" id=\"contact-title\">\n                    Hire the intelligence behind your\n                    <em class=\"text-[#1f5eff]\" data-kid=\"1-2-7-1-3-1\" data-name=\"contact title highlight\">\n                        growth.\n                    </em>\n                </h2>\n                <a class=\"mt-10 rounded-full bg-[#1f5eff] px-7 py-4 text-[13px] font-semibold text-white hover:bg-[#1749cf]\" data-kid=\"1-2-7-1-4\" data-name=\"contact action button\" href=\"#top\">\n                    Talk to Collision\n                </a>\n                <p class=\"mt-6 text-[11px] uppercase tracking-[0.16em] text-[#738187]\" data-kid=\"1-2-7-1-5\" data-name=\"contact footer text\">\n                    One conversation · One memory · One personality · One source of truth\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#18324a]/15 bg-[#f8f8f2] px-7 pb-9 pt-7 lg:px-0\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1120px] flex-col justify-between gap-6 text-[11px] text-[#738187] sm:flex-row sm:items-center\" data-kid=\"1-3-1\" data-name=\"footer container\">\n            <a class=\"collision-serif text-[23px] tracking-[-0.05em] text-[#18324a]\" data-kid=\"1-3-1-1\" data-name=\"footer logo link\" href=\"#top\">\n                collision.\n            </a>\n            <nav class=\"flex flex-wrap gap-x-7 gap-y-3\" data-kid=\"1-3-1-2\" data-name=\"footer navigation\">\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-1\" data-name=\"footer approach link\" href=\"#ownership\">\n                    What we own\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-2\" data-name=\"footer behind link\" href=\"#behind\">\n                    Behind the scenes\n                </a>\n                <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-3-1-2-3\" data-name=\"footer contact email link\" href=\"mailto:hi@usecollision.com\">\n                    Contact\n                </a>\n            </nav>\n            <span data-kid=\"1-3-1-3\" data-name=\"copyright text\">\n                © 2026 Collision Labs\n            </span>\n        </div>\n    </footer>\n</div>\n",
