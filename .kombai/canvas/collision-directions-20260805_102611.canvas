      "html": "<div class=\"min-h-screen overflow-hidden bg-[#f9f9f6] text-[#111111] antialiased\" data-kid=\"1\" data-name=\"page container\" style=\"font-family:'DM Sans',sans-serif\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Fraunces:opsz,wght,SOFT,WONK@9..144,400..900,0,1&display=swap');\n    .collision-display{font-family:'Fraunces',serif}\n    .collision-shadow{box-shadow:5px 5px 0 #111111}\n    .collision-shadow-sm{box-shadow:3px 3px 0 #111111}\n    .cloud-drift{animation:cloud-drift 18s ease-in-out infinite}\n    .cloud-drift-slow{animation:cloud-drift-slow 24s ease-in-out infinite}\n    .sticker-bob{animation:sticker-bob 4.5s ease-in-out infinite}\n    .sun-pulse{animation:sun-pulse 5s ease-in-out infinite}\n    .ticker-move{animation:ticker-move 28s linear infinite}\n    @keyframes cloud-drift{0%,100%{transform:translateX(0)}50%{transform:translateX(18px)}}\n    @keyframes cloud-drift-slow{0%,100%{transform:translateX(0) translateY(0)}50%{transform:translateX(-24px) translateY(7px)}}\n    @keyframes sticker-bob{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-10px) rotate(3deg)}}\n    @keyframes sun-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.035)}}\n    @keyframes ticker-move{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n    @media (prefers-reduced-motion:reduce){.cloud-drift,.cloud-drift-slow,.sticker-bob,.sun-pulse,.ticker-move{animation:none}}\n    </style>\n    <nav aria-label=\"Primary navigation\" class=\"fixed left-1/2 top-4 z-50 flex w-[calc(100%-2rem)] max-w-[1160px] -translate-x-1/2 items-center justify-between rounded-full border-2 border-[#111111] bg-white/90 px-3 py-2 backdrop-blur-md collision-shadow-sm sm:px-5\" data-kid=\"1-1\" data-name=\"navigation bar\">\n        <a aria-label=\"Collision home\" class=\"flex items-center gap-2.5\" data-kid=\"1-1-1\" data-name=\"logo container\" href=\"#top\">\n            <img alt=\"Collision helmet logo\" class=\"size-9 rounded-full border-2 border-[#111111] bg-[#a5f3fc] object-cover p-0.5 sm:size-10\" data-kid=\"1-1-1-1\" data-name=\"helmet logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend-new/public/collision-helmet.png\"/>\n            <span class=\"collision-display text-xl font-black tracking-[-0.06em] sm:text-2xl\" data-kid=\"1-1-1-2\" data-name=\"logo text\">\n                collision.\n            </span>\n        </a>\n        <div class=\"hidden items-center gap-7 text-[10px] font-extrabold uppercase tracking-[0.18em] md:flex\" data-kid=\"1-1-2\" data-name=\"navigation links container\">\n            <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-1-2-1\" data-name=\"how it works navigation link\" href=\"#how\">\n                How it works\n            </a>\n            <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-1-2-2\" data-name=\"what it owns navigation link\" href=\"#owns\">\n                What it owns\n            </a>\n            <a class=\"hover:text-[#1f5eff]\" data-kid=\"1-1-2-3\" data-name=\"proof navigation link\" href=\"#proof\">\n                Proof\n            </a>\n        </div>\n        <a class=\"rounded-full border-2 border-[#111111] bg-[#1f5eff] px-4 py-2.5 text-[10px] font-black uppercase tracking-[0.12em] text-white collision-shadow-sm hover:bg-[#111111]\" data-kid=\"1-1-3\" data-name=\"hire collision action button\" href=\"#contact\">\n            Hire Collision\n        </a>\n    </nav>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <section aria-labelledby=\"hero-title\" class=\"relative isolate flex min-h-[790px] items-center overflow-hidden bg-[#8fe8f5] px-4 pb-24 pt-32 sm:px-8 lg:min-h-[830px]\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div aria-hidden=\"true\" class=\"absolute inset-0 bg-[radial-gradient(circle_at_70%_22%,rgba(255,255,255,.72),transparent_20%),linear-gradient(180deg,#67d9ef_0%,#a5f3fc_67%,#d6f7ee_100%)]\" data-kid=\"1-2-1-1\" data-name=\"hero gradient background decoration\">\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute right-[10%] top-[13%] z-0 size-32 rounded-full border-2 border-[#111111] bg-[#ffe16a] collision-shadow sun-pulse sm:size-40\" data-kid=\"1-2-1-2\" data-name=\"sun decoration container\">\n                <div class=\"absolute left-1/2 top-[43%] flex -translate-x-1/2 gap-5 text-2xl\" data-kid=\"1-2-1-2-1\" data-name=\"sun eyes decoration\">\n                    <span data-kid=\"1-2-1-2-1-1\" data-name=\"left eye icon\">\n                        •\n                    </span>\n                    <span data-kid=\"1-2-1-2-1-2\" data-name=\"right eye icon\">\n                        •\n                    </span>\n                </div>\n                <div class=\"absolute left-1/2 top-[59%] h-5 w-10 -translate-x-1/2 rounded-b-full border-b-4 border-[#111111]\" data-kid=\"1-2-1-2-2\" data-name=\"sun mouth decoration\">\n                </div>\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute left-[11%] top-[22%] text-3xl text-[#111111]/70\" data-kid=\"1-2-1-3\" data-name=\"lightning bolt decoration\">\n                ⌁\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute left-[16%] top-[28%] text-2xl text-[#111111]/70\" data-kid=\"1-2-1-4\" data-name=\"lightning bolt decoration\">\n                ⌁\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute right-[20%] top-[31%] text-3xl text-[#111111]/60\" data-kid=\"1-2-1-5\" data-name=\"lightning bolt decoration\">\n                ⌁\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute left-[21%] top-[20%] rotate-[-8deg] text-2xl\" data-kid=\"1-2-1-6\" data-name=\"arrow decoration\">\n                ↗\n            </div>\n            <div aria-hidden=\"true\" class=\"absolute right-[29%] top-[24%] rotate-[12deg] text-xl\" data-kid=\"1-2-1-7\" data-name=\"arrow d