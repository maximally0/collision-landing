iner\">\n                            <div class=\"w-8 h-8 bg-gray-200 rounded-full border border-[var(--black)]\" data-kid=\"1-5-1-2-2-1-1-1\" data-name=\"user avatar placeholder\">\n                            </div>\n                            User\n                        </div>\n                        <p class=\"font-bold text-3xl md:text-5xl leading-tight\" data-kid=\"1-5-1-2-2-1-2\" data-name=\"chat message text\">\n                            \"Anything interesting today?\"\n                        </p>\n                    </div>\n                    <div class=\"chat-bubble-anim bg-[var(--blue)] text-white border-2 border-[var(--black)] p-10 bubble-right max-w-2xl hard-shadow self-end relative\" data-kid=\"1-5-1-2-2-2\" data-name=\"ai chat bubble\">\n                        <div class=\"absolute -top-14 right-0 font-black uppercase tracking-widest text-xs flex items-center gap-2 py-2\" data-kid=\"1-5-1-2-2-2-1\" data-name=\"ai bubble label container\">\n                            <span class=\"text-[var(--black)]\" data-kid=\"1-5-1-2-2-2-1-1\" data-name=\"ai name text\">\n                                Collision\n                            </span>\n                            <img alt=\"Collision Avatar\" class=\"w-10 h-10 border-2 border-white rounded-full bg-white\" data-kid=\"1-5-1-2-2-2-1-2\" data-name=\"ai avatar image\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                        </div>\n                        <p class=\"font-bold text-3xl md:text-5xl leading-tight text-white\" data-kid=\"1-5-1-2-2-2-2\" data-name=\"chat message text\">\n                            \"Three founders mentioned you. I drafted replies.\"\n                        </p>\n                    </div>\n                </div>\n                <!-- Row 3 -->\n                <div class=\"chat-row flex flex-col gap-12\" data-kid=\"1-5-1-2-3\" data-name=\"third conversation row\">\n                    <div class=\"chat-bubble-anim bg-[var(--paper)] border-2 border-[var(--black)] p-10 bubble-left max-w-2xl hard-shadow self-start relative\" data-kid=\"1-5-1-2-3-1\" data-name=\"user chat bubble\">\n                        <div class=\"absolute -top-14 left-0 font-black uppercase tracking-widest text-xs flex items-center gap-2 py-2\" data-kid=\"1-5-1-2-3-1-1\" data-name=\"user bubble avatar container\">\n                            <div class=\"w-8 h-8 bg-gray-200 rounded-full border border-[var(--black)]\" data-kid=\"1-5-1-2-3-1-1-1\" data-name=\"user avatar placeholder\">\n                            </div>\n                            User\n                        </div>\n                        <p class=\"font-bold text-3xl md:text-5xl leading-tight\" data-kid=\"1-5-1-2-3-1-2\" data-name=\"chat message text\">\n                            \"Write something about AI browsers.\"\n                        </p>\n                    </div>\n                    <div class=\"chat-bubble-anim bg-[var(--blue)] text-white border-2 border-[var(--black)] p-10 bubble-right max-w-2xl hard-shadow self-end relative\" data-kid=\"1-5-1-2-3-2\" data-name=\"ai chat bubble\">\n                        <div class=\"absolute -top-14 right-0 font-black uppercase tracking-widest text-xs flex items-center gap-2 py-2\" data-kid=\"1-5-1-2-3-2-1\" data-name=\"ai bubble label container\">\n                            <span class=\"text-[var(--black)]\" data-kid=\"1-5-1-2-3-2-1-1\" data-name=\"ai name text\">\n                                Collision\n                            </span>\n                            <img alt=\"Collision Avatar\" class=\"w-10 h-10 border-2 border-white rounded-full bg-white\" data-kid=\"1-5-1-2-3-2-1-2\" data-name=\"ai avatar image\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                        </div>\n                        <p class=\"font-bold text-3xl md:text-5xl leading-tight text-white\" data-kid=\"1-5-1-2-3-2-2\" data-name=\"chat message text\">\n                            \"Done. Want it opinionated or educational?\"\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Meet Collision (Mascot Section) -->\n    <section class=\"py-32 px-8 bg-[var(--yellow)] border-y-2 border-[var(--black)] relative overflow-hidden\" data-kid=\"1-6\" data-name=\"meet collision section\">\n        <div class=\"absolute top-0 right-0 w-64 h-64 halftone opacity-20 rotate-45\" data-kid=\"1-6-1\" data-name=\"section background decorative element\">\n        </div>\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-20 relative z-10\" data-kid=\"1-6-2\" data-name=\"mascot section grid container\">\n            <div class=\"w-full lg:w-1/2 relative\" data-kid=\"1-6-2-1\" data-name=\"mascot visual container\">\n                <div class=\"relative z-10\" data-kid=\"1-6-2-1-1\" data-name=\"helmet container\" id=\"meet-helmet-container\">\n                    <div class=\"absolute -top-12 -left-8 bg-white border-2 border-[var(--black)] p-5 rounded-2xl hard-shadow -rotate-6 z-20\" data-kid=\"1-6-2-1-1-1\" data-name=\"mascot quote bubble\">\n                        <span class=\"font-black text-2xl italic font-heading\" data-kid=\"1-6-2-1-1-1-1\" data-name=\"mascot quote text\">\n                            \"I'm Collision.\"\n                        </span>\n                    </div>\n                    <div class=\"rounded-full border-4 border-[var(--black)] hard-shadow-lg overflow-hidden bg-white aspect-square max-w-[500px] mx-auto group gsap-card\" data-kid=\"1-6-2-1-1-2\" data-name=\"mascot portrait container\">\n                        <img alt=\"Mascot Portrait\" class=\"w-full h-full object-cover\" data-kid=\"1-6-2-1-1-2-1\" data-name=\"mascot image\" id=\"mascot-img\" src=\"https://kombai-assets.b-cdn.net/generated_assets/c8f608587bf04d20abd249b05f177e57.jpg\"/>\n                    </div>\n                    <!-- Orbiting Labels -->\n                    <div class=\"orbit-label absolute -top-10 right-0 bg-[var(--blue)] text-white border-2 border-[var(--black)] px-4 py-2 rounded-full hard-shadow text-sm font-black uppercase\" data-kid=\"1-6-2-1-1-3\" data-name=\"orbiting scanning label\">\n                        Scanning DMs\n                    </div>\n                    <div class=\"orbit-label absolute top-1/2 -right-20 bg-[var(--mint)] border-2 border-[var(--black)] px-4 py-2 rounded-full hard-shadow text-sm font-black uppercase\" data-kid=\"1-6-2-1-1-4\" data-name=\"orbiting posting label\">\n                        Posting Content\n                    </div>\n                    <div class=\"orbit-label absolute bottom-0 left-0 bg-[var(--coral)] text-white border-2 border-[var(--black)] px-4 py-2 rounded-full hard-shadow text-sm font-black uppercase\" data-kid=\"1-6-2-1-1-5\" data-name=\"orbiting managing label\">\n                        Managing X\n                    </div>\n                </div>\n            </div>\n            <div class=\"w-full lg:w-1/2 space-y-12\" data-kid=\"1-6-2-2\" data-name=\"mascot info text container\">\n                <h2 class=\"font-heading text-6xl md:text-8xl leading-[0.9] tracking-tighter\" data-kid=\"1-6-2-2-1\" data-name=\"mascot main headline\">\n                    \"I make sure you don't disappear from the internet.\"\n                </h2>\n                <p class=\"text-2xl md:text-3xl font-medium text-[var(--black)]/80 leading-relaxed italic border-l-8 border-[var(--blue)] pl-8\" data-kid=\"1-6-2-2-2\" data-name=\"mascot description paragraph\">\n                    While you're asleep, coding, or playing tennis, I'm your digital twin. I learn your quirks and represent your best self online.\n                </p>\n                <div class=\"flex flex-wrap gap-4\" data-kid=\"1-6-2-2-3\" data-name=\"mascot feature tags container\">\n                    <span class=\"bg-white border-2 border-[var(--black)] px-6 py-3 rounded-xl hard-shadow font-black uppercase tracking-tighter\" data-kid=\"1-6-2-2-3-1\" data-name=\"feature tag 1\">\n                        Consistent ✓\n                    </span>\n                    <span class=\"bg-white border-2 border-[var(--black)] px-6 py-3 rounded-xl hard-shadow font-black uppercase tracking-tighter\" data-kid=\"1-6-2-2-3-2\" data-name=\"feature tag 2\">\n                        Authentic ✓\n                    </span>\n                    <span class=\"bg-white border-2 border-[var(--black)] px-6 py-3 rounded-xl hard-shadow font-black uppercase tracking-tighter\" data-kid=\"1-6-2-2-3-3\" data-name=\"feature tag 3\">\n                        Proactive ✓\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- How It Works (Zig-Zag Path) -->\n    <section class=\"py-32 px-8 bg-[var(--paper)]\" data-kid=\"1-7\" data-name=\"how it works section\" id=\"how\">\n        <div class=\"max-w-5xl mx-auto\" data-kid=\"1-7-1\" data-name=\"how it works container\">\n            <div class=\"text-center mb-24\" data-kid=\"1-7-1-1\" data-name=\"section header\">\n                <h2 class=\"font-heading text-6xl md:text-8xl\" data-kid=\"1-7-1-1-1\" data-name=\"section title\">\n                    How it works\n                </h2>\n                <p class=\"text-2xl mt-4 opacity-60\" data-kid=\"1-7-1-1-2\" data-name=\"section description\">\n                    Three steps to internet freedom.\n                </p>\n            </div>\n            <div class=\"relative\" data-kid=\"1-7-1-2\" data-name=\"process steps container\">\n                <!-- SVG Zig-Zag Path -->\n                <div class=\"absolute inset-0 pointer-events-none flex justify-center py-20\" data-kid=\"1-7-1-2-1\" data-name=\"path line graphic container\">\n                    <svg class=\"w-full h-full max-w-md opacity-20\" data-kid=\"1-7-1-2-1-1\" data-name=\"zig-zag line path\" height=\"1200\" viewbox=\"0 0 400 1200\" width=\"400\">\n                        <path d=\"M200,0 L100,200 L300,400 L100,600 L300,800 L100,1000 L200,1200\" fill=\"none\" id=\"scroll-path\" stroke=\"var(--black)\" stroke-dasharray=\"10 10\" stroke-width=\"4\">\n                        </path>\n                    </svg>\n                </div>\n                <div class=\"space-y-40 relative z-10\" data-kid=\"1-7-1-2-2\" data-name=\"steps wrapper\">\n                    <!-- Step 1 -->\n                    <div class=\"how-step flex flex-col md:flex-row items-center gap-12 group\" data-kid=\"1-7-1-2-2-1\" data-name=\"process step 1\">\n                        <div class=\"w-32 h-32 rounded-full bg-[var(--yellow)] border-4 border-[var(--black)] flex items-center justify-center font-heading text-6xl hard-shadow shrink-0 group-hover:scale-110 transition-transform\" data-kid=\"1-7-1-2-2-1-1\" data-name=\"step number circle\">\n                            1\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-7-1-2-2-1-2\" data-name=\"step details text wrapper\">\n                            <h3 class=\"font-heading text-5xl\" data-kid=\"1-7-1-2-2-1-2-1\" data-name=\"step title\">\n                                Teach me who you are.\n                            </h3>\n                            <p class=\"text-2xl text-[var(--black)]/70 max-w-lg\" data-kid=\"1-7-1-2-2-1-2-2\" data-name=\"step description\">\n                                Connect your profiles and let me analyze your history to learn your voice, humor, and expertise.\n                            </p>\n                        </div>\n                    </div>\n                    <!-- Step 2 -->\n                    <div class=\"how-step flex flex-col md:flex-row-reverse items-center gap-12 group text-right\" data-kid=\"1-7-1-2-2-2\" data-name=\"process step 2\">\n                        <div class=\"w-32 h-32 rounded-full bg-[var(--blue)] border-4 border-[var(--black)] flex items-center justify-center font-heading text-6xl text-white hard-shadow shrink-0 group-hover:scale-110 transition-transform\" data-kid=\"1-7-1-2-2-2-1\" data-name=\"step number circle\">\n                            2\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-7-1-2-2-2-2\" data-name=\"step details text wrapper\">\n                            <h3 class=\"font-heading text-5xl\" data-kid=\"1-7-1-2-2-2-2-1\" data-name=\"step title\">\n                                Talk to me naturally.\n                            </h3>\n                            <p class=\"text-2xl text-[var(--black)]/70 max-w-lg ml-auto\" data-kid=\"1-7-1-2-2-2-2-2\" data-name=\"step description\">\n                                No complex prompts. Just tell me your goals for the day in plain English. I'll take it from there.\n                            </p>\n                        </div>\n                    </div>\n                    <!-- Step 3 -->\n                    <div class=\"how-step flex flex-col md:flex-row items-center gap-12 group\" data-kid=\"1-7-1-2-2-3\" data-name=\"process step 3\">\n                        <div class=\"w-32 h-32 rounded-full bg-[var(--mint)] border-4 border-[var(--black)] flex items-center justify-center font-heading text-6xl hard-shadow shrink-0 group-hover:scale-110 transition-transform\" data-kid=\"1-7-1-2-2-3-1\" data-name=\"step number circle\">\n                            3\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"1-7-1-2-2-3-2\" data-name=\"step details text wrapper\">\n                            <h3 class=\"font-heading text-5xl\" data-kid=\"1-7-1-2-2-3-2-1\" data-name=\"step title\">\n                                Go build. I've got this.\n                            </h3>\n                            <p class=\"text-2xl text-[var(--black)]/70 max-w-lg\" data-kid=\"1-7-1-2-2-3-2-2\" data-name=\"step description\">\n                                Go back to your real work. I'll handle the replies, the posting, and the growth while you scale.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Today vs Tomorrow -->\n    <section class=\"py-32 px-8 border-y-2 border-[var(--black)]\" data-kid=\"1-8\" data-name=\"today vs tomorrow comparison section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-8-1\" data-name=\"comparison section container\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-0 border-4 border-[var(--black)] hard-shadow-lg rounded-[40px] overflow-hidden\" data-kid=\"1-8-1-1\" data-name=\"comparison grid container\">\n                <!-- Today -->\n                <div class=\"bg-[var(--coral)] p-16 md:p-24 border-b-4 md:border-b-0 md:border-r-4 border-[var(--black)] text-white\" data-kid=\"1-8-1-1-1\" data-name=\"today card\">\n                    <div class=\"text-sm font-black uppercase tracking-widest mb-6 opacity-80\" data-kid=\"1-8-1-1-1-1\" data-name=\"card status label\">\n                        TODAY\n                    </div>\n                    <h2 class=\"font-heading text-5xl md:text-7xl mb-10 leading-none\" data-kid=\"1-8-1-1-1-2\" data-name=\"card title\">\n                        AI + human operators.\n                    </h2>\n                    <p class=\"text-xl md:text-2xl opacity-90 leading-relaxed font-medium\" data-kid=\"1-8-1-1-1-3\" data-name=\"card description\">\n                        We're honest. Right now, our best-in-class AI works alongside creative strategists to ensure 100% brand safety and high-touch quality.\n                    </p>\n                    <div class=\"mt-12 flex items-center gap-4\" data-kid=\"1-8-1-1-1-4\" data-name=\"card footer\">\n                        <div class=\"flex -space-x-4\" data-kid=\"1-8-1-1-1-4-1\" data-name=\"avatar stack container\">\n                            <img alt=\"Avatar\" class=\"w-12 h-12 rounded-full border-2 border-[var(--black)]\" data-kid=\"1-8-1-1-1-4-1-1\" data-name=\"avatar 1\" src=\"https://i.pravatar.cc/100?u=1\"/>\n                            <img alt=\"Avatar\" class=\"w-12 h-12 rounded-full border-2 border-[var(--black)]\" data-kid=\"1-8-1-1-1-4-1-2\" data-name=\"avatar 2\" src=\"https://i.pravatar.cc/100?u=2\"/>\n                            <div class=\"w-12 h-12 rounded-full border-2 border-[var(--black)] bg-[var(--black)] flex items-center justify-center text-xs font-bold\" data-kid=\"1-8-1-1-1-4-1-3\" data-name=\"avatar extra count\">\n                                +12\n                            </div>\n                        </div>\n                        <span class=\"font-bold text-sm uppercase tracking-tighter\" data-kid=\"1-8-1-1-1-4-2\" data-name=\"human in loop text\">\n                            Humans in the loop\n                        </span>\n                    </div>\n                </div>\n                <!-- Tomorrow -->\n                <div class=\"bg-[var(--mint)] p-16 md:p-24 relative overflow-hidden group\" data-kid=\"1-8-1-1-2\" data-name=\"tomorrow card\">\n                    <div class=\"absolute top-0 right-0 p-8\" data-kid=\"1-8-1-1-2-1\" data-name=\"experimental tag container\">\n                        <div class=\"bg-white border-2 border-[var(--black)] px-4 py-2 rounded-lg hard-shadow -rotate-6 font-black text-xs\" data-kid=\"1-8-1-1-2-1-1\" data-name=\"experimental tag text\">\n                            EXPERIMENTAL V2\n                        </div>\n                    </div>\n                    <div class=\"text-sm font-black uppercase tracking-widest mb-6 text-[var(--black)]/60\" data-kid=\"1-8-1-1-2-2\" data-name=\"card status label\">\n                        TOMORROW\n                    </div>\n                    <h2 class=\"font-heading text-5xl md:text-7xl mb-10 leading-none\" data-kid=\"1-8-1-1-2-3\" data-name=\"card title\">\n                        Fully autonomous.\n                    </h2>\n                    <p class=\"text-xl md:text-2xl text-[var(--black)]/80 leading-relaxed font-medium\" data-kid=\"1-8-1-1-2-4\" data-name=\"card description\">\n                        The vision is zero human intervention. Real-time context, sentient-level understanding, and perfect execution 24/7 without a single supervisor.\n                    </p>\n                    <div class=\"mt-12\" data-kid=\"1-8-1-1-2-5\" data-name=\"card footer\">\n                        <div class=\"flex items-center gap-4\" data-kid=\"1-8-1-1-2-5-1\" data-name=\"level indicator wrapper\">\n                            <div class=\"w-12 h-12 rounded-full border-2 border-[var(--black)] bg-white flex items-center justify-center animate-spin-slow\" data-kid=\"1-8-1-1-2-5-1-1\" data-name=\"logo spinner container\">\n                                <img alt=\"Logo\" class=\"w-8 h-8\" data-kid=\"1-8-1-1-2-5-1-1-1\" data-name=\"logo icon\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                            </div>\n                            <span class=\"font-black text-sm uppercase tracking-tighter\" data-kid=\"1-8-1-1-2-5-1-2\" data-name=\"autonomy level text\">\n                                Level 5 Autonomy\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Final CTA -->\n    <section class=\"py-40 px-8 bg-[var(--paper)] relative overflow-hidden\" data-kid=\"1-9\" data-name=\"final call-to-action section\">\n        <div class=\"absolute -top-40 -left-40 w-96 h-96 halftone opacity-10 rounded-full\" data-kid=\"1-9-1\" data-name=\"background decorative element\">\n        </div>\n        <div class=\"max-w-7xl mx-auto relative z-10\" data-kid=\"1-9-2\" data-name=\"final cta wrapper\">\n            <div class=\"bg-white border-4 border-[var(--black)] rounded-[60px] p-12 md:p-24 hard-shadow-lg grid grid-cols-1 lg:grid-cols-2 gap-16 items-center overflow-hidden relative\" data-kid=\"1-9-2-1\" data-name=\"final cta content card\">\n                <div class=\"absolute inset-0 halftone opacity-5 pointer-events-none\" data-kid=\"1-9-2-1-1\" data-name=\"decorative halftone overlay\">\n                </div>\n                <div class=\"space-y-10\" data-kid=\"1-9-2-1-2\" data-name=\"cta content wrapper\">\n                    <h2 class=\"font-heading text-6xl md:text-8xl leading-[0.9] tracking-tighter\" data-kid=\"1-9-2-1-2-1\" data-name=\"cta title\">\n                        Ready to stop managing your online presence?\n                    </h2>\n                    <p class=\"text-2xl text-[var(--black)]/70 font-medium\" data-kid=\"1-9-2-1-2-2\" data-name=\"cta description\">\n                        Let Collision do it. We're onboarding 5 new clients every week. Grab your spot.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row gap-6\" data-kid=\"1-9-2-1-2-3\" data-name=\"cta buttons and status\">\n                        <button class=\"bg-[var(--blue)] text-white px-12 py-6 rounded-full font-black text-2xl border-4 border-[var(--black)] hard-shadow hover:translate-x-1 hover:translate-y-1 hover:shadow-none active:scale-95 transition-all\" data-kid=\"1-9-2-1-2-3-1\" data-name=\"primary cta button\" id=\"final-cta-btn\">\n                            Become a Client\n                        </button>\n                        <div class=\"flex flex-col justify-center\" data-kid=\"1-9-2-1-2-3-2\" data-name=\"cta status labels wrapper\">\n                            <span class=\"font-bold text-sm uppercase tracking-widest\" data-kid=\"1-9-2-1-2-3-2-1\" data-name=\"next onboarding date\">\n                                Next slot: Aug 15\n                            </span>\n                            <span class=\"text-xs text-red-500 font-bold uppercase animate-pulse\" data-kid=\"1-9-2-1-2-3-2-2\" data-name=\"remaining slots count\">\n                                2 spots remaining\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"relative\" data-kid=\"1-9-2-1-3\" data-name=\"cta illustration wrapper\">\n                    <div class=\"rounded-3xl border-4 border-[var(--black)] hard-shadow-lg overflow-hidden bg-[var(--cyan)] transform rotate-2\" data-kid=\"1-9-2-1-3-1\" data-name=\"cta illustration image container\">\n                        <img alt=\"Final CTA Illustration\" class=\"w-full h-full object-cover\" data-kid=\"1-9-2-1-3-1-1\" data-name=\"cta illustration\" src=\"https://kombai-assets.b-cdn.net/generated_assets/c3f729b9a34e496f9ea5f3c929f5d5d8.jpg\"/>\n                    </div>\n                    <!-- Floating helmets -->\n                    <img alt=\"Helmet\" class=\"absolute -top-10 -right-10 w-24 h-24 hard-shadow bg-white rounded-full border-2 border-[var(--black)] p-4 -rotate-12 floating-helmet\" data-kid=\"1-9-2-1-3-2\" data-name=\"floating helmet 1\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                    <img alt=\"Helmet\" class=\"absolute -bottom-10 left-1/4 w-20 h-20 hard-shadow bg-[var(--yellow)] rounded-full border-2 border-[var(--black)] p-4 rotate-6 floating-helmet\" data-kid=\"1-9-2-1-3-3\" data-name=\"floating helmet 2\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"py-20 px-8 bg-white border-t-2 border-[var(--black)] font-bold text-sm uppercase tracking-widest\" data-kid=\"1-10\" data-name=\"footer\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-12\" data-kid=\"1-10-1\" data-name=\"footer contents\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-10-1-1\" data-name=\"footer logo section\">\n                <img alt=\"Logo\" class=\"w-12 h-12\" data-kid=\"1-10-1-1-1\" data-name=\"logo\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                <span class=\"font-heading text-3xl font-black lowercase tracking-tighter\" data-kid=\"1-10-1-1-2\" data-name=\"footer brand name\">\n                    collision.\n                </span>\n            </div>\n            <div class=\"flex flex-wrap justify-center gap-12\" data-kid=\"1-10-1-2\" data-name=\"footer link group\">\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-10-1-2-1\" data-name=\"blog link\" href=\"#\">\n                    Blog\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-10-1-2-2\" data-name=\"privacy policy link\" href=\"#\">\n                    Privacy\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-10-1-2-3\" data-name=\"terms link\" href=\"#\">\n                    Terms\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-10-1-2-4\" data-name=\"twitter x link\" href=\"#\">\n                    Twitter / X\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-10-1-2-5\" data-name=\"linkedin link\" href=\"#\">\n                    LinkedIn\n                </a>\n            </div>\n            <div class=\"text-[var(--black)]/40 text-xs\" data-kid=\"1-10-1-3\" data-name=\"copyright text\">\n                © 2026 Collision Labs. Build on.\n            </div>\n        </div>\n        <div class=\"mt-16 overflow-hidden border-y border-[var(--black)] py-4\" data-kid=\"1-10-2\" data-name=\"marquee wrapper\">\n            <div class=\"marquee-track flex gap-20 whitespace-nowrap\" data-kid=\"1-10-2-1\" data-name=\"marquee track\">\n                <span class=\"marquee-item text-4xl font-heading opacity-30\" data-kid=\"1-10-2-1-1\" data-name=\"marquee item 1\">\n                    BUILD THE FUTURE. WE'LL TALK.\n                </span>\n                <span class=\"marquee-item text-4xl font-heading opacity-30\" data-kid=\"1-10-2-1-2\" data-name=\"marquee item 2\">\n                    REPRESENTING YOU 24/7.\n                </span>\n                <span class=\"marquee-item text-4xl font-heading opacity-30\" data-kid=\"1-10-2-1-3\" data-name=\"marquee item 3\">\n                    BUILD THE FUTURE. WE'LL TALK.\n                </span>\n                <span class=\"marquee-item text-4xl font-heading opacity-30\" data-kid=\"1-10-2-1-4\" data-name=\"marquee item 4\">\n                    REPRESENTING YOU 24/7.\n                </span>\n                <span class=\"marquee-item text-4xl font-heading opacity-30\" data-kid=\"1-10-2-1-5\" data-name=\"marquee item 5\">\n                    BUILD THE FUTURE. WE'LL TALK.\n                </span>\n                <span class=\"marquee-item text-4xl font-heading opacity-30\" data-kid=\"1-10-2-1-6\" data-name=\"marquee item 6\">\n                    REPRESENTING YOU 24/7.\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    // Initial Page Entrance\n  document.addEventListener('DOMContentLoaded', () => {\n    const tl = gsap.timeline();\n    \n    tl.from(\"#hero-badge\", { y: -20, opacity: 0, duration: 0.8, ease: \"power4.out\" })\n      .from(\"#hero-title\", { y: 40, opacity: 0, duration: 1, ease: \"power4.out\" }, \"-=0.6\")\n      .from(\"#hero-copy\", { y: 30, opacity: 0, duration: 1, ease: \"power4.out\" }, \"-=0.8\")\n      .from(\"#hero-ctas\", { y: 20, opacity: 0, duration: 0.8, ease: \"power4.out\" }, \"-=0.8\")\n      .from(\"#hero-image\", { scale: 1.1, opacity: 0, duration: 1.5, ease: \"power2.out\" }, \"-=1.2\")\n      .from(\".sticker\", { scale: 0, opacity: 0, rotation: -45, stagger: 0.2, duration: 0.8, ease: \"back.out(1.7)\" }, \"-=0.5\");\n\n    // Bobbing stickers\n    gsap.to(\".sticker\", {\n      y: -10,\n      duration: 2,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\",\n      stagger: 0.3\n    });\n\n    // Comic Panels reveal\n    gsap.utils.toArray('.comic-panel').forEach(panel => {\n      gsap.from(panel, {\n        scrollTrigger: {\n          trigger: panel,\n          start: \"top 80%\",\n        },\n        y: 60,\n        opacity: 0,\n        rotation: panel.dataset.scrollSpeed > 1.1 ? 5 : -5,\n        duration: 1.2,\n        ease: \"power3.out\"\n      });\n    });\n\n    // Feature cards stagger\n    gsap.from(\".feature-card\", {\n      scrollTrigger: {\n        trigger: \".feature-card\",\n        start: \"top 75%\",\n      },\n      y: 100,\n      opacity: 0,\n      duration: 1,\n      stagger: 0.15,\n      ease: \"power4.out\",\n      clearProps: \"transform\" // Critical to allow hover transitions after animation\n    });\n\n    // Chat bubbles revealing upward\n    gsap.utils.toArray('.chat-bubble-anim').forEach((bubble, i) => {\n      gsap.from(bubble, {\n        scrollTrigger: {\n          trigger: bubble,\n          start: \"top 85%\",\n        },\n        y: 40,\n        opacity: 0,\n        scale: 0.95,\n        duration: 0.8,\n        ease: \"back.out(1.2)\",\n        delay: i % 2 === 0 ? 0 : 0.3\n      });\n    });\n\n    // Mascot float animation\n    gsap.to(\"#mascot-img\", {\n      y: -15,\n      duration: 3,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n\n    gsap.to(\".orbit-label\", {\n      x: 10,\n      y: -10,\n      duration: 2.5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\",\n      stagger: 0.5\n    });\n\n    // How it works path drawing\n    gsap.from(\"#scroll-path\", {\n      scrollTrigger: {\n        trigger: \"#how\",\n        start: \"top 50%\",\n        end: \"bottom 50%\",\n        scrub: 2,\n      },\n      strokeDashoffset: 1000,\n      ease: \"none\"\n    });\n\n    // Step indicators pop\n    gsap.utils.toArray('.how-step').forEach(step => {\n       gsap.from(step, {\n         scrollTrigger: {\n           trigger: step,\n           start: \"top 80%\",\n         },\n         x: step.classList.contains('md:flex-row-reverse') ? 50 : -50,\n         opacity: 0,\n         duration: 1,\n         ease: \"power3.out\"\n       });\n    });\n\n    // Marquee animation\n    gsap.to(\".marquee-track\", {\n      xPercent: -50,\n      duration: 20,\n      repeat: -1,\n      ease: \"none\"\n    });\n\n    // Floating helmets in CTA\n    gsap.to(\".floating-helmet\", {\n       y: -20,\n       x: 10,\n       rotation: 10,\n       duration: 4,\n       repeat: -1,\n       yoyo: true,\n       ease: \"sine.inOut\",\n       stagger: 1\n    });\n\n    // Confetti burst on click\n    const btn = document.getElementById('final-cta-btn');\n    btn.addEventListener('click', () => {\n      confetti({\n        particleCount: 150,\n        spread: 70,\n        origin: { y: 0.6 },\n        colors: ['#1F5EFF', '#FF7B63', '#00E5C0', '#FFE16A']\n      });\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-08-04T15:32:39.399042+00:00",
      "modified": "2026-08-04T15:32:39.399042+00:00",
      "id": "var_3f9540dd1aa0",
      "viewportScrollY": 0
    },
    "var_e8d48baaea01": {
      "type": "variant",
      "label": "Collision — Sticker Book Landing",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Karla:wght@400;500;700&display=swap');\n\n    :root {\n        --electric-blue: #1F5EFF;\n        --soft-cyan: #F0F4FF;\n        --bold-yellow: #FFE600;\n        --soft-pink: #FF99A8;\n        --mint: #B2F5EA;\n        --black: #000000;\n        --white: #FFFFFF;\n    }\n\n    body {\n        font-family: 'Karla', sans-serif;\n        background-color: var(--white);\n        color: var(--black);\n        overflow-x: clip;\n    }\n\n    .font-outfit {\n        font-family: 'Outfit', sans-serif;\n    }\n\n    /* Sticker Shapes */\n    .sticker-shadow {\n        box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.1), 0 4px 10px -5px rgba(0, 0, 0, 0.04);\n    }\n\n    .glass {\n        background: rgba(255, 255, 255, 0.7);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 1px solid rgba(255, 255, 255, 0.3);\n    }\n\n    .aurora-bg {\n        background: linear-gradient(135deg, #F0F4FF 0%, #B2F5EA 25%, #FF99A8 50%, #F0F4FF 100%);\n        background-size: 400% 400%;\n        animation: aurora 15s ease infinite;\n    }\n\n    @keyframes aurora {\n        0% { background-position: 0% 50%; }\n        50% { background-position: 100% 50%; }\n        100% { background-position: 0% 50%; }\n    }\n\n    .marquee {\n        display: flex;\n        width: 200%;\n        animation: marquee 30s linear infinite;\n    }\n\n    @keyframes marquee {\n        0% { transform: translateX(0); }\n        100% { transform: translateX(-50%); }\n    }\n\n    .lenis.lenis-smooth {\n        height: auto;\n    }\n\n    .lenis.lenis-smooth [data-lenis-prevent] {\n        overscroll-behavior: contain;\n    }\n\n    .lenis.lenis-stopped {\n        overflow: hidden;\n    }\n\n    /* Product Orbit */\n    .orbit-pill {\n        position: absolute;\n        transform-origin: center center;\n    }\n\n    /* Cutout Window Mask */\n    .cutout-mask {\n        clip-path: inset(10% 10% 10% 10% round 3rem);\n    }\n</style>\n<link data-kid=\"1\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\"/>\n<!-- Navbar -->\n<nav class=\"fixed top-8 left-1/2 -translate-x-1/2 z-[100] w-full max-w-[1440px] px-8 pointer-events-none\" data-kid=\"2\" data-name=\"main navigation container\">\n    <div class=\"glass sticker-shadow rounded-full px-8 py-4 flex items-center justify-between pointer-events-auto\" data-kid=\"2-1\" data-name=\"navbar inner wrapper\">\n        <div class=\"flex items-center gap-3\" data-kid=\"2-1-1\" data-name=\"brand logo and name container\">\n            <img alt=\"Collision Logo\" class=\"w-10 h-10\" data-kid=\"2-1-1-1\" data-name=\"collision helmet icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n            <span class=\"font-outfit font-black text-2xl tracking-tighter\" data-kid=\"2-1-1-2\" data-name=\"brand name text\">\n                COLLISION\n            </span>\n        </div>\n        <div class=\"hidden lg:flex items-center gap-10 text-[15px] font-bold text-black/50\" data-kid=\"2-1-2\" data-name=\"navigation links container\">\n            <a class=\"hover:text-black transition-colors\" data-kid=\"2-1-2-1\" data-name=\"features navigation link\" href=\"#features\">\n                Features\n            </a>\n            <a class=\"hover:text-black transition-colors\" data-kid=\"2-1-2-2\" data-name=\"how it works navigation link\" href=\"#how-it-works\">\n                How it works\n            </a>\n            <a class=\"hover:text-black transition-colors\" data-kid=\"2-1-2-3\" data-name=\"pricing navigation link\" href=\"#pricing\">\n                Pricing\n            </a>\n            <a class=\"hover:text-black transition-colors\" data-kid=\"2-1-2-4\" data-name=\"blog navigation link\" href=\"#blog\">\n                Blog\n            </a>\n        </div>\n        <button class=\"bg-[#1F5EFF] text-white px-7 py-3 rounded-full font-black text-sm shadow-[0_8px_20px_rgba(31,94,255,0.3)] hover:scale-105 active:scale-95 transition-transform\" data-kid=\"2-1-3\" data-name=\"become a client call-to-action button\">\n            Become a Client\n        </button>\n    </div>\n</nav>\n<!-- Hero Section -->\n<section class=\"relative min-h-[950px] flex items-end px-20 pb-32 pt-40\" data-kid=\"3\" data-name=\"hero section\">\n    <div class=\"max-w-3xl relative z-10\" data-kid=\"3-1\" data-name=\"hero content wrapper\">\n        <h1 class=\"font-outfit text-[110px] leading-[0.88] font-black tracking-tight mb-8\" data-kid=\"3-1-1\" data-name=\"hero headline text\">\n            The AI that\n            <br data-kid=\"3-1-1-1\" data-name=\"headline line break 1\"/>\n            represents\n            <br data-kid=\"3-1-1-2\" data-name=\"headline line break 2\"/>\n            you online.\n        </h1>\n        <p class=\"text-[22px] leading-relaxed text-black/60 max-w-lg mb-12 font-medium\" data-kid=\"3-1-2\" data-name=\"hero subheadline text\">\n            Focus on building. Collision writes, replies, engages, and keeps your online presence alive while you're busy doing real work.\n        </p>\n        <div class=\"flex items-center gap-5\" data-kid=\"3-1-3\" data-name=\"hero call-to-action button group\">\n            <button class=\"bg-[#1F5EFF] text-white px-10 py-5 rounded-full text-xl font-black shadow-[0_15px_35px_rgba(31,94,255,0.25)] hover:bg-[#1546cc] transition-colors\" data-kid=\"3-1-3-1\" data-name=\"primary become a client button\">\n                Become a Client\n            </button>\n            <button class=\"bg-black/5 hover:bg-black/10 text-black px-10 py-5 rounded-full text-xl font-black transition-colors\" data-kid=\"3-1-3-2\" data-name=\"secondary see how it works button\">\n                See how it works\n            </button>\n        </div>\n    </div>\n    <!-- Hero Illustration Scatter -->\n    <div class=\"absolute top-0 right-[-150px] w-3/4 h-full pointer-events-none\" data-kid=\"3-2\" data-name=\"hero illustration container\">\n        <div class=\"relative w-full h-full\" data-kid=\"3-2-1\" data-name=\"hero illustration wrapper\">\n            <img alt=\"Collision Hero Illustration\" class=\"hero-main-img absolute top-10 right-0 w-[1050px] object-contain rotate-[-3deg] drop-shadow-[0_40px_80px_rgba(0,0,0,0.15)]\" data-dynamic=\"true\" data-kid=\"3-2-1-1\" data-name=\"main hero illustration image\" data-reason=\"position and rotation continuously updated by mouse move script\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/b03f8d0f3b08499a84fc4da81ac8388e.jpg?auto=format&w=1200&q=80\"/>\n            <!-- Floating Stickers -->\n            <div class=\"hero-sticker absolute top-[25%] left-[15%] bg-[#FFE600] px-6 py-3 rounded-2xl font-black text-lg sticker-shadow rotate-12 flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"3-2-1-2\" data-name=\"hero sticker replying\" data-reason=\"position updated by mouse move script\">\n                <span data-kid=\"3-2-1-2-1\" data-name=\"replying sticker text\">\n                    replying...\n                </span>\n            </div>\n            <div class=\"hero-sticker absolute top-[15%] left-[45%] bg-white p-5 rounded-3xl shadow-2xl -rotate-6\" data-dynamic=\"true\" data-kid=\"3-2-1-3\" data-name=\"hero sticker lightning\" data-reason=\"position updated by mouse move script\">\n                <span class=\"text-4xl\" data-kid=\"3-2-1-3-1\" data-name=\"lightning icon\">\n                    ⚡️\n                </span>\n            </div>\n            <div class=\"hero-sticker absolute top-[55%] left-[10%] bg-[#FF99A8] px-6 py-3 rounded-2xl font-black text-lg text-black/80 shadow-xl rotate-[-8deg]\" data-dynamic=\"true\" data-kid=\"3-2-1-4\" data-name=\"hero sticker comments done\" data-reason=\"position updated by mouse move script\">\n                <span data-kid=\"3-2-1-4-1\" data-name=\"comments done sticker text\">\n                    18 comments done\n                </span>\n            </div>\n            <div class=\"hero-sticker absolute top-[70%] left-[50%] bg-[#1F5EFF] px-6 py-3 rounded-2xl font-black text-lg text-white shadow-xl rotate-[5deg] flex items-center gap-2\" data-dynamic=\"true\" data-kid=\"3-2-1-5\" data-name=\"hero sticker posting\" data-reason=\"position updated by mouse move script\">\n                <span data-kid=\"3-2-1-5-1\" data-name=\"posting sticker text\">\n                    posting...\n                </span>\n            </div>\n            <div class=\"hero-sticker absolute top-[40%] right-[10%] bg-white p-5 rounded-3xl shadow-2xl rotate-12\" data-dynamic=\"true\" data-kid=\"3-2-1-6\" data-name=\"hero sticker heart\" data-reason=\"position updated by mouse move script\">\n                <span class=\"text-4xl\" data-kid=\"3-2-1-6-1\" data-name=\"heart icon\">\n                    ❤️\n                </span>\n            </div>\n            <div class=\"hero-sticker absolute bottom-[10%] right-[20%] bg-[#B2F5EA] px-5 py-2.5 rounded-full font-bold text-black/70 shadow-lg -rotate-12 border-2 border-white\" data-dynamic=\"true\" data-kid=\"3-2-1-7\" data-name=\"hero sticker handle\" data-reason=\"position updated by mouse move script\">\n                <span data-kid=\"3-2-1-7-1\" data-name=\"handle sticker text\">\n                    @collision_ai\n                </span>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- Problem Section: Polaroid Scatter -->\n<section class=\"py-40 bg-[#F0F4FF] overflow-hidden relative\" data-kid=\"4\" data-name=\"problem section\">\n    <div class=\"max-w-6xl mx-auto px-10 text-center mb-32 relative z-10\" data-kid=\"4-1\" data-name=\"problem section header container\">\n        <h2 class=\"font-outfit text-6xl font-black mb-6 tracking-tight\" data-kid=\"4-1-1\" data-name=\"problem section headline text\">\n            Your online presence has become\n            <br data-kid=\"4-1-1-1\" data-name=\"headline line break\"/>\n            a full-time job.\n        </h2>\n        <p class=\"text-2xl text-black/40 font-medium\" data-kid=\"4-1-2\" data-name=\"problem section subheadline text\">\n            It's a noisy mess. Let Collision sweep it clean.\n        </p>\n    </div>\n    <div class=\"relative h-[800px] max-w-7xl mx-auto\" data-kid=\"4-2\" data-name=\"problem cards container\">\n        <!-- Messy Notification Cards -->\n        <div class=\"problem-card absolute top-10 left-[10%] w-[320px] p-4 pb-14 bg-white shadow-2xl z-10 border border-black/5\" data-dynamic=\"true\" data-kid=\"4-2-1\" data-name=\"unread DMs problem card\" data-reason=\"hidden by script on trigger\">\n            <div class=\"bg-[#FFE600]/10 aspect-square rounded-lg mb-4 flex items-center justify-center text-6xl\" data-kid=\"4-2-1-1\" data-name=\"unread DMs icon\">\n                🔔\n            </div>\n            <p class=\"font-bold text-center text-xl\" data-kid=\"4-2-1-2\" data-name=\"unread DMs description text\">\n                14 unread DMs\n            </p>\n            <div class=\"absolute bottom-4 left-0 right-0 h-1 bg-black/5 mx-6 rounded-full\" data-kid=\"4-2-1-3\" data-name=\"unread DMs progress bar\">\n            </div>\n        </div>\n        <div class=\"problem-card absolute top-[15%] right-[12%] w-[320px] p-4 pb-14 bg-white shadow-2xl z-20 border border-black/5\" data-dynamic=\"true\" data-kid=\"4-2-2\" data-name=\"post performance problem card\" data-reason=\"hidden by script on trigger\">\n            <div class=\"bg-[#FF99A8]/10 aspect-square rounded-lg mb-4 flex items-center justify-center text-6xl\" data-kid=\"4-2-2-1\" data-name=\"post performance icon\">\n                📈\n            </div>\n            <p class=\"font-bold text-center text-xl\" data-kid=\"4-2-2-2\" data-name=\"post performance description text\">\n                Post performing poorly\n            </p>\n            <div class=\"absolute bottom-4 left-0 right-0 h-1 bg-black/5 mx-6 rounded-full\" data-kid=\"4-2-2-3\" data-name=\"post performance progress bar\">\n            </div>\n        </div>\n        <div class=\"problem-card absolute bottom-[20%] left-[20%] w-[320px] p-4 pb-14 bg-white shadow-2xl z-30 border border-black/5\" data-dynamic=\"true\" data-kid=\"4-2-3\" data-name=\"VC reply problem card\" data-reason=\"hidden by script on trigger\">\n            <div class=\"bg-[#1F5EFF]/10 aspect-square rounded-lg mb-4 flex items-center justify-center text-6xl\" data-kid=\"4-2-3-1\" data-name=\"VC reply icon\">\n                💼\n            </div>\n            <p class=\"font-bold text-center text-xl\" data-kid=\"4-2-3-2\" data-name=\"VC reply description text\">\n                Draft reply to VC\n            </p>\n            <div class=\"absolute bottom-4 left-0 right-0 h-1 bg-black/5 mx-6 rounded-full\" data-kid=\"4-2-3-3\" data-name=\"VC reply progress bar\">\n            </div>\n        </div>\n        <div class=\"problem-card absolute bottom-10 right-[25%] w-[320px] p-4 pb-14 bg-white shadow-2xl z-40 border border-black/5\" data-dynamic=\"true\" data-kid=\"4-2-4\" data-name=\"mention problem card\" data-reason=\"hidden by script on trigger\">\n            <div class=\"bg-[#B2F5EA]/10 aspect-square rounded-lg mb-4 flex items-center justify-center text-6xl\" data-kid=\"4-2-4-1\" data-name=\"mention icon\">\n                🗣️\n            </div>\n            <p class=\"font-bold text-center text-xl\" data-kid=\"4-2-4-2\" data-name=\"mention description text\">\n                3 people mentioned you\n            </p>\n            <div class=\"absolute bottom-4 left-0 right-0 h-1 bg-black/5 mx-6 rounded-full\" data-kid=\"4-2-4-3\" data-name=\"mention progress bar\">\n            </div>\n        </div>\n        <!-- Clearing Sticker -->\n        <div class=\"clearing-sticker absolute inset-0 flex items-center justify-center z-50 pointer-events-none scale-0 opacity-0\" data-dynamic=\"true\" data-kid=\"4-2-5\" data-name=\"clearing mascot sticker container\" data-reason=\"scale and opacity updated by scroll trigger\">\n            <div class=\"bg-[#1F5EFF] w-[500px] h-[500px] rounded-full flex flex-col items-center justify-center text-white shadow-[0_50px_100px_rgba(31,94,255,0.4)] rotate-6 border-[12px] border-white\" data-kid=\"4-2-5-1\" data-name=\"clearing mascot wrapper\">\n                <img alt=\"Collision Mascot\" class=\"w-48 h-48 mb-6 brightness-200\" data-kid=\"4-2-5-1-1\" data-name=\"clearing mascot logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                <p class=\"font-outfit font-black text-6xl uppercase tracking-tighter\" data-kid=\"4-2-5-1-2\" data-name=\"clearing text\">\n                    CLEANED\n                </p>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- Capability Section: Fanned Deck -->\n<section class=\"py-40 bg-white relative\" data-kid=\"5\" data-name=\"capability section\" id=\"features\">\n    <div class=\"max-w-7xl mx-auto px-10\" data-kid=\"5-1\" data-name=\"capability container\">\n        <div class=\"text-center mb-40\" data-kid=\"5-1-1\" data-name=\"capability header\">\n            <h2 class=\"font-outfit text-[80px] font-black tracking-tight\" data-kid=\"5-1-1-1\" data-name=\"capability headline text\">\n                What Collision actually does\n            </h2>\n            <p class=\"text-2xl text-black/30 font-bold -mt-4\" data-kid=\"5-1-1-2\" data-name=\"capability subheadline text\">\n                Human-grade presence, AI-grade scale.\n            </p>\n        </div>\n        <div class=\"capability-deck relative h-[700px] flex justify-center\" data-dynamic=\"true\" data-kid=\"5-1-2\" data-name=\"fanned capability cards deck\" data-reason=\"positions and rotations controlled by scroll scrub script\">\n            <!-- Think Card -->\n            <div class=\"capability-card absolute w-[380px] h-[550px] bg-[#FFE600] rounded-[3.5rem] p-12 flex flex-col justify-between shadow-2xl border-4 border-black/5 cursor-pointer\" data-kid=\"5-1-2-1\" data-name=\"think capability card\">\n                <div class=\"text-[120px]\" data-kid=\"5-1-2-1-1\" data-name=\"think emoji icon\">\n                    🧠\n                </div>\n                <div data-kid=\"5-1-2-1-2\" data-name=\"think text container\">\n                    <h3 class=\"font-outfit text-5xl font-black mb-6 tracking-tight\" data-kid=\"5-1-2-1-2-1\" data-name=\"think headline\">\n                        Think\n                    </h3>\n                    <p class=\"text-xl text-black font-medium leading-relaxed\" data-kid=\"5-1-2-1-2-2\" data-name=\"think description\">\n                        Learns your voice, goals and opinions in real-time.\n                    </p>\n                </div>\n            </div>\n            <!-- Create Card -->\n            <div class=\"capability-card absolute w-[380px] h-[550px] bg-[#B2F5EA] rounded-[3.5rem] p-12 flex flex-col justify-between shadow-2xl border-4 border-black/5 cursor-pointer\" data-kid=\"5-1-2-2\" data-name=\"create capability card\">\n                <div class=\"text-[120px]\" data-kid=\"5-1-2-2-1\" data-name=\"create emoji icon\">\n                    ✍️\n                </div>\n                <div data-kid=\"5-1-2-2-2\" data-name=\"create text container\">\n                    <h3 class=\"font-outfit text-5xl font-black mb-6 tracking-tight\" data-kid=\"5-1-2-2-2-1\" data-name=\"create headline\">\n                        Create\n                    </h3>\n                    <p class=\"text-xl text-black font-medium leading-relaxed\" data-kid=\"5-1-2-2-2-2\" data-name=\"create description\">\n                        Writes high-quality content that actually sounds like you.\n                    </p>\n                </div>\n            </div>\n            <!-- Engage Card -->\n            <div class=\"capability-card absolute w-[380px] h-[550px] bg-[#FF99A8] rounded-[3.5rem] p-12 flex flex-col justify-between shadow-2xl border-4 border-black/5 cursor-pointer\" data-kid=\"5-1-2-3\" data-name=\"engage capability card\">\n                <div class=\"text-[120px]\" data-kid=\"5-1-2-3-1\" data-name=\"engage emoji icon\">\n                    💬\n                </div>\n                <div data-kid=\"5-1-2-3-2\" data-name=\"engage text container\">\n                    <h3 class=\"font-outfit text-5xl font-black mb-6 tracking-tight\" data-kid=\"5-1-2-3-2-1\" data-name=\"engage headline\">\n                        Engage\n                    </h3>\n                    <p class=\"text-xl text-black font-medium leading-relaxed\" data-kid=\"5-1-2-3-2-2\" data-name=\"engage description\">\n                        Replies, comments and keeps every conversation alive.\n                    </p>\n                </div>\n            </div>\n            <!-- Grow Card -->\n            <div class=\"capability-card absolute w-[380px] h-[550px] bg-[#1F5EFF] rounded-[3.5rem] p-12 flex flex-col justify-between shadow-2xl border-4 border-black/5 cursor-pointer text-white\" data-kid=\"5-1-2-4\" data-name=\"grow capability card\">\n                <div class=\"text-[120px]\" data-kid=\"5-1-2-4-1\" data-name=\"grow emoji icon\">\n                    🚀\n                </div>\n                <div data-kid=\"5-1-2-4-2\" data-name=\"grow text container\">\n                    <h3 class=\"font-outfit text-5xl font-black mb-6 tracking-tight\" data-kid=\"5-1-2-4-2-1\" data-name=\"grow headline\">\n                        Grow\n                    </h3>\n                    <p class=\"text-xl text-white/90 font-medium leading-relaxed\" data-kid=\"5-1-2-4-2-2\" data-name=\"grow description\">\n                        Helps you stay consistently present and visible online.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- Talk Section: Frosted Bubbles -->\n<section class=\"py-40 px-8\" data-kid=\"6\" data-name=\"conversation section\">\n    <div class=\"max-w-[1300px] mx-auto aurora-bg rounded-[5rem] p-24 relative overflow-hidden sticker-shadow\" data-kid=\"6-1\" data-name=\"conversation content wrapper\">\n        <div class=\"absolute inset-0 bg-white/20 backdrop-blur-3xl\" data-kid=\"6-1-1\" data-name=\"frosted glass background overlay\">\n        </div>\n        <div class=\"relative z-10 max-w-4xl mx-auto flex flex-col gap-16\" data-kid=\"6-1-2\" data-name=\"conversation content group\">\n            <h2 class=\"font-outfit text-5xl font-black text-center mb-10\" data-kid=\"6-1-2-1\" data-name=\"conversation section headline\">\n                Talk to Collision naturally.\n            </h2>\n            <!-- Conversation 1 -->\n            <div class=\"chat-group flex flex-col gap-6 items-start\" data-kid=\"6-1-2-2\" data-name=\"conversation group 1\">\n                <div class=\"glass px-10 py-6 rounded-[2.5rem] rounded-bl-none shadow-xl text-2xl font-bold max-w-[80%]\" data-kid=\"6-1-2-2-1\" data-name=\"user message bubble 1\">\n                    \"Reply to everyone from today.\"\n                </div>\n                <div class=\"bg-[#1F5EFF] text-white px-10 py-6 rounded-[2.5rem] rounded-br-none shadow-2xl text-2xl font-bold self-end flex items-center gap-6\" data-kid=\"6-1-2-2-2\" data-name=\"collision reply bubble 1\">\n                    <img alt=\"C\" class=\"w-10 h-10 brightness-200\" data-kid=\"6-1-2-2-2-1\" data-name=\"collision helmet icon 1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                    <span data-kid=\"6-1-2-2-2-2\" data-name=\"reply text 1\">\n                        Done. I replied to 18 comments.\n                    </span>\n                </div>\n            </div>\n            <!-- Conversation 2 -->\n            <div class=\"chat-group flex flex-col gap-6 items-start\" data-kid=\"6-1-2-3\" data-name=\"conversation group 2\">\n                <div class=\"glass px-10 py-6 rounded-[2.5rem] rounded-bl-none shadow-xl text-2xl font-bold max-w-[80%]\" data-kid=\"6-1-2-3-1\" data-name=\"user message bubble 2\">\n                    \"Anything interesting today?\"\n                </div>\n                <div class=\"bg-[#1F5EFF] text-white px-10 py-6 rounded-[2.5rem] rounded-br-none shadow-2xl text-2xl font-bold self-end flex items-center gap-6\" data-kid=\"6-1-2-3-2\" data-name=\"collision reply bubble 2\">\n                    <img alt=\"C\" class=\"w-10 h-10 brightness-200\" data-kid=\"6-1-2-3-2-1\" data-name=\"collision helmet icon 2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                    <span data-kid=\"6-1-2-3-2-2\" data-name=\"reply text 2\">\n                        Three founders mentioned you. I drafted replies.\n                    </span>\n                </div>\n            </div>\n            <!-- Conversation 3 -->\n            <div class=\"chat-group flex flex-col gap-6 items-start\" data-kid=\"6-1-2-4\" data-name=\"conversation group 3\">\n                <div class=\"glass px-10 py-6 rounded-[2.5rem] rounded-bl-none shadow-xl text-2xl font-bold max-w-[80%]\" data-kid=\"6-1-2-4-1\" data-name=\"user message bubble 3\">\n                    \"Write something about AI browsers.\"\n                </div>\n                <div class=\"bg-[#1F5EFF] text-white px-10 py-6 rounded-[2.5rem] rounded-br-none shadow-2xl text-2xl font-bold self-end flex items-center gap-6\" data-kid=\"6-1-2-4-2\" data-name=\"collision reply bubble 3\">\n                    <img alt=\"C\" class=\"w-10 h-10 brightness-200\" data-kid=\"6-1-2-4-2-1\" data-name=\"collision helmet icon 3\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                    <span data-kid=\"6-1-2-4-2-2\" data-name=\"reply text 3\">\n                        Done. Want it opinionated or educational?\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- Meet Collision: Product Orbit -->\n<section class=\"py-40 bg-white overflow-hidden\" data-kid=\"7\" data-name=\"product orbit section\">\n    <div class=\"max-w-5xl mx-auto px-10 text-center\" data-kid=\"7-1\" data-name=\"product orbit content container\">\n        <h2 class=\"font-outfit text-7xl font-black mb-32 tracking-tight\" data-kid=\"7-1-1\" data-name=\"orbit section headline\">\n            Meet Collision\n        </h2>\n        <div class=\"relative w-[700px] h-[700px] mx-auto flex items-center justify-center\" data-kid=\"7-1-2\" data-name=\"orbit animation ring container\">\n            <!-- Concentric Rings -->\n            <div class=\"absolute inset-0 border-[3px] border-dashed border-black/5 rounded-full ring-large\" data-dynamic=\"true\" data-kid=\"7-1-2-1\" data-name=\"large animation ring\" data-reason=\"rotated 360 degrees infinitely by script\">\n            </div>\n            <div class=\"absolute inset-24 border-[2px] border-dashed border-black/5 rounded-full ring-medium\" data-dynamic=\"true\" data-kid=\"7-1-2-2\" data-name=\"medium animation ring\" data-reason=\"rotated -360 degrees infinitely by script\">\n            </div>\n            <div class=\"absolute inset-48 border-[1px] border-dashed border-black/5 rounded-full ring-small\" data-kid=\"7-1-2-3\" data-name=\"small animation ring\">\n            </div>\n            <div class=\"relative z-10\" data-kid=\"7-1-2-4\" data-name=\"mascot illustration container\">\n                <img alt=\"Collision Mascot Character\" class=\"w-[500px] h-[500px] object-contain drop-shadow-[0_60px_100px_rgba(0,0,0,0.1)]\" data-kid=\"7-1-2-4-1\" data-name=\"mascot illustration image\" decoding=\"async\" loading=\"lazy\" src=\"https://kombai-assets.b-cdn.net/generated_assets/a7c4744a00cd4566a7f68ea41d9ae9f2.jpg?auto=format&w=800&q=80\"/>\n            </div>\n            <!-- Orbiting Badges -->\n        