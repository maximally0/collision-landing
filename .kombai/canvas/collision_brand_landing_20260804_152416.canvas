rated_assets/c3f729b9a34e496f9ea5f3c929f5d5d8.jpg?auto=format&w=1440&q=80\"/>\n            <div class=\"absolute inset-0 bg-[#1F5EFF]/40 mix-blend-multiply\" data-kid=\"10-1-1-2\" data-name=\"background image tint\">\n            </div>\n        </div>\n        <!-- Content -->\n        <div class=\"relative z-10 flex flex-col items-center max-w-4xl\" data-kid=\"10-1-2\" data-name=\"final cta content\">\n            <h2 class=\"font-outfit text-[90px] leading-[0.9] font-black text-white mb-10 tracking-tight\" data-kid=\"10-1-2-1\" data-name=\"final headline\">\n                Ready to stop managing\n                <br data-kid=\"10-1-2-1-1\" data-name=\"final headline line break\"/>\n                your online presence?\n            </h2>\n            <p class=\"text-3xl text-white/90 mb-14 font-bold\" data-kid=\"10-1-2-2\" data-name=\"final subheadline text\">\n                Let Collision do it. You focus on building.\n            </p>\n            <button class=\"bg-white text-[#1F5EFF] px-16 py-8 rounded-full text-3xl font-black shadow-[0_25px_60px_rgba(0,0,0,0.3)] hover:scale-110 active:scale-95 transition-all duration-300\" data-kid=\"10-1-2-3\" data-name=\"final become a client button\" id=\"final-cta\">\n                Become a Client\n            </button>\n        </div>\n        <!-- Cutout Corner Decorations -->\n        <div class=\"absolute top-10 left-10 bg-white p-4 rounded-3xl shadow-xl rotate-[-12deg] hidden lg:block\" data-kid=\"10-1-3\" data-name=\"corner sticker container\">\n            <img alt=\"Helmet Sticker\" class=\"w-12 h-12\" data-kid=\"10-1-3-1\" data-name=\"corner helmet logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n        </div>\n        <div class=\"absolute bottom-10 right-10 bg-[#FFE600] px-6 py-3 rounded-2xl font-black text-xl shadow-xl rotate-12 hidden lg:block\" data-kid=\"10-1-4\" data-name=\"corner let's go sticker\">\n            LETS GO! 🚀\n        </div>\n    </div>\n</section>\n<!-- Footer -->\n<footer class=\"bg-white pt-20 px-10\" data-kid=\"11\" data-name=\"footer\">\n    <div class=\"bg-[#F0F4FF] rounded-t-[5rem] p-32 flex flex-col items-center gap-20\" data-kid=\"11-1\" data-name=\"footer inner container\">\n        <div class=\"flex flex-col items-center gap-8\" data-kid=\"11-1-1\" data-name=\"footer branding container\">\n            <img alt=\"Collision Footer Logo\" class=\"w-24 h-24 mb-4\" data-kid=\"11-1-1-1\" data-name=\"footer helmet logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n            <h2 class=\"font-outfit font-black text-[120px] leading-none tracking-[calc(-0.06em)] text-black\" data-kid=\"11-1-1-2\" data-name=\"footer brand name\">\n                COLLISION\n            </h2>\n        </div>\n        <div class=\"flex flex-wrap justify-center gap-4 max-w-4xl\" data-kid=\"11-1-2\" data-name=\"footer links container\">\n            <a class=\"bg-white px-10 py-4 rounded-full font-black text-lg text-black/60 hover:text-[#1F5EFF] transition-colors shadow-sm\" data-kid=\"11-1-2-1\" data-name=\"blog link\" href=\"#blog\">\n                Blog\n            </a>\n            <a class=\"bg-white px-10 py-4 rounded-full font-black text-lg text-black/60 hover:text-[#1F5EFF] transition-colors shadow-sm\" data-kid=\"11-1-2-2\" data-name=\"privacy link\" href=\"#privacy\">\n                Privacy\n            </a>\n            <a class=\"bg-white px-10 py-4 rounded-full font-black text-lg text-black/60 hover:text-[#1F5EFF] transition-colors shadow-sm\" data-kid=\"11-1-2-3\" data-name=\"terms link\" href=\"#terms\">\n                Terms\n            </a>\n            <a class=\"bg-white px-10 py-4 rounded-full font-black text-lg text-black/60 hover:text-[#1F5EFF] transition-colors shadow-sm\" data-kid=\"11-1-2-4\" data-name=\"twitter link\" href=\"#twitter\">\n                Twitter\n            </a>\n            <a class=\"bg-white px-10 py-4 rounded-full font-black text-lg text-black/60 hover:text-[#1F5EFF] transition-colors shadow-sm\" data-kid=\"11-1-2-5\" data-name=\"linkedin link\" href=\"#linkedin\">\n                LinkedIn\n            </a>\n        </div>\n        <!-- Marquee Text -->\n        <div class=\"w-full overflow-hidden border-y-2 border-black/5 py-10 mt-10\" data-kid=\"11-1-3\" data-name=\"marquee text container\">\n            <div class=\"marquee font-outfit font-black text-black/5 text-6xl uppercase tracking-[calc(0.2em)] flex items-center gap-20\" data-dynamic=\"true\" data-kid=\"11-1-3-1\" data-name=\"marquee text content\" data-reason=\"x position updated by marquee animation\">\n                <span data-kid=\"11-1-3-1-1\" data-name=\"marquee segment 1\">\n                    BUILD. WE'LL TALK.\n                </span>\n                <span data-kid=\"11-1-3-1-2\" data-name=\"marquee segment 2\">\n                    BUILD. WE'LL TALK.\n                </span>\n                <span data-kid=\"11-1-3-1-3\" data-name=\"marquee segment 3\">\n                    BUILD. WE'LL TALK.\n                </span>\n                <span data-kid=\"11-1-3-1-4\" data-name=\"marquee segment 4\">\n                    BUILD. WE'LL TALK.\n                </span>\n                <span data-kid=\"11-1-3-1-5\" data-name=\"marquee segment 5\">\n                    BUILD. WE'LL TALK.\n                </span>\n            </div>\n        </div>\n        <div class=\"text-black/30 font-bold text-sm\" data-kid=\"11-1-4\" data-name=\"copyright notice text\">\n            © 2026 COLLISION — ALL RIGHTS RESERVED.\n        </div>\n    </div>\n</footer>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js\">\n</script>\n<script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    \n    // Initialize Lenis Smooth Scroll\n    const lenis = new Lenis()\n    function raf(time) {\n        lenis.raf(time)\n        requestAnimationFrame(raf)\n    }\n    requestAnimationFrame(raf)\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Hero Parallax Tilt\n    document.addEventListener('mousemove', (e) => {\n        const x = (e.clientX / window.innerWidth - 0.5) * 20;\n        const y = (e.clientY / window.innerHeight - 0.5) * 20;\n        \n        gsap.to('.hero-main-img', {\n            x: x,\n            y: y,\n            rotation: -3 + (x * 0.1),\n            duration: 1,\n            ease: 'power2.out'\n        });\n\n        gsap.to('.hero-sticker', {\n            x: -x * 2,\n            y: -y * 2,\n            duration: 1.5,\n            ease: 'power2.out',\n            stagger: 0.05\n        });\n    });\n\n    // Problem Section Animation\n    const problemCards = document.querySelectorAll('.problem-card');\n    gsap.set(problemCards[0], { rotation: -15 });\n    gsap.set(problemCards[1], { rotation: 12 });\n    gsap.set(problemCards[2], { rotation: 6 });\n    gsap.set(problemCards[3], { rotation: -10 });\n\n    gsap.from(problemCards, {\n        scrollTrigger: {\n            trigger: '.problem-card',\n            start: 'top 80%',\n        },\n        y: 100,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.2,\n        ease: 'back.out(1.7)'\n    });\n\n    // Clear stickers\n    ScrollTrigger.create({\n        trigger: '.problem-card',\n        start: 'center center',\n        onEnter: () => {\n            gsap.to('.clearing-sticker', {\n                scale: 1,\n                opacity: 1,\n                duration: 1,\n                ease: 'elastic.out(1, 0.5)'\n            });\n            gsap.to(problemCards, {\n                x: (i) => (i % 2 === 0 ? -1000 : 1000),\n                opacity: 0,\n                duration: 1,\n                stagger: 0.1,\n                delay: 0.5\n            });\n        }\n    });\n\n    // Capability Fanned Deck\n    const capCards = document.querySelectorAll('.capability-card');\n    gsap.set(capCards, { x: 0, rotation: 0, zIndex: (i) => 50 - i });\n    \n    gsap.to(capCards, {\n        scrollTrigger: {\n            trigger: '.capability-deck',\n            start: 'top center',\n            end: 'bottom center',\n            scrub: 1,\n        },\n        x: (i) => (i - 1.5) * 420,\n        rotation: (i) => (i - 1.5) * 8,\n        ease: 'none'\n    });\n\n    // Chat Bubbles Float\n    gsap.from('.chat-group', {\n        scrollTrigger: {\n            trigger: '.aurora-bg',\n            start: 'top 60%',\n        },\n        y: 100,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.3,\n        ease: 'power3.out'\n    });\n\n    // Product Orbit\n    gsap.to('.ring-large', { rotation: 360, duration: 40, repeat: -1, ease: 'linear' });\n    gsap.to('.ring-medium', { rotation: -360, duration: 30, repeat: -1, ease: 'linear' });\n    \n    // Animate orbit badges separately\n    const orbitBadges = document.querySelectorAll('.orbit-badge');\n    orbitBadges.forEach((badge, i) => {\n        gsap.to(badge, {\n            y: '+=20',\n            duration: 2 + i,\n            repeat: -1,\n            yoyo: true,\n            ease: 'sine.inOut'\n        });\n    });\n\n    // S-Curve Step Blobs\n    gsap.from('.step-blob', {\n        scrollTrigger: {\n            trigger: '.step-blob',\n            start: 'top 85%',\n            toggleActions: 'play none none none'\n        },\n        scale: 0.8,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.4,\n        ease: 'back.out(1.7)'\n    });\n\n    // Final CTA Confetti\n    const ctaBtn = document.getElementById('final-cta');\n    ctaBtn.addEventListener('click', () => {\n        confetti({\n            particleCount: 150,\n            spread: 70,\n            origin: { y: 0.8 },\n            colors: ['#1F5EFF', '#FFE600', '#FF99A8', '#B2F5EA']\n        });\n    });\n</script>\n",
