      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap');\n\n  :root {\n    --paper: #F9F9F6;\n    --blue: #1F5EFF;\n    --black: #111111;\n    --coral: #FF7B63;\n    --mint: #00E5C0;\n    --yellow: #FFE16A;\n    --cyan: #A5F3FC;\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--black);\n    font-family: 'DM Sans', sans-serif;\n    overflow-x: clip;\n    margin: 0;\n  }\n\n  .font-heading { font-family: 'Fraunces', serif; }\n  \n  .hard-shadow {\n    box-shadow: 4px 4px 0 var(--black);\n  }\n  \n  .hard-shadow-lg {\n    box-shadow: 8px 8px 0 var(--black);\n  }\n\n  .halftone {\n    background-image: radial-gradient(var(--black) 1.5px, transparent 1.5px);\n    background-size: 15px 15px;\n    opacity: 0.05;\n  }\n\n  .grid-bg {\n    background-image: linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px),\n                      linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .bubble-left {\n    border-radius: 32px 32px 32px 8px;\n  }\n  \n  .bubble-right {\n    border-radius: 32px 32px 8px 32px;\n  }\n\n  /* Fix for GSAP / CSS Transition conflict */\n  .gsap-card {\n    transition: none !important;\n  }\n\n  .zig-zag-path {\n    background: repeating-linear-gradient(\n      45deg,\n      transparent,\n      transparent 10px,\n      rgba(17, 17, 17, 0.1) 10px,\n      rgba(17, 17, 17, 0.1) 11px\n    );\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 12px; }\n  ::-webkit-scrollbar-track { background: var(--paper); }\n  ::-webkit-scrollbar-thumb { \n    background: var(--black); \n    border: 3px solid var(--paper);\n    border-radius: 10px;\n  }\n\n  .perspective { perspective: 1000px; }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js\">\n</script>\n<div class=\"relative w-full overflow-x-clip min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Nav -->\n    <nav class=\"fixed top-8 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-4rem)] max-w-5xl\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <div class=\"bg-white border-2 border-[var(--black)] rounded-full px-6 py-3 flex items-center justify-between hard-shadow backdrop-blur-md bg-white/90\" data-kid=\"1-1-1\" data-name=\"navigation container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"logo and brand name group\">\n                <img alt=\"Collision Logo\" class=\"w-10 h-10\" data-kid=\"1-1-1-1-1\" data-name=\"collision logo\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                <span class=\"font-heading text-2xl font-black tracking-tighter\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Collision\n                </span>\n            </div>\n            <div class=\"hidden md:flex items-center gap-8 font-bold text-sm uppercase tracking-widest\" data-kid=\"1-1-1-2\" data-name=\"navigation link container\">\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-1-1-2-1\" data-name=\"features link\" href=\"#features\">\n                    Features\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-1-1-2-2\" data-name=\"how it works link\" href=\"#how\">\n                    How it works\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-1-1-2-3\" data-name=\"pricing link\" href=\"#pricing\">\n                    Pricing\n                </a>\n                <a class=\"hover:text-[var(--blue)] transition-colors\" data-kid=\"1-1-1-2-4\" data-name=\"blog link\" href=\"#blog\">\n                    Blog\n                </a>\n            </div>\n            <button class=\"bg-[var(--blue)] text-white px-6 py-2 rounded-full font-bold border-2 border-[var(--black)] hard-shadow-sm transform active:scale-95 transition-transform\" data-kid=\"1-1-1-3\" data-name=\"primary call-to-action button\" style=\"box-shadow: 2px 2px 0 var(--black);\">\n                Become a Client\n            </button>\n        </div>\n    </nav>\n    <!-- Hero -->\n    <section class=\"pt-32 pb-20 px-8 bg-grid\" data-kid=\"1-2\" data-name=\"hero section\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-12 border-2 border-[var(--black)] bg-white hard-shadow relative overflow-hidden\" data-kid=\"1-2-1\" data-name=\"hero card container\">\n            <div class=\"absolute inset-0 halftone pointer-events-none\" data-kid=\"1-2-1-1\" data-name=\"halftone background overlay\">\n            </div>\n            <div class=\"col-span-12 lg:col-span-7 p-12 lg:p-20 border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--black)] bg-[var(--paper)] relative z-10 flex flex-col justify-center min-h-full\" data-kid=\"1-2-1-2\" data-name=\"hero content wrapper\">\n                <div class=\"inline-block self-start px-4 py-1.5 border-2 border-[var(--black)] rounded-full text-xs font-black uppercase tracking-widest mb-8 bg-[var(--yellow)] hard-shadow\" data-kid=\"1-2-1-2-1\" data-name=\"hero badge\" id=\"hero-badge\" style=\"box-shadow: 2px 2px 0 var(--black);\">\n                    Internet-Native Partner\n                </div>\n                <h1 class=\"font-heading text-6xl md:text-9xl leading-[0.85] mb-8 tracking-tighter\" data-kid=\"1-2-1-2-2\" data-name=\"hero headline text\" id=\"hero-title\">\n                    The AI that\n                    <br data-kid=\"1-2-1-2-2-1\" data-name=\"line break\"/>\n                    <span class=\"text-[var(--blue)] italic decoration-4 decoration-[var(--black)]\" data-kid=\"1-2-1-2-2-2\" data-name=\"highlighted headline text\">\n                        represents you\n                    </span>\n                    <br data-kid=\"1-2-1-2-2-3\" data-name=\"line break\"/>\n                    online.\n                </h1>\n                <p class=\"text-xl md:text-3xl max-w-xl mb-10 text-[var(--black)]/90 leading-tight font-medium\" data-kid=\"1-2-1-2-3\" data-name=\"hero subheadline text\" id=\"hero-copy\">\n                    Focus on building. Collision writes, replies, engages, and keeps your presence alive while you do real work.\n                </p>\n                <div class=\"flex flex-wrap gap-6 items-center\" data-kid=\"1-2-1-2-4\" data-name=\"hero call-to-action container\" id=\"hero-ctas\">\n                    <button class=\"group bg-[var(--blue)] text-white px-10 py-5 rounded-full font-black text-xl border-2 border-[var(--black)] hard-shadow transform hover:-translate-y-1 active:translate-y-0 active:shadow-none transition-all\" data-kid=\"1-2-1-2-4-1\" data-name=\"primary action button\">\n                        Become a Client\n                    </button>\n                    <a class=\"font-bold text-lg flex items-center gap-3 group\" data-kid=\"1-2-1-2-4-2\" data-name=\"secondary action link\" href=\"#\">\n                        <span class=\"border-b-2 border-transparent group-hover:border-[var(--black)] transition-all\" data-kid=\"1-2-1-2-4-2-1\" data-name=\"secondary action text\">\n                            See how it works\n                        </span>\n                        <span class=\"w-10 h-10 rounded-full border-2 border-[var(--black)] flex items-center justify-center group-hover:bg-[var(--black)] group-hover:text-white transition-all\" data-kid=\"1-2-1-2-4-2-2\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"col-span-12 lg:col-span-5 relative bg-[var(--cyan)] min-h-[500px] overflow-hidden group\" data-kid=\"1-2-1-3\" data-name=\"hero illustration container\">\n                <img alt=\"Collision Hero Illustration\" class=\"w-full h-full object-cover\" data-kid=\"1-2-1-3-1\" data-name=\"hero illustration image\" id=\"hero-image\" src=\"https://kombai-assets.b-cdn.net/generated_assets/ae108eacaeea46e8b9d85ce3ea4b235e.jpg\"/>\n                <!-- Animated Stickers -->\n                <div class=\"sticker absolute top-12 right-12 bg-white border-2 border-[var(--black)] p-4 rounded-2xl hard-shadow -rotate-6 z-20\" data-kid=\"1-2-1-3-2\" data-name=\"replying status sticker\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-3-2-1\" data-name=\"sticker content wrapper\">\n                        <div class=\"w-3 h-3 rounded-full bg-red-500 animate-pulse\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"pulse indicator\">\n                        </div>\n                        <span class=\"font-black text-sm uppercase tracking-tighter\" data-kid=\"1-2-1-3-2-1-2\" data-name=\"status label text\">\n                            replying...\n                        </span>\n                    </div>\n                </div>\n                <div class=\"sticker absolute bottom-24 right-8 bg-[var(--blue)] text-white border-2 border-[var(--black)] p-4 rounded-2xl hard-shadow rotate-3 z-20\" data-kid=\"1-2-1-3-3\" data-name=\"dm status sticker\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-3-3-1\" data-name=\"sticker content wrapper\">\n                        <img alt=\"Helmet Icon\" class=\"w-8 h-8 object-contain brightness-0 invert\" data-kid=\"1-2-1-3-3-1-1\" data-name=\"helmet icon\" src=\"/api/local/images/frontend/public/collision-helmet.png\"/>\n                        <span class=\"font-black text-sm uppercase tracking-tighter\" data-kid=\"1-2-1-3-3-1-2\" data-name=\"status label text\">\n                            DMs handled ✓\n                        </span>\n                    </div>\n                </div>\n                <div class=\"sticker absolute top-1/2 left-8 bg-[var(--yellow)] border-2 border-[var(--black)] p-4 rounded-2xl hard-shadow -rotate-3 z-20\" data-kid=\"1-2-1-3-4\" data-name=\"posting status sticker\">\n                    <span class=\"font-black text-sm uppercase tracking-tighter\" data-kid=\"1-2-1-3-4-1\" data-name=\"status label text\">\n                        posting on X...\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Problem Section (Comic Strip) -->\n    <section class=\"py-24 px-8 bg-[var(--paper)]\" data-kid=\"1-3\" data-name=\"problem description section\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-3-1\" data-name=\"problem description container\">\n            <div class=\"text-center mb-20\" data-kid=\"1-3-1-1\" data-name=\"problem section header\">\n                <span class=\"text-[var(--blue)] font-black uppercase tracking-widest text-sm\" data-kid=\"1-3-1-1-1\" data-name=\"section pre-header label\">\n                    The Internet Problem\n                </span>\n                <h2 class=\"font-heading text-5xl md:text-7xl mt-4 leading-none\" data-kid=\"1-3-1-1-2\" data-name=\"section main title\">\n                    Your presence is a full-time job.\n                </h2>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-16 relative\" data-kid=\"1-3-1-2\" data-name=\"comic panel grid container\">\n                <!-- Panel 1 -->\n                <div class=\"comic-panel relative\" data-kid=\"1-3-1-2-1\" data-name=\"comic panel one\" data-scroll-speed=\"1\">\n                    <div class=\"absolute -top-6 -left-6 bg-[var(--coral)] text-white font-black px-6 py-2 border-2 border-[var(--black)] hard-shadow z-30 -rotate-3 uppercase text-xl\" data-kid=\"1-3-1-2-1-1\" data-name=\"panel caption bubble\">\n                        You, 47 tabs deep\n                    </div>\n                    <div class=\"border-4 border-[var(--black)] rounded-3xl overflow-hidden hard-shadow-lg bg-white aspect-[4/3] relative\" data-kid=\"1-3-1-2-1-2\" data-name=\"panel image container\">\n                        <img alt=\"Chaos\" class=\"w-full h-full object-cover grayscale-[0.2] contrast-125\" data-kid=\"1-3-1-2-1-2-1\" data-name=\"panel illustration\" src=\"https://kombai-assets.b-cdn.net/generated_assets/13b0d6eaf7bf48cb9a94510d0b654726.jpg\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--black)]/40 to-transparent\" data-kid=\"1-3-1-2-1-2-2\" data-name=\"panel gradient overlay\">\n                        </div>\n                    </div>\n                </div>\n                <!-- Panel 2 -->\n                <div class=\"comic-panel relative md:mt-32\" data-kid=\"1-3-1-2-2\" data-name=\"comic panel two\" data-scroll-speed=\"1.2\">\n                    <div class=\"absolute -top-6 -right-6 bg-[var(--mint)] text-[var(--black)] font-black px-6 py-2 border-2 border-[var(--black)] hard-shadow z-30 rotate-3 uppercase text-xl\" data-kid=\"1-3-1-2-2-1\" data-name=\"panel caption bubble\">\n                        Collision, on it.\n                    </div>\n                    <div class=\"border-4 border-[var(--black)] rounded-3xl overflow-hidden hard-shadow-lg bg-white aspect-[4/3] relative\" data-kid=\"1-3-1-2-2-2\" data-name=\"panel image container\">\n                        <img alt=\"Calm\" class=\"w-full h-full object-cover\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"panel illustration\" src=\"https://kombai-assets.b-cdn.net/generated_assets/3ca7b96a02624fa99f948e8ea55deed8.jpg\"/>\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--mint)]/20 to-transparent\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"panel gradient overlay\">\n                        </div>\n                    </div>\n                </div>\n                <!-- Comic Arrow -->\n                <div class=\"hidden md:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20\" data-kid=\"1-3-1-2-3\" data-name=\"comic connector arrow graphic\">\n                    <svg class=\"rotate-12\" data-kid=\"1-3-1-2-3-1\" data-name=\"arrow svg\" height=\"120\" viewbox=\"0 0 120 120\" width=\"120\">\n                        <path d=\"M10,60 Q60,10 110,60\" fill=\"none\" stroke=\"var(--black)\" stroke-dasharray=\"8 8\" stroke-width=\"4\">\n                        </path>\n                        <path d=\"M100,45 L115,60 L100,75\" fill=\"none\" stroke=\"var(--black)\" stroke-width=\"4\">\n                        </path>\n                    </svg>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Capability Cards -->\n    <section class=\"py-24 px-8 bg-grid relative overflow-hidden\" data-kid=\"1-4\" data-name=\"feature capabilities section\" id=\"features\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"1-4-1\" data-name=\"feature section container\">\n            <div class=\"mb-20 flex flex-col md:flex-row md:items-end justify-between gap-8\" data-kid=\"1-4-1-1\" data-name=\"section header container\">\n                <h2 class=\"font-heading text-6xl md:text-8xl max-w-2xl leading-none\" data-kid=\"1-4-1-1-1\" data-name=\"section title\">\n                    What Collision actually does\n                </h2>\n                <p class=\"text-xl font-medium text-[var(--black)]/60 max-w-sm mb-4 italic\" data-kid=\"1-4-1-1-2\" data-name=\"section description text\">\n                    No generic dashboards. Just pure performance.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 items-stretch\" data-kid=\"1-4-1-2\" data-name=\"feature grid container\">\n                <!-- Think -->\n                <div class=\"feature-card lg:col-span-4 bg-[var(--yellow)] border-2 border-[var(--black)] p-12 rounded-[48px] hard-shadow group cursor-default -rotate-1 gsap-card\" data-kid=\"1-4-1-2-1\" data-name=\"think feature card\">\n                    <div class=\"mb-12 flex justify-between items-start\" data-kid=\"1-4-1-2-1-1\" data-name=\"card header\">\n                        <div class=\"text-8xl\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"brain emoji\">\n                            🧠\n                        </div>\n                        <svg class=\"w-16 h-16 text-[var(--black)]/20 -rotate-12\" data-kid=\"1-4-1-2-1-1-2\" data-name=\"decorative line icon\" viewbox=\"0 0 100 100\">\n                            <path d=\"M10,90 Q50,10 90,90\" fill=\"none\" stroke=\"currentColor\" stroke-dasharray=\"6 6\" stroke-linecap=\"round\" stroke-width=\"6\">\n                            </path>\n                        </svg>\n                    </div>\n                    <h3 class=\"font-heading text-5xl mb-8\" data-kid=\"1-4-1-2-1-2\" data-name=\"card title\">\n                        Think\n                    </h3>\n                    <p class=\"text-2xl font-medium text-[var(--black)]/80 leading-snug\" data-kid=\"1-4-1-2-1-3\" data-name=\"card description\">\n                        Deep analysis of your past interactions to learn your specific humor and expertise.\n                    </p>\n                    <div class=\"mt-12 pt-12 border-t-2 border-[var(--black)]/10 flex items-center justify-between font-black uppercase text-sm tracking-tighter\" data-kid=\"1-4-1-2-1-4\" data-name=\"card footer\">\n                        <span data-kid=\"1-4-1-2-1-4-1\" data-name=\"capability label\">\n                            Voice DNA Engine\n                        </span>\n                        <span data-kid=\"1-4-1-2-1-4-2\" data-name=\"capability index\">\n                            01\n                        </span>\n                    </div>\n                </div>\n                <!-- Create -->\n                <div class=\"feature-card lg:col-span-8 bg-[var(--blue)] text-white border-2 border-[var(--black)] p-12 rounded-[48px] hard-shadow group cursor-default rotate-1 gsap-card\" data-kid=\"1-4-1-2-2\" data-name=\"create feature card\">\n                    <div class=\"mb-12 flex justify-between items-start\" data-kid=\"1-4-1-2-2-1\" data-name=\"card header\">\n                        <div class=\"text-8xl\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"pen emoji\">\n                            ✍️\n                        </div>\n                        <svg class=\"w-24 h-24 text-white/10\" data-kid=\"1-4-1-2-2-1-2\" data-name=\"decorative box icon\" viewbox=\"0 0 100 100\">\n                            <path d=\"M10,10 L90,10 L90,90 L10,90 Z\" fill=\"none\" stroke=\"currentColor\" stroke-dasharray=\"12 6\" stroke-width=\"4\">\n                            </path>\n                        </svg>\n                    </div>\n                    <h3 class=\"font-heading text-6xl mb-8 text-white\" data-kid=\"1-4-1-2-2-2\" data-name=\"card title\">\n                        Create\n                    </h3>\n                    <p class=\"text-3xl font-medium text-white/90 leading-tight max-w-2xl\" data-kid=\"1-4-1-2-2-3\" data-name=\"card description\">\n                        Writes high-quality, long-form content that captures your unique perspective without you lifting a finger.\n                    </p>\n                    <div class=\"mt-12 pt-12 border-t-2 border-white/20 flex items-center justify-between font-black uppercase text-sm tracking-tighter\" data-kid=\"1-4-1-2-2-4\" data-name=\"card footer\">\n                        <span data-kid=\"1-4-1-2-2-4-1\" data-name=\"capability label\">\n                            Autonomous Content Studio\n                        </span>\n                        <span data-kid=\"1-4-1-2-2-4-2\" data-name=\"capability index\">\n                            02\n                        </span>\n                    </div>\n                </div>\n                <!-- Engage -->\n                <div class=\"feature-card lg:col-span-7 bg-[var(--mint)] border-2 border-[var(--black)] p-12 rounded-[48px] hard-shadow group cursor-default -rotate-1 gsap-card\" data-kid=\"1-4-1-2-3\" data-name=\"engage feature card\">\n                    <div class=\"mb-12 flex justify-between items-start\" data-kid=\"1-4-1-2-3-1\" data-name=\"card header\">\n                        <div class=\"text-8xl\" data-kid=\"1-4-1-2-3-1-1\" data-name=\"chat emoji\">\n                            💬\n                        </div>\n                        <svg class=\"w-20 h-20 text-[var(--black)]/10\" data-kid=\"1-4-1-2-3-1-2\" data-name=\"decorative circle icon\" viewbox=\"0 0 100 100\">\n                            <circle cx=\"50\" cy=\"50\" fill=\"none\" r=\"40\" stroke=\"currentColor\" stroke-dasharray=\"10 5\" stroke-width=\"5\">\n                            </circle>\n                        </svg>\n                    </div>\n                    <h3 class=\"font-heading text-6xl mb-8\" data-kid=\"1-4-1-2-3-2\" data-name=\"card title\">\n                        Engage\n                    </h3>\n                    <p class=\"text-3xl font-medium text-[var(--black)]/80 leading-tight\" data-kid=\"1-4-1-2-3-3\" data-name=\"card description\">\n                        Your digital double. I reply to every comment and DM with the exact nuance you would use.\n                    </p>\n                    <div class=\"mt-12 pt-12 border-t-2 border-[var(--black)]/10 flex items-center justify-between font-black uppercase text-sm tracking-tighter\" data-kid=\"1-4-1-2-3-4\" data-name=\"card footer\">\n                        <span data-kid=\"1-4-1-2-3-4-1\" data-name=\"capability label\">\n                            Active Engagement Loop\n                        </span>\n                        <span data-kid=\"1-4-1-2-3-4-2\" data-name=\"capability index\">\n                            03\n                        </span>\n                    </div>\n                </div>\n                <!-- Grow -->\n                <div class=\"feature-card lg:col-span-5 bg-[var(--coral)] text-white border-2 border-[var(--black)] p-12 rounded-[48px] hard-shadow group cursor-default rotate-2 gsap-card\" data-kid=\"1-4-1-2-4\" data-name=\"grow feature card\">\n                    <div class=\"mb-12 flex justify-between items-start\" data-kid=\"1-4-1-2-4-1\" data-name=\"card header\">\n                        <div class=\"text-8xl\" data-kid=\"1-4-1-2-4-1-1\" data-name=\"rocket emoji\">\n                            🚀\n                        </div>\n                        <div class=\"w-16 h-16 bg-white/10 rounded-full flex items-center justify-center\" data-kid=\"1-4-1-2-4-1-2\" data-name=\"decorative arrow icon container\">\n                            <svg class=\"w-8 h-8 text-white\" data-kid=\"1-4-1-2-4-1-2-1\" data-name=\"arrow icon\" viewbox=\"0 0 100 100\">\n                                <path d=\"M50,10 L90,90 L10,90 Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"8\">\n                                </path>\n                            </svg>\n                        </div>\n                    </div>\n                    <h3 class=\"font-heading text-5xl mb-8 text-white\" data-kid=\"1-4-1-2-4-2\" data-name=\"card title\">\n                        Grow\n                    </h3>\n                    <p class=\"text-2xl font-medium text-white/90 leading-snug\" data-kid=\"1-4-1-2-4-3\" data-name=\"card description\">\n                        Exponential scale. I build your audience while you build the actual product.\n                    </p>\n                    <div class=\"mt-12 pt-12 border-t-2 border-white/20 flex items-center justify-between font-black uppercase text-sm tracking-tighter\" data-kid=\"1-4-1-2-4-4\" data-name=\"card footer\">\n                        <span data-kid=\"1-4-1-2-4-4-1\" data-name=\"capability label\">\n                            Network Expansion\n                        </span>\n                        <span data-kid=\"1-4-1-